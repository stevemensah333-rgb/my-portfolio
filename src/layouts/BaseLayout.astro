---
import Analytics from '@vercel/analytics/astro';
import { default as SpeedInsights } from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';
import WorkspaceRail from '../components/WorkspaceRail.astro';
import '../styles/global.css';
import '../styles/interactions.css';
import displayFontURL from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import interFontURL from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoFontURL from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';

type WorkspaceArea = 'home' | 'work' | 'case' | 'lab' | 'profile';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  canonical?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Which density the page uses. Derived from the route by default. */
  area?: WorkspaceArea;
}

const {
  title,
  description,
  image = '/social-preview.png',
  imageAlt = 'Stephen Mensah — AI Engineering and Computer Science',
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  ogType = 'website',
  noindex = false,
  canonical = true,
  structuredData,
  area,
} = Astro.props;

/* Density is a property of the place, not of the page file: Home is
   spacious, Work is visual, Lab is concentrated, Profile is
   structured. Case studies inherit Work's tighter rhythm. */
const routeArea = (pathname: string): WorkspaceArea => {
  if (pathname.startsWith('/lab')) return 'lab';
  if (pathname.startsWith('/profile')) return 'profile';
  if (pathname.startsWith('/work')) return 'work';
  if (pathname.startsWith('/404')) return 'home';
  return 'home';
};
const activeArea: WorkspaceArea = area ?? routeArea(Astro.url.pathname);
const path = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalURL = new URL(path, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-area={activeArea}>
  <head>
    <ClientRouter fallback="animate" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Legacy anchor routes: the old single-page anchors now live on
         real routes. Old /#section URLs are mapped to their new homes
         before first paint. Fragment-only mapping — no server route
         depends on this. -->
    <script is:inline>
      (function () {
        if (location.pathname !== '/' || !location.hash) return;
        var legacy = {
          '#about': '/profile/#about',
          '#toolkit': '/profile/#capabilities',
          '#experience': '/profile/#experience',
          '#evidence': '/profile/#evidence',
          '#reliability-lab': '/lab/',
          '#syncareer': '/work/syncareer/',
          '#sessionbook': '/work/sessionbook/',
          '#koranco': '/work/koranco/',
        };
        var target = legacy[location.hash];
        if (target) location.replace(target);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="n5Zp1r0200c1EAmsKwpPnrSlVwWY-pz7RMShX3SFCRg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101315" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Stephen Mensah" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href={displayFontURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interFontURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFontURL} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GH" />
    <meta property="og:site_name" content="Stephen Mensah" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="shell">
      <WorkspaceRail />
      <div class="shell__field" transition:animate="fade">
        <main id="main-content" class="shell__main" tabindex="-1">
          <slot />
        </main>
        <slot name="footer" />
      </div>
    </div>
    <script is:inline>
      // Continuity: after a view transition the <html> is swapped — the
      // inline `classList.add('js')` above already ran, but keep it here
      // for any transition that bypasses the head script. No global store.
      (function () {
        var apply = function () { document.documentElement.classList.add('js'); };
        document.addEventListener('astro:page-load', apply);
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* THE SHELL — one control rail, one field.
     Below 64rem the rail becomes a compact navigation control that
     sits in the flow at the head of the page (see
     WorkspaceRail.astro); above it, the two become columns and the
     rail stays with the reader for the whole scroll. */
  .shell {
    display: block;
    min-height: 100vh;
  }

  .shell__field,
  .shell__main {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .shell {
      display: grid;
      grid-template-columns: var(--shell-rail) minmax(0, 1fr);
      align-items: stretch;
    }

    .shell__field,
    .shell__main {
      min-width: 0;
    }
  }
</style>
