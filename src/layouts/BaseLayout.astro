---
import Analytics from '@vercel/analytics/astro';
import { default as SpeedInsights } from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/motion.css';
import SiteFooter from '../components/SiteFooter.astro';
import ContactSection from '../components/ContactSection.astro';
import WorkspaceRail from '../components/WorkspaceRail.astro';
import { SITE, DEFAULT_SOCIAL_IMAGE, SOCIAL_IMAGE } from '../config/site';
import displayFontURL from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import interFontURL from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoFontURL from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';

type WorkspaceArea = 'home' | 'work' | 'case' | 'lab' | 'profile';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  canonical?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Which density the page uses. Derived from the route by default. */
  area?: WorkspaceArea;
}

const {
  title,
  description,
  image = DEFAULT_SOCIAL_IMAGE.src,
  imageAlt = DEFAULT_SOCIAL_IMAGE.alt,
  imageWidth = SOCIAL_IMAGE.width,
  imageHeight = SOCIAL_IMAGE.height,
  imageType = SOCIAL_IMAGE.type,
  ogType = 'website',
  noindex = false,
  canonical = true,
  structuredData,
  area,
} = Astro.props;

/* Density is a property of the place, not of the page file: Home is
   spacious, Work is visual, Lab is concentrated, Profile is
   structured. Case studies inherit Work's tighter rhythm. */
const routeArea = (pathname: string): WorkspaceArea => {
  if (pathname.startsWith('/lab')) return 'lab';
  if (pathname.startsWith('/profile')) return 'profile';
  if (pathname.startsWith('/work')) return 'work';
  if (pathname.startsWith('/404')) return 'home';
  return 'home';
};
const activeArea: WorkspaceArea = area ?? routeArea(Astro.url.pathname);
const path = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalURL = new URL(path, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-area={activeArea}>
  <head>
    <ClientRouter fallback="animate" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Legacy anchor routes: the old single-page anchors now live on
         real routes. Old /#section URLs are mapped to their new homes
         before first paint. Fragment-only mapping — no server route
         depends on this. -->
    <script is:inline>
      (function () {
        if (location.pathname !== '/' || !location.hash) return;
        var legacy = {
          '#about': '/profile/#about',
          '#toolkit': '/profile/#capabilities',
          '#experience': '/profile/#experience',
          '#evidence': '/profile/#evidence',
          '#reliability-lab': '/lab/',
          '#syncareer': '/work/syncareer/',
          '#sessionbook': '/work/sessionbook/',
          '#koranco': '/work/koranco/',
        };
        var target = legacy[location.hash];
        if (target) location.replace(target);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="n5Zp1r0200c1EAmsKwpPnrSlVwWY-pz7RMShX3SFCRg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#F6F1E6" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href={displayFontURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interFontURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFontURL} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GH" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <WorkspaceRail />
    {/* No container animation: the page-level cross-fade comes from the
        root view transition, which leaves the named project artifact
        free to travel between the homepage bench and its case study. */}
    <div class="shell__field">
      <main id="main-content" class="shell__main" tabindex="-1">
        <slot />
      </main>
      <ContactSection />
      <SiteFooter />
    </div>
    <script>
      /* Focus and scroll after client-side navigation.
         `astro:after-swap` only fires for client-side navigations; the
         initial document load never reaches it, so the first paint keeps
         the document's own focus and the skip link stays the first tab
         stop.

         Three rules, in the order they matter:
         1. Focus moves to the main region, so a keyboard visitor is told
            the page changed. `preventScroll` keeps that from moving the
            page by itself.
         2. A hash destination keeps its own scroll target.
         3. A new page starts at the top, but a back/forward traversal
            keeps the position the browser restored for that history
            entry. Without that split, Back always reopened at the top.

         The reset asks for `behavior: 'instant'` because <html> is set
         to smooth scrolling for in-page anchors; a smooth reset is
         animated and can be interrupted by the new page's layout, which
         left new routes open part-way down. */
      let preparing = false;
      let traversal = false;

      document.addEventListener('astro:before-preparation', (event) => {
        preparing = true;
        traversal = event.navigationType === 'traverse';
      });

      const settle = () => {
        if (!preparing) return;
        const main = document.getElementById('main-content');
        main?.focus({ preventScroll: true });

        /* A cross-page hash link: the browser resolves the fragment
           against the new document, whose height is not final yet, so
           the page can land past the heading it asked for. Resolve it
           again once the route has loaded. `scroll-padding-top` on
           <html> supplies the offset under the sticky header. */
        if (location.hash) {
          const target = document.getElementById(location.hash.slice(1));
          target?.scrollIntoView({ behavior: 'instant', block: 'start' });
          return;
        }

        /* A traversal keeps the position the browser restored for that
           history entry. */
        if (traversal) return;
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      };

      document.addEventListener('astro:after-swap', settle);
      document.addEventListener('astro:page-load', () => {
        settle();
        preparing = false;
      });
    </script>
    <script is:inline>
      // Continuity: after a view transition the <html> is swapped — the
      // inline `classList.add('js')` above already ran, but keep it here
      // for any transition that bypasses the head script. No global store.
      (function () {
        var apply = function () {
          document.documentElement.classList.add('js');
          var target = document.getElementById(location.hash.slice(1));
          if (target) { var parent = target.closest('details'); if (parent) parent.open = true; }
        };
        window.addEventListener('hashchange', apply);
        apply();
        document.addEventListener('astro:page-load', apply);
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </body>
</html>

<style is:global>
.shell{min-height:100vh}.shell__field,.shell__main{min-width:0}
</style>
