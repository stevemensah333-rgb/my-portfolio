---
import ProductFrame from './ProductFrame.astro';
import SectionFrame from './SectionFrame.astro';
import {
  illustrativeBadOutput,
  illustrativeValidOutput,
  sharedSyncareerStages,
  syncareerFailureModes,
  syncareerHomepageNarrativeStates,
  syncareerHomepageNarrativeStateByStage,
  syncareerInterventions,
  type SyncareerTraceStageId,
  type SyncareerTraceStageKind,
} from '../data/syncareerTrace';

type CompactStage = {
  id: SyncareerTraceStageId;
  step: string;
  label: string;
  title: string;
  detail: string;
  evidence: string;
  kind: SyncareerTraceStageKind;
  code?: string;
  modes?: { name: string; note: string }[];
  fixes?: string[];
};

const compactStages: CompactStage[] = [
  {
    ...sharedSyncareerStages.input,
    step: '01',
    detail:
      'Syncareer supplies Claude with explicit context from the student profile — degree, interests, activity, progress and weaknesses — so guidance can be tailored.',
  },
  {
    ...sharedSyncareerStages.modelOutput,
    step: '02',
    detail:
      'Mixed prose and inconsistent structure before constraints — the kind of format drift observed in production.',
    code: illustrativeBadOutput,
  },
  {
    ...sharedSyncareerStages.validation,
    step: '03',
    detail:
      'Gate that checks required fields and types before the product uses the response. If it fails, the path routes to failure diagnosis.',
  },
  {
    ...sharedSyncareerStages.failure,
    step: '04',
    detail: 'Formatting, context and structure broke the expected product contract.',
    modes: [...syncareerFailureModes],
  },
  {
    ...sharedSyncareerStages.intervention,
    step: '05',
    label: 'FIX',
    title: 'Diagnosis + intervention',
    detail:
      'Each failure mode mapped to a missing constraint — then the response path was made more explicit.',
    fixes: [...syncareerInterventions],
  },
  {
    ...sharedSyncareerStages.output,
    step: '06',
    detail:
      'After the intervention the output conforms to the product contract. Shape matches product needs — no fabricated metrics.',
    code: illustrativeValidOutput,
  },
];
---

<section id="syncareer" class="case" aria-labelledby="syncareer-title">
  <SectionFrame coordinate="01 / Case · Syncareer" surface="paper">
    <header class="case__header page-shell">
      <div class="case__header-row">
        <p class="mono-label">Project 01</p>
        <p class="mono-label case__header-meta">Live · syncareer.me</p>
      </div>
      <h2 id="syncareer-title" class="case__headline">
        The AI worked in the demo. Production exposed what the demo didn't.
      </h2>
      <p class="case__context">
        Syncareer is an AI-integrated career platform built by Stephen. This trace previews how an
        output moves from raw model to product-ready.
      </p>
    </header>

    <div class="case__product page-shell">
      <ProductFrame
        src1440="/images/syncareer/synai-context-1440.png"
        src1800="/images/syncareer/synai-context-1800.png"
        src2400="/images/syncareer/synai-context-2400.png"
        width={2400}
        height={1302}
        alt="Syncareer SynAI interface showing personalised career guidance based on Stephen's profile, quick actions and a message input."
        label="Product surface / SynAI"
        caption="The AI feature combines profile context with career-guidance entry points inside the product."
      />
    </div>

    <section
      class="case__narrative page-shell"
      data-syncareer-narrative
      data-active-narrative-state="observed-failure"
      aria-labelledby="narrative-title"
    >
      <div class="narrative__intro">
        <p class="mono-label">Reliability narrative</p>
        <h3 id="narrative-title">Failure, engineering response, then a product contract.</h3>
        <p>Scroll the three states or use the state controls. The detailed trace remains directly selectable below.</p>
      </div>

      <nav class="narrative__rail" aria-label="Syncareer narrative states">
        <p class="narrative__rail-meta">
          <span class="mono-label" data-narrative-position>01 / 03</span>
          <span class="narrative__rail-status">Current state</span>
        </p>
        <ol class="narrative__rail-list">
          {syncareerHomepageNarrativeStates.map((state, index) => (
            <li>
              <button
                type="button"
                class="narrative__rail-btn"
                data-narrative-control={state.id}
                aria-controls={`narrative-${state.id}`}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <span class="narrative__rail-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="narrative__rail-label">{state.label}</span>
                <span class="narrative__rail-tone" data-tone={state.tone}></span>
              </button>
            </li>
          ))}
        </ol>
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-narrative-announcement>
          Current state: Observed failure
        </p>
      </nav>

      <div class="narrative__sequence">
        {syncareerHomepageNarrativeStates.map((state, index) => (
          <article
            id={`narrative-${state.id}`}
            class="narrative__state"
            data-narrative-step={state.id}
            data-tone={state.tone}
            data-active={index === 0 ? 'true' : 'false'}
            style={`--state-row: ${index + 1}`}
          >
            <header class="narrative__state-copy">
              <p class="narrative__state-kicker mono-label">
                State {String(index + 1).padStart(2, '0')} / {state.label}
              </p>
              <h4>{state.title}</h4>
              <p class="narrative__state-summary">{state.summary}</p>
              <button
                type="button"
                class="text-link narrative__state-link"
                data-select-trace-stage={state.primaryStageId}
              >
                Inspect this state in the trace
                <span class="text-link__arrow" aria-hidden="true">↓</span>
              </button>
            </header>

            <div class="narrative__state-evidence" aria-label={`${state.label} evidence`}>
              <header class="narrative__state-evidence-header">
                <span class="mono-label">Evidence state</span>
                <span class="mono-label">{String(index + 1).padStart(2, '0')} / 03</span>
              </header>

              {state.id === 'observed-failure' && (
                <>
                  <div class="code-panel">
                    <div class="code-panel__meta">
                      <span>Illustrative bad output</span>
                      <span class="code-panel__type code-panel__type--fail">Raw</span>
                    </div>
                    <pre><code>{illustrativeBadOutput}</code></pre>
                  </div>
                  <ul class="failure-grid">
                    {syncareerFailureModes.map((mode) => (
                      <li>
                        <span class="mono-label">{mode.name}</span>
                        <p>{mode.note}</p>
                      </li>
                    ))}
                  </ul>
                  <p class="evidence-line">
                    <span class="mono-label">Evidence</span>
                    Confirmed observations from production use.
                  </p>
                </>
              )}

              {state.id === 'engineering-response' && (
                <>
                  <ul class="fix-list">
                    {syncareerInterventions.map((fix) => <li>{fix}</li>)}
                  </ul>
                  <p class="evidence-line">
                    <span class="mono-label">Evidence</span>
                    Related interventions listed in the case study.
                  </p>
                </>
              )}

              {state.id === 'product-contract' && (
                <>
                  <div class="validation-card">
                    <div class="validation-card__side">
                      <span class="mono-label">Product expects</span>
                      <strong>title, level, years, next_steps</strong>
                    </div>
                    <span class="validation-card__rule" aria-hidden="true"></span>
                    <div class="validation-card__side">
                      <span class="mono-label">Validation</span>
                      <strong>required fields + types</strong>
                    </div>
                  </div>
                  <div class="code-panel">
                    <div class="code-panel__meta">
                      <span>Illustrative valid output</span>
                      <span class="code-panel__type code-panel__type--pass">Valid</span>
                    </div>
                    <pre><code>{illustrativeValidOutput}</code></pre>
                  </div>
                  <div class="boundary-callout">
                    <p><span class="mono-label">Interpretation</span>Prompt structure, context handling and the expected output needed tighter control.</p>
                    <p><span class="mono-label">Measured result</span>Not yet supplied. No reliability threshold is claimed here.</p>
                  </div>
                </>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="case__inspector page-shell" aria-labelledby="trace-title">
      <header class="inspector__intro">
        <div>
          <p class="mono-label">Direct stage inspector</p>
          <h3 id="trace-title">Inspect the six underlying stages.</h3>
        </div>
        <p class="inspector__legend">
          Select a stage to see what happened at each step. Keyboard: arrows to move between stages.
          Values marked ILLUSTRATIVE are demo shapes, not historical logs.
        </p>
      </header>

      <div class="inspector__panel" data-trace-compact>
        <div class="inspector__rail" role="tablist" aria-label="Failure trace stages" aria-orientation="horizontal">
          {compactStages.map((stage, idx) => (
            <button
              type="button"
              role="tab"
              id={`ctab-${stage.id}`}
              class="inspector__tab"
              data-stage-tab={stage.id}
              data-narrative-state={syncareerHomepageNarrativeStateByStage[stage.id]}
              aria-controls={`cpanel-${stage.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex={idx === 0 ? '0' : '-1'}
              data-step={stage.step}
            >
              <span class="inspector__tab-step">{stage.step}</span>
              <span class="inspector__tab-label">{stage.label}</span>
              <span class="inspector__tab-dot" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <div class="inspector__panels">
          {compactStages.map((stage, idx) => (
            <div
              role="tabpanel"
              id={`cpanel-${stage.id}`}
              aria-labelledby={`ctab-${stage.id}`}
              class="inspector__panel-content"
              data-stage-panel={stage.id}
              data-narrative-state={syncareerHomepageNarrativeStateByStage[stage.id]}
              data-active={idx === 0 ? 'true' : 'false'}
              tabindex="0"
              hidden={idx !== 0}
            >
              <header class="inspector__panel-header">
                <p class="mono-label">{stage.step} / {stage.label}</p>
                <h4>{stage.title}</h4>
                <p class="inspector__panel-detail">{stage.detail}</p>
              </header>

              {(stage.kind === 'raw' || stage.kind === 'valid') && (
                <div class="code-panel">
                  <div class="code-panel__meta">
                    <span>{stage.kind === 'raw' ? 'ILLUSTRATIVE BAD OUTPUT' : 'ILLUSTRATIVE VALID OUTPUT'}</span>
                    <span class:list={['code-panel__type', stage.kind === 'raw' ? 'code-panel__type--fail' : 'code-panel__type--pass']}>
                      {stage.kind}
                    </span>
                  </div>
                  <pre><code>{stage.code}</code></pre>
                </div>
              )}

              {stage.kind === 'validate' && (
                <div class="validation-card">
                  <div class="validation-card__side">
                    <span class="mono-label">Product expects</span>
                    <strong>title, level, years, next_steps</strong>
                  </div>
                  <span class="validation-card__rule" aria-hidden="true"></span>
                  <div class="validation-card__side">
                    <span class="mono-label">Observed before fix</span>
                    <strong class="validation-card__fail">mixed prose + malformed fields</strong>
                  </div>
                </div>
              )}

              {stage.kind === 'fail' && (
                <ul class="failure-grid">
                  {stage.modes?.map((mode) => (
                    <li>
                      <span class="mono-label">{mode.name}</span>
                      <p>{mode.note}</p>
                    </li>
                  ))}
                </ul>
              )}

              {stage.kind === 'intervene' && (
                <ul class="fix-list">
                  {stage.fixes?.map((fix) => <li>{fix}</li>)}
                </ul>
              )}

              <p class="evidence-line">
                <span class="mono-label">Evidence</span>
                {stage.evidence}
              </p>
            </div>
          ))}
        </div>

        <footer class="inspector__footer">
          <a class="text-link" href="/work/syncareer/">
            Explore the full reliability case study
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </footer>
      </div>
    </section>

    <div class="case__footer page-shell">
      <a class="text-link" href="https://syncareer.me/" target="_blank" rel="noopener">
        View Syncareer
        <span class="text-link__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </SectionFrame>
</section>

<script>
  import { initTraceTabs } from '../scripts/initTraceTabs';

  const narrativeRoots = document.querySelectorAll<HTMLElement>('[data-syncareer-narrative]');

  for (const narrativeRoot of narrativeRoots) {
    const section = narrativeRoot.closest('.case');
    const traceRoot = section?.querySelector<HTMLElement>('[data-trace-compact]');
    const steps = [...narrativeRoot.querySelectorAll<HTMLElement>('[data-narrative-step]')];
    const controls = [...narrativeRoot.querySelectorAll<HTMLButtonElement>('[data-narrative-control]')];
    const stageLinks = [...narrativeRoot.querySelectorAll<HTMLButtonElement>('[data-select-trace-stage]')];
    const position = narrativeRoot.querySelector<HTMLElement>('[data-narrative-position]');
    const announcement = narrativeRoot.querySelector<HTMLElement>('[data-narrative-announcement]');

    if (steps.length === 0 || controls.length === 0) continue;

    const desktopNarrativeQuery = window.matchMedia('(min-width: 64rem)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const activationLineRatio = 0.425;
    let syncingTrace = false;
    let narrativeObserver: IntersectionObserver | null = null;

    const traceController = traceRoot
      ? initTraceTabs(traceRoot, {
          onSelect: (_id, _index, _count, tab) => {
            const narrativeState = tab.dataset.narrativeState;
            if (!narrativeState || syncingTrace) return;
            setActiveState(narrativeState, { syncTrace: false, announce: true });
          },
        })
      : null;

    function setActiveState(
      stateId: string,
      options: { syncTrace?: boolean; announce?: boolean } = {},
    ) {
      const activeIndex = steps.findIndex(step => step.dataset.narrativeStep === stateId);
      if (activeIndex < 0) return;

      narrativeRoot.dataset.activeNarrativeState = stateId;
      steps.forEach(step => {
        step.dataset.active = String(step.dataset.narrativeStep === stateId);
      });
      controls.forEach(control => {
        const active = control.dataset.narrativeControl === stateId;
        if (active) control.setAttribute('aria-current', 'step');
        else control.removeAttribute('aria-current');
      });

      if (position) position.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
      if (options.announce && announcement) {
        const activeLabel = controls[activeIndex]?.querySelector<HTMLElement>('.narrative__rail-label')?.textContent?.trim() ?? stateId;
        announcement.textContent = `Current state: ${activeLabel}`;
      }

      if (options.syncTrace && traceController) {
        const stageId = steps[activeIndex]?.querySelector<HTMLButtonElement>('[data-select-trace-stage]')?.dataset.selectTraceStage;
        if (stageId) {
          syncingTrace = true;
          traceController.select(stageId);
          syncingTrace = false;
        }
      }
    }

    function getNarrativeStateAtActivationLine() {
      const activationLine = window.innerHeight * activationLineRatio;
      const stepPositions = steps.map(step => ({
        step,
        bounds: step.getBoundingClientRect(),
      }));
      const activeStep = stepPositions.find(({ bounds }) => (
        bounds.top <= activationLine && bounds.bottom > activationLine
      ));

      return activeStep?.step.dataset.narrativeStep;
    }

    function syncNarrativeToScrollPosition() {
      const stateId = getNarrativeStateAtActivationLine();
      if (stateId) setActiveState(stateId, { syncTrace: true });
    }

    function configureAutomaticNarrativeSync() {
      narrativeObserver?.disconnect();
      narrativeObserver = null;

      if (!desktopNarrativeQuery.matches || reducedMotionQuery.matches) return;

      narrativeObserver = new IntersectionObserver(
        () => syncNarrativeToScrollPosition(),
        {
          rootMargin: '-42% 0px -57% 0px',
          threshold: 0,
        },
      );

      steps.forEach(step => narrativeObserver?.observe(step));
      syncNarrativeToScrollPosition();
    }

    controls.forEach(control => {
      control.addEventListener('click', () => {
        const stateId = control.dataset.narrativeControl;
        const step = steps.find(candidate => candidate.dataset.narrativeStep === stateId);
        if (!stateId || !step) return;
        step.scrollIntoView({ block: 'center', behavior: 'instant' });
        setActiveState(stateId, { syncTrace: true, announce: true });
      });
    });

    stageLinks.forEach(link => {
      link.addEventListener('click', () => {
        const stageId = link.dataset.selectTraceStage;
        if (!stageId || !traceRoot || !traceController) return;
        traceRoot.scrollIntoView({ block: 'center', behavior: 'instant' });
        traceController.select(stageId);
        traceRoot.querySelector<HTMLButtonElement>(`[data-stage-tab="${stageId}"]`)?.focus({ preventScroll: true });
      });
    });

    narrativeRoot.dataset.narrativeEnhanced = 'true';
    setActiveState('observed-failure');
    configureAutomaticNarrativeSync();
    desktopNarrativeQuery.addEventListener('change', configureAutomaticNarrativeSync);
    reducedMotionQuery.addEventListener('change', configureAutomaticNarrativeSync);
  }
</script>

<style>
  .case {
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .case__header {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
  }

  .case__header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .case__header-meta {
    color: var(--color-text-on-paper-faint);
  }

  .case__headline {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
  }

  .case__context {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .case__product {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule-on-paper);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  /* --- Narrative --- */
  .case__narrative {
    padding-block: var(--section-block);
  }

  .narrative__intro {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
    margin-bottom: var(--space-7);
  }

  .narrative__intro h3 {
    margin: 0;
    max-width: 24ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .narrative__intro p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .narrative__rail {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .narrative__rail-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
  }

  .narrative__rail-status {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .narrative__rail-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .narrative__rail-list li {
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .narrative__rail-list li:first-child {
    border-top: 0;
  }

  .narrative__rail-btn {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: transparent;
    color: var(--color-text-on-paper-muted);
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .narrative__rail-btn:hover {
    color: var(--color-text-on-paper);
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
  }

  .narrative__rail-num {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .narrative__rail-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .narrative__rail-tone {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .narrative__rail-tone[data-tone='failure'] {
    border-color: var(--color-signal-fail);
    background: var(--color-signal-fail);
  }
  .narrative__rail-tone[data-tone='technical'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .narrative__rail-tone[data-tone='valid'] {
    border-color: var(--color-signal-pass);
    background: var(--color-signal-pass);
  }

  .engineering-narrative[data-narrative-enhanced='true'] .narrative__rail-btn[aria-current='step'] {
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .narrative__rail-btn:focus-visible {
    outline-offset: -3px;
  }

  /* Sequence */
  .narrative__sequence {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .narrative__state {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .narrative__state[data-tone='failure'] {
    border-color: color-mix(in srgb, var(--color-signal-fail) 40%, var(--color-rule-on-paper));
  }

  .narrative__state[data-tone='valid'] {
    border-color: color-mix(in srgb, var(--color-signal-pass) 40%, var(--color-rule-on-paper));
  }

  .narrative__state-copy {
    display: grid;
    gap: var(--space-3);
  }

  .narrative__state-kicker {
    color: var(--color-text-on-paper-muted);
  }

  .narrative__state-copy h4 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.08;
  }

  .narrative__state-summary {
    margin: 0;
    max-width: 34rem;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .narrative__state-link {
    color: var(--color-text-on-paper);
    justify-self: start;
  }

  .narrative__state-evidence {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-paper-soft);
    background: var(--color-paper-soft);
  }

  .narrative__state[data-tone='failure'] .narrative__state-evidence {
    background: color-mix(in srgb, var(--color-signal-fail-tint) 40%, var(--color-paper));
