---
import AmbientField from './AmbientField.astro';
import ProductFrame from './ProductFrame.astro';

type CompactStage = {
  id: string;
  step: string;
  label: string;
  title: string;
  detail: string;
  evidence: string;
  kind: 'input' | 'raw' | 'validate' | 'fail' | 'fix' | 'valid';
  code?: string;
  modes?: { name: string; note: string }[];
  fixes?: string[];
};

const compactStages: CompactStage[] = [
  {
    id: 'input',
    step: '01',
    label: 'INPUT',
    title: 'User activity + profile context',
    detail:
      'Syncareer supplies Claude with explicit context from the student profile — degree, interests, activity, progress and weaknesses — so guidance can be tailored.',
    evidence: 'Product record — context visible in SynAI surface.',
    kind: 'input',
  },
  {
    id: 'output',
    step: '02',
    label: 'MODEL OUTPUT',
    title: 'Raw LLM response (illustrative bad output)',
    detail:
      'Mixed prose and inconsistent structure before constraints — the kind of format drift observed in production.',
    evidence: 'Confirmed observation: inconsistent formatting.',
    code: `To become senior, you should...
- build projects

{
  title: Senior Dev
  level: 
  years: "five?"`,
    kind: 'raw',
  },
  {
    id: 'validate',
    step: '03',
    label: 'VALIDATION',
    title: 'Schema check',
    detail:
      'Gate that checks required fields and types before the product uses the response. If it fails, the path routes to failure diagnosis.',
    evidence: 'Check: title (string), level (enum), years (number), next_steps (array).',
    kind: 'validate',
  },
  {
    id: 'failure',
    step: '04',
    label: 'FAILURE',
    title: 'Observed failure modes',
    detail: 'Formatting, context and structure broke the expected product contract.',
    evidence: 'Confirmed observations from production use.',
    modes: [
      { name: 'Formatting', note: 'Missing schema' },
      { name: 'Context', note: 'Context dropped' },
      { name: 'Structure', note: 'Inconsistent output' },
    ],
    kind: 'fail',
  },
  {
    id: 'fix',
    step: '05',
    label: 'FIX',
    title: 'Diagnosis + intervention',
    detail:
      'Each failure mode mapped to a missing constraint — then the response path was made more explicit.',
    evidence: 'Related interventions listed in the case study.',
    fixes: ['Prompt restructuring', 'Few-shot anchor', 'Explicit context management', 'Tighter output constraints'],
    kind: 'fix',
  },
  {
    id: 'result',
    step: '06',
    label: 'VALID OUTPUT',
    title: 'Valid product output (illustrative)',
    detail:
      'After the intervention the output conforms to the product contract. Shape matches product needs — no fabricated metrics.',
    evidence: 'Outcome shape matches product needs; no fabricated metrics.',
    code: `{
  "title": "Senior Developer",
  "level": "senior",
  "years": 5,
  "next_steps": [
    "ship one AI feature",
    "add validation",
    "test beyond happy path"
  ]
}`,
    kind: 'valid',
  },
];
---

<section id="syncareer" class="case-study" aria-labelledby="syncareer-title">
  <AmbientField density={12} variant="case" />
  <div class="page-shell">
    <header class="case-header">
      <p class="technical-label">Case 01 / Syncareer</p>
      <h2 id="syncareer-title">The AI worked in the demo. Production exposed what the demo didn't.</h2>
      <p class="case-context">Syncareer is an AI-integrated career platform built by Stephen. This trace previews how an output moves from raw model to product-ready.</p>
    </header>

    <div class="product-proof">
      <ProductFrame
        src1440="/images/syncareer/synai-context-1440.png"
        src1800="/images/syncareer/synai-context-1800.png"
        src2400="/images/syncareer/synai-context-2400.png"
        width={2400}
        height={1302}
        alt="Syncareer SynAI interface showing personalised career guidance based on Stephen's profile, quick actions and a message input."
        label="Product surface / SynAI"
        caption="The AI feature combines profile context with career-guidance entry points inside the product."
      />
    </div>

    <div class="failure-trace" data-trace-compact aria-labelledby="trace-title">
      <div class="trace-intro">
        <div>
          <p class="technical-label">Interactive failure trace</p>
          <h3 id="trace-title">How an unreliable LLM response became valid product output.</h3>
        </div>
        <p class="trace-legend">Select a stage to see what happened at each step. Keyboard: arrows to move between stages. Values marked ILLUSTRATIVE are demo shapes, not historical logs.</p>
      </div>

      <div class="trace-strip">
        <div class="trace-tablist" role="tablist" aria-label="Failure trace stages" aria-orientation="horizontal">
          {compactStages.map((stage, idx) => (
            <button
              type="button"
              role="tab"
              id={`ctab-${stage.id}`}
              class="trace-tab"
              data-stage-tab={stage.id}
              aria-controls={`cpanel-${stage.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex={idx === 0 ? '0' : '-1'}
              data-step={stage.step}
            >
              <span class="tab-step">{stage.step}</span>
              <span class="tab-label">{stage.label}</span>
              <i class="tab-dot" aria-hidden="true"></i>
            </button>
          ))}
        </div>
      </div>

      <div class="trace-panels">
        {compactStages.map((stage, idx) => (
          <div
            role="tabpanel"
            id={`cpanel-${stage.id}`}
            aria-labelledby={`ctab-${stage.id}`}
            class="trace-panel"
            data-stage-panel={stage.id}
            data-active={idx === 0 ? 'true' : 'false'}
            tabindex="0"
            hidden={idx !== 0}
          >
            <header class="panel-header">
              <p class="panel-kicker">{stage.step} / {stage.label}</p>
              <h4>{stage.title}</h4>
              <p class="panel-detail">{stage.detail}</p>
            </header>

            {(stage.kind === 'raw' || stage.kind === 'valid') && (
              <div class="panel-code">
                <div class="code-meta">
                  <span>{stage.kind === 'raw' ? 'ILLUSTRATIVE BAD OUTPUT' : 'ILLUSTRATIVE VALID OUTPUT'}</span>
                  <span class="code-type">{stage.kind}</span>
                </div>
                <pre><code>{stage.code}</code></pre>
              </div>
            )}

            {stage.kind === 'validate' && (
              <div class="validate-card">
                <div class="validate-side">
                  <span class="mono-small">Product expects</span>
                  <strong>title, level, years, next_steps</strong>
                </div>
                <i aria-hidden="true"></i>
                <div class="validate-side">
                  <span class="mono-small mono-fail">Observed before fix</span>
                  <strong class="fail-text">mixed prose + malformed fields</strong>
                </div>
              </div>
            )}

            {stage.kind === 'fail' && (
              <ul class="failure-modes">
                {stage.modes?.map((mode) => (
                  <li><span>{mode.name}</span><p>{mode.note}</p></li>
                ))}
              </ul>
            )}

            {stage.kind === 'fix' && (
              <ul class="fix-list">
                {stage.fixes?.map((fix) => <li>{fix}</li>)}
              </ul>
            )}

            <p class="panel-evidence"><span>Evidence</span>{stage.evidence}</p>
          </div>
        ))}
      </div>

      <div class="trace-cta">
        <a class="case-link" href="/work/syncareer/">Explore the full reliability case study <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="evidence-status">
      <p><span>Interpretation</span> Prompt structure, context handling and the expected output needed tighter control.</p>
      <p><span>Measured result</span> Not yet supplied. No reliability threshold is claimed here.</p>
    </div>

    <div class="case-actions">
      <a class="live-link" href="https://syncareer.me/" target="_blank" rel="noopener">View Syncareer <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  const traceRoots = document.querySelectorAll('[data-trace-compact]');

  for (const root of traceRoots) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-stage-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-stage-panel]')];

    if (tabs.length === 0 || panels.length === 0) continue;

    const select = (id: string) => {
      const idx = tabs.findIndex(t => t.dataset.stageTab === id);
      tabs.forEach((tab, i) => {
        const active = tab.dataset.stageTab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        tab.dataset.active = String(active);
        tab.dataset.past = String(i < idx);
      });
      panels.forEach(panel => {
        const active = panel.dataset.stagePanel === id;
        panel.dataset.active = String(active);
        panel.hidden = !active;
      });
    };

    // initial
    const initial = tabs[0]?.dataset.stageTab;
    if (initial) select(initial);

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.stageTab;
        if (id) select(id);
      });
      tab.addEventListener('keydown', (e) => {
        const currentIdx = tabs.indexOf(tab);
        let nextIdx: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIdx = (currentIdx + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIdx = (currentIdx - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextIdx = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          nextIdx = tabs.length - 1;
        }
        if (nextIdx !== null) {
          const nextTab = tabs[nextIdx];
          nextTab?.focus();
          const id = nextTab?.dataset.stageTab;
          if (id) select(id);
        }
      });
    });
  }
</script>

<style>
  .case-study {
    padding-block: var(--section-standard);
    border-top: var(--border-default);
    background: var(--color-surface-light);
    scroll-margin-top: 5rem;
    position: relative;
  }

  .case-header {
    display: grid;
    gap: var(--space-4);
    max-width: 62rem;
  }

  .case-header p,
  .case-header h2 {
    margin: 0;
  }

  .case-header h2 {
    max-width: 20ch;
    font-size: var(--text-h1);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .case-context {
    max-width: var(--width-reading);
    color: var(--color-text-secondary);
    font-size: var(--text-body-large);
  }

  .product-proof {
    margin-top: var(--section-content-gap);
  }

  /* --- Compact failure trace --- */
  .failure-trace {
    margin-top: var(--section-content-gap);
    border: var(--border-default);
    border-radius: var(--radius-card);
    background: var(--color-background);
    overflow: hidden;
  }

  .trace-intro {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-default);
    background: var(--color-surface-light);
  }

  .trace-intro h3 {
    max-width: 26ch;
    margin: var(--space-1) 0 0;
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .trace-legend {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .trace-strip {
    position: relative;
    display: flex;
    border-bottom: var(--border-default);
    background: var(--color-background);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .trace-strip::-webkit-scrollbar {
    display: none;
  }

  /* Fade on the right edge signals the tab strip scrolls on narrow screens. */
  .trace-strip::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1.5rem;
    background: linear-gradient(to right, transparent, var(--color-background));
    pointer-events: none;
  }

  .trace-tablist {
    display: flex;
    align-items: stretch;
    flex: 0 0 auto;
  }

  .trace-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0;
    border-right: var(--border-default);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .trace-tab:last-child {
    border-right: 0;
  }

  .tab-step {
    display: inline-flex;
    min-width: 1.8rem;
    justify-content: center;
    padding: 0.15rem 0.35rem;
    border: var(--border-default);
    background: var(--color-surface-light);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .tab-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tab-dot {
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0;
    height: 2px;
    background: transparent;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .trace-tab:hover {
    background: color-mix(in srgb, var(--color-surface-cool) 70%, white);
    color: var(--color-text);
  }

  .trace-tab:focus-visible {
    outline-offset: -2px;
    background: var(--color-surface-cool);
  }

  .trace-tab[data-active='true'] {
    color: var(--color-text);
  }

  .trace-tab[data-active='true'] .tab-step {
    border-color: var(--color-accent);
    background: var(--color-surface-cool);
    color: var(--color-text);
  }

  .trace-tab[data-active='true'] .tab-dot {
    background: var(--color-accent);
  }

  .trace-tab[data-past='true'] .tab-step {
    border-color: color-mix(in srgb, var(--color-border) 40%, var(--color-accent));
  }

  .trace-panels {
    padding: var(--space-4);
    background: var(--color-background);
  }

  .trace-panel {
    display: grid;
    gap: var(--space-3);
  }

  .trace-panel[hidden] {
    display: none !important;
  }

  .panel-kicker {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel-header h4 {
    margin: var(--space-1) 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .panel-detail {
    max-width: 40rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .panel-code {
    border: var(--border-default);
    border-radius: var(--radius-small);
    overflow: hidden;
    background: var(--color-surface-light);
  }

  .code-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-bottom: var(--border-default);
    background: var(--color-background);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .code-type {
    color: var(--color-accent);
  }

  .panel-code pre {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.5;
    background: var(--color-background);
  }

  .validate-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border: var(--border-default);
    background: var(--color-surface-light);
  }

  .validate-side {
    display: grid;
    gap: var(--space-1);
  }

  .validate-side strong {
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .validate-card i {
    border-top: var(--border-default);
    position: relative;
  }

  .validate-card i::after {
    content: '';
    position: absolute;
    right: 0;
    top: -0.25rem;
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--color-accent);
    background: var(--color-background);
  }

  .mono-small {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mono-fail {
    color: #8a2e2e;
  }

  .fail-text {
    color: #8a2e2e;
  }

  .failure-modes {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .failure-modes li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border: var(--border-default);
    background: var(--color-surface-light);
  }

  .failure-modes span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .failure-modes p {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .fix-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fix-list li {
    position: relative;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-6);
    border: var(--border-default);
    background: var(--color-surface-light);
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .fix-list li::before {
    content: '+';
    position: absolute;
    left: var(--space-3);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .panel-evidence {
    margin: 0;
    padding-top: var(--space-3);
    border-top: var(--border-default);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .panel-evidence span {
    display: inline-block;
    margin-right: var(--space-3);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .trace-cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-top: var(--border-default);
    background: var(--color-surface-light);
  }

  .trace-cta .case-link {
    font-size: var(--text-small);
  }

  .evidence-status {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: var(--border-default);
    margin-top: var(--space-5);
  }

  .evidence-status p {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .evidence-status span {
    display: inline-block;
    margin-right: var(--space-3);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-5);
  }

  .case-link,
  .live-link {
    display: inline-flex;
    min-height: var(--control-height);
    align-items: center;
    color: var(--color-text);
    font-weight: 600;
    position: relative;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .case-link::after,
  .live-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    border-top: 1px solid currentColor;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .case-link:hover::after,
  .live-link:hover::after {
    opacity: 1;
    transform: translateY(0);
  }

  .case-link:hover,
  .live-link:hover {
    transform: translateY(-1px);
  }

  .case-link span,
  .live-link span {
    color: var(--color-accent);
    margin-left: 0.25rem;
  }

  @media (min-width: 48rem) {
    .trace-strip::after {
      display: none;
    }

    .failure-modes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .fix-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .trace-intro {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: end;
    }
  }

  @media (max-width: 30rem) {
    .case-header h2 {
      font-size: clamp(1.875rem, 8.5vw, 2.25rem);
    }

    .validate-card {
      grid-template-columns: 1fr;
    }

    .validate-card i {
      width: 1px;
      height: 1.25rem;
      margin-left: var(--space-3);
      border-top: 0;
      border-left: var(--border-default);
    }

    .trace-cta {
      justify-content: flex-start;
    }
  }
</style>
