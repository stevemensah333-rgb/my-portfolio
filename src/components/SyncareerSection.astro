---
import AmbientField from './AmbientField.astro';
import ProductFrame from './ProductFrame.astro';
import {
  illustrativeBadOutput,
  illustrativeValidOutput,
  sharedSyncareerStages,
  syncareerFailureModes,
  syncareerHomepageNarrativeStates,
  syncareerHomepageNarrativeStateByStage,
  syncareerInterventions,
  type SyncareerTraceStageId,
  type SyncareerTraceStageKind,
} from '../data/syncareerTrace';

type CompactStage = {
  id: SyncareerTraceStageId;
  step: string;
  label: string;
  title: string;
  detail: string;
  evidence: string;
  kind: SyncareerTraceStageKind;
  code?: string;
  modes?: { name: string; note: string }[];
  fixes?: string[];
};

const compactStages: CompactStage[] = [
  {
    ...sharedSyncareerStages.input,
    step: '01',
    detail:
      'Syncareer supplies Claude with explicit context from the student profile — degree, interests, activity, progress and weaknesses — so guidance can be tailored.',
  },
  {
    ...sharedSyncareerStages.modelOutput,
    step: '02',
    detail:
      'Mixed prose and inconsistent structure before constraints — the kind of format drift observed in production.',
    code: illustrativeBadOutput,
  },
  {
    ...sharedSyncareerStages.validation,
    step: '03',
    detail:
      'Gate that checks required fields and types before the product uses the response. If it fails, the path routes to failure diagnosis.',
  },
  {
    ...sharedSyncareerStages.failure,
    step: '04',
    detail: 'Formatting, context and structure broke the expected product contract.',
    modes: [...syncareerFailureModes],
  },
  {
    ...sharedSyncareerStages.intervention,
    step: '05',
    label: 'FIX',
    title: 'Diagnosis + intervention',
    detail:
      'Each failure mode mapped to a missing constraint — then the response path was made more explicit.',
    fixes: [...syncareerInterventions],
  },
  {
    ...sharedSyncareerStages.output,
    step: '06',
    detail:
      'After the intervention the output conforms to the product contract. Shape matches product needs — no fabricated metrics.',
    code: illustrativeValidOutput,
  },
];
---

<section id="syncareer" class="case-study" aria-labelledby="syncareer-title">
  <AmbientField density={12} variant="case" />
  <div class="page-shell">
    <header class="case-header">
      <p class="technical-label">Case 01 / Syncareer</p>
      <h2 id="syncareer-title">The AI worked in the demo. Production exposed what the demo didn't.</h2>
      <p class="case-context">Syncareer is an AI-integrated career platform built by Stephen. This trace previews how an output moves from raw model to product-ready.</p>
    </header>

    <div class="product-proof">
      <ProductFrame
        src1440="/images/syncareer/synai-context-1440.png"
        src1800="/images/syncareer/synai-context-1800.png"
        src2400="/images/syncareer/synai-context-2400.png"
        width={2400}
        height={1302}
        alt="Syncareer SynAI interface showing personalised career guidance based on Stephen's profile, quick actions and a message input."
        label="Product surface / SynAI"
        caption="The AI feature combines profile context with career-guidance entry points inside the product."
      />
    </div>

    <section
      class="engineering-narrative"
      data-syncareer-narrative
      data-active-narrative-state="observed-failure"
      aria-labelledby="narrative-title"
    >
      <header class="narrative-intro">
        <p class="technical-label">Reliability narrative</p>
        <h3 id="narrative-title">Failure, engineering response, then a product contract.</h3>
        <p>Scroll the three states or use the state controls. The detailed trace remains directly selectable below.</p>
      </header>

      <nav class="narrative-rail" aria-label="Syncareer narrative states">
        <p><span data-narrative-position>01 / 03</span> Current state</p>
        <ol>
          {syncareerHomepageNarrativeStates.map((state, index) => (
            <li>
              <button
                type="button"
                data-narrative-control={state.id}
                aria-controls={`narrative-${state.id}`}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                {state.label}
              </button>
            </li>
          ))}
        </ol>
        <p class="sr-only" aria-live="polite" aria-atomic="true" data-narrative-announcement>
          Current state: Observed failure
        </p>
      </nav>

      <div class="narrative-sequence">
        {syncareerHomepageNarrativeStates.map((state, index) => (
          <article
            id={`narrative-${state.id}`}
            class="narrative-state"
            data-narrative-step={state.id}
            data-tone={state.tone}
            data-active={index === 0 ? 'true' : 'false'}
            style={`--state-row: ${index + 1}`}
          >
            <div class="narrative-copy">
              <p class="narrative-kicker">State {String(index + 1).padStart(2, '0')} / {state.label}</p>
              <h4>{state.title}</h4>
              <p class="narrative-summary">{state.summary}</p>
              <button
                type="button"
                class="narrative-stage-link"
                data-select-trace-stage={state.primaryStageId}
              >
                Inspect this state in the trace <span aria-hidden="true">↓</span>
              </button>
            </div>

            <div class="narrative-evidence" aria-label={`${state.label} evidence`}>
              <div class="narrative-evidence-meta">
                <span>Evidence state</span>
                <span>{String(index + 1).padStart(2, '0')} / 03</span>
              </div>

              {state.id === 'observed-failure' && (
                <>
                  <div class="panel-code narrative-code">
                    <div class="code-meta">
                      <span>Illustrative bad output</span>
                      <span class="code-type code-type-failure">Raw</span>
                    </div>
                    <pre><code>{illustrativeBadOutput}</code></pre>
                  </div>
                  <ul class="failure-modes narrative-modes">
                    {syncareerFailureModes.map((mode) => (
                      <li><span>{mode.name}</span><p>{mode.note}</p></li>
                    ))}
                  </ul>
                  <p class="narrative-evidence-line"><span>Evidence</span> Confirmed observations from production use.</p>
                </>
              )}

              {state.id === 'engineering-response' && (
                <>
                  <ul class="fix-list narrative-fixes">
                    {syncareerInterventions.map((fix) => <li>{fix}</li>)}
                  </ul>
                  <p class="narrative-evidence-line"><span>Evidence</span> Related interventions listed in the case study.</p>
                </>
              )}

              {state.id === 'product-contract' && (
                <>
                  <div class="validate-card narrative-validation">
                    <div class="validate-side">
                      <span class="mono-small">Product expects</span>
                      <strong>title, level, years, next_steps</strong>
                    </div>
                    <i aria-hidden="true"></i>
                    <div class="validate-side">
                      <span class="mono-small">Validation</span>
                      <strong>required fields + types</strong>
                    </div>
                  </div>
                  <div class="panel-code narrative-code">
                    <div class="code-meta">
                      <span>Illustrative valid output</span>
                      <span class="code-type">Valid</span>
                    </div>
                    <pre><code>{illustrativeValidOutput}</code></pre>
                  </div>
                  <div class="narrative-boundary">
                    <p><span>Interpretation</span> Prompt structure, context handling and the expected output needed tighter control.</p>
                    <p><span>Measured result</span> Not yet supplied. No reliability threshold is claimed here.</p>
                  </div>
                </>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="failure-trace" data-trace-compact aria-labelledby="trace-title">
      <div class="trace-intro">
        <div>
          <p class="technical-label">Direct stage inspector</p>
          <h3 id="trace-title">Inspect the six underlying stages.</h3>
        </div>
        <p class="trace-legend">Select a stage to see what happened at each step. Keyboard: arrows to move between stages. Values marked ILLUSTRATIVE are demo shapes, not historical logs.</p>
      </div>

      <div class="trace-strip">
        <div class="trace-tablist" role="tablist" aria-label="Failure trace stages" aria-orientation="horizontal">
          {compactStages.map((stage, idx) => (
            <button
              type="button"
              role="tab"
              id={`ctab-${stage.id}`}
              class="trace-tab"
              data-stage-tab={stage.id}
              data-narrative-state={syncareerHomepageNarrativeStateByStage[stage.id]}
              aria-controls={`cpanel-${stage.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex={idx === 0 ? '0' : '-1'}
              data-step={stage.step}
            >
              <span class="tab-step">{stage.step}</span>
              <span class="tab-label">{stage.label}</span>
              <i class="tab-dot" aria-hidden="true"></i>
            </button>
          ))}
        </div>
      </div>

      <div class="trace-panels">
        {compactStages.map((stage, idx) => (
          <div
            role="tabpanel"
            id={`cpanel-${stage.id}`}
            aria-labelledby={`ctab-${stage.id}`}
            class="trace-panel"
            data-stage-panel={stage.id}
            data-narrative-state={syncareerHomepageNarrativeStateByStage[stage.id]}
            data-active={idx === 0 ? 'true' : 'false'}
            tabindex="0"
            hidden={idx !== 0}
          >
            <header class="panel-header">
              <p class="panel-kicker">{stage.step} / {stage.label}</p>
              <h4>{stage.title}</h4>
              <p class="panel-detail">{stage.detail}</p>
            </header>

            {(stage.kind === 'raw' || stage.kind === 'valid') && (
              <div class="panel-code">
                <div class="code-meta">
                  <span>{stage.kind === 'raw' ? 'ILLUSTRATIVE BAD OUTPUT' : 'ILLUSTRATIVE VALID OUTPUT'}</span>
                  <span class="code-type">{stage.kind}</span>
                </div>
                <pre><code>{stage.code}</code></pre>
              </div>
            )}

            {stage.kind === 'validate' && (
              <div class="validate-card">
                <div class="validate-side">
                  <span class="mono-small">Product expects</span>
                  <strong>title, level, years, next_steps</strong>
                </div>
                <i aria-hidden="true"></i>
                <div class="validate-side">
                  <span class="mono-small mono-fail">Observed before fix</span>
                  <strong class="fail-text">mixed prose + malformed fields</strong>
                </div>
              </div>
            )}

            {stage.kind === 'fail' && (
              <ul class="failure-modes">
                {stage.modes?.map((mode) => (
                  <li><span>{mode.name}</span><p>{mode.note}</p></li>
                ))}
              </ul>
            )}

            {stage.kind === 'intervene' && (
              <ul class="fix-list">
                {stage.fixes?.map((fix) => <li>{fix}</li>)}
              </ul>
            )}

            <p class="panel-evidence"><span>Evidence</span>{stage.evidence}</p>
          </div>
        ))}
      </div>

      <div class="trace-cta">
        <a class="case-link" href="/work/syncareer/">Explore the full reliability case study <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="case-actions">
      <a class="live-link" href="https://syncareer.me/" target="_blank" rel="noopener">View Syncareer <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  import { initTraceTabs } from '../scripts/initTraceTabs';

  const narrativeRoots = document.querySelectorAll<HTMLElement>('[data-syncareer-narrative]');

  for (const narrativeRoot of narrativeRoots) {
    const section = narrativeRoot.closest('.case-study');
    const traceRoot = section?.querySelector<HTMLElement>('[data-trace-compact]');
    const steps = [...narrativeRoot.querySelectorAll<HTMLElement>('[data-narrative-step]')];
    const controls = [...narrativeRoot.querySelectorAll<HTMLButtonElement>('[data-narrative-control]')];
    const stageLinks = [...narrativeRoot.querySelectorAll<HTMLButtonElement>('[data-select-trace-stage]')];
    const position = narrativeRoot.querySelector<HTMLElement>('[data-narrative-position]');
    const announcement = narrativeRoot.querySelector<HTMLElement>('[data-narrative-announcement]');
    let syncingTrace = false;

    const traceController = traceRoot
      ? initTraceTabs(traceRoot, {
          onSelect: (_id, _index, _count, tab) => {
            const narrativeState = tab.dataset.narrativeState;
            if (!narrativeState || syncingTrace) return;
            setActiveState(narrativeState, { syncTrace: false, announce: true });
          },
        })
      : null;

    function setActiveState(
      stateId: string,
      options: { syncTrace?: boolean; announce?: boolean } = {},
    ) {
      const activeIndex = steps.findIndex(step => step.dataset.narrativeStep === stateId);
      if (activeIndex < 0) return;

      narrativeRoot.dataset.activeNarrativeState = stateId;
      steps.forEach(step => {
        step.dataset.active = String(step.dataset.narrativeStep === stateId);
      });
      controls.forEach(control => {
        const active = control.dataset.narrativeControl === stateId;
        if (active) control.setAttribute('aria-current', 'step');
        else control.removeAttribute('aria-current');
      });

      if (position) position.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
      if (options.announce && announcement) {
        const activeLabel = controls[activeIndex]?.textContent?.trim() ?? stateId;
        announcement.textContent = `Current state: ${activeLabel}`;
      }

      if (options.syncTrace && traceController) {
        const stageId = steps[activeIndex]?.querySelector<HTMLButtonElement>('[data-select-trace-stage]')?.dataset.selectTraceStage;
        if (stageId) {
          syncingTrace = true;
          traceController.select(stageId);
          syncingTrace = false;
        }
      }
    }

    controls.forEach(control => {
      control.addEventListener('click', () => {
        const stateId = control.dataset.narrativeControl;
        const step = steps.find(candidate => candidate.dataset.narrativeStep === stateId);
        if (!stateId || !step) return;
        setActiveState(stateId, { syncTrace: true, announce: true });
        step.scrollIntoView({ block: 'center' });
      });
    });

    stageLinks.forEach(link => {
      link.addEventListener('click', () => {
        const stageId = link.dataset.selectTraceStage;
        if (!stageId || !traceRoot || !traceController) return;
        traceController.select(stageId);
        traceRoot.scrollIntoView({ block: 'center' });
        traceRoot.querySelector<HTMLButtonElement>(`[data-stage-tab="${stageId}"]`)?.focus({ preventScroll: true });
      });
    });

    const observer = new IntersectionObserver(
      entries => {
        const activeEntry = entries
          .filter(entry => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const stateId = (activeEntry?.target as HTMLElement | undefined)?.dataset.narrativeStep;
        if (stateId) setActiveState(stateId, { syncTrace: true });
      },
      {
        rootMargin: '-30% 0px -45% 0px',
        threshold: [0, 0.2, 0.5, 0.8],
      },
    );

    steps.forEach(step => observer.observe(step));
    setActiveState('observed-failure');
  }
</script>

<style>
  .case-study {
    padding-block: var(--section-standard);
    border-top: var(--border-default);
    background: var(--color-surface-light);
    scroll-margin-top: 5rem;
    position: relative;
  }

  .case-header {
    display: grid;
    gap: var(--space-4);
    max-width: 62rem;
  }

  .case-header p,
  .case-header h2 {
    margin: 0;
  }

  .case-header h2 {
    max-width: 20ch;
    font-size: var(--text-h1);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .case-context {
    max-width: var(--width-reading);
    color: var(--color-text-secondary);
    font-size: var(--text-body-large);
  }

  .product-proof {
    margin-top: var(--section-content-gap);
  }

  /* --- Three-state engineering narrative --- */
  .engineering-narrative {
    margin-top: var(--section-content-gap);
  }

  .narrative-intro {
    display: grid;
    gap: var(--space-2);
    max-width: 48rem;
  }

  .narrative-intro p,
  .narrative-intro h3 {
    margin: 0;
  }

  .narrative-intro h3 {
    max-width: 24ch;
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .narrative-intro > p:last-child {
    max-width: var(--width-reading);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .narrative-rail {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-block: var(--space-3);
    border-block: var(--border-default);
    background: var(--color-surface-light);
  }

  .narrative-rail > p {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .narrative-rail > p span {
    margin-right: var(--space-2);
    color: var(--color-text);
  }

  .narrative-rail ol {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: var(--border-default);
    background: var(--color-border);
    list-style: none;
  }

  .narrative-rail li {
    min-width: 0;
  }

  .narrative-rail button {
    position: relative;
    display: grid;
    width: 100%;
    min-height: var(--control-height);
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: var(--color-background);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--text-small);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .narrative-rail button > span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
  }

  .narrative-rail button[aria-current='step'] {
    background: var(--color-surface-cool);
    color: var(--color-text);
    font-weight: 600;
  }

  .narrative-rail button[aria-current='step']::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-accent);
  }

  .narrative-rail button[aria-current='step']::after {
    content: 'Current';
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .narrative-rail button:hover {
    color: var(--color-text);
  }

  .narrative-rail button:focus-visible {
    z-index: 1;
    outline-offset: -3px;
  }

  .narrative-sequence {
    display: grid;
    margin-top: var(--space-4);
  }

  .narrative-state {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7);
    border-bottom: var(--border-default);
    scroll-margin-top: 7rem;
  }

  .narrative-state:first-child {
    border-top: var(--border-default);
  }

  .narrative-copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .narrative-kicker {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .narrative-copy h4 {
    max-width: 19ch;
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .narrative-summary {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .narrative-stage-link {
    justify-self: start;
    min-height: var(--control-height);
    padding: 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-small);
    font-weight: 600;
    cursor: pointer;
  }

  .narrative-stage-link span {
    margin-left: 0.2rem;
    color: var(--color-accent);
  }

  .narrative-evidence {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: var(--border-default);
    border-radius: var(--radius-card);
    background: var(--color-background);
    transition:
      opacity var(--duration-reveal) var(--ease-standard),
      transform var(--duration-reveal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard),
      background-color var(--duration-normal) var(--ease-standard);
  }

  .narrative-state[data-tone='failure'] .narrative-evidence {
    border-color: var(--color-failure-border);
    background: var(--color-failure-surface);
  }

  .narrative-state[data-tone='valid'] .narrative-evidence {
    border-color: color-mix(in srgb, var(--color-border) 45%, var(--color-accent));
  }

  .narrative-evidence-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-default);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .narrative-code pre {
    max-height: 12.5rem;
  }

  .code-type-failure {
    color: var(--color-failure-text);
  }

  .narrative-modes {
    gap: var(--space-2);
  }

  .narrative-modes li {
    background: color-mix(in srgb, var(--color-background) 80%, var(--color-failure-surface));
  }

  .narrative-modes span {
    color: var(--color-failure-text);
  }

  .narrative-fixes li {
    background: var(--color-surface-light);
  }

  .narrative-evidence-line,
  .narrative-boundary p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .narrative-evidence-line {
    padding-top: var(--space-3);
    border-top: var(--border-default);
  }

  .narrative-evidence-line span,
  .narrative-boundary span {
    display: inline-block;
    margin-right: var(--space-2);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .narrative-boundary {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface-cool);
  }

  /* --- Compact failure trace --- */
  .failure-trace {
    margin-top: var(--section-content-gap);
    border: var(--border-default);
    border-radius: var(--radius-card);
    background: var(--color-background);
    overflow: hidden;
  }

  .trace-intro {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-default);
    background: var(--color-surface-light);
  }

  .trace-intro h3 {
