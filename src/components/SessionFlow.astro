---
import {sessionbook} from '../data/registry';
const stages=sessionbook.stages??[];
const aliases: Record<string,string[]>={
 input:['arch-panel-caller','arch-panel-voice-agent','arch-panel-http-tool-call','arch-panel-backend','walk-panel-tool','walk-panel-request'],
 'model-output':['arch-panel-booking-logic'], intervention:['walk-panel-process'],
 output:['arch-panel-response','arch-panel-voice-agent-return','arch-panel-spoken-response','walk-panel-response'],
};
---
<div class="session-flow" data-session-flow>
 <p class="mono-label">Source-defined booking path / not a live call</p>
 <p class="session-flow__path">Caller → voice agent → HTTP tool → backend → booking decision → spoken reply</p>
 <div class="flow-controls" hidden><button class="button button--secondary" data-flow-prev>Previous</button><button class="button button--secondary" data-flow-next>Next</button><span role="status" aria-live="polite" data-flow-status></span></div>
 <div class="flow-stages">{stages.map(s=><details class="flow-stage" id={`flow-${s.id}`}><summary><span>{s.step}</span><strong>{s.title}</strong><span aria-hidden="true">+</span></summary><div><span id={`trace-panel-${s.id}`}></span>{(aliases[s.id]??[]).map(alias=><span id={alias}></span>)}<p>{s.detail}</p>{s.code&&<figure class="flow-code on-deck"><figcaption>{s.codeLabel??'Illustrative response · not a captured call'}</figcaption><pre><code>{s.code}</code></pre></figure>}{s.fixes&&<ul>{s.fixes.map(f=><li>{f}</li>)}</ul>}<p class="flow-source">{s.evidence}</p></div></details>)}</div>
</div>
<script>
const init=()=>{const root=document.querySelector<HTMLElement>('[data-session-flow]');if(!root||root.dataset.ready)return;root.dataset.ready='1';const controls=root.querySelector<HTMLElement>('.flow-controls')!;controls.hidden=false;const stages=[...root.querySelectorAll<HTMLDetailsElement>('details')];const status=root.querySelector<HTMLElement>('[data-flow-status]')!;let index=0;const select=(i:number)=>{index=(i+stages.length)%stages.length;stages.forEach((s,n)=>s.open=n===index);status.textContent=`Stage ${index+1} of ${stages.length}: ${stages[index].querySelector('strong')?.textContent}`;history.replaceState(null,'',`#${stages[index].id}`)};root.querySelector('[data-flow-prev]')?.addEventListener('click',()=>select(index-1));root.querySelector('[data-flow-next]')?.addEventListener('click',()=>select(index+1));stages.forEach((s,i)=>s.querySelector('summary')?.addEventListener('click',()=>{index=i}));const hash=location.hash.slice(1);const found=stages.findIndex(s=>s.id===hash||[...s.querySelectorAll('[id]')].some(el=>el.id===hash));if(found>=0)select(found);else stages[0].open=true;window.addEventListener('hashchange',()=>{const target=document.getElementById(location.hash.slice(1));const detail=target?.closest('details');if(detail instanceof HTMLDetailsElement){detail.open=true;index=stages.indexOf(detail);}});};init();document.addEventListener('astro:page-load',init);
</script>
<style>.session-flow{border:1px solid var(--rule);background:var(--color-sheet-raised);padding:clamp(1rem,3vw,2rem)}.session-flow__path{font:1.5rem/1.5 var(--font-display);margin-block:1rem 1.5rem}.flow-controls{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-bottom:1.5rem}.flow-controls>span{font-size:.75rem;flex-basis:100%}.flow-stage{padding-block:.8rem;border-top:1px solid var(--rule)}.flow-stage summary{display:flex;gap:1rem;align-items:center;list-style:none}.flow-stage summary::-webkit-details-marker{display:none}.flow-stage summary>span:first-child{font: .75rem var(--font-instrument);color:var(--color-accent-text)}.flow-stage summary>span:last-child{margin-left:auto}.flow-stage strong{font-size:1rem;font-weight:500}.flow-stage p{font-size:.95rem}.flow-source{color:var(--color-text-on-paper-faint);margin-top:1rem;font-size:.75rem!important}.flow-code{margin-top:1rem;padding:1rem}.flow-code figcaption{font-size:.7rem}.flow-stage:target{border-color:var(--color-accent-text)}</style>
