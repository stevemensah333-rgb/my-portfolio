---
import {investigationStages} from '../data/syncareerInvestigation';
import {inspectFixture} from '../scripts/fixtureValidator.mjs';
const old=investigationStages.find(s=>s.id==='model-output')!.artifact;
const revised=investigationStages.find(s=>s.id==='output')!.artifact;
const before=old?.kind==='code'?old.code:'';const after=revised?.kind==='code'?revised.code:'';
const ids=['requirement-2','evidence-1'];
const result=inspectFixture(before,ids);const corrected=inspectFixture(after,ids);
---
<section class="fixture-demo on-deck" data-fixture-demo data-before={before} data-after={after} aria-labelledby="demo-title">
 <div class="page-shell section"><div class="demo-heading"><div><p class="eyebrow">Reliability Lab / local demonstration</p><h1 id="demo-title">Looks convincing.<br /><em>Does it hold up?</em></h1></div><div><p class="lead">A polished rewrite can invent experience. Inspect what a small application check can refuse, and what still needs a human.</p><p class="demo-boundary">Illustrative fixtures. Deterministic browser checks. No AI request, captured incident or production test is running.</p></div></div>
 <div class="demo-context"><span class="mono-label">Supplied context</span><p><strong>requirement-2</strong> Python and SQL</p><p><strong>evidence-1</strong> Class project analysing 1,200 sales records</p></div>
 <div class="demo-controls" hidden><label for="demo-scenario">Example</label><select id="demo-scenario"><option value="prose">Unstructured rewrite</option><option value="missing">Missing evidence citation</option><option value="unknown">Unknown source citation</option></select><button class="button demo-run" data-demo-run>Run checks ↗</button><button class="button button--secondary" data-demo-pause disabled>Pause</button><button class="button button--secondary" data-demo-reset>Reset</button></div>
 <div class="demo-branches"><article class="demo-branch"><p class="mono-label" data-demo-branch-label>A / Old-contract fixture</p><h2>A claim with no footing.</h2><pre data-demo-raw>{before}</pre><p class="demo-check demo-check--fail" data-demo-rejection>× Refused: {result.reason}</p><p data-demo-rejection-note>{result.message}</p></article><article class="demo-branch demo-branch--bounded"><p class="mono-label">B / Separate revised-shape fixture</p><h2>A proposal for review.</h2><p class="demo-proposal">Built Python and SQL queries to analyse 1,200 sales records.</p><div class="citation-pair"><span>requirement-2</span><span>evidence-1</span></div><p class="demo-check" data-demo-accepted>✓ {corrected.reason}</p><p>{corrected.message}</p></article></div>
 <div class="demo-progress" aria-label="Local check stages"><span data-demo-step="0">01 Parse</span><span data-demo-step="1">02 Check citations</span><span data-demo-step="2">03 Human review</span></div><p class="demo-announcement" role="status" aria-live="polite" data-demo-status>Ready. Both examples and their local check results are shown above.</p>
 <details class="demo-scope"><summary>What these checks do — and what they can’t prove</summary><p>The local checker parses JSON, requires a non-empty rewrite, checks that citation IDs belong to supplied context, and requires both requirement and evidence citations. It does not prove that the text is true. The revised fixture is a separate authored example, not a correction returned by a model or the result of the old request.</p><p>The source inspection below exposes the actual contract, handler ordering and evidence boundaries. The application’s full validation is broader than this small local checker.</p></details>
 <a class="text-link" href="#source-inspection">Inspect the source artifacts ↓</a></div>
</section>
<script>
import {inspectFixture} from '../scripts/fixtureValidator.mjs';
const init=()=>{const root=document.querySelector<HTMLElement>('[data-fixture-demo]');if(!root||root.dataset.ready)return;root.dataset.ready='1';root.querySelector<HTMLElement>('.demo-controls')!.hidden=false;
const scenario=root.querySelector<HTMLSelectElement>('select')!;const run=root.querySelector<HTMLButtonElement>('[data-demo-run]')!;const pause=root.querySelector<HTMLButtonElement>('[data-demo-pause]')!;const reset=root.querySelector<HTMLButtonElement>('[data-demo-reset]')!;const status=root.querySelector<HTMLElement>('[data-demo-status]')!;const steps=[...root.querySelectorAll<HTMLElement>('[data-demo-step]')];const media=matchMedia('(prefers-reduced-motion: reduce)');let timer:ReturnType<typeof setTimeout>|undefined;let stage=-1;let running=false;let paused=false;
const stop=()=>{clearTimeout(timer);running=false;paused=false;run.disabled=false;scenario.disabled=false;pause.disabled=true;pause.textContent='Pause'};
const renderExample=()=>{stop();root.dataset.scenario=scenario.value;root.querySelector<HTMLElement>('[data-demo-branch-label]')!.textContent=scenario.value==='prose'?'A / Old-contract fixture':scenario.value==='missing'?'A / Illustrative missing-citation fixture':'A / Illustrative unknown-citation fixture';stage=-1;steps.forEach(s=>s.removeAttribute('data-active'));let raw=root.dataset.before||'';if(scenario.value!=='prose'){const proposal=JSON.parse(root.dataset.after||'{}');proposal.sourceContextIds=scenario.value==='missing'?['requirement-2']:['requirement-2','evidence-99'];raw=JSON.stringify(proposal,null,2)}root.querySelector<HTMLElement>('[data-demo-raw]')!.textContent=raw;const r=inspectFixture(raw,['requirement-2','evidence-1']);root.querySelector<HTMLElement>('[data-demo-rejection]')!.textContent=`× Refused: ${r.reason}`;root.querySelector<HTMLElement>('[data-demo-rejection-note]')!.textContent=r.message;status.textContent='Ready. Example selected; both branches remain visible.';};
const advance=()=>{stage++;steps.forEach((s,i)=>s.toggleAttribute('data-active',i<=stage));const labels=['Parsed each fixture independently.','Checked supplied IDs, then the requirement/evidence citation pair.','Complete: old example refused; revised example still requires human review.'];status.textContent=labels[Math.min(stage,2)];if(stage>=2){stop();run.textContent='Replay checks ↺';return}timer=setTimeout(advance,900)};
run.addEventListener('click',()=>{stop();stage=-1;running=true;run.disabled=true;scenario.disabled=true;if(media.matches){stage=1;advance()}else{pause.disabled=false;advance()}});
pause.addEventListener('click',()=>{if(!running)return;paused=!paused;pause.textContent=paused?'Resume':'Pause';if(paused){clearTimeout(timer);status.textContent='Paused. Both fixtures remain available to inspect.'}else advance()});reset.addEventListener('click',renderExample);scenario.addEventListener('change',renderExample);media.addEventListener('change',()=>{if(media.matches&&running){clearTimeout(timer);stage=1;advance()}});document.addEventListener('visibilitychange',()=>{if(document.hidden&&running&&!paused)pause.click()});document.addEventListener('astro:before-swap',stop,{once:true});};init();document.addEventListener('astro:page-load',init);
</script>
<style>
.demo-heading{display:grid;grid-template-columns:1.3fr 1fr;gap:4rem;align-items:end}.demo-heading h1{font-size:clamp(3.1rem,6vw,6rem)}.demo-heading h1 em{font-style:normal;color:#add0ba}.demo-heading .lead{font-size:1rem}.demo-boundary{font-size:.75rem;color:#bdbdb2;margin-top:1rem}.demo-context{display:flex;flex-wrap:wrap;gap:.5rem 2rem;padding:1.25rem 0;margin-block:2.5rem 1rem;border-block:1px solid #4a514b;align-items:center}.demo-context p{font-size:.8rem}.demo-context strong{font-size:.7rem;color:#add0ba;font-weight:400;margin-right:.5rem}.demo-controls{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-block:1.5rem}.demo-controls label{font-size:.8rem}.demo-controls select{max-width:100%;padding:.7rem;background:#202824;color:#f4f0e6;border:1px solid #68766d;font-size:.8rem;min-height:48px}.demo-run{background:#bed7c0;color:#101315}.demo-controls .button--secondary{border-color:#68766d;color:#eae7df}.demo-branches{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}.demo-branch{padding:2rem;background:#1b2420;border:1px solid #51584f;min-width:0}.demo-branch h2{font-size:1.7rem;margin-block:1rem 1.5rem}.demo-branch pre,.demo-proposal{font:clamp(1.1rem,2vw,1.65rem)/1.45 var(--font-display);margin:0 0 1.5rem;min-height:9rem}.fixture-demo[data-scenario="missing"] .demo-branch pre,.fixture-demo[data-scenario="unknown"] .demo-branch pre{font-family:var(--font-instrument);font-size:.8rem}.demo-branch>p:last-child{font-size:.8rem;color:#bdbdb2}.demo-check{font-size:.8rem;color:#add0ba;margin-block:1.5rem .5rem}.demo-check--fail{color:#efac85}.citation-pair{display:flex;gap:.5rem;flex-wrap:wrap}.citation-pair span{font-size:.7rem;border:1px solid #68766d;padding:.3rem .5rem}.demo-progress{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:1.5rem}.demo-progress span{font-size:.75rem;color:#aaa;font-family:var(--font-instrument)}.demo-progress [data-active]{color:#add0ba}.demo-announcement{font-size:.8rem;color:#bdbdb2;min-height:3rem;margin-top:1rem}.demo-scope{margin-block:1rem;border-block:1px solid #51584f;padding-block:1rem;font-size:.85rem}.demo-scope summary{display:flex;align-items:center}.demo-scope p+p{margin-top:1rem}@media(max-width:700px){.demo-heading,.demo-branches{grid-template-columns:1fr;gap:1.5rem}.demo-branch{padding:1.25rem}.demo-branch pre,.demo-proposal{min-height:0}.demo-context{margin-top:2rem}.demo-progress{gap:.6rem 1.5rem}}
</style>
