---
const words = ['STEPHEN', 'MENSAH'];
---

<div class="identity" data-interactive-name>
  <span class="identity__name" role="img" aria-label="Stephen Mensah" tabindex="0">
    {words.map(word => (
      <span class="identity__word" aria-hidden="true">
        {Array.from(word).map(letter => <span class="identity__letter">{letter}</span>)}
      </span>
    ))}
  </span>
</div>

<script>
  /* Re-initializes on `astro:page-load` (the ClientRouter swaps the
     shell without re-running bundled scripts); markers keep it
     idempotent and the run-scoped AbortController removes the
     previous run's document/media-query listeners. */
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let teardown: (() => void) | null = null;

  const init = () => {
    const roots = [...document.querySelectorAll<HTMLElement>('[data-interactive-name]')]
      .filter(root => root.dataset.nameEnhanced !== '1');
    if (roots.length === 0) return;
    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();

    for (const root of roots) {
      root.dataset.nameEnhanced = '1';
      const letters = Array.from(root.querySelectorAll<HTMLElement>('.identity__letter'));
      let frame = 0;
      let idle: ReturnType<typeof setTimeout>;
      const reset = () => {
        cancelAnimationFrame(frame);
        clearTimeout(idle);
        letters.forEach(letter => letter.style.removeProperty('transform'));
      };
      root.addEventListener('pointermove', event => {
        if (motion.matches || event.pointerType === 'touch') return;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          // Read first, then write; four pixels maximum, no perpetual loop.
          const offsets = letters.map(letter => {
            const box = letter.getBoundingClientRect();
            const dx = event.clientX - (box.left + box.width / 2);
            const dy = event.clientY - (box.top + box.height / 2);
            const strength = Math.max(0, 1 - Math.hypot(dx, dy) / 160);
            return [dx / 160 * strength * 8, -strength * 4];
          });
          letters.forEach((letter, i) => {
            letter.style.transform = `translate(${offsets[i][0]}px, ${offsets[i][1]}px)`;
          });
        });
        clearTimeout(idle);
        idle = setTimeout(reset, 700);
      }, { signal: events.signal });
      root.addEventListener('pointerleave', reset, { signal: events.signal });
      root.addEventListener('pointercancel', reset, { signal: events.signal });
      root.addEventListener('focusin', reset, { signal: events.signal });
      motion.addEventListener('change', reset, { signal: events.signal });
      document.addEventListener('visibilitychange', reset, { signal: events.signal });
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .identity { min-width: 0; container-type: inline-size; }
  .identity__name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.08em 0.25em;
    width: fit-content;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8.1cqw, 7.75rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.1;
  }
  .identity__word { display: inline-flex; }
  .identity__letter { display: inline-block; transition: transform 180ms ease-out; }
  .identity__name:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 8px;
    color: var(--color-accent-ink);
  }
  @media (max-width: 30rem) {
    .identity__name { font-size: 15cqw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .identity__letter { transform: none !important; transition: none; }
  }
</style>
