---
/**
 * SelectedWork — the substantial part of the homepage.
 *
 * Purpose distinct from the hero: the hero shows that the work exists;
 * this section says what each project is, what Stephen did, and what
 * state it is actually in. All wording comes from the shared registry
 * so the homepage, the archive and the case studies cannot drift apart.
 */
import ProjectArtifact from '../ProjectArtifact.astro';
import { projectRecords } from '../../data/portfolio';
import { projects } from '../../data/registry';

const record = {
  syncareer: projectRecords.syncareer,
  sessionbook: projectRecords.sessionbook,
  koranco: projectRecords.koranco,
};

const stack = (id: string, count: number) =>
  (projects.find((project) => project.id === id)?.stack ?? []).slice(0, count).join(' · ');

const facts = {
  syncareer: [
    { term: 'My part', value: 'Product and application engineering' },
    { term: 'State', value: 'Live product' },
    { term: 'Reliability work', value: 'In source — awaiting redeployment' },
    { term: 'Stack', value: stack('syncareer', 4) },
  ],
  sessionbook: [
    { term: 'My part', value: 'Backend and integration engineering' },
    { term: 'State', value: 'Implemented MVP' },
    { term: 'Live calls', value: 'Unverified — none retained' },
    { term: 'Stack', value: stack('sessionbook', 3) },
  ],
  koranco: [
    { term: 'My part', value: 'Software engineering, farm operations' },
    { term: 'State', value: 'Delivered MVP' },
    { term: 'Public artifacts', value: 'No source, no screenshots' },
    { term: 'Stack', value: stack('koranco', 2) },
  ],
};
---

<section class="selected page-shell" id="work" aria-labelledby="selected-title">
  <header class="selected__head">
    <p class="eyebrow">02 / Selected work</p>
    <div class="selected__head-grid">
      <h2 id="selected-title">The work, and<br />the evidence for it.</h2>
      <p class="lead">
        Three projects at three different stages. Each case study keeps what is running, what is
        only written, and what has never been tested in separate, labelled places.
      </p>
    </div>
  </header>

  <article class="feature" aria-labelledby="feature-syncareer">
    <div class="feature__copy">
      <p class="kicker"><span class="kicker__n">01</span> Flagship · live product</p>
      <h3 id="feature-syncareer">Syncareer</h3>
      <p class="feature__statement">
        One record from saved opportunity to recorded outcome.
      </p>
      <p>
        An AI-powered career platform for African students, built so a saved opportunity, the
        tailored CV and the interview preparation all sit inside one application record.
      </p>
      <p>
        I built the product and its application layer. After the CV assistant produced fluent
        bullets it could not support, I rebuilt the request and response contract around explicit
        context and citations.
      </p>
      <dl class="facts">
        {facts.syncareer.map((fact) => (
          <div class="facts__row">
            <dt>{fact.term}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <p class="result"><strong>Known result.</strong> {record.syncareer.result}</p>
      <a class="text-link feature__cta" href="/work/syncareer/">
        Open the Syncareer case study <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="feature__art">
      <!-- Two real captures from the same product, not one screenshot
           repeated: the application workflow and the dashboard read
           from it. -->
      <div class="feature__shot feature__shot--a">
        <ProjectArtifact
          id="syncareer"
          href="/work/syncareer/"
          shared={false}
          dense
          capture="opportunities"
          label="Syncareer opportunities screen — open the case study"
        />
      </div>
      <div class="feature__shot feature__shot--b">
        <ProjectArtifact
          id="syncareer"
          href="/work/syncareer/"
          shared={false}
          dense
          capture="dashboard"
          label="Syncareer dashboard — open the case study"
        />
      </div>
    </div>
  </article>

  <div class="pair">
    <article class="mini" aria-labelledby="mini-sessionbook">
      <ProjectArtifact id="sessionbook" href="/work/sessionbook/" shared={false} dense />
      <p class="kicker"><span class="kicker__n">02</span> Backend · implemented MVP</p>
      <h3 id="mini-sessionbook">SessionBook</h3>
      <p class="mini__statement">The backend decides what is true. The agent only asks.</p>
      <p class="mini__body">
        A booking service for a voice agent: availability, a row-locked booking transaction and a
        confirmation phrase designed to be read aloud.
      </p>
      <dl class="facts facts--mini">
        {facts.sessionbook.map((fact) => (
          <div class="facts__row">
            <dt>{fact.term}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link mini__cta" href="/work/sessionbook/">
        Open the SessionBook case study <span aria-hidden="true">↗</span>
      </a>
    </article>

    <article class="mini" aria-labelledby="mini-koranco">
      <ProjectArtifact id="koranco" href="/work/koranco/" shared={false} dense />
      <p class="kicker"><span class="kicker__n">03</span> Operations · delivered MVP</p>
      <h3 id="mini-koranco">Koranco Farms</h3>
      <p class="mini__statement">Three record types for a farm’s daily work.</p>
      <p class="mini__body">
        Attendance, produce and employee records, shaped during a six-week Ashesi Innovation Lab
        engagement and delivered as a working MVP.
      </p>
      <dl class="facts facts--mini">
        {facts.koranco.map((fact) => (
          <div class="facts__row">
            <dt>{fact.term}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link mini__cta" href="/work/koranco/">
        Open the Koranco case study <span aria-hidden="true">↗</span>
      </a>
    </article>
  </div>

  <div class="selected__archive">
    <p>
      Each case study carries its own decision record, source links and the limits of what has
      been verified.
    </p>
    <a class="button button--secondary" href="/work/">
      All three projects <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .selected {
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--color-rule);
  }

  .selected__head {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .selected__head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }
  .selected__head h2 {
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 16ch;
  }
  .selected__head .lead {
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    max-width: 44ch;
  }

  /* ---- feature --------------------------------------------- */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  /* DOM order follows the reading order — the project is named and
     explained before its capture appears. The grid puts the capture
     back on the left where the eye expects it. */
  .feature__art {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1rem;
  }
  /* A stepped pair: the workflow shot leads, the dashboard it feeds
     sits behind and below it. */
  .feature__shot {
    min-width: 0;
  }
  .feature__shot--a {
    width: 100%;
    z-index: 2;
  }
  .feature__shot--b {
    width: 88%;
    margin-left: auto;
    margin-top: -0.5rem;
    z-index: 1;
  }
  .feature__copy {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-instrument);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .kicker__n {
    color: var(--color-copper-text);
  }

  .feature__copy h3 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.2vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 0.1rem;
  }
  .feature__statement {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.24;
    letter-spacing: -0.015em;
    color: var(--color-teal);
    text-wrap: balance;
    max-width: 26ch;
  }
  .feature__copy p:not(.kicker):not(.feature__statement):not(.result) {
    color: var(--color-ink-muted);
    font-size: 0.97rem;
    max-width: 48ch;
  }

  .facts {
    margin: 0.4rem 0 0.2rem;
    border-top: 1px solid var(--color-rule);
    max-width: 32rem;
  }
  .facts__row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.62fr) minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .facts dt {
    font-family: var(--font-instrument);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    padding-top: 0.12rem;
  }
  .facts dd {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.45;
  }

  .result {
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    border-left: 2px solid var(--color-teal);
    padding-left: 0.8rem;
    max-width: 44ch;
  }
  .result strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .feature__cta {
    margin-top: 0.3rem;
    color: var(--color-teal);
  }
  .feature__cta:hover {
    color: var(--color-copper-text);
  }

  /* ---- pair ------------------------------------------------- */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule);
  }
  .mini {
    min-width: 0;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  /* Each artifact keeps its own natural height — the ticket is a
     longer object than the module map, and stretching either one would
     leave a hollow panel. The captions under them do the explaining. */
  .mini h3 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.4vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .mini__statement {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    line-height: 1.3;
    color: var(--color-teal);
    max-width: 28ch;
  }
  .mini__body {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 44ch;
  }
  .facts--mini {
    margin-top: 0.2rem;
  }
  .mini__cta {
    color: var(--color-teal);
    font-size: 0.9rem;
  }
  .mini__cta:hover {
    color: var(--color-copper-text);
  }

  .selected__archive {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 2px solid var(--color-rule-strong);
  }
  .selected__archive p {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    max-width: 46ch;
  }

  @media (max-width: 60rem) {
    .selected__head-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      align-items: start;
    }
    .feature {
      grid-template-columns: 1fr;
    }
    .feature__art,
    .feature__copy {
      grid-column: auto;
      grid-row: auto;
    }
    .feature__art {
      position: static;
    }
    .feature__shot--b {
      width: 100%;
      margin-top: 1rem;
    }
    .feature__copy h3 {
      font-size: clamp(2rem, 6vw, 2.6rem);
    }
  }

  @media (max-width: 46rem) {
    .pair {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .selected__head h2 {
      font-size: clamp(1.95rem, 8.4vw, 2.5rem);
    }
    .selected__archive {
      align-items: flex-start;
      flex-direction: column;
    }
    .selected__archive .button {
      width: 100%;
    }
    .facts__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
