---
/**
 * SelectedWork — the three projects, in one pass.
 *
 * The hero already shows that the objects exist and what state each is
 * in. This section only has to say what each one is and what Stephen did,
 * so it stays short: one capture for the flagship, two plain entries
 * underneath. Everything comes from the shared registry, so the homepage
 * cannot claim a state the archive or a case study contradicts.
 */
import ProjectArtifact from '../ProjectArtifact.astro';
import { projectRecords, projects } from '../../data/registry';

const record = projectRecords;

/* Stack lines are read from the registry and trimmed: three names are
   enough to place the work, and the case study carries the rest. */
const stack = (id: string, count: number) =>
  (projects.find((project) => project.id === id)?.stack ?? []).slice(0, count).join(', ');

const entries = [
  { id: 'sessionbook' as const, n: '02' },
  { id: 'koranco' as const, n: '03' },
];
---

<section class="selected page-shell" id="work" aria-labelledby="selected-title">
  <header class="selected__head">
    <p class="eyebrow">02 / The work</p>
    <div class="selected__head-grid">
      <h2 id="selected-title">Three projects,<br />three honest states.</h2>
      <p class="lead">
        One is live. One has never taken a real call. One has no public build.
      </p>
    </div>
  </header>

  <article class="feature" aria-labelledby="feature-syncareer">
    <div class="feature__copy">
      <p class="kicker">
        <span class="kicker__n">01</span>
        {record.syncareer.kind} · {record.syncareer.status}
      </p>
      <h3 id="feature-syncareer">Syncareer</h3>
      <p class="feature__statement">One record, from saved opportunity to recorded outcome.</p>
      <p>
        A career platform for African students: a saved opportunity, the tailored CV and the
        interview prep all sit in one application. I built the product and its application layer.
      </p>
      <p>
        Then the CV assistant started writing bullets it couldn't back up. So I rebuilt the contract
        around explicit context and citations.
      </p>
      <p class="feature__meta">
        {record.syncareer.role} · {stack('syncareer', 3)}
      </p>
      <p class="result">
        The revised contract is in source. The live model's grounding hasn't been measured, and that
        revision isn't redeployed yet.
      </p>
      <a class="text-link feature__cta" href="/work/syncareer/">
        Open the Syncareer case study <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="feature__art">
      <ProjectArtifact
        id="syncareer"
        href="/work/syncareer/"
        shared={false}
        capture="dashboard"
        label="Syncareer dashboard — open the case study"
      />
    </div>
  </article>

  <ul class="entries">
    {entries.map((entry) => (
      <li class="entry">
        <p class="kicker">
          <span class="kicker__n">{entry.n}</span>
          {record[entry.id].kind} · {record[entry.id].status}
        </p>
        <h3 class="entry__name" id={`entry-${entry.id}`}>
          <a href={`/work/${entry.id}/`}>
            {entry.id === 'sessionbook' ? 'SessionBook' : 'Koranco Farms'}
          </a>
        </h3>
        <p class="entry__statement">
          {entry.id === 'sessionbook'
            ? 'The backend decides what is true. The agent only asks.'
            : 'Three record types, built for a bad connection.'}
        </p>
        <p class="entry__body">{record[entry.id].purpose}</p>
        <p class="entry__state">{record[entry.id].deployment}</p>
        <a class="text-link entry__cta" href={`/work/${entry.id}/`}>
          Read the case study <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="selected__foot">
    Each case study carries its decision record and what hasn't been verified.
    <a class="text-link" href="/work/">See all three <span aria-hidden="true">↗</span></a>
  </p>
</section>

<style>
  .selected {
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--color-rule);
  }

  .selected__head {
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .selected__head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }
  .selected__head h2 {
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 16ch;
  }
  .selected__head .lead {
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    max-width: 40ch;
  }

  /* ---- the flagship ---------------------------------------- */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.25rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-rule);
  }
  /* DOM order follows reading order; the grid puts the capture back on
     the left, where the eye arrives first. */
  .feature__art {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    position: sticky;
    top: 6rem;
  }
  .feature__copy {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-instrument);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .kicker__n {
    color: var(--color-copper-text);
  }

  .feature__copy h3 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.2vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .feature__statement {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.24;
    letter-spacing: -0.015em;
    color: var(--color-teal);
    text-wrap: balance;
    max-width: 28ch;
  }
  .feature__copy p:not(.kicker):not(.feature__statement):not(.result):not(.feature__meta) {
    color: var(--color-ink-muted);
    font-size: 0.97rem;
    max-width: 46ch;
  }
  .feature__meta {
    font-family: var(--font-instrument);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-ink-faint);
    border-top: 1px solid var(--color-rule-soft);
    padding-top: 0.6rem;
    max-width: 42ch;
  }
  .result {
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    border-left: 2px solid var(--color-teal);
    padding-left: 0.8rem;
    max-width: 44ch;
  }
  .feature__cta {
    justify-self: start;
    margin-top: 0.2rem;
  }

  /* ---- the two shorter ones -------------------------------- */
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    border-top: 1px solid var(--color-rule);
  }
  .entry {
    padding-top: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-width: 0;
  }
  .entry__name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .entry__name a {
    display: inline-block;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    padding-block: 0.15rem;
  }
  .entry__name a:hover {
    color: var(--color-teal);
  }
  .entry__statement {
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.3;
    color: var(--color-teal);
    max-width: 30ch;
  }
  .entry__body {
    color: var(--color-ink-muted);
    font-size: 0.93rem;
    max-width: 44ch;
  }
  .entry__cta {
    justify-self: start;
  }
  .entry__state {
    font-family: var(--font-instrument);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
    text-transform: uppercase;
  }

  .selected__foot {
    margin-top: clamp(2rem, 3.5vw, 3rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule-soft);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 60rem) {
    .selected__head-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .feature {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .feature__art {
      grid-column: 1;
      grid-row: 2;
      position: static;
    }
    .feature__copy {
      grid-column: 1;
      grid-row: 1;
    }
  }
  @media (max-width: 46rem) {
    .entries {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
