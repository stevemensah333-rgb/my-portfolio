---
/**
 * ProofTeaser — the compact route from Home into the Lab.
 *
 * A signpost, not a second case study: one label that names the real
 * project, the four-step reliability path, one link. It borrows the
 * Lab's vocabulary — mono steps, rust on the one failing step — so a
 * visitor knows what the Lab is before arriving, while the dark
 * ground stays reserved for the instrument itself (LIGHT =
 * INFORMATION). About six short lines; no surface of its own.
 *
 * The link's name stays short ("Open the Lab"); its ::after stretches
 * over the block so the whole cue is one large click/tap target and
 * the focus ring outlines the block, while the path is still read
 * as a list. `id="lab"` keeps the existing /#lab anchor landing here.
 */
const steps = [
  { label: 'Raw output' },
  { label: 'Failure', failure: true },
  { label: 'Intervention' },
  { label: 'Valid output' },
];
---
<div id="lab" class="proof">
  <p class="proof__label mono-label">Syncareer · Reliability Lab</p>
  <ol class="proof__path" aria-label="Reliability path">
    {steps.map((step, index) => (
      <li class:list={['proof__step', step.failure && 'proof__step--fail']}>
        <span class="proof__arrow" aria-hidden="true">{index > 0 ? '↓' : ''}</span>
        <span>{step.label}</span>
      </li>
    ))}
  </ol>
  <a class="proof__link" href="/lab/">Open the Lab <span class="proof__link-arrow" aria-hidden="true">→</span></a>
</div>

<style>
  .proof {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    width: fit-content;
    max-width: 100%;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper);
  }
  .proof__label {
    margin: 0;
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-instrument-sm);
  }
  .proof__path {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .proof__step {
    display: grid;
    grid-template-columns: 1.25rem auto;
    align-items: baseline;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .proof__arrow { color: var(--color-text-on-paper-faint); }
  /* Rust only on the step that fails — fail is the subject of this path. */
  .proof__step--fail { color: var(--color-signal-fail-text); }

  .proof__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height-sm);
    color: var(--color-text-on-paper);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-rule-on-paper-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .proof__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .proof__link-arrow {
    color: var(--color-accent-text);
    transition: transform var(--duration-base) var(--ease-emphasized);
  }
  .proof__link:hover,
  .proof__link:focus-visible {
    color: var(--color-accent-text);
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .proof__link:hover .proof__link-arrow { transform: translateX(2px); }
  .proof__link:focus-visible { outline: none; }
  .proof__link:focus-visible::after {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 6px;
  }
</style>
