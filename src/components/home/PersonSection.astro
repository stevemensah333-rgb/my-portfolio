---
/**
 * PersonSection — who is at the bench.
 *
 * One paragraph, three roles named, one line of paper proof, and the two
 * routes out. The detail lives on /profile/; repeating it here made the
 * homepage twice as long as it needed to be. Dates and attribution come
 * from the shared experience records.
 */
import StephenPortrait from './StephenPortrait.astro';
import { experiences } from '../../data/portfolio';

/* Dates are fields in the record, not something to parse here. Three roles
   are enough to place the work; the full list is on the About page. */
const roles = experiences.slice(0, 3);
---

<section class="person page-shell" id="person" aria-labelledby="person-title">
  <div class="person__portrait">
    <StephenPortrait />
  </div>

  <div class="person__body">
    <p class="eyebrow">04 / The person</p>
    <h2 id="person-title">Curious about the details.<br />Clear about the limits.</h2>

    <p class="person__lead">
      I’m Stephen, a software engineer and Computer Science student at Ashesi University in Ghana. I
      like the part of the work that comes after the model answers: did it see the right context, and
      can every claim be traced back to something real?
    </p>

    <!-- Roles are named, not argued: the résumé and the About page carry
         the detail, and the homepage does not need to repeat them. -->
    <ul class="roles" aria-label="Recent roles">
      {roles.map((role) => (
        <li class="role">
          <span class="role__org">{role.organisation}</span>
          <span class="role__title">{role.role}</span>
          <span class="role__date">{role.dates}</span>
        </li>
      ))}
    </ul>

    <p class="person__proof">
      Also on paper: SAT 1520, Dean’s List at Ashesi, and a Gold Award in the Royal Commonwealth
      Essay Competition.
    </p>

    <div class="person__close-actions">
      <a class="button button--secondary" href="/profile/">
        About Stephen <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/Stephen-Mensah-Resume.pdf">Résumé <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .person {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--color-rule);
  }

  .person__portrait {
    position: sticky;
    top: 7rem;
    min-width: 0;
    max-width: 22rem;
  }

  .person__body {
    min-width: 0;
  }
  .person__body h2 {
    font-size: clamp(2rem, 3.6vw, 3.3rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    margin-bottom: 1.4rem;
    max-width: 20ch;
  }
  .person__lead {
    color: var(--color-ink);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.62;
    max-width: 52ch;
  }

  .roles {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 2px solid var(--color-rule-strong);
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.6rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .role__org {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .role__title {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  /* A hairline between the place and the job, so the two names do not
     read as one long title. */
  .role__title::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-right: 0.55rem;
    vertical-align: -0.1em;
    background: var(--color-rule-strong);
  }
  .role__date {
    margin-left: auto;
    font-family: var(--font-instrument);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .person__proof {
    margin-top: 1.25rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .person__close-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-rule-strong);
  }
  .person__close-actions .button {
    min-height: 44px;
    flex: none;
  }

  @media (max-width: 62rem) {
    .person {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .person__portrait {
      position: static;
      max-width: 15rem;
      order: -1;
    }
  }

  @media (max-width: 46rem) {
    .person {
      gap: 1.6rem;
    }
    .person__portrait {
      max-width: 12.5rem;
    }
    .person__body h2 {
      font-size: clamp(1.95rem, 8.6vw, 2.5rem);
    }
    .role__date {
      margin-left: 0;
      width: 100%;
    }
    .person__close-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .person__close-actions .button {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
