---
/**
 * Home avatar slot. The photograph is the no-JS and failure baseline; the
 * renderer mounts into [data-stephen-renderer] only when the stage is on
 * screen. The square stage reserves its aspect before anything loads, so the
 * model can never shift layout. State is reported in the caption line and,
 * once revealed, in the single note below the portrait.
 */
---
<figure class="stephen" data-stephen-visual data-state="photo" data-model-src="/assets/models/stephen.glb">
  <details class="stephen__note">
    <summary aria-label="A note from Stephen">
      <span class="stephen__stage">
        <img
          class="stephen__portrait"
          src="/images/stephen-480.webp"
          srcset="/images/stephen-480.webp 480w, /images/stephen-800.webp 800w"
          sizes="(min-width: 64rem) 360px, (min-width: 48rem) 40vw, 480px"
          alt="Stephen Mensah"
          width="800" height="800"
          fetchpriority="high" decoding="async"
        />
        <span class="stephen__renderer" data-stephen-renderer aria-hidden="true"><slot name="renderer" /></span>
        <span class="stephen__marker" aria-hidden="true">SM / 01</span>
      </span>
      <span class="stephen__prompt"><span>A note from Stephen</span><span class="stephen__toggle" aria-hidden="true">+</span></span>
    </summary>
    <p class="stephen__message" data-stephen-message>I care about what happens after the model responds. That’s where I like to work.</p>
  </details>
  <figcaption class="stephen__caption" data-stephen-caption aria-live="polite">Portrait / static view</figcaption>
</figure>

<script>
  import { initStephenVisual } from '../../scripts/stephenVisual';
  import type { StephenVisualState } from '../../scripts/stephenVisual';
  import { createStephenRenderer } from '../../scripts/stephenRenderer';

  /** One instrument-style line per state; the markup ships the no-JS line. */
  const CAPTIONS: Record<StephenVisualState, string> = {
    photo: 'Portrait / static view',
    loading: '3D view / loading',
    live: '3D view / live · generated stand-in',
    held: '3D view / held · reduced motion',
    fallback: 'Portrait / 3D unavailable',
    missing: 'Portrait / model not deployed',
  };
  /** The note stays Stephen's identity line unless a state has its own. */
  const NOTES: Partial<Record<StephenVisualState, string>> = {
    live: 'A generated stand-in, rendered live in your browser and held still when you ask for less motion.',
    held: 'A generated stand-in. It stays still because your system prefers reduced motion.',
    fallback: 'The 3D view could not load here. The photograph stays, and nothing on this page depends on the model.',
    missing: 'The model file is not part of this deployment. The photograph stays, and nothing on this page depends on it.',
  };

  /* The ClientRouter swaps the shell without re-executing bundled
     scripts, so init re-runs on `astro:page-load` (also fired on first
     load). Markers keep it idempotent; a previous page's controller is
     disposed when a fresh one mounts, so renderers never accumulate. */
  let active: Array<() => void> = [];

  const init = () => {
    const fresh: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>('[data-stephen-visual]').forEach(root => {
      if (root.dataset.visualEnhanced === '1') return;
      root.dataset.visualEnhanced = '1';
      const caption = root.querySelector<HTMLElement>('[data-stephen-caption]');
      const message = root.querySelector<HTMLElement>('[data-stephen-message]');
      const baseNote = message?.textContent ?? '';
      fresh.push(initStephenVisual(root, createStephenRenderer, (state) => {
        root.dataset.state = state;
        if (caption) caption.textContent = CAPTIONS[state];
        if (message) message.textContent = NOTES[state] ?? baseNote;
      }));
    });
    if (fresh.length > 0) {
      active.forEach(dispose => dispose());
      active = fresh;
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .stephen { position: relative; margin: 0; width: 100%; max-width: 30rem; }
  .stephen__note { position: relative; padding-bottom: 6.5rem; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--color-accent-ink); outline-offset: 5px; }
  .stephen__stage {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1; /* reserved before any model request: no layout shift */
    background: var(--color-sheet-inset);
    border: 1px solid var(--color-rule-on-paper);
  }
  .stephen__portrait { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.45s ease; }
  /* The render replaces the photograph only after its first frame exists. */
  .stephen[data-state='live'] .stephen__portrait,
  .stephen[data-state='held'] .stephen__portrait { opacity: 0; }
  .stephen__renderer { position: absolute; inset: 0; pointer-events: none; }
  .stephen__marker {
    position: absolute; top: 1rem; left: 1rem;
    padding: 0.35rem 0.5rem;
    background: var(--color-sheet);
    font: 500 0.65rem var(--font-instrument);
    letter-spacing: 0.08em;
  }
  .stephen__prompt {
    display: flex; justify-content: space-between; align-items: center;
    min-height: 3rem; gap: 1rem;
    border-bottom: 1px solid var(--color-rule-on-paper-strong);
    font-size: var(--text-small);
  }
  summary:hover .stephen__prompt, summary:focus-visible .stephen__prompt { color: var(--color-accent-ink); }
  .stephen__toggle { font-size: 1.5rem; }
  details[open] .stephen__toggle { transform: rotate(45deg); }
  .stephen__message {
    position: absolute; bottom: 0; inset-inline: 0; height: 6.5rem;
    margin: 0; padding-top: 0.8rem;
    font-size: 0.875rem; line-height: 1.5;
    color: var(--color-text-on-paper-muted);
  }
  .stephen__caption {
    position: absolute; bottom: 0;
    font: 500 0.625rem var(--font-instrument);
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-text-on-paper-faint);
  }
  /* A quiet pulse only while the model is actually in flight. */
  .stephen[data-state='loading'] .stephen__caption::after {
    content: '';
    display: inline-block;
    width: 0.375rem; height: 0.375rem;
    margin-left: 0.5rem;
    background: var(--color-accent);
    border-radius: 50%;
    animation: stephen-pulse 1.1s ease-in-out infinite;
  }
  @keyframes stephen-pulse { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) {
    .stephen__portrait { transition: none; }
    .stephen[data-state='loading'] .stephen__caption::after { animation: none; }
  }
</style>
