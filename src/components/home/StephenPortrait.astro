---
/**
 * Home portrait — Stephen's identity slot in the hero.
 *
 * The portrait is a real photograph: no WebGL, no 3D, no generated
 * stand-in, no depth reconstruction. The frame is a simple
 * interaction boundary. Under a fine pointer it responds with three
 * small, related movements — the photograph shifts a few pixels
 * inside its boundary and a soft highlight, clipped to Stephen's own
 * silhouette, follows the pointer. At rest (touch, keyboard, no
 * JavaScript, reduced motion) it is the plain, uncropped photograph.
 *
 * The asset (public/images/stephen.{webp,png}, 500×500) is a cut-out
 * with a transparent background, so there is no box: no fill, no
 * border, no mat. The subject stands directly on the page sheet, and
 * the photograph's cropped lower edge lands on the prompt's rule —
 * the one line the portrait is allowed, and the one that grounds it.
 *
 * "A note from Stephen" is a native <details>: the whole portrait is
 * its summary, so tap, click, Enter and Space open it with no
 * JavaScript. One short personal message — not a menu, not a chat.
 */
---
<figure class="portrait" data-portrait>
  <details class="portrait__note">
    <summary aria-label="A note from Stephen">
      <span class="portrait__frame">
        <span class="portrait__subject">
          <picture>
            <source type="image/webp" srcset="/images/stephen.webp" />
            <img
              class="portrait__image"
              src="/images/stephen.png"
              alt="Stephen Mensah"
              width="500" height="500"
              fetchpriority="high" decoding="async"
            />
          </picture>
          <span class="portrait__light" aria-hidden="true"></span>
        </span>
      </span>
      <span class="portrait__prompt">
        <span>A note from Stephen</span>
        <span class="portrait__toggle" aria-hidden="true">+</span>
      </span>
    </summary>
    <div class="portrait__message">
      <p>
        I’m most interested in what happens after the model answers. Did it see the
        right context? Can every claim be traced back to evidence?
      </p>
      <p>Thanks for taking a closer look. <span class="portrait__sign">— Stephen</span></p>
    </div>
  </details>
</figure>

<script>
  /* Pointer-responsive portrait. Writes two normalized offsets
     (--portrait-x / --portrait-y, each -1…1) onto the figure; every
     movement lives in CSS behind a fine-pointer, motion-OK media
     query. Nothing runs for touch or reduced motion. Re-initializes
     on `astro:page-load`. */
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let teardown: (() => void) | null = null;

  const init = () => {
    const roots = [...document.querySelectorAll<HTMLElement>('[data-portrait]')]
      .filter(root => root.dataset.portraitEnhanced !== '1');
    if (roots.length === 0) return;
    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();

    for (const root of roots) {
      root.dataset.portraitEnhanced = '1';
      const frame = root.querySelector<HTMLElement>('.portrait__frame');
      if (!frame) continue;

      let queued = false;
      let x = 0;
      let y = 0;
      const write = () => {
        queued = false;
        root.style.setProperty('--portrait-x', x.toFixed(3));
        root.style.setProperty('--portrait-y', y.toFixed(3));
      };
      const schedule = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(write);
      };
      const rest = () => {
        x = 0;
        y = 0;
        schedule();
      };
      const clamp = (value: number) => Math.max(-1, Math.min(1, value));

      frame.addEventListener('pointermove', event => {
        if (motion.matches || event.pointerType === 'touch') return;
        const box = frame.getBoundingClientRect();
        if (box.width === 0 || box.height === 0) return;
        x = clamp(((event.clientX - box.left) / box.width) * 2 - 1);
        y = clamp(((event.clientY - box.top) / box.height) * 2 - 1);
        schedule();
      }, { signal: events.signal });
      frame.addEventListener('pointerleave', rest, { signal: events.signal });
      frame.addEventListener('pointercancel', rest, { signal: events.signal });
      motion.addEventListener('change', rest, { signal: events.signal });
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .portrait { position: relative; width: 100%; max-width: 26rem; margin: 0; }

  .portrait__note { position: relative; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--color-accent-ink); outline-offset: 5px; }

  /* THE FRAME — the interaction boundary. Square, so the photograph
     is never cropped to fit a shape, and the space is reserved so
     the portrait never shifts the layout. It is invisible: the image
     is a transparent cut-out, so a fill or border here would only
     draw the rectangle the cut-out exists to remove. `overflow`
     keeps the parallax headroom from spilling past the lower edge,
     so the shoulders always meet the rule below cleanly. */
  .portrait__frame {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  /* The photograph and its highlight move together as one subject. */
  .portrait__subject {
    display: block;
    position: absolute;
    inset: 0;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .portrait__subject picture { display: contents; }

  .portrait__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Controlled lighting: a warm highlight positioned by the pointer.
     Soft-light keeps it inside the photograph's own value range
     instead of washing it out, and the mask — the photograph's own
     alpha — keeps it on Stephen, never on the empty sheet around
     him. Hidden unless the frame is hovered. */
  .portrait__light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: soft-light;
    background: radial-gradient(
      60% 56% at calc(50% + var(--portrait-x, 0) * 30%) calc(36% + var(--portrait-y, 0) * 30%),
      rgba(255, 250, 240, 0.6),
      rgba(255, 250, 240, 0) 72%
    );
    -webkit-mask: url('/images/stephen.webp') center / 100% 100% no-repeat;
    mask: url('/images/stephen.webp') center / 100% 100% no-repeat;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  /* DEPTH, ONLY WHERE IT CAN BE FELT. A fine pointer that can hover,
     and a visitor who has not asked for less motion. The subject is
     pushed in by 5% — at the narrowest two-column frame (~250px) that
     is ~6px of headroom, enough to keep its cropped lower edge below
     the rule while it parallaxes (6px across, 4px up) against the
     pointer.
     No frame tilt: with no visible frame, a tilt would only lift the
     shoulders off the baseline. It settles back on leave. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    summary:hover .portrait__subject {
      transform:
        scale(1.05)
        translate3d(calc(var(--portrait-x, 0) * -6px), calc(var(--portrait-y, 0) * -4px), 0);
    }
    summary:hover .portrait__light { opacity: 1; }
  }

  .portrait__prompt {
    display: flex; justify-content: space-between; align-items: center;
    min-height: 3rem; gap: 1rem;
    /* The baseline the cut-out stands on. */
    border-top: 1px solid var(--color-rule-on-paper-strong);
    border-bottom: 1px solid var(--color-rule-on-paper);
    font-size: var(--text-small);
  }
  summary:hover .portrait__prompt, summary:focus-visible .portrait__prompt { color: var(--color-accent-ink); }
  .portrait__toggle { font-size: 1.5rem; line-height: 1; transition: transform var(--duration-quick) var(--ease-standard); }
  details[open] .portrait__toggle { transform: rotate(45deg); }

  /* The note flows in the document when opened — no overlay, no
     fixed height, nothing to clip on a narrow screen or at zoom. */
  .portrait__message {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    animation: reveal-enter var(--duration-reveal) var(--ease-emphasized);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }
  .portrait__message p { margin: 0; }
  .portrait__sign {
    color: var(--color-text-on-paper);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 47.99rem) {
    .portrait { max-width: 20rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait__message { animation: none; }
  }
</style>
