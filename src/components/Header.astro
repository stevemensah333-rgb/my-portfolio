---
import { GMAIL_COMPOSE_URL, PUBLIC_LINKS } from '../config/site';

const isHomepage = Astro.url.pathname === '/';
const homeHref = isHomepage ? '#top' : '/';
const sectionHref = (id: string) => isHomepage ? `#${id}` : `/#${id}`;

const navItems = [
  { id: 'syncareer', label: 'Work', href: sectionHref('syncareer') },
  { id: 'toolkit', label: 'Toolkit', href: sectionHref('toolkit') },
  { id: 'about', label: 'About', href: sectionHref('about') },
  { id: 'experience', label: 'Experience', href: sectionHref('experience') },
  { id: 'evidence', label: 'Evidence', href: sectionHref('evidence') },
];
---

<header id="top" class="site-header" data-site-header>
  <div class="page-shell header-grid">
    <a class="site-name" href={homeHref} aria-label="Stephen Nyarko Mensah, home">
      <span class="site-name__mark" aria-hidden="true">SM</span>
      <span class="site-name__text">
        <span class="site-name__full">Stephen Nyarko Mensah</span>
        <span class="site-name__role mono-label">Engineering · AI · Reliability</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ol class="desktop-nav__list">
        {navItems.map((item, index) => (
          <li class="desktop-nav__item">
            <span class="desktop-nav__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li class="desktop-nav__item desktop-nav__item--external">
          <span class="desktop-nav__index" aria-hidden="true">R</span>
          <a href={PUBLIC_LINKS.resume} target="_blank" rel="noopener noreferrer">
            Résumé <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ol>
    </nav>

    <a
      class="header-cta"
      href={GMAIL_COMPOSE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="header-cta__dot" aria-hidden="true"></span>
      <span>Email</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      <span class="menu-toggle__label" data-menu-label>Menu</span>
    </button>

    <div id="mobile-navigation" class="mobile-panel" data-mobile-panel hidden>
      <div class="page-shell mobile-panel__inner">
        <p class="mono-label mobile-panel__eyebrow">Index</p>
        <nav aria-label="Mobile navigation">
          <ol class="mobile-panel__list">
            {navItems.map((item, index) => (
              <li>
                <a href={item.href}>
                  <span class="mobile-panel__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span class="mobile-panel__label">{item.label}</span>
                  <span class="mobile-panel__chev" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
            <li>
              <a href={PUBLIC_LINKS.resume} target="_blank" rel="noopener noreferrer">
                <span class="mobile-panel__index" aria-hidden="true">R</span>
                <span class="mobile-panel__label">Résumé</span>
                <span class="mobile-panel__chev" aria-hidden="true">↗</span>
              </a>
            </li>
          </ol>
        </nav>
        <a class="button button--accent mobile-panel__cta" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">
          Email me
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuButton = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menuPanel = header?.querySelector<HTMLElement>('[data-mobile-panel]');
  const menuLabel = header?.querySelector<HTMLElement>('[data-menu-label]');

  if (header && menuButton && menuPanel) {
    const backgroundElements = [
      document.querySelector<HTMLElement>('.skip-link'),
      document.querySelector<HTMLElement>('main'),
      document.querySelector<HTMLElement>('body > footer'),
    ].filter((element): element is HTMLElement => element !== null);

    const menuLinks = [...menuPanel.querySelectorAll<HTMLAnchorElement>('a[href]')];

    const closeMenu = (restoreFocus = true) => {
      menuButton.setAttribute('aria-expanded', 'false');
      if (menuLabel) menuLabel.textContent = 'Menu';
      menuPanel.hidden = true;
      document.documentElement.classList.remove('menu-open');
      for (const element of backgroundElements) element.inert = false;
      if (restoreFocus) menuButton.focus();
    };

    const openMenu = () => {
      menuButton.setAttribute('aria-expanded', 'true');
      if (menuLabel) menuLabel.textContent = 'Close';
      menuPanel.hidden = false;
      document.documentElement.classList.add('menu-open');
      for (const element of backgroundElements) element.inert = true;
      menuLinks[0]?.focus();
    };

    menuButton.addEventListener('click', () => {
      menuButton.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });

    for (const link of menuLinks) {
      link.addEventListener('click', () => closeMenu(false));
    }

    document.addEventListener('keydown', (event) => {
      if (menuButton.getAttribute('aria-expanded') !== 'true') return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }

      if (event.key !== 'Tab') return;

      const siteName = header.querySelector<HTMLAnchorElement>('.site-name');
      const focusable: HTMLElement[] = [
        ...(siteName ? [siteName] : []),
        menuButton,
        ...menuLinks,
      ];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 48rem)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches && menuButton.getAttribute('aria-expanded') === 'true') closeMenu(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .header-grid {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
  }

  /* Site name */
  .site-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    color: var(--color-text-on-canvas);
    text-decoration: none;
  }

  .site-name__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .site-name__text {
    display: grid;
    gap: 2px;
    line-height: 1.1;
  }

  .site-name__full {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .site-name__role {
    font-size: 0.625rem;
    letter-spacing: var(--tracking-meta);
  }

  .site-name__role::before {
    border-color: var(--color-accent);
  }

  /* Desktop nav */
  .desktop-nav {
    display: none;
    justify-self: center;
  }

  .desktop-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-rule-on-canvas);
  }

  .desktop-nav__item {
    display: flex;
    align-items: center;
  }

  .desktop-nav__item a {
    display: inline-flex;
    min-height: var(--control-height-sm);
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-3);
    color: var(--color-text-on-canvas-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--duration-quick) var(--ease-standard),
      background-color var(--duration-quick) var(--ease-standard);
  }

  .desktop-nav__item + .desktop-nav__item a {
    border-left: 1px solid var(--color-rule-on-canvas);
  }

  .desktop-nav__index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .desktop-nav__item a:hover,
  .desktop-nav__item a:focus-visible {
    color: var(--color-text-on-canvas);
    background: var(--color-canvas-soft);
  }

  .desktop-nav__item--external a:hover {
    color: var(--color-accent);
  }

  /* Header CTA */
  .header-cta {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height-sm);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .header-cta__dot {
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--color-accent);
    border-radius: 50%;
    animation: signal-pulse 2.4s var(--ease-standard) infinite;
  }

  .header-cta:hover {
    background: var(--color-accent);
    color: var(--color-canvas);
  }

  @keyframes signal-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-cta__dot {
      animation: none;
    }
  }

  /* Mobile menu toggle */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height-sm);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-rule-on-canvas);
    background: transparent;
    color: var(--color-text-on-canvas);
    cursor: pointer;
    transition:
      border-color var(--duration-quick) var(--ease-standard),
      background-color var(--duration-quick) var(--ease-standard);
  }

  .menu-toggle__bars {
    display: inline-grid;
    gap: 3px;
  }

  .menu-toggle__bars i {
    width: 0.875rem;
    height: 1px;
    background: currentColor;
  }

  .menu-toggle__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .menu-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Mobile panel */
  .mobile-panel {
    position: fixed;
    inset: 4rem 0 0 0;
    z-index: calc(var(--z-overlay) - 1);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    overflow-y: auto;
  }

  .mobile-panel__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }

  .mobile-panel__eyebrow {
    color: var(--color-text-on-canvas-muted);
  }

  .mobile-panel__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .mobile-panel__list li {
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .mobile-panel__list a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 4rem;
    padding-inline: var(--space-1);
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition: background-color var(--duration-quick) var(--ease-standard);
  }

  .mobile-panel__list a:hover,
  .mobile-panel__list a:focus-visible {
    background: var(--color-canvas-soft);
  }

  .mobile-panel__index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .mobile-panel__label {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .mobile-panel__chev {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 1.125rem;
  }

  .mobile-panel__cta {
    justify-self: start;
  }

  /* Tablet+ */
  @media (min-width: 48rem) {
    .header-grid {
      min-height: 4.5rem;
      grid-template-columns: auto 1fr auto;
    }

    .menu-toggle,
    .mobile-panel {
      display: none;
    }

    .desktop-nav {
      display: flex;
    }

    .header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .site-name__role {
      display: none;
    }
  }
</style>

<style is:global>
  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }
</style>
