  .preset-select {
    display: none;
    margin: 0;
    gap: 0.5rem;
    align-items: center;
  }
  .preset-select label {
    font-family: var(--font-instrument);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-on-canvas-faint);
