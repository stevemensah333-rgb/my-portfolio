    background: var(--color-signal-pass-bright);
  }
  .checks__row[data-pass='false'] .checks__mark {
    border-color: var(--color-signal-fail-bright);
  }
  .checks__row[data-pass='false'] .checks__name {
    color: var(--color-signal-fail-bright);
  }
  .desk__hint {
    margin: 0;
    font-family: var(--font-instrument);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-on-canvas-faint);
  }
  .desk[hidden] {
    display: none;
  }

  .panel {
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck-soft);
    padding: clamp(1rem, 2vw, 1.5rem);
  }
  .panel--material {
    padding-bottom: 0.5rem;
  }
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .panel__title {
    font-family: var(--font-instrument);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-on-canvas-faint);
    font-weight: 500;
