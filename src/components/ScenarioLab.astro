---
/**
 * The Reliability Lab.
 *
 * One idea: a check reads a CV sentence before a person does, and you get to
 * write the sentence. The visitor's text and their citation choices go
 * through `evaluateReply` — the same pure function `npm test` asserts — so
 * the verdict on screen is computed, never authored.
 *
 * With JavaScript off the page still shows a worked example and its reading:
 * that panel is rendered on the server and swapped for the live bench as soon
 * as the script runs.
 */
import { LIMITS, PRESETS, SUPPLIED_CONTEXT, evaluateReply } from '../scripts/labScenario.mjs';
import { investigationStages } from '../data/syncareerInvestigation.ts';

const honest = PRESETS.find((preset) => preset.id === 'honest') ?? PRESETS[PRESETS.length - 1];
const first = evaluateReply({ text: honest.text, citedIds: honest.citedIds });

const codeOf = (id: string) => {
  const stage = investigationStages.find((item) => item.id === id);
  return stage && stage.artifact && stage.artifact.kind === 'code' ? stage.artifact.code : '';
};

const beforeText = codeOf('model-output').replace(/\s*\n\s*/g, ' ').trim();
const afterText = 'Built Python and SQL queries to analyse 1,200 sales records.';
const gateCode = codeOf('output');

const materials = SUPPLIED_CONTEXT.map((item) => ({
  id: item.id,
  label: item.label,
  content: item.content,
  citedByDefault: honest.citedIds.includes(item.id),
}));
---

<section class="lab" id="lab" aria-labelledby="lab-title">
  <div class="page-shell lab__shell">
    <header class="lab__head">
      <div>
        <p class="eyebrow">03 / The Reliability Lab</p>
        <h1 class="lab__title" id="lab-title">
          The rewrite looked right.<br />
          <em>Then somebody checked it.</em>
        </h1>
      </div>
      <div class="lab__head-side">
        <p class="lab__lead">
          A CV sentence can invent a company. Write one below, choose what it cites, and watch the
          check decide.
        </p>
        <p class="lab__lead lab__lead--static">
          A CV sentence can invent a company. Here is one that cites its sources, and the reading
          the check gives it.
        </p>
        <p class="lab__fine">No model is called. Everything here runs in your browser.</p>
      </div>
    </header>

    {/* ------------------------------------------------ the bench ---- */}
    <div class="desk" data-lab-live hidden>
      <div class="desk__side">
        <div class="panel panel--material">
          <div class="panel__head">
            <h2 class="panel__title">The material</h2>
          </div>
          <ul class="material">
            {
              materials.map((item) => (
                <li class="material__item">
                  <span class="material__label">
                    {item.label}
                    <span class="material__id">{item.id}</span>
                  </span>
                  <span class="material__text">{item.content}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="desk__main">
        <div class="panel panel--compose">
          <div class="compose">
            <label class="compose__label" for="lab-text">Your sentence</label>
            <textarea
              id="lab-text"
              class="compose__field"
              rows="2"
              spellcheck="false"
              data-lab-text>{honest.text}</textarea>

            <div class="presets" role="group" aria-label="Examples">
              <span class="presets__label" aria-hidden="true">Try</span>
              {
                PRESETS.map((preset) => (
                  <button type="button" class="preset" data-preset={preset.id}>
                    {preset.label}
                  </button>
                ))
              }
            </div>
            <p class="preset-select">
              <label for="lab-preset">Try</label>
              <select id="lab-preset" data-preset-select>
                {PRESETS.map((preset) => (
                  <option value={preset.id}>{preset.label}</option>
                ))}
              </select>
            </p>
            <p class="presets__note" data-preset-note aria-live="polite">
              {honest.note}
            </p>

          </div>

        </div>
      </div>

      <div class="desk__cites panel panel--cites">
        <fieldset class="cites">
          <legend class="cites__legend">What it cites</legend>
          <div class="cites__row">
            {
              materials.map((item) => (
                <button
                  type="button"
                  class="cite"
                  data-cite={item.id}
                  aria-pressed={item.citedByDefault ? 'true' : 'false'}
                >
                  <span class="cite__tick" aria-hidden="true"></span>
                  {item.label}
                </button>
              ))
            }
          </div>
        </fieldset>
      </div>

      <aside class="desk__verdict">
        <div class="verdict" data-verdict data-status={first.status} role="status" aria-live="polite">
          <p class="verdict__label" data-verdict-label>{first.label}</p>
          <p class="verdict__reason" data-verdict-reason>{first.reason}</p>
          <div class="verdict__aside" data-verdict-aside hidden>
            <p class="verdict__aside-title">Not in the material</p>
            <ul class="verdict__claims" data-verdict-claims></ul>
            <p class="verdict__aside-note">
              A word match, so it misses paraphrases and it can be fooled. A place to start, not a
              verdict.
            </p>
          </div>
        </div>
        <ul class="checks" data-checks>
          {first.checks.map((check) => (
            <li class="checks__row" data-pass={check.pass ? 'true' : 'false'}>
              <span class="checks__mark" aria-hidden="true"></span>
              <span class="checks__name">{check.name}</span>
            </li>
          ))}
        </ul>
        </aside>
    </div>

    {/* --------------------------------------- the no-JS reading ---- */}
    <div class="desk desk--static" data-lab-static>
      <div class="desk__side">
        <div class="panel panel--material">
          <div class="panel__head">
            <h2 class="panel__title">The material</h2>
          </div>
          <ul class="material">
            {
              materials.map((item) => (
                <li class="material__item">
                  <span class="material__label">
                    {item.label}
                    <span class="material__id">{item.id}</span>
                  </span>
                  <span class="material__text">{item.content}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="desk__main">
        <div class="panel panel--compose">
          <p class="compose__label">A sentence that cites both sides</p>
          <blockquote class="static-quote">“{honest.text}”</blockquote>
          <p class="static-cites">Cites requirement-2 and evidence-1.</p>
          <p class="static-note">
            The bench needs JavaScript. Everything below reads without it.
          </p>
        </div>
      </div>
      <aside class="desk__verdict">
        <div class="verdict">
          <p class="verdict__label">{first.label}</p>
          <p class="verdict__reason">{first.reason}</p>
        </div>
      </aside>
    </div>

    {/* ----------------------------------------------- the checks ---- */}
    <section class="lab-block" id="lab-checks" aria-labelledby="lab-checks-title">
      <h2 class="lab-block__title" id="lab-checks-title">What the check looks at</h2>
      <p class="lab-block__lead">
        Four things, in order. The contract in the product refuses two more before any of this runs:
        a reply that isn’t JSON, and a reply that isn’t a rewrite.
      </p>
      <ol class="rules">
        <li class="rule">
          <span class="rule__name">Cites something</span>
          <span class="rule__note">A proposal with no source ids cites nothing, so it stops there.</span>
        </li>
        <li class="rule">
          <span class="rule__name">Only ids it was given</span>
          <span class="rule__note">Every id has to be one the request actually supplied. No invented ids.</span>
        </li>
        <li class="rule">
          <span class="rule__name">A requirement and evidence</span>
          <span class="rule__note">At least one requirement-* and one evidence-* id, or the claim has no footing.</span>
        </li>
        <li class="rule">
          <span class="rule__name">Then a person</span>
          <span class="rule__note">What passes is a proposal for review. Not a verified claim, and not an applied edit.</span>
        </li>
      </ol>
      <p class="lab-block__fine">
        Request limits: {LIMITS.contextItemMax} items, {LIMITS.contextItemContentMax.toLocaleString('en-GB')}{' '}
        characters each, {LIMITS.contextTotalMax.toLocaleString('en-GB')} in total.
      </p>
    </section>

    {/* ------------------------------------------------ the story ---- */}
    <section class="lab-block lab-block--story" id="lab-story" aria-labelledby="lab-story-title">
      <div>
        <h2 class="lab-block__title" id="lab-story-title">What actually happened</h2>
        <p class="lab-story__body">
          My CV assistant wrote fluent bullets. Some invented employers, years and percentages that
          were nowhere in the data it had been given.
        </p>
        <p class="lab-story__body">
          A better prompt wasn’t the fix. The request now carries the material explicitly, and the
          reply has to point at the ids it used before a person ever sees it.
        </p>
        <p class="lab-story__body">
          That revision is in the source. It isn’t redeployed yet, and I haven’t measured whether the
          live model behaves better. <a href="/work/syncareer/">The Syncareer case study</a> has the rest.
        </p>
      </div>
      <div class="compare">
        <div class="compare__col compare__col--before">
          <p class="compare__label">Before</p>
          <p class="compare__text">“{beforeText}”</p>
          <p class="compare__note">Free text. Nothing to check.</p>
        </div>
        <div class="compare__col compare__col--after">
          <p class="compare__label">After</p>
          <p class="compare__text">“{afterText}”</p>
          <p class="compare__note">Cites what it used, and a person still reads it.</p>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------ limits ------- */}
    <section class="lab-block" id="lab-limits" aria-labelledby="lab-limits-title">
      <h2 class="lab-block__title" id="lab-limits-title">What this can’t tell you</h2>
      <p class="lab-block__lead">
        Whether the sentence is true. These checks read structure and citations, not meaning, so a
        line can cite everything and still be wrong — which is why a person still reads it.
      </p>
      <p class="lab-block__lead">
        The checker here is a small subset of the product’s validator, written for this page. Both
        fixtures are mine, not captured output.
      </p>
    </section>

    {/* ------------------------------------------------ code --------- */}
    <details class="lab-code" id="lab-code">
      <summary>The contract this imitates</summary>
      <pre tabindex="0"><code>{gateCode}</code></pre>
      <p class="lab-code__note">
        Excerpt from <code>career-guidance/contract.ts</code>. The gate in this page is a subset of it.
      </p>
    </details>
  </div>
</section>

<script>
  import { PRESETS, evaluateReply } from '../scripts/labScenario.mjs';

  const root = document.querySelector<HTMLElement>('[data-lab-live]');
  const staticPanel = document.querySelector<HTMLElement>('[data-lab-static]');

  if (root) {
    const text = root.querySelector<HTMLTextAreaElement>('[data-lab-text]');
    const note = root.querySelector<HTMLElement>('[data-preset-note]');
    const verdict = root.querySelector<HTMLElement>('[data-verdict]');
    const label = root.querySelector<HTMLElement>('[data-verdict-label]');
    const reason = root.querySelector<HTMLElement>('[data-verdict-reason]');
    const aside = root.querySelector<HTMLElement>('[data-verdict-aside]');
    const claims = root.querySelector<HTMLElement>('[data-verdict-claims]');
    const cites = [...root.querySelectorAll<HTMLButtonElement>('[data-cite]')];
    const presets = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];

    const citedIds = () =>
      cites.filter((chip) => chip.getAttribute('aria-pressed') === 'true').map((chip) => chip.dataset.cite ?? '');

    const checkList = root.querySelector<HTMLElement>('[data-checks]');

    const render = (state: ReturnType<typeof evaluateReply>) => {
      if (!verdict || !label || !reason) return;
      verdict.dataset.status = state.status;
      label.textContent = state.label;
      reason.textContent = state.reason;

      if (checkList) {
        const rows = [...checkList.querySelectorAll<HTMLElement>('.checks__row')];
        state.checks.forEach((check, index) => {
          const row = rows[index];
          if (!row) return;
          row.dataset.pass = check.pass ? 'true' : 'false';
        });
      }

      if (aside && claims) {
        const flagged = state.unbacked;
        aside.hidden = flagged.length === 0;
        claims.replaceChildren(
          ...flagged.map((claim) => {
            const li = document.createElement('li');
            li.textContent = claim.phrase;
            return li;
          }),
        );
      }
    };

    let timer: number | undefined;
    const read = () => render(evaluateReply({ text: text?.value ?? '', citedIds: citedIds() }));
    const readSoon = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(read, 120);
    };

    text?.addEventListener('input', readSoon);

    for (const chip of cites) {
      chip.addEventListener('click', () => {
        chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        read();
      });
    }

    const applyPreset = (id: string, { fromHash = false } = {}) => {
      const preset = PRESETS.find((item) => item.id === id);
      if (!preset || !text) return;
      text.value = preset.text;
      for (const chip of cites) {
        chip.setAttribute('aria-pressed', preset.citedIds.includes(chip.dataset.cite ?? '') ? 'true' : 'false');
      }
      if (note) note.textContent = preset.note;
      if (select) select.value = preset.id;
      read();
      /* A preset addresses the bench the way a link would, so the URL can be
         shared and the back button walks back through the examples. */
      if (!fromHash && location.hash !== `#lab-${preset.id}`) {
        history.pushState(null, '', `#lab-${preset.id}`);
      }
    };

    for (const button of presets) {
      button.addEventListener('click', () => applyPreset(button.dataset.preset ?? ''));
    }

    const select = root.querySelector<HTMLSelectElement>('[data-preset-select]');
    select?.addEventListener('change', () => applyPreset(select.value));

    const fromHash = () => {
      const id = location.hash.replace('#lab-', '');
      if (!location.hash.startsWith('#lab-') || !PRESETS.some((preset) => preset.id === id)) return false;
      applyPreset(id, { fromHash: true });
      return true;
    };

    window.addEventListener('hashchange', fromHash);
    window.addEventListener('popstate', fromHash);

    /* Show the bench, drop the server-rendered example, then honour a link. */
    staticPanel?.setAttribute('hidden', '');
    root.removeAttribute('hidden');
    if (!fromHash()) read();
  }
</script>

<style>
  /* ------------------------------------------------------------------
     A bench, not a terminal. The dark register says "machine", but the
     reading order is the same as every other page: what the material is,
     what you write, what the check decided. Mono is for ids only.
     ------------------------------------------------------------------ */
  .lab {
    padding-block: clamp(1.75rem, 3vw, 3rem) clamp(3rem, 6vw, 6rem);
  }
  .lab__shell {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .lab__head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }
  .lab__title {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: var(--leading-display);
    letter-spacing: -0.04em;
    margin-top: 0.5rem;
    text-wrap: balance;
    max-width: 26ch;
  }
  .lab__title em {
    font-style: normal;
    color: var(--color-teal-bright);
  }
  .lab__lead {
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.6;
    max-width: 44ch;
  }
  .lab__lead--static {
    display: none;
  }
  /* Without JavaScript nobody can write in the field, so the invitation is
     swapped for a description of the worked example that is there. */
  :global(html:not(.js)) .lab__lead {
    display: none;
  }
  :global(html:not(.js)) .lab__lead--static {
    display: block;
  }
  .lab__fine {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-on-canvas-muted);
    max-width: 44ch;
  }

  /* ---- the desk --------------------------------------------------- */
  .desk {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.1fr) minmax(0, 0.88fr);
    grid-template-areas:
      'material compose verdict'
      'material cites   verdict';
    grid-template-rows: auto 1fr;
    gap: clamp(0.6rem, 1.2vw, 1rem) clamp(0.9rem, 1.6vw, 1.5rem);
    align-items: start;
  }
  .desk__side {
    grid-area: material;
  }
  .desk__main {
    grid-area: compose;
  }
  .desk__cites {
    grid-area: cites;
    align-self: stretch;
  }
  .desk__verdict {
    grid-area: verdict;
  }
  .panel--cites {
    padding-block: clamp(0.7rem, 1.4vw, 0.95rem);
  }
  /* The reading sits in its own column, level with the sentence being
     written rather than stacked under it. Write on the left, verdict on the
     right: the eye travels one way only. */
  .desk__verdict {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck-soft);
    align-content: start;
  }
  .checks {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--color-rule-on-canvas-soft);
    display: grid;
    gap: 0.4rem;
  }
  .checks__row {
    display: grid;
    grid-template-columns: 0.9rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-on-canvas-muted);
  }
  .checks__mark {
    position: relative;
    top: 0.28rem;
    width: 0.6rem;
    height: 0.6rem;
    border: 1px solid var(--color-rule-on-canvas-strong);
  }
  .checks__row[data-pass='true'] .checks__mark {
