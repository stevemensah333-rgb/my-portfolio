<script>
  import { createReview, reviewAction } from '../scripts/labScenario.mjs';

  type ReviewStatus = 'awaiting_review' | 'blocked' | 'accepted' | 'edited' | 'rejected';

  type ReviewState = {
    gateOk: boolean;
    reason: string | null;
    status: ReviewStatus;
    text: string;
    draft: string | null;
    saved: string | null;
    message: string;
  };

  type ReviewAction = 'accept' | 'edit' | 'reject' | 'undo';

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-scenario]');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const stages = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
    const railLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')];
    const runButton = root.querySelector<HTMLButtonElement>('[data-run]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let timer: ReturnType<typeof setTimeout> | undefined;
    let index = -1;

    const setRail = (target: string | null) => {
      railLinks.forEach((link) => {
        if (target && link.dataset.railLink === target) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
    };

    const clearStageStates = () => {
      stages.forEach((stage) => {
        delete stage.dataset.reached;
        delete stage.dataset.current;
      });
    };

    const finish = () => {
      root.dataset.walk = 'done';
      if (runButton) {
        runButton.disabled = false;
        runButton.textContent = 'Replay the scenario ↺';
      }
      setRail(stages[stages.length - 1]?.dataset.stage ?? null);
    };

    const advance = () => {
      index += 1;
      if (index >= stages.length) {
        finish();
        if (status) {
          status.textContent =
            'Complete. Five steps, one person. Nothing was called, fetched or saved — replaying changes nothing.';
        }
        return;
      }
      const stage = stages[index];
      if (!stage) return;
      stage.dataset.reached = 'true';
      stages.forEach((item, itemIndex) => {
        if (itemIndex === index) item.dataset.current = 'true';
        else delete item.dataset.current;
      });
      setRail(stage.dataset.stage ?? null);
      if (status) status.textContent = stage.dataset.announce ?? stage.id;
      timer = setTimeout(advance, 900);
    };

    const run = () => {
      if (!runButton) return;
      clearTimeout(timer);
      clearStageStates();
      runButton.disabled = true;
      runButton.textContent = 'Running…';

      if (motion.matches) {
        stages.forEach((stage) => {
          stage.dataset.reached = 'true';
        });
        index = stages.length;
        finish();
        if (status) {
          status.textContent =
            'Complete — motion reduced, so all five steps are shown at once. The results are unchanged.';
        }
        return;
      }

      root.dataset.walk = 'walking';
      index = -1;
      advance();
    };

    if (runButton) {
      runButton.hidden = false;
      runButton.addEventListener('click', run);
    }

    /* Stage selection. The rail is a set of real links, so it works with the
       keyboard and without JavaScript; this only marks the current reading. */
    const selectStage = (id: string) => {
      setRail(id);
    };

    root.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>('[data-rail-link]');
      if (!link) return;
      selectStage(link.dataset.railLink ?? '');
    });

    const hashTarget = () => {
      const id = location.hash.slice(1);
      if (!id) return;
      if (!root.querySelector(`#${CSS.escape(id)}`)) return;
      selectStage(id);
    };
    hashTarget();
    window.addEventListener('hashchange', hashTarget);

    /* Keyboard: R runs, 1–5 jump, C opens the comparison. Ignored whenever a
       form control or a modifier is involved, so typing is never hijacked. */
    const keys = (event: KeyboardEvent) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (target && target.closest('input, textarea, select, [contenteditable]')) return;
      if (target?.isContentEditable) return;

      const key = event.key.toLowerCase();
      if (key === 'r') {
        event.preventDefault();
        run();
        return;
      }
      if (key === 'c') {
        event.preventDefault();
        location.hash = '#lab-compare';
        selectStage('lab-compare');
        return;
      }
      if (/^[1-5]$/.test(key)) {
        const stage = stages[Number(key) - 1];
        if (!stage) return;
        event.preventDefault();
        stage.scrollIntoView({ behavior: motion.matches ? 'auto' : 'smooth', block: 'start' });
        selectStage(stage.dataset.stage ?? '');
        stage.focus?.({ preventScroll: true });
      }
    };

    const cleanup = () => {
      clearTimeout(timer);
      document.removeEventListener('keydown', keys);
      window.removeEventListener('hashchange', hashTarget);
    };
    const previousCleanup = (window as unknown as Record<string, unknown>).__labCleanup;
    if (typeof previousCleanup === 'function') (previousCleanup as () => void)();
    (window as unknown as Record<string, unknown>).__labCleanup = cleanup;

    document.addEventListener('keydown', keys);
    document.addEventListener('astro:before-swap', cleanup);

    /* ---- the review surface --------------------------------------- */
    const reviewRoot = root.querySelector<HTMLElement>('[data-review]');
    const staticPanel = root.querySelector<HTMLElement>('[data-review-static]');
    if (reviewRoot) {
      reviewRoot.hidden = false;
      if (staticPanel) staticPanel.hidden = true;

      const sources = [...reviewRoot.querySelectorAll<HTMLInputElement>('[data-review-source]')];
      const textarea = reviewRoot.querySelector<HTMLTextAreaElement>('[data-review-text]');
      const message = reviewRoot.querySelector<HTMLElement>('[data-review-message]');
      const stateEl = reviewRoot.querySelector<HTMLElement>('[data-review-state]');
      const draftEl = reviewRoot.querySelector<HTMLElement>('[data-review-draft]');
      const savedEl = reviewRoot.querySelector<HTMLElement>('[data-review-saved]');
      const buttons = [...reviewRoot.querySelectorAll<HTMLButtonElement>('[data-review-action]')];

      let review: ReviewState | null = null;

      const sourceOf = (): ReviewState | null => {
        const radio = sources.find((item) => item.checked);
        if (!radio) return null;
        return createReview(
          { ok: radio.dataset.gateOk === 'true', reason: radio.dataset.gateReason ?? '' },
          radio.dataset.text ?? '',
        ) as ReviewState;
      };

      const render = () => {
        const current = review;
        if (!current) return;
        if (stateEl) stateEl.textContent = current.status.replace('_', ' ');
        if (draftEl) draftEl.textContent = current.draft ?? '—';
        if (savedEl) savedEl.textContent = current.saved ? 'Saved' : 'Unchanged';
        if (message) message.textContent = current.message;
        if (textarea) {
          textarea.disabled = !current.gateOk;
          if (current.draft !== null) textarea.value = current.draft;
        }
        const awaiting = current.status === 'awaiting_review';
        const canUndo = current.status === 'accepted' || current.status === 'edited';
        buttons.forEach((button) => {
          const action = button.dataset.reviewAction;
          if (action === 'undo') button.disabled = !canUndo;
          else button.disabled = !current.gateOk || !awaiting;
        });
      };

      const reset = () => {
        review = sourceOf();
        if (textarea && review) textarea.value = review.text;
        render();
      };

      sources.forEach((radio) => radio.addEventListener('change', reset));

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.dataset.reviewAction as ReviewAction | undefined;
          const current = review;
          if (!current || !action) return;
          const payload = { text: textarea?.value ?? current.text };
          review = reviewAction(current, action, action === 'accept' || action === 'edit' ? payload : {}) as ReviewState;
          render();
        });
      });

      reset();
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

