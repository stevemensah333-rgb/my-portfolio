    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-rule-on-canvas-strong);
    background: var(--color-deck-inset);
    color: var(--color-text-on-canvas);
    font: inherit;
    font-size: 0.9rem;
  }
  .presets__note {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-on-canvas-muted);
  }

  .cites {
    border: 0;
    padding: 0;
    margin: 0.15rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .cites__legend {
    font-family: var(--font-instrument);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-on-canvas-faint);
