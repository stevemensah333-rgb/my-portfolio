    color: var(--color-text-on-canvas);
  }

  /* ---- composing -------------------------------------------------- */
  .compose {
    display: grid;
    gap: 0.85rem;
  }
  .compose__label {
    font-family: var(--font-instrument);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-on-canvas-faint);
