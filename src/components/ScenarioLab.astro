  /* The reply is injected with set:html, so these marks carry no Astro scope
     attribute and have to be targeted globally. */
  .reply :global(mark) {
    background: transparent;
    color: inherit;
  }
  .reply :global(mark.claim--unsupported) {
    color: var(--color-signal-fail-text, #f1a7a6);
    text-decoration: underline wavy;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
