---
/**
 * ScenarioLab — /lab/, rebuilt around one scenario a reader can follow.
 *
 * One CV bullet, five steps: the context a revised request carries, an answer
 * that context cannot support, the gate that refuses it, a cited proposal that
 * passes the gate, and the person who still decides. Then the two contract
 * branches side by side, and the code behind both.
 *
 * The reading is computed once, on the server, by `runScenario` in
 * src/scripts/labScenario.mjs. That module is pure and deterministic, is
 * asserted by `npm test`, and is the only place the checks live — the browser
 * replays the same reading instead of re-deciding anything. No model is
 * called, no network request is made, and every fixture is labelled where it
 * appears.
 *
 * The fixture texts come from syncareerInvestigation.ts, which stays the
 * single copy on the site.
 */
import { syncareer } from '../data/registry';
import {
  evidenceBoundary,
  failureRecord,
  interventionRecord,
  investigationStages,
  type InvestigationArtifact,
} from '../data/syncareerInvestigation';
import { GATE_RULES, LIMITS, runScenario } from '../scripts/labScenario.mjs';

type CodeArtifact = Extract<InvestigationArtifact, { kind: 'code' }>;
type RefusalArtifact = Extract<InvestigationArtifact, { kind: 'refusal' }>;

const codeOf = (id: string): CodeArtifact | null => {
  const stage = investigationStages.find((item) => item.id === id);
  return stage && stage.artifact && stage.artifact.kind === 'code' ? stage.artifact : null;
};

const refusalOf = (id: string): RefusalArtifact | null => {
  const stage = investigationStages.find((item) => item.id === id);
  return stage && stage.artifact && stage.artifact.kind === 'refusal' ? stage.artifact : null;
};

const oldArtifact = codeOf('model-output');
const revisedArtifact = codeOf('output');
const contractArtifact = codeOf('input');
const handlerArtifact = codeOf('intervention');
const refusalArtifact = refusalOf('failure');

const scenario = runScenario({
  oldText: oldArtifact?.code ?? '',
  revisedText: revisedArtifact?.code ?? '',
});

const oldClaims = scenario.oldClaims;
const revisedClaims = scenario.revisedClaims;
const unsupportedCount = oldClaims.filter((claim) => !claim.grounded).length;
const groundedCount = revisedClaims.filter((claim) => claim.grounded).length;

const escapeHtml = (value: string) =>
  value.replace(
    /[&<>"']/g,
    (character) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character,
  );

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

/** The stored fixtures hard-wrap their prose; a quote reads as one paragraph. */
const asParagraph = (text: string) => text.replace(/\s*\n\s*/g, ' ').trim();

/** One pass, so a marked phrase is never marked again inside itself. */
const markClaims = (text: string, claims: { phrase: string }[], className: string) => {
  const phrases = [...new Set(claims.map((claim) => claim.phrase))]
    .filter(Boolean)
    .sort((a, b) => b.length - a.length);
  const html = escapeHtml(asParagraph(text));
  if (!phrases.length) return html;
  const pattern = new RegExp(phrases.map(escapeRegExp).join('|'), 'gi');
  return html.replace(pattern, (match) => `<mark class="${className}">${match}</mark>`);
};

const oldReplyHtml = markClaims(scenario.oldText, oldClaims, 'claim claim--unsupported');
const revisedReplyHtml = markClaims(scenario.revisedReplyText, revisedClaims, 'claim claim--grounded');

const contextById = new Map(scenario.context.map((item) => [item.id, item]));

const stageMeta = [
  {
    id: 'lab-input',
    step: '01',
    label: 'Supplied context',
    state: 'Preflight passed',
    verdict: 'neutral',
    announce: `Step 01, supplied context: ${scenario.context.length} allowlisted items. The request would stop here if the opportunity, a requirement or the evidence record were missing.`,
  },
  {
    id: 'lab-model-output',
    step: '02',
    label: 'Unsupported answer',
    state: `${unsupportedCount} claims, none in context`,
    verdict: 'fail',
    announce: `Step 02, unsupported answer: ${unsupportedCount} claims in the fixture appear nowhere in the supplied context.`,
  },
  {
    id: 'lab-failure',
    step: '03',
    label: 'The gate refuses',
    state: `${scenario.variants.length} refusals, each named`,
    verdict: 'fail',
    announce: `Step 03, the gate: ${scenario.variants.length} variants refused. The old prose stops at ${scenario.oldGate.reason}. Nothing is applied and the reservation is released.`,
  },
  {
    id: 'lab-revised',
    step: '04',
    label: 'Cited proposal',
    state: `Gate passes · ${scenario.revisedGate.reason}`,
    verdict: 'pass',
    announce: `Step 04, cited proposal: the gate passes shape and citations, ${groundedCount} of ${revisedClaims.length} claims trace to supplied context. A person still has to review it.`,
  },
  {
    id: 'lab-review',
    step: '05',
    label: 'Human review',
    state: 'A person decides',
    verdict: 'neutral',
    announce:
      'Step 05, human review: accept, edit, reject or undo. Nothing is written to a saved CV by this page.',
  },
];

const branchA = [
  { name: 'Request', value: interventionRecord.comparison.items[0]?.before ?? '' },
  { name: 'Response', value: interventionRecord.comparison.items[1]?.before ?? '' },
  { name: 'Trust', value: interventionRecord.comparison.items[2]?.before ?? '' },
  { name: 'Gate', value: `${scenario.oldGate.reason} — the reply is prose, so there is nothing to check.` },
  { name: 'Outcome', value: '422 no_safe_proposal. Reservation released. Nothing applied, nothing shown as a result.' },
];

const branchB = [
  { name: 'Request', value: interventionRecord.comparison.items[0]?.after ?? '' },
  { name: 'Response', value: interventionRecord.comparison.items[1]?.after ?? '' },
  { name: 'Trust', value: interventionRecord.comparison.items[2]?.after ?? '' },
  { name: 'Gate', value: `${scenario.revisedGate.reason} — shape and citations pass these local checks.` },
  { name: 'Outcome', value: 'Shown to a person as a proposal. Accept, edit, reject or undo; nothing saved automatically.' },
];
---

<section
  id="reliability-lab"
  class="lab"
  data-scenario
  data-walk="off"
  data-workspace-section="reliability-lab"
  aria-labelledby="lab-title"
>
  <div class="page-shell lab__shell">
    <!-- ---------------------------------------------------------------- -->
    <!-- Title                                                            -->
    <!-- ---------------------------------------------------------------- -->
    <header class="lab__head">
      <div class="lab__head-main">
        <p class="eyebrow">03 / Reliability Lab · local demonstration</p>
        <h1 id="lab-title" class="lab__title">
          The rewrite looked right. <em>Then somebody checked it.</em>
        </h1>
      </div>
      <div class="lab__head-side">
        <p class="lead lab__lead">
          One CV bullet, followed through five steps: the context a request carries, an answer that
          context cannot support, the gate that refuses it, a cited proposal that passes, and the
          person who still decides.
        </p>
        <p class="lab__boundary">
          No model is called and no network request is made. The replies are authored fixtures,
          labelled where they appear. The checks are deterministic code, tested, and printed in the
          inspector at the bottom of this page. There is no captured incident and no measured result
          here.
        </p>
      </div>
    </header>

    <div class="console">
      <!-- -------------------------------------------------------------- -->
      <!-- Runner: rail + controls                                        -->
      <!-- -------------------------------------------------------------- -->
      <nav class="rail" aria-label="Scenario steps" data-rail>
      <ol class="rail__list">
        {stageMeta.map((stage) => (
          <li>
            <a
              class="rail__item"
              href={`#${stage.id}`}
              data-rail-link={stage.id}
              aria-label={`Step ${stage.step} — ${stage.label}`}
            >
              <span class="rail__step" aria-hidden="true">{stage.step}</span>
              <span class="rail__label">{stage.label}</span>
            </a>
          </li>
        ))}
        <li>
          <a
            class="rail__item rail__item--compare"
            href="#lab-compare"
            data-rail-link="lab-compare"
            aria-label="Before and after comparison"
          >
            <span class="rail__step" aria-hidden="true">A/B</span>
            <span class="rail__label">Before / after</span>
          </a>
        </li>
      </ol>
    </nav>

    <div class="transport">
      <div class="transport__controls">
        <button type="button" class="lab-button lab-button--run" data-run hidden>
          Run the scenario <span aria-hidden="true">↗</span>
        </button>
        <p class="transport__keys" id="lab-keys">
          Keys: <kbd>R</kbd> run · <kbd>1</kbd>–<kbd>5</kbd> jump to a step · <kbd>C</kbd> comparison
        </p>
      </div>
      <p class="transport__status" role="status" aria-live="polite" aria-atomic="true" data-status>
        All five steps and their results are below. Running walks through them again; it does not
        change a single result.
      </p>
    </div>

    <!-- ---------------------------------------------------------------- -->
    <!-- The five steps                                                   -->
    <!-- ---------------------------------------------------------------- -->
    <div class="steps">
      {stageMeta.map((stage) => (
        <article
          class:list={['step', `step--${stage.verdict}`]}
          id={stage.id}
          data-stage={stage.id}
          data-verdict={stage.verdict}
          data-announce={stage.announce}
          tabindex="-1"
          aria-labelledby={`${stage.id}-title`}
        >
          <header class="step__head">
            <p class="step__index" aria-hidden="true">{stage.step}</p>
            <div class="step__heading">
              <h2 class="step__title" id={`${stage.id}-title`}>
                <span class="visually-hidden">Step {stage.step}: </span>
                <span data-step-label>{stage.label}</span>
              </h2>
            </div>
            <p class="step__state">{stage.state}</p>
            <span class="step__dot" aria-hidden="true"></span>
          </header>

          {/* ---- 01 · supplied context -------------------------------- */}
          {stage.id === 'lab-input' && (
            <div class="step__body">
              <div class="step__main">
                <figure class="plate">
                  <figcaption class="plate__label">
                    The request · {scenario.task} · version 2 · illustrative context
                  </figcaption>
                  <p class="plate__instruction">
                    <span class="plate__field">instruction</span>
                    <span>{scenario.instruction}</span>
                  </p>
                  <ul class="context">
                    {scenario.context.map((item) => (
                      <li class="context__row">
                        <span class="context__id">{item.id}</span>
                        <span class="context__prov">{item.provenance}</span>
                        <span class="context__content">{item.content}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="plate__note">
                    The server retrieves nothing on its own: no profile, no history, no CV beyond
                    these items.
                  </p>
                </figure>
              </div>
              <aside class="step__side">
                <p class="side__label">Preflight</p>
                <ul class="checks">
                  {scenario.requestChecks.map((check) => (
                    <li class="check" data-pass={check.pass ? 'true' : 'false'}>
                      <span class="check__mark" aria-hidden="true">{check.pass ? '✓' : '×'}</span>
                      <span class="check__body">
                        <span class="check__name">{check.name}</span>
                        <span class="check__note">{check.note}</span>
                      </span>
                      <span class="visually-hidden">{check.pass ? ' — passes' : ' — fails'}</span>
                    </li>
                  ))}
                </ul>
                <p class="side__note">
                  <strong>Branch note.</strong> Under the old contract only the selected bullet
                  crossed this boundary. Everything above is what the revised contract adds.
                </p>
                <p class="side__source">
                  Request shape and preflight from <code>contract.ts</code>. These values are an
                  illustrative fixture, not captured user data.
                </p>
              </aside>
            </div>
          )}

          {/* ---- 02 · unsupported answer ------------------------------ */}
          {stage.id === 'lab-model-output' && (
            <div class="step__body">
              <div class="step__main">
                <figure class="plate plate--fail">
                  <figcaption class="plate__label">
                    Illustrative reply · old-contract shape
                  </figcaption>
                  <blockquote class="reply" set:html={oldReplyHtml} />
                  <p class="plate__note">
                    Written from the bullet alone. The marked phrases are the claims this page can
                    match against the context above; nothing in that context mentions Kubernetes,
                    five years, Acme Corp or 40%.
                  </p>
                </figure>
              </div>
              <aside class="step__side">
                <p class="side__label">Claims against the supplied context</p>
                <ul class="claims">
                  {oldClaims.map((claim) => (
                    <li class="claim-row" data-grounded={claim.grounded ? 'true' : 'false'}>
                      <span class="claim-row__phrase">“{claim.phrase}”</span>
                      <span class="claim-row__verdict">
                        {claim.grounded ? `Found in ${claim.sourceId}` : 'Not in the supplied context'}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="side__note">
                  <strong>This is a word match, not fact-checking.</strong> A claim phrased
                  differently would read as unsupported, and a claim whose words do appear can still
                  be misused. The production checks are broader; see the inspector.
                </p>
                <p class="side__source">
                  ILLUSTRATIVE — fixture, not a captured output. Shaped after the failure classes in
                  <code>docs/AI_APPLICATION_GUIDANCE.md</code>.
                </p>
              </aside>
            </div>
          )}

          {/* ---- 03 · the gate refuses -------------------------------- */}
          {stage.id === 'lab-failure' && (
            <div class="step__body">
              <div class="step__main">
                <figure class="plate plate--fail">
                  <figcaption class="plate__label">
                    The same gate, {scenario.variants.length} times
                  </figcaption>
                  <ul class="refusals">
                    {scenario.variants.map((variant) => (
                      <li class="refusal" data-verdict={variant.verdict.ok ? 'pass' : 'fail'}>
                        <span class="refusal__mark" aria-hidden="true">
                          {variant.verdict.ok ? '✓' : '×'}
                        </span>
                        <span class="refusal__body">
                          <span class="refusal__label">{variant.label}</span>
                          <span class="refusal__note">{variant.note}</span>
                          <span class="refusal__reason">
                            <code>{variant.verdict.reason}</code> — {variant.verdict.message}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ul>
                  {refusalArtifact && (
                    <dl class="refusal-record">
                      {refusalArtifact.items.map((item) => (
                        <div>
                          <dt>{item.name}</dt>
                          <dd>{item.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </figure>
              </div>
              <aside class="step__side">
                <div id="lab-validation" class="anchor-target">
                  <p class="side__label">The rules, in the order they run</p>
                  <ol class="rules">
                    {GATE_RULES.map((rule) => (
                      <li class="rule">
                        <code class="rule__reason">{rule.reason}</code>
                        <span class="rule__name">{rule.name}</span>
                        <span class="rule__note">{rule.note}</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <p class="side__note">
                  <strong>Nothing was applied.</strong> A refusal releases the quota reservation,
                  and the review surface blocks accept until the text is edited or regenerated.
                </p>
                <p class="side__source">
                  Reason codes from <code>contract.ts</code> and <code>handler.ts</code>. The gate
                  that runs on this page is the local checker in the inspector — a subset of the
                  production validator, not a copy of it.
                </p>
              </aside>
            </div>
          )}

          {stage.id === 'lab-revised' && (
            <span id="lab-output" class="anchor-target" aria-hidden="true"></span>
          )}

          {/* ---- 04 · cited proposal ---------------------------------- */}
          {stage.id === 'lab-revised' && (
            <div class="step__body">
              <div class="step__main">
                <figure class="plate plate--pass">
                  <figcaption class="plate__label">
                    Illustrative reply · revised-contract shape
                  </figcaption>
                  <blockquote class="reply reply--pass" set:html={revisedReplyHtml} />
                  <ul class="citations" aria-label="Source ids cited by the proposal">
                    {scenario.revisedProposal?.sourceContextIds?.map((id: string) => (
                      <li class="citation">
                        <span class="citation__id">{id}</span>
                        <span class="citation__label">{contextById.get(id)?.label ?? 'unknown id'}</span>
                      </li>
                    ))}
                  </ul>
                  <details class="raw">
                    <summary>The fixture exactly as it is checked</summary>
                    <pre tabindex="0"><code>{scenario.revisedText}</code></pre>
                  </details>
                  <p class="plate__note">
                    The same gate that refused four replies accepts this one. Passing it means the
                    shape is legal and the citations exist — not that the sentence is true.
                  </p>
                </figure>
              </div>
              <aside class="step__side">
                <p class="side__label">Claims against the supplied context</p>
                <ul class="claims">
                  {revisedClaims.map((claim) => (
                    <li class="claim-row" data-grounded={claim.grounded ? 'true' : 'false'}>
                      <span class="claim-row__phrase">“{claim.phrase}”</span>
                      <span class="claim-row__verdict">
                        {claim.grounded ? `Found in ${claim.sourceId}` : 'Not in the supplied context'}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="side__note">
                  <strong>{groundedCount} of {revisedClaims.length} claims trace back.</strong> A
                  pass is permission to show a person a proposal, not a verdict on it.
                </p>
                <p class="side__source">
                  ILLUSTRATIVE — fixture in the revised shape, not a live sample. The shape comes
                  from <code>career-guidance</code>; the example follows the fixed comparison in
                  <code>docs/AI_APPLICATION_GUIDANCE.md</code>.
                </p>
              </aside>
            </div>
          )}

          {/* ---- 05 · human review ------------------------------------ */}
          {stage.id === 'lab-review' && (
            <div class="step__body">
              <div class="step__main">
                <div class="review" data-review hidden>
                  <fieldset class="review__source">
                    <legend class="side__label">Proposal under review</legend>
                    <label class="review__choice">
                      <input
                        type="radio"
                        name="review-source"
                        value="revised"
                        checked
                        data-review-source
                        data-gate-ok="true"
                        data-gate-reason={scenario.revisedGate.reason}
                        data-text={scenario.revisedProposal?.text ?? ''}
                      />
                      <span>Cited proposal · gate passed</span>
                    </label>
                    <label class="review__choice">
                      <input
                        type="radio"
                        name="review-source"
                        value="refused"
                        data-review-source
                        data-gate-ok="false"
                        data-gate-reason={scenario.oldGate.reason}
                        data-text=""
                      />
                      <span>Refused fixture · gate refused</span>
                    </label>
                  </fieldset>

                  <label class="review__text">
                    <span class="side__label">Draft text</span>
                    <textarea data-review-text rows="3" spellcheck="false">{scenario.revisedProposal?.text ?? ''}</textarea>
                  </label>

                  <div class="review__actions">
                    <button type="button" class="lab-button" data-review-action="accept">Accept</button>
                    <button type="button" class="lab-button" data-review-action="edit">Edit</button>
                    <button type="button" class="lab-button" data-review-action="reject">Reject</button>
                    <button type="button" class="lab-button lab-button--quiet" data-review-action="undo">
                      Undo
                    </button>
                  </div>

                  <dl class="review__state">
                    <div>
                      <dt>Status</dt>
                      <dd data-review-state>{scenario.reviews.revised.status}</dd>
                    </div>
                    <div>
                      <dt>Draft field</dt>
                      <dd data-review-draft>—</dd>
                    </div>
                    <div>
                      <dt>Saved CV</dt>
                      <dd data-review-saved>Unchanged</dd>
                    </div>
                  </dl>
                  <p class="review__message" role="status" aria-live="polite" data-review-message>
                    {scenario.reviews.revised.message}
                  </p>
                </div>

                <div class="review-static" data-review-static>
                  <p class="plate__label">The last gate is a person</p>
                  <ul class="review-list">
                    <li><strong>Accept</strong> moves the proposal into the draft field.</li>
                    <li><strong>Edit</strong> keeps the person’s wording instead.</li>
                    <li><strong>Reject</strong> leaves the draft untouched.</li>
                    <li><strong>Undo</strong> returns the draft to the proposal.</li>
                  </ul>
                  <p class="plate__note">
                    None of these writes to a saved CV here. With JavaScript off this stays a written
                    rule rather than a control.
                  </p>
                </div>
              </div>
              <aside class="step__side">
                <p class="side__label">Why a person is required</p>
                <ul class="checks">
                  <li class="check" data-pass="false">
                    <span class="check__mark" aria-hidden="true">×</span>
                    <span class="check__body">
                      <span class="check__name">Accept on a refused reply</span>
                      <span class="check__note">
                        Blocked. The product keeps the unsafe text visible with a warning and waits
                        for an edit or a regeneration.
                      </span>
                    </span>
                  </li>
                  <li class="check" data-pass="true">
                    <span class="check__mark" aria-hidden="true">✓</span>
                    <span class="check__body">
                      <span class="check__name">Accept on a cited proposal</span>
                      <span class="check__note">
                        Allowed — by the person reading it, not by the gate.
                      </span>
                    </span>
                  </li>
                </ul>
                <p class="side__note">
                  <strong>Nothing is saved automatically.</strong> Accept writes the draft only while
                  its current value still matches the original; the existing CV save persists it.
                </p>
                <p class="side__source">
                  Behaviour from the CV review flow in <code>career-guidance</code>. The control above
                  is a local model of it, not the product.
                </p>
              </aside>
            </div>
          )}
        </article>
        ))}
      </div>
    </div>

    <!-- ---------------------------------------------------------------- -->
    <!-- Before / after                                                   -->
    <!-- ---------------------------------------------------------------- -->
    <section class="compare" id="lab-compare" aria-labelledby="lab-compare-title">
      <header class="compare__head">
        <p class="eyebrow">A / B</p>
        <h2 id="lab-compare-title" class="compare__title">Two branches, kept apart.</h2>
        <p class="compare__note" id="lab-diagnosis">
          Same seam, two shapes. The difference is what the server can check. One path never leaves
          the request it was sent with; the other has something to test the reply against. Neither
          column below is a captured run.
        </p>
      </header>

      <div class="branches">
        <section class="branch branch--old" aria-labelledby="branch-old-title" data-branch="old">
          <h3 id="branch-old-title" class="branch__title">
            <span class="branch__tag">A</span> Old contract
          </h3>
          <p class="branch__sub">The branch that produced the fluent lie.</p>
          <dl class="branch__rows">
            {branchA.map((row) => (
              <div class="branch__row">
                <dt>{row.name}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="branch branch--new" aria-labelledby="branch-new-title" data-branch="new">
          <h3 id="branch-new-title" class="branch__title">
            <span class="branch__tag">B</span> Revised contract
          </h3>
          <p class="branch__sub">The branch that gives the server something to check.</p>
          <dl class="branch__rows">
            {branchB.map((row) => (
              <div class="branch__row">
                <dt>{row.name}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>

      <p class="compare__numbers">
        <strong>On numbers.</strong> {evidenceBoundary.numbers.body}
      </p>
    </section>

    <!-- ---------------------------------------------------------------- -->
    <!-- Inspector                                                        -->
    <!-- ---------------------------------------------------------------- -->
    <section class="inspector" id="lab-code" aria-labelledby="lab-code-title">
      <details class="inspector__details">
        <summary class="inspector__summary" aria-labelledby="lab-code-title">
          <span
            id="source-inspection"
            class="anchor-target anchor-target--abs"
            aria-hidden="true"></span>
          <span class="inspector__summary-main">
            <span class="eyebrow">Secondary reading</span>
            <span id="lab-code-title" class="inspector__title">Code inspector</span>
          </span>
          <span class="inspector__summary-side">
            The rules that run here, the contract they mirror, and the handler order around them ↓
          </span>
        </summary>

        <div class="inspector__body">
          <figure class="plate inspector__figure">
            <figcaption class="plate__label">
              This page’s gate · <code>src/scripts/labScenario.mjs</code>
            </figcaption>
            <ol class="rules rules--wide">
              {GATE_RULES.map((rule) => (
                <li class="rule">
                  <code class="rule__reason">{rule.reason}</code>
                  <span class="rule__name">{rule.name}</span>
                  <span class="rule__note">{rule.note}</span>
                </li>
              ))}
            </ol>
            <p class="plate__note">
