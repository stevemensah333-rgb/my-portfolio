---
/**
 * NotVerified — one block, one home, for everything a project cannot prove.
 *
 * Every case study has hedges. Scattered through six sections they read as
 * apologising; gathered into one block at the end of the evidence they read
 * as a boundary. This is that block: a lead sentence, the list, and an
 * optional closing note for the one thing that could be misread.
 *
 * Rendered from data on each page. Nothing here is generated prose.
 */
interface Props {
  lead: string;
  items: readonly string[];
  closing?: string;
}

const { lead, items, closing } = Astro.props;
---

<div class="not-verified">
  <p class="not-verified__label">Not verified</p>
  <p class="not-verified__lead">{lead}</p>
  <ul class="not-verified__list">
    {items.map((item) => <li>{item}</li>)}
  </ul>
  {closing && <p class="not-verified__closing">{closing}</p>}
</div>

<style>
  .not-verified {
    border-top: 2px solid var(--color-rule-strong);
    border-left: 3px solid var(--color-teal);
    background: var(--color-sheet-soft);
    padding: clamp(1.1rem, 2.4vw, 1.6rem) clamp(1.1rem, 2.6vw, 1.9rem);
  }
  .not-verified__label {
    font-family: var(--font-instrument);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-copper-text);
    margin-bottom: 0.6rem;
  }
  .not-verified__lead {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    max-width: 44ch;
  }
  .not-verified__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    max-width: 62ch;
  }
  .not-verified__list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  /* A dash, not a cross: these are things the record does not claim, not
     things it got wrong. */
  .not-verified__list li::before {
    content: "—";
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-instrument);
    font-size: 0.8rem;
    color: var(--color-signal-fail);
  }
  .not-verified__closing {
    margin-top: 1.5rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--color-rule-on-paper-strong);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 62ch;
  }
</style>
