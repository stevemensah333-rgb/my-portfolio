---
/**
 * BookingFlow — SessionBook's one inspector.
 *
 * There used to be three ways to look at the same booking: a stage
 * walker with Previous/Next buttons, a second accordion of the same
 * stages, and a question list. This is the single one.
 *
 * Five steps of the path a call actually takes, each openable for the
 * implementation detail. The two engineering stages that used to sit in
 * the middle of the walk (diagnosis, intervention) are decisions, not
 * stops on the path, so they live in 05 Key decisions.
 *
 * The block carries `view-transition-name: artifact-sessionbook`, the name
 * the homepage ticket uses, so the homepage → case-study move is the same
 * shared-element transition as the other two projects.
 *
 * The steps read from the canonical stage record in the registry; this
 * component adds no facts of its own. Every step keeps its old anchor,
 * including the panel ids the earlier layout used.
 */
import { sessionbook } from '../../data/registry';

/** The path, in the order a call meets it. */
const path = ['input', 'model-output', 'validation', 'failure', 'output'] as const;

/** Anchors from the previous layouts that must keep landing somewhere. */
const aliases: Record<string, string[]> = {
  input: ['trace-panel-input', 'arch-panel-caller', 'arch-panel-voice-agent', 'arch-panel-http-tool-call', 'arch-panel-backend', 'walk-panel-tool', 'walk-panel-request'],
  'model-output': ['trace-panel-model-output', 'arch-panel-booking-logic'],
  validation: ['trace-panel-validation'],
  failure: ['trace-panel-failure'],
  output: ['trace-panel-output', 'arch-panel-response', 'arch-panel-voice-agent-return', 'arch-panel-spoken-response', 'walk-panel-response'],
};

/** The chain a call follows, and where the backend takes over. */
const nodes = [
  { label: 'Caller', inBackend: false },
  { label: 'voice agent', inBackend: false },
  { label: 'HTTP tool', inBackend: true },
  { label: 'FastAPI service', inBackend: true },
  { label: 'booking decision', inBackend: true },
  { label: 'spoken reply', inBackend: false },
] as const;

const stages = path
  .map((id) => (sessionbook.stages ?? []).find((stage) => stage.id === id))
  .filter((stage): stage is NonNullable<typeof stage> => Boolean(stage));
---

<div class="flow" style="view-transition-name: artifact-sessionbook">
  <div class="case-sim">
    <span class="case-sim__label">Simulation</span>
    <span>A walk through the path written in source. Nothing is sent.</span>
  </div>

  <div class="flow__diagram">
    <p class="flow__path">
      {nodes.map((node, index) => (
        <>
          {index > 0 && <span class="flow__arrow" aria-hidden="true">→</span>}
          <span class:list={['flow__node', node.inBackend && 'flow__node--backend']}>{node.label}</span>
        </>
      ))}
    </p>
    <p class="flow__legend">
      <span class="flow__legend-key" aria-hidden="true" />
      Tinted steps run in the backend.
    </p>
  </div>

  <ol class="flow__steps">
    {
      stages.map((stage, index) => (
        <li class="flow__step" id={`flow-${stage.id}`}>
          {aliases[stage.id]?.map((alias) => <span id={alias} aria-hidden="true"></span>)}
          <details class="flow__item">
            <summary>
              <span class="flow__n">{String(index + 1).padStart(2, '0')}</span>
              <span class="flow__label">{stage.label}</span>
              <span class="flow__text">
                <strong>{stage.title}</strong>
                <span class="flow__summary">{stage.summary}</span>
              </span>
              <span class="flow__plus" aria-hidden="true" />
            </summary>
            <div class="flow__body">
              <p>{stage.detail}</p>
              {stage.code && (
                <figure class="flow__code">
                  <figcaption>{stage.codeLabel ?? 'Implementation excerpt'}</figcaption>
                  <pre tabindex="0"><code>{stage.code}</code></pre>
                </figure>
              )}
              {stage.fixes && (
                <ul class="flow__fixes">
                  {stage.fixes.map((fix) => <li>{fix}</li>)}
                </ul>
              )}
              <p class="flow__source"><strong>Source.</strong> {stage.evidence}</p>
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</div>

<script>
  /* A hash into a step opens it. That is the only behaviour script adds
     here; the steps themselves are native disclosures. */
  const openStep = () => {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const target = document.getElementById(hash);
    /* The hash may address the step itself or one of its older panel
       anchors, which sit inside it. */
    const item = target?.closest('details') ?? target?.querySelector('details');
    if (item instanceof HTMLDetailsElement) item.open = true;
  };
  openStep();
  document.addEventListener('astro:page-load', openStep);
  window.addEventListener('hashchange', openStep);
</script>

<style>
  .flow {
    display: grid;
    gap: 1.1rem;
  }

  .flow__diagram {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 1.1rem;
    border-bottom: 2px solid var(--color-ink);
  }

  .flow__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0;
    /* the global prose cap does not apply to a diagram */
    max-width: none;
  }

  .flow__node {
    padding: 0.42rem 0.68rem;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-paper-raised);
    font-family: var(--font-instrument);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.3;
    white-space: nowrap;
  }

  /* The tint is the boundary: these are the steps the backend owns. */
  .flow__node--backend {
    border-color: var(--color-teal);
    background: var(--color-teal-tint);
    color: var(--color-teal);
  }

  .flow__arrow {
    font-family: var(--font-instrument);
    font-size: 0.8rem;
    color: var(--color-accent-text);
  }

  .flow__legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.74rem;
    color: var(--color-text-on-paper-muted);
  }
  .flow__legend-key {
    width: 14px;
    height: 10px;
    border: 1px solid var(--color-teal);
    background: var(--color-teal-tint);
  }

  .flow__steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .flow__step {
    border-bottom: 1px solid var(--color-rule);
  }
  /* The section already closes the list; a second rule would read as an
     accidental seam. */
  .flow__step:last-child {
    border-bottom: 0;
  }

  .flow__item > summary {
    display: grid;
    grid-template-columns: 2rem 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.95rem 0;
    cursor: pointer;
    list-style: none;
  }
  .flow__item > summary::-webkit-details-marker {
    display: none;
  }
  .flow__item > summary:focus-visible {
    outline: 3px solid var(--color-accent-text);
    outline-offset: 3px;
  }

  .flow__n {
    font-family: var(--font-instrument);
    font-size: 0.72rem;
    color: var(--color-accent-text);
  }

  .flow__label {
    font-family: var(--font-instrument);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-on-paper-faint);
  }

  .flow__text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .flow__text strong {
    font-size: 1rem;
    font-weight: 500;
  }
  .flow__summary {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-on-paper-muted);
  }

  .flow__plus {
    font-family: var(--font-instrument);
    font-size: 1rem;
    color: var(--color-accent-text);
  }
  .flow__plus::before {
    content: '+';
  }
  .flow__item[open] .flow__plus::before {
    content: '−';
  }

  /* The detail aligns with the step's title column, not with its number. */
  .flow__body {
    display: grid;
    gap: 1rem;
    padding: 0 0 1.4rem 10.5rem;
    max-width: 74rem;
  }
  .flow__body p {
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .flow__code {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--color-rule);
    background: var(--color-sheet-soft);
  }
  .flow__code figcaption {
    font-family: var(--font-instrument);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .flow__code pre {
    margin-top: 0.6rem;
    font-size: 0.76rem;
  }

  .flow__fixes {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .flow__source {
    font-size: 0.76rem !important;
    color: var(--color-text-on-paper-faint);
  }

  @media (max-width: 46rem) {
    .flow__item > summary {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.3rem 0.75rem;
    }
    .flow__label {
      grid-column: 2;
      grid-row: 1;
    }
    .flow__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .flow__body {
      padding-left: 0;
    }
  }
</style>
