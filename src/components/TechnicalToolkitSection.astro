---
import SectionFrame from './SectionFrame.astro';

type ToolkitItem = {
  id: string;
  name: string;
  featuredOrder: number | null;
  usedIn: { project: string; href?: string }[];
  evidence: string[];
  note?: string;
};

type ToolkitGroup = {
  category: string;
  items: ToolkitItem[];
};

const toolkit: ToolkitGroup[] = [
  {
    category: 'Languages',
    items: [
      {
        id: 'python',
        name: 'Python',
        featuredOrder: null,
        usedIn: [
          { project: 'SessionBook', href: '/work/sessionbook/' },
          { project: 'Coursework / Data cleaning' },
          { project: 'Supervised ML (DataCamp)' },
        ],
        evidence: ['FastAPI service', 'async DB drivers', 'data cleaning', 'validation patterns'],
      },
      {
        id: 'javascript',
        name: 'JavaScript',
        featuredOrder: 4,
        usedIn: [{ project: 'Syncareer', href: '/work/syncareer/' }, { project: 'Portfolio (this site)' }],
        evidence: ['product surface logic', 'failure trace interactivity', 'editorial UI states'],
      },
      {
        id: 'html',
        name: 'HTML',
        featuredOrder: null,
        usedIn: [{ project: 'Syncareer', href: 'https://syncareer.me/' }, { project: 'Portfolio' }],
        evidence: ['semantic product surfaces', 'accessible trace markup', 'evidence-first layout'],
      },
      {
        id: 'css',
        name: 'CSS',
        featuredOrder: null,
        usedIn: [{ project: 'Syncareer' }, { project: 'Portfolio' }],
        evidence: ['restrained design tokens', 'responsive editorial grid'],
      },
    ],
  },
  {
    category: 'Backend & AI Integration',
    items: [
      {
        id: 'prompt-engineering',
        name: 'Prompt engineering',
        featuredOrder: 1,
        usedIn: [{ project: 'Syncareer', href: '/work/syncareer/' }],
        evidence: ['custom system instructions', 'explicit context management', 'output constraint design'],
      },
      {
        id: 'fastapi',
        name: 'FastAPI',
        featuredOrder: 5,
        usedIn: [{ project: 'SessionBook', href: '/work/sessionbook/' }],
        evidence: ['async SQLAlchemy 2.0', 'Pydantic contracts at the boundary', 'transactional booking routes'],
      },
      {
        id: 'sqlalchemy',
        name: 'SQLAlchemy (async)',
        featuredOrder: 6,
        usedIn: [{ project: 'SessionBook', href: '/work/sessionbook/' }],
        evidence: ['typed Mapped[...] models', 'async session lifecycle', 'Alembic-ready metadata'],
      },
    ],
  },
  {
    category: 'Databases',
    items: [
      {
        id: 'postgresql',
        name: 'PostgreSQL',
        featuredOrder: 2,
        usedIn: [
          { project: 'SessionBook', href: '/work/sessionbook/' },
          { project: 'Syncareer', href: '/work/syncareer/' },
        ],
        evidence: [
          'SELECT … FOR UPDATE for booking row lock',
          'flexible schema for activity / progress / weaknesses',
        ],
      },
      {
        id: 'mysql',
        name: 'MySQL',
        featuredOrder: null,
        usedIn: [{ project: 'Coursework (learning)' }],
        evidence: ['relational modeling', 'query patterns'],
      },
      {
        id: 'mongodb',
        name: 'MongoDB',
        featuredOrder: null,
        usedIn: [{ project: 'Learning / document model' }],
        evidence: ['document modeling exploration'],
      },
      {
        id: 'sqlite',
        name: 'SQLite',
        featuredOrder: null,
        usedIn: [{ project: 'Local prototypes' }],
        evidence: ['local persistence', 'rapid iteration'],
      },
    ],
  },
  {
    category: 'Infrastructure & Tools',
    items: [
      {
        id: 'docker',
        name: 'Docker',
        featuredOrder: null,
        usedIn: [{ project: 'SessionBook', href: '/work/sessionbook/' }],
        evidence: ['docker-compose for Postgres 16', 'reproducible local dev environment'],
      },
      {
        id: 'vercel',
        name: 'Vercel',
        featuredOrder: null,
        usedIn: [{ project: 'Portfolio deployment' }],
        evidence: ['static deployment', 'analytics integration'],
      },
      {
        id: 'git-github',
        name: 'Git / GitHub',
        featuredOrder: null,
        usedIn: [
          { project: 'Syncareer' },
          { project: 'SessionBook', href: '/work/sessionbook/' },
          { project: 'Portfolio' },
        ],
        evidence: ['evidence branch workflow', 'documentation history'],
      },
    ],
  },
  {
    category: 'Data & ML',
    items: [
      {
        id: 'data-cleaning',
        name: 'Data cleaning',
        featuredOrder: null,
        usedIn: [{ project: 'DataCamp / Coursework' }],
        evidence: ['handling inconsistent data', 'prep for validation'],
      },
      {
        id: 'supervised-machine-learning',
        name: 'Supervised machine learning',
        featuredOrder: null,
        usedIn: [{ project: 'Coursework' }],
        evidence: ['evaluation beyond happy path', 'testing variance'],
      },
      {
        id: 'output-validation-few-shot',
        name: 'Output validation / Few-shot anchoring',
        featuredOrder: 3,
        usedIn: [
          { project: 'Syncareer', href: '/work/syncareer/' },
          { project: 'SessionBook', href: '/work/sessionbook/' },
        ],
        evidence: [
          'schema checks before product use',
          'few-shot examples for structure',
          'failure mode separation',
          'spoken-output design for the booking confirmation',
        ],
      },
    ],
  },
];

const allToolkitItems = toolkit.flatMap(group => group.items);
const primaryToolkitItems = allToolkitItems
  .filter(item => item.featuredOrder !== null)
  .sort((a, b) => (a.featuredOrder ?? 0) - (b.featuredOrder ?? 0));
const additionalToolkit = toolkit
  .map(group => ({
    ...group,
    items: group.items.filter(item => item.featuredOrder === null),
  }))
  .filter(group => group.items.length > 0);
const additionalToolCount = additionalToolkit.reduce((count, group) => count + group.items.length, 0);
const initialItemId = primaryToolkitItems[0]?.id;
---

<section id="toolkit" class="toolkit" aria-labelledby="toolkit-title" data-workspace-section="toolkit">
  <SectionFrame coordinate="03 / Toolkit" surface="paper">
    <div class="page-shell toolkit-layout" data-toolkit>
      <header class="toolkit__header">
        <p class="mono-label">Technical index — evidence linked</p>
        <h2 id="toolkit-title" class="toolkit__title">Technical Toolkit</h2>
        <p class="toolkit__note">
          Project-relevant capabilities stay visible. Select one to see where I used it and what
          I actually did with it.
        </p>
      </header>

      <section class="toolkit__primary" aria-labelledby="toolkit-primary-title">
        <header class="toolkit__primary-header">
          <h3 id="toolkit-primary-title">Project capabilities</h3>
          <p class="mono-label">{primaryToolkitItems.length} selected</p>
        </header>
        <ul class="toolkit__primary-list" role="list">
          {primaryToolkitItems.map(item => {
              const itemId = item.id;
              const btnId = `toolkit-btn-${itemId}`;
              const isInitial = itemId === initialItemId;
              return (
                <li class="toolkit__item">
                  <button
                    id={btnId}
                    type="button"
                    class="toolkit__trigger"
                    aria-pressed={isInitial ? 'true' : 'false'}
                    data-active={String(isInitial)}
                    data-toolkit-trigger={itemId}
                  >
                    <span class="toolkit__trigger-step" aria-hidden="true">
                      {String(item.featuredOrder ?? '').padStart(2, '0')}
                    </span>
                    <span class="toolkit__trigger-name">{item.name}</span>
                    <span class="toolkit__trigger-mark" aria-hidden="true"></span>
                  </button>
                </li>
              );
            })}
        </ul>
      </section>

      <section class="toolkit__detail" data-toolkit-detail aria-live="polite">
        {toolkit.flatMap(group => group.items.map(item => {
          const itemId = item.id;
          const btnId = `toolkit-btn-${itemId}`;
          const isInitial = itemId === initialItemId;
          return (
            <article
              class="toolkit__panel"
              aria-labelledby={btnId}
              data-toolkit-detail-panel={itemId}
              data-active={String(isInitial)}
              hidden={!isInitial}
            >
              <header class="toolkit__panel-header">
                <p class="mono-label">Selected</p>
                <strong class="toolkit__panel-name">{item.name}</strong>
              </header>
              <dl class="toolkit__panel-grid">
                <div>
                  <dt class="mono-label">Used in</dt>
                  <dd>
                    <ul class="toolkit__panel-list">
                      {item.usedIn.map(u => (
                        <li>
                          {u.href
                            ? <a href={u.href} target={u.href.startsWith('http') ? '_blank' : undefined} rel={u.href.startsWith('http') ? 'noopener' : undefined}>{u.project}</a>
                            : <span>{u.project}</span>}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="mono-label">Evidence</dt>
                  <dd>
                    <ul class="toolkit__panel-list">
                      {item.evidence.map(e => <li>{e}</li>)}
                    </ul>
                  </dd>
                </div>
              </dl>
              {item.note && <p class="toolkit__panel-note">{item.note}</p>}
            </article>
          );
        }))}
      </section>

      <details class="toolkit__more" data-toolkit-more>
        <summary>
          <span class="mono-label">More technical tools</span>
          <span class="toolkit__more-count">{additionalToolCount} tools</span>
          <span class="toolkit__more-mark" aria-hidden="true"></span>
        </summary>
        <div class="toolkit__more-groups">
          {additionalToolkit.map((group, groupIndex) => (
            <section class="toolkit__group" aria-labelledby={`toolkit-more-group-${groupIndex}`}>
              <h3 id={`toolkit-more-group-${groupIndex}`}>
                <span class="mono-label">{group.category}</span>
              </h3>
              <ul class="toolkit__group-list">
                {group.items.map(item => (
                  <li>
                    <span class="toolkit__group-name">{item.name}</span>
                    <span class="toolkit__group-meta mono-label">
                      {item.usedIn[0]?.project ?? '—'}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </details>
    </div>
  </SectionFrame>
</section>

<script>
  const toolkitRoot = document.querySelector('[data-toolkit]');

  if (toolkitRoot) {
    const triggers = [...toolkitRoot.querySelectorAll<HTMLButtonElement>('[data-toolkit-trigger]')];
    const detailPanels = [...toolkitRoot.querySelectorAll<HTMLElement>('[data-toolkit-detail-panel]')];

    const select = (id: string) => {
      if (!triggers.some(trigger => trigger.dataset.toolkitTrigger === id)) return;

      triggers.forEach(trigger => {
        const active = trigger.dataset.toolkitTrigger === id;
        trigger.setAttribute('aria-pressed', String(active));
        trigger.dataset.active = String(active);
      });
      detailPanels.forEach(panel => {
        const active = panel.dataset.toolkitDetailPanel === id;
        panel.hidden = !active;
        panel.dataset.active = String(active);
      });
    };

    triggers.forEach(trigger => {
      const itemId = trigger.dataset.toolkitTrigger;
      if (!itemId) return;

      trigger.addEventListener('click', () => select(itemId));

      trigger.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          select(itemId);
        }
      });

      // A4 fix: do not select on focus. Keyboard nav uses Arrow keys
      // to move focus + change selection; tabbing through should not
      // mutate the visible detail panel.

      trigger.addEventListener('keydown', (e) => {
        const visibleTriggers = triggers;
        const idx = visibleTriggers.indexOf(trigger);
        if (idx < 0) return;
        let next: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          next = (idx + 1) % visibleTriggers.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          next = (idx - 1 + visibleTriggers.length) % visibleTriggers.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          next = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          next = visibleTriggers.length - 1;
        }
        if (next !== null) {
          const t = visibleTriggers[next];
          if (t) {
            t.focus();
            // Select on Arrow / Home / End so keyboard-only users see the
            // corresponding detail panel change (A4 fix — selection is NOT
            // driven by plain focus).
            const nextId = t.dataset.toolkitTrigger;
            if (nextId) select(nextId);
          }
        }
      });
    });

    const initial = triggers.find(trigger => trigger.getAttribute('aria-pressed') === 'true')?.dataset.toolkitTrigger;
    if (initial) select(initial);
  }
</script>

<style>
  .toolkit {
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .toolkit-layout {
    display: grid;
    gap: var(--space-6);
  }

  .toolkit__header {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .toolkit__title {
    margin: 0;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .toolkit__note {
    max-width: 32rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* Primary skills list */
  .toolkit__primary {
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .toolkit__primary-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .toolkit__primary-header h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .toolkit__primary-list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-rule-on-paper-soft);
  }

  .toolkit__item {
    background: var(--color-paper);
  }

  .toolkit__trigger {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: 0 var(--space-4);
    border: 0;
    background: transparent;
    color: var(--color-text-on-paper);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .toolkit__trigger:hover,
  .toolkit__trigger:focus-visible {
    background: var(--color-paper-soft);
  }

  .toolkit__trigger-step {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .toolkit__trigger-mark {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-rule-on-paper);
    background: transparent;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard);
  }

  .toolkit__trigger[aria-pressed='true'] {
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .toolkit__trigger[aria-pressed='true'] .toolkit__trigger-mark {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Detail panel */
  .toolkit__detail {
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
    min-height: 0;
  }

  .toolkit__panel {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .toolkit__panel[hidden] {
    display: none !important;
  }

  /* Progressive enhancement: without JS, every panel shows stacked. */
  html:not(.js) .toolkit__panel,
  html:not(.js) .toolkit__panel[hidden] {
    display: grid !important;
  }

  html:not(.js) .toolkit__primary {
    display: none;
  }

  .toolkit__panel-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .toolkit__panel-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-on-paper);
  }

  .toolkit__panel-grid {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .toolkit__panel-grid > div {
    display: grid;
    gap: var(--space-2);
  }

  .toolkit__panel-grid dt {
    color: var(--color-text-on-paper-muted);
  }

  .toolkit__panel-grid dd {
    margin: 0;
  }

  .toolkit__panel-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toolkit__panel-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .toolkit__panel-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.35rem;
    height: 0.35rem;
    border: 1px solid var(--color-accent);
    background: transparent;
  }

  .toolkit__panel-list a {
    color: var(--color-text-on-paper);
    font-weight: 600;
  }

  .toolkit__panel-note {
    margin: 0;
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent-tint) 30%, var(--color-paper));
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* More tools disclosure */
  .toolkit__more {
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .toolkit__more summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    padding: 0 var(--space-4);
    color: var(--color-text-on-paper);
    cursor: pointer;
    list-style: none;
    transition:
      background-color var(--duration-quick) var(--ease-standard);
  }

  .toolkit__more summary::-webkit-details-marker {
    display: none;
  }

  .toolkit__more summary:hover,
  .toolkit__more summary:focus-visible {
    background: var(--color-paper-soft);
  }

  .toolkit__more-count {
    color: var(--color-text-on-paper-muted);
  }

  .toolkit__more-mark {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--color-accent);
    background: transparent;
    position: relative;
  }

  .toolkit__more[open] .toolkit__more-mark {
    background: var(--color-accent);
  }

  .toolkit__more-groups {
    display: grid;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .toolkit__group {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .toolkit__group:last-child {
    border-bottom: 0;
  }

  .toolkit__group h3 {
    margin: 0 0 var(--space-2);
  }

  .toolkit__group-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toolkit__group-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper);
    font-size: var(--text-small);
  }

  .toolkit__group-list li:first-child {
    border-top: 0;
  }

  .toolkit__group-meta {
    color: var(--color-text-on-paper-muted);
  }

  @media (min-width: 48rem) {
    .toolkit-layout {
      grid-template-columns: minmax(18rem, 22rem) minmax(0, 1fr);
      grid-template-areas:
        "header header"
        "primary detail";
      column-gap: var(--space-7);
      row-gap: var(--space-5);
      align-items: start;
    }

    .toolkit__header {
      grid-area: header;
    }

    .toolkit__primary {
      grid-area: primary;
    }

    .toolkit__detail {
      grid-area: detail;
      position: sticky;
      top: 5.5rem;
    }

    .toolkit__more-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .toolkit__group {
      border-right: 1px solid var(--color-rule-on-paper-soft);
    }

    .toolkit__group:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (min-width: 64rem) {
    .toolkit__panel-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toolkit__trigger {
      transition: none;
    }
  }
</style>
