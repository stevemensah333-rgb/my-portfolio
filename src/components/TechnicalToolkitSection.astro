---
type ToolkitItem = {
  name: string;
  usedIn: { project: string; href?: string }[];
  evidence: string[];
  note?: string;
};

type ToolkitGroup = {
  category: string;
  items: ToolkitItem[];
};

const toolkit: ToolkitGroup[] = [
  {
    category: 'Languages',
    items: [
      {
        name: 'Python',
        usedIn: [{ project: 'Coursework / Data cleaning' }, { project: 'Supervised ML (DataCamp)' }],
        evidence: ['data cleaning', 'validation patterns', 'scripting for evaluation'],
        note: 'Used for data work and API validation patterns, not claimed as Syncareer prod stack.',
      },
      {
        name: 'JavaScript',
        usedIn: [{ project: 'Syncareer', href: '/work/syncareer/' }, { project: 'Portfolio (this site)' }],
        evidence: ['product surface logic', 'failure trace interactivity', 'editorial UI states'],
      },
      {
        name: 'HTML',
        usedIn: [{ project: 'Syncareer', href: 'https://syncareer.me/' }, { project: 'Portfolio' }],
        evidence: ['semantic product surfaces', 'accessible trace markup', 'evidence-first layout'],
      },
      {
        name: 'CSS',
        usedIn: [{ project: 'Syncareer' }, { project: 'Portfolio' }],
        evidence: ['restrained design tokens', 'responsive editorial grid'],
      },
    ],
  },
  {
    category: 'Backend & AI Integration',
    items: [
      {
        name: 'Prompt engineering',
        usedIn: [{ project: 'Syncareer', href: '/work/syncareer/' }],
        evidence: ['custom system instructions', 'explicit context management', 'output constraint design'],
      },
      {
        name: 'FastAPI',
        usedIn: [{ project: 'Learning / API design' }],
        evidence: ['schema validation patterns', 'transfer to LLM output validation'],
        note: 'Learning – pattern reference, not Syncareer prod claim.',
      },
    ],
  },
  {
    category: 'Databases',
    items: [
      {
        name: 'PostgreSQL',
        usedIn: [{ project: 'Syncareer', href: '/work/syncareer/' }],
        evidence: ['flexible schema for activity / progress / weaknesses', 'career data storage'],
      },
      {
        name: 'MySQL',
        usedIn: [{ project: 'Coursework (learning)' }],
        evidence: ['relational modeling', 'query patterns'],
      },
      {
        name: 'MongoDB',
        usedIn: [{ project: 'Learning / document model' }],
        evidence: ['document modeling exploration'],
      },
      {
        name: 'SQLite',
        usedIn: [{ project: 'Local prototypes' }],
        evidence: ['local persistence', 'rapid iteration'],
      },
    ],
  },
  {
    category: 'Infrastructure & Tools',
    items: [
      {
        name: 'Docker',
        usedIn: [{ project: 'Learning / reproducible env' }],
        evidence: ['reproducible deployment exploration'],
      },
      {
        name: 'Vercel',
        usedIn: [{ project: 'Portfolio deployment' }],
        evidence: ['static deployment', 'analytics integration'],
      },
      {
        name: 'Git / GitHub',
        usedIn: [{ project: 'Syncareer' }, { project: 'Portfolio' }],
        evidence: ['evidence branch workflow', 'documentation history'],
      },
    ],
  },
  {
    category: 'Data & ML',
    items: [
      {
        name: 'Data cleaning',
        usedIn: [{ project: 'DataCamp / Coursework' }],
        evidence: ['handling inconsistent data', 'prep for validation'],
      },
      {
        name: 'Supervised machine learning',
        usedIn: [{ project: 'Coursework' }],
        evidence: ['evaluation beyond happy path', 'testing variance'],
      },
      {
        name: 'Output validation / Few-shot anchoring',
        usedIn: [{ project: 'Syncareer', href: '/work/syncareer/' }],
        evidence: ['schema checks before product use', 'few-shot examples for structure', 'failure mode separation'],
      },
    ],
  },
];
---

<section id="toolkit" class="toolkit" aria-labelledby="toolkit-title">
  <div class="page-shell toolkit-layout" data-toolkit>
    <header class="toolkit-header">
      <p class="technical-label">Technical index — evidence linked</p>
      <h2 id="toolkit-title">Technical Toolkit</h2>
      <p class="toolkit-note">Select a skill to see where I used it and what I actually did with it.</p>
    </header>

    <div class="toolkit-skills">
      {toolkit.map((group, gIndex) => (
        <section class="toolkit-group" aria-labelledby={`toolkit-group-${gIndex}`}>
          <h3 id={`toolkit-group-${gIndex}`}>{group.category}</h3>
          <ul role="list">
            {group.items.map((item, iIndex) => {
              const itemId = `${gIndex}-${iIndex}`;
              const panelId = `toolkit-panel-${itemId}`;
              const btnId = `toolkit-btn-${gIndex}-${iIndex}`;
              const isInitial = gIndex === 0 && iIndex === 0;
              return (
                <li class="toolkit-item" data-toolkit-item>
                  <button
                    id={btnId}
                    type="button"
                    class="toolkit-trigger"
                    aria-pressed={isInitial ? 'true' : 'false'}
                    data-active={String(isInitial)}
                    data-toolkit-trigger={itemId}
                  >
                    <span class="trigger-name">{item.name}</span>
                    <span class="trigger-meta" aria-hidden="true"><i></i></span>
                  </button>
                  <div
                    id={panelId}
                    class="toolkit-panel toolkit-panel--inline"
                    role="region"
                    aria-labelledby={btnId}
                    data-toolkit-panel={itemId}
                    data-active={String(isInitial)}
                    hidden={!isInitial}
                  >
                    <div class="panel-section">
                      <span class="panel-label">Used in</span>
                      <ul class="panel-list">
                        {item.usedIn.map(u => (
                          <li>
                            {u.href ? <a href={u.href} target={u.href.startsWith('http') ? '_blank' : undefined} rel={u.href.startsWith('http') ? 'noopener' : undefined}>{u.project}</a> : <span>{u.project}</span>}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="panel-section">
                      <span class="panel-label">Evidence</span>
                      <ul class="panel-list">
                        {item.evidence.map(e => <li>{e}</li>)}
                      </ul>
                    </div>
                    {item.note && <p class="panel-note">{item.note}</p>}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <div class="toolkit-detail" data-toolkit-detail>
      {toolkit.flatMap((group, gIndex) => group.items.map((item, iIndex) => {
        const itemId = `${gIndex}-${iIndex}`;
        const btnId = `toolkit-btn-${itemId}`;
        const isInitial = gIndex === 0 && iIndex === 0;
        return (
          <div
            class="toolkit-panel toolkit-panel--detail"
            role="region"
            aria-labelledby={btnId}
            data-toolkit-detail-panel={itemId}
            data-active={String(isInitial)}
            hidden={!isInitial}
          >
            <div class="detail-header">
              <span class="panel-label">Selected</span>
              <strong class="detail-name">{item.name}</strong>
            </div>
            <div class="panel-section">
              <span class="panel-label">Used in</span>
              <ul class="panel-list">
                {item.usedIn.map(u => (
                  <li>
                    {u.href ? <a href={u.href} target={u.href.startsWith('http') ? '_blank' : undefined} rel={u.href.startsWith('http') ? 'noopener' : undefined}>{u.project}</a> : <span>{u.project}</span>}
                  </li>
                ))}
              </ul>
            </div>
            <div class="panel-section">
              <span class="panel-label">Evidence</span>
              <ul class="panel-list">
                {item.evidence.map(e => <li>{e}</li>)}
              </ul>
            </div>
            {item.note && <p class="panel-note">{item.note}</p>}
          </div>
        );
      }))}
    </div>
  </div>
</section>

<script>
  const toolkitRoot = document.querySelector('[data-toolkit]');

  if (toolkitRoot) {
    const triggers = [...toolkitRoot.querySelectorAll<HTMLButtonElement>('[data-toolkit-trigger]')];
    const panels = [...toolkitRoot.querySelectorAll<HTMLElement>('[data-toolkit-panel]')];
    const detailPanels = [...toolkitRoot.querySelectorAll<HTMLElement>('[data-toolkit-detail-panel]')];

    const select = (id: string) => {
      if (!triggers.some(trigger => trigger.dataset.toolkitTrigger === id)) return;

      triggers.forEach(trigger => {
        const active = trigger.dataset.toolkitTrigger === id;
        trigger.setAttribute('aria-pressed', String(active));
        trigger.dataset.active = String(active);
      });
      panels.forEach(panel => {
        const active = panel.dataset.toolkitPanel === id;
        panel.hidden = !active;
        panel.dataset.active = String(active);
      });
      detailPanels.forEach(panel => {
        const active = panel.dataset.toolkitDetailPanel === id;
        panel.hidden = !active;
        panel.dataset.active = String(active);
      });
    };

    triggers.forEach(trigger => {
      const itemId = trigger.dataset.toolkitTrigger;
      if (!itemId) return;

      trigger.addEventListener('click', () => select(itemId));

      trigger.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          select(itemId);
        }
      });

      trigger.addEventListener('focus', () => {
        select(itemId);
      });

      trigger.addEventListener('keydown', (e) => {
        const idx = triggers.indexOf(trigger);
        let next: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          next = (idx + 1) % triggers.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          next = (idx - 1 + triggers.length) % triggers.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          next = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          next = triggers.length - 1;
        }
        if (next !== null) {
          const t = triggers[next];
          t?.focus();
        }
      });
    });

    const initial = triggers.find(trigger => trigger.getAttribute('aria-pressed') === 'true')?.dataset.toolkitTrigger;
    if (initial) select(initial);
  }
</script>

<style>
  .toolkit {
    padding-block: var(--section-tight);
    border-top: var(--border-default);
    background: var(--color-background);
    position: relative;
  }

  .toolkit-layout {
    display: grid;
    gap: var(--space-6);
  }

  .toolkit-header p,
  .toolkit-header h2 {
    margin: 0;
  }

  .toolkit-header h2 {
    margin-top: var(--section-heading-gap);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .toolkit-note {
    max-width: 30rem;
    margin: var(--space-4) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .toolkit-detail {
    display: none;
    padding: var(--space-5);
    border: var(--border-default);
    border-radius: var(--radius-small);
    background: var(--color-surface-light);
    min-height: 0;
  }

  .detail-header {
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-default);
  }

  .detail-name {
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--color-text);
  }

  .toolkit-detail .toolkit-panel {
    margin-top: 0;
    padding: 0;
    border: 0;
    background: transparent;
    gap: var(--space-4);
    animation: none;
  }

  .toolkit-skills {
    display: grid;
    gap: 0;
    border-top: var(--border-default);
    border-bottom: var(--border-default);
  }

  .toolkit-group {
    display: grid;
    grid-template-columns: minmax(7.75rem, 0.9fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-default);
  }

  .toolkit-group:last-child {
    border-bottom: 0;
  }

  .toolkit-group h3 {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .toolkit-group ul {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toolkit-item {
    position: relative;
  }

  .toolkit-trigger {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-text);
    font: 550 var(--text-small) / 1.5 var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .trigger-name {
    min-width: 0;
  }

  .trigger-meta {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .trigger-meta i {
    width: 0.375rem;
    height: 0.375rem;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .toolkit-trigger:hover {
    background: var(--color-surface-light);
    border-color: var(--color-border);
    transform: translateX(1px);
  }

  .toolkit-trigger:hover .trigger-meta i {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .toolkit-trigger:focus-visible {
    outline: 0.1875rem solid var(--color-accent);
    outline-offset: -1px;
    background: var(--color-surface-cool);
  }

  .toolkit-trigger[aria-pressed='true'] {
    background: var(--color-surface-cool);
    border-color: color-mix(in srgb, var(--color-border) 40%, var(--color-accent));
    color: var(--color-text);
  }

  .toolkit-trigger[aria-pressed='true'] .trigger-meta i {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.2);
  }

  .toolkit-trigger[data-active='true'] {
    font-weight: 650;
  }

  .toolkit-panel {
    margin-top: var(--space-2);
    padding: var(--space-4);
    border: var(--border-default);
    border-radius: var(--radius-small);
    background: var(--color-surface-light);
    display: grid;
    gap: var(--space-4);
    animation: panel-in var(--duration-normal) var(--ease-standard);
  }

  .toolkit-panel[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-section {
    display: grid;
    gap: var(--space-2);
  }

  .panel-label {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel-list li {
    position: relative;
    padding-left: var(--space-4);
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .panel-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.35rem;
    height: 0.35rem;
    border: 1px solid var(--color-accent);
    background: var(--color-background);
  }

  .panel-list a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration-color: var(--color-border);
  }

  .panel-list a:hover {
    text-decoration-color: var(--color-accent);
  }

  .panel-note {
    margin: 0;
    padding-top: var(--space-3);
    border-top: var(--border-default);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
    font-style: italic;
  }

  /* Mobile: inspector after skills (default order header -> skills -> detail) already natural */
  /* Desktop two-zone */
  @media (min-width: 48rem) {
    .toolkit-layout {
      grid-template-columns: minmax(17rem, 22rem) minmax(0, 1fr);
      grid-template-areas:
        "header skills"
        "detail skills";
      align-items: start;
      column-gap: var(--space-7);
      row-gap: var(--space-5);
    }

    .toolkit-header {
      grid-area: header;
    }

    .toolkit-detail {
      display: block;
      grid-area: detail;
      position: sticky;
      top: 5.5rem;
    }

    .toolkit-skills {
      grid-area: skills;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border: var(--border-default);
      border-radius: var(--radius-small);
      overflow: hidden;
      background: var(--color-background);
    }

    .toolkit-group {
      display: block;
      min-height: 0;
      padding: var(--space-4);
      border-right: var(--border-default);
      border-bottom: var(--border-default);
    }

    .toolkit-group:nth-child(2n) {
      border-right: 0;
    }

    .toolkit-group:last-child {
      grid-column: 1 / -1;
      border-bottom: 0;
      border-right: 0;
    }

    .toolkit-group .toolkit-panel--inline {
      display: none !important;
    }

    .toolkit-group ul {
      margin-top: var(--space-3);
    }

    .toolkit-detail .toolkit-panel:not([hidden]) {
      display: grid !important;
    }
  }

  @media (min-width: 64rem) {
    .toolkit-layout {
      grid-template-columns: minmax(18rem, 23rem) minmax(0, 1fr);
      column-gap: var(--space-8);
    }

    /* Balanced 5-category arrangement – avoid long single tail.
       Use 6-col base: 3 on top row (Languages, Backend, Databases)
       and 2 on bottom row (Infrastructure & Tools, Data & ML) equally filled. */
    .toolkit-skills {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .toolkit-group {
      grid-column: span 2;
      border-right: var(--border-default);
      border-bottom: var(--border-default);
    }

    .toolkit-group:nth-child(1) {
      grid-column: span 2;
      border-right: var(--border-default);
      border-bottom: var(--border-default);
    }
    .toolkit-group:nth-child(2) {
      grid-column: span 2;
      border-right: var(--border-default);
      border-bottom: var(--border-default);
    }
    .toolkit-group:nth-child(3) {
      grid-column: span 2;
      border-right: 0;
      border-bottom: var(--border-default);
    }
    .toolkit-group:nth-child(4) {
      grid-column: span 3;
      border-right: var(--border-default);
      border-bottom: 0;
    }
    .toolkit-group:nth-child(5) {
      grid-column: span 3;
      border-right: 0;
      border-bottom: 0;
    }
  }

  @media (max-width: 47.98rem) {
    .toolkit-skills {
      order: 2;
    }
    .toolkit-group .toolkit-panel[hidden] {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toolkit-panel {
      animation: none;
    }
    .toolkit-trigger {
      transition: none;
    }
  }
</style>
