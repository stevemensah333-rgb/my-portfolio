        usedIn: [{ project: 'Syncareer' }, { project: 'Portfolio' }],
        evidence: ['restrained design tokens', 'responsive editorial grid', 'motion system (140/220/380ms)'],
      },
    ],
  },
  {
    category: 'Backend & AI Integration',
    items: [
