      },
      {
        name: 'Node.js',
        usedIn: [{ project: 'Portfolio tooling' }, { project: 'Personal projects' }],
        evidence: ['Astro build', 'static + hydrated islands'],
      },
      {
        name: 'Express.js',
        usedIn: [{ project: 'Personal projects (learning)' }],
