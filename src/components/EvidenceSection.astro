---
import { credentials } from '../data/credentials';
import SectionFrame from './SectionFrame.astro';
---

<!--
  EVIDENCE — the archival register.

  Evidence is information, so it sits on the light environment inside
  PROFILE (AGENTS.md §3: light = information, dark = instrumentation).
  The register keeps its plate-drawer character: an accession index,
  a mounted plate, catalogue metadata — just on paper, not on deck.

  Everything else supports that:
  - the index is a numbered accession list, not a menu of buttons;
  - the selected record opens in a mounted PLATE — a bordered well
    with the artifact centred on it and a caption strip beneath;
  - metadata is set as a record header (accession / issuer / result)
    in mono, because it is catalogue data.

  No badges, no trophies, no achievement cards. The interaction and
  the content model are unchanged.
-->
<section id="evidence" class="evidence" aria-labelledby="evidence-title" data-workspace-section="evidence" data-workspace-label="Evidence">
  <SectionFrame coordinate="04.4 · Profile / Evidence" status="Archive" surface="paper" density="default">
    <div class="page-shell region-grid">
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">04.4</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Archive</span>
          <span class="region-index__note">{credentials.length} records. Each links to its source artifact.</span>
        </div>
      </aside>

      <div class="region-body evidence__body">
        <header class="evidence__header">
          <h2 id="evidence-title" class="region-title">Evidence</h2>
          <p class="region-lede">Academic records and awards — easier to show than describe. The engineering work itself is evidenced in the project case studies.</p>
        </header>

        <div class="evidence__drawer" data-credential-evidence>
          <div class="evidence__index">
            <p class="evidence__index-label" id="evidence-index-label">Accession index</p>
            <ol class="evidence__list" role="tablist" aria-labelledby="evidence-index-label">
              {credentials.map((credential, index) => {
                const type = credential.evidenceImage ? 'image' : credential.evidenceDocument ? 'document' : 'record';
                return (
                  <li role="presentation">
                    <button
                      type="button"
                      role="tab"
                      id={`evidence-tab-${credential.id}`}
                      class="evidence__trigger"
                      data-credential-trigger={credential.id}
                      aria-controls={`credential-preview-${credential.id}`}
                      aria-selected={index === 0 ? 'true' : 'false'}
                      tabindex={index === 0 ? '0' : '-1'}
                    >
                      <span class="evidence__trigger-index" aria-hidden="true">{String(index + 1).padStart(3, '0')}</span>
                      <span class="evidence__trigger-copy">
                        <span class="evidence__trigger-name">{credential.name}</span>
                        <span class="evidence__trigger-meta">{type} · {credential.issuer ?? 'record'}</span>
                      </span>
                      <span class="evidence__trigger-result">{credential.result}</span>
                    </button>
                  </li>
                );
              })}
            </ol>
          </div>

          <div class="evidence__panels">
            {credentials.map((credential, index) => (
              <div
                id={`credential-preview-${credential.id}`}
                class="evidence__panel"
                role="tabpanel"
                aria-labelledby={`evidence-tab-${credential.id}`}
                data-credential-panel={credential.id}
                data-active={index === 0 ? 'true' : 'false'}
                tabindex="0"
                hidden={index !== 0}
              >
                <header class="evidence__record-head">
                  <span class="evidence__record-no">{String(index + 1).padStart(3, '0')}</span>
                  <span class="evidence__record-name">{credential.name}</span>
                  <span class="evidence__record-result">{credential.result}</span>
                </header>

                {credential.evidenceImage && credential.evidenceAlt && credential.evidenceWidth && credential.evidenceHeight ? (
                  <a
                    class="evidence__plate"
                    href={credential.evidenceImage}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Open full-size evidence for ${credential.name}`}
                  >
                    <span class="evidence__plate-well">
                      <img
                        src={credential.evidenceImage}
                        alt={credential.evidenceAlt}
                        width={credential.evidenceWidth}
                        height={credential.evidenceHeight}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="evidence__plate-strip">
                      <span class="evidence__plate-kind">Artifact · {credential.evidenceWidth}×{credential.evidenceHeight}</span>
                      <span class="evidence__plate-open">Open full size <span aria-hidden="true">↗</span></span>
                    </span>
                  </a>
                ) : (
                  <div class="evidence__text-record">
                    <p class="mono-label mono-label--bare">Evidence record</p>
                    <p class="evidence__result">{credential.result}</p>
                  </div>
                )}

                {(credential.issuer || credential.detail) && (
                  <dl class="evidence__meta">
                    {credential.issuer && (
                      <div>
                        <dt>Issuer</dt>
                        <dd>{credential.issuer}</dd>
                      </div>
                    )}
                    {credential.detail && (
                      <div>
                        <dt>Detail</dt>
                        <dd>{credential.detail}</dd>
                      </div>
                    )}
                  </dl>
                )}

                {credential.evidenceDocument && (
                  <a class="text-link" href={credential.evidenceDocument} target="_blank" rel="noopener">
                    View document
                    <span class="text-link__arrow" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            ))}
          </div>
          <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-evidence-status></p>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<script>
  import { reserveStackHeight } from '../scripts/initTraceTabs';

  /* Re-initializes on `astro:page-load` (the ClientRouter swaps the
     shell without re-running bundled scripts); the marker keeps it
     idempotent and the run-scoped AbortController removes the previous
     run's window listeners. */
  let teardown: (() => void) | null = null;

  const init = () => {
    const sections = [...document.querySelectorAll<HTMLElement>('[data-credential-evidence]')]
      .filter((section) => section.dataset.evidenceEnhanced !== '1');
    if (sections.length === 0) return;
    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();
    const signal = events.signal;

    for (const section of sections) {
    section.dataset.evidenceEnhanced = '1';
    const STORAGE_KEY = 'workspace:evidence';
    const readStored = () => {
      try {
        return sessionStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    };
    const writeStored = (id: string) => {
      try {
        sessionStorage.setItem(STORAGE_KEY, id);
      } catch {}
    };

    const triggers = [...section.querySelectorAll<HTMLButtonElement>('[data-credential-trigger]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[data-credential-panel]')];
    const status = section.querySelector<HTMLElement>('[data-evidence-status]');
    reserveStackHeight(panels, signal);

    // The live region is for user-driven changes only; the initial
    // render must not announce anything on page load.
    let interacted = false;

    const selectCredential = (id: string) => {
      if (!triggers.some((t) => t.dataset.credentialTrigger === id)) return;
      for (const trigger of triggers) {
        const isActive = trigger.dataset.credentialTrigger === id;
        trigger.setAttribute('aria-selected', String(isActive));
        trigger.tabIndex = isActive ? 0 : -1;
      }

      for (const panel of panels) {
        const isActive = panel.dataset.credentialPanel === id;
        panel.dataset.active = String(isActive);
        panel.hidden = !isActive;
      }

      const label = triggers
        .find((trigger) => trigger.dataset.credentialTrigger === id)
        ?.querySelector('.evidence__trigger-name')
        ?.textContent
        ?.trim();
      if (status && label && interacted) status.textContent = `Showing evidence: ${label}`;
      writeStored(id);
    };

    for (const trigger of triggers) {
      const id = trigger.dataset.credentialTrigger;
      if (!id) continue;

      // Click — primary interaction (mouse, touch, keyboard activation)
      trigger.addEventListener('click', () => {
        interacted = true;
        selectCredential(id);
      });

      // Hover — only on hover-capable pointers (per A4 fix)
      trigger.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          interacted = true;
          selectCredential(id);
        }
      });

      // Keyboard nav: Arrow keys move between triggers; selection happens on click or Arrow
      trigger.addEventListener('keydown', (e) => {
        const visibleTriggers = triggers;
        const idx = visibleTriggers.indexOf(trigger);
        if (idx < 0) return;
        let next: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          next = (idx + 1) % visibleTriggers.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          next = (idx - 1 + visibleTriggers.length) % visibleTriggers.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          next = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          next = visibleTriggers.length - 1;
        }
        if (next !== null) {
          interacted = true;
          const t = visibleTriggers[next];
          if (t) {
            t.focus();
            selectCredential(t.dataset.credentialTrigger ?? '');
          }
        }
      });
    }

    // Continuity: restore last inspected evidence across view transitions.
    const stored = readStored();
    const hasStored = stored ? triggers.some((t) => t.dataset.credentialTrigger === stored) : false;
    if (hasStored && stored) {
      selectCredential(stored);
    } else {
      // Ensure the initially marked tab is announced consistently.
      const marked = triggers.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset
        .credentialTrigger;
      if (marked) selectCredential(marked);
    }
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .evidence {
    background: var(--color-sheet);
    color: var(--color-text-on-paper);
  }

  .evidence__body {
    gap: var(--space-5);
  }

  .evidence__header {
    display: grid;
    gap: var(--space-3);
  }

  /* --- the drawer ------------------------------------------------ */
  /* Index and plate are one bounded object, because a drawer IS a
     boundary. It is the only container in the section. */

  .evidence__drawer {
    display: grid;
    border: 1px solid var(--color-rule-on-paper-strong);
    background: var(--color-paper-soft);
  }

  /* --- accession index ------------------------------------------- */

  .evidence__index {
    display: grid;
    align-content: start;
    background: var(--color-paper-inset);
  }

  .evidence__index-label {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .evidence__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence__list li + li .evidence__trigger {
    border-top: 1px solid var(--color-rule-on-paper);
  }

  /* Two columns, not three: the index column is narrow at every
     width, so a right-hand result column squeezed record names to a
     word per line. The result sits under the name instead. */
  .evidence__trigger {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2) var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-left: 2px solid transparent;
    background: transparent;
    color: var(--color-text-on-paper-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  /* Accession numbers are three digits — the register reads as a
     catalogue rather than as a four-item menu. */
  .evidence__trigger-index {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    line-height: 1.4;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .evidence__trigger-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .evidence__trigger-name {
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.35;
  }

  /* Catalogue metadata is always visible here — an archive does not
     hide its own labels behind hover. */
  .evidence__trigger-meta {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .evidence__trigger-result {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    line-height: 1.4;
    grid-column: 2;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .evidence__trigger:hover,
  .evidence__trigger:focus-visible {
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper);
  }

  .evidence__trigger[aria-selected='true'] {
    background: var(--color-paper-soft);
    border-left-color: var(--color-accent);
    color: var(--color-text-on-paper);
  }

  .evidence__trigger[aria-selected='true'] .evidence__trigger-index,
  .evidence__trigger[aria-selected='true'] .evidence__trigger-result {
    color: var(--color-accent-text);
  }

  /* --- the plate -------------------------------------------------- */

  .evidence__panels {
    position: relative;
    padding: var(--space-5);
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .evidence__panel {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .evidence__panel[hidden] {
    display: none !important;
  }

  @keyframes evidence-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .evidence__panel[data-active='true'] {
    animation: evidence-enter var(--duration-base) var(--ease-standard);
  }

  /* Record header — accession no., name, result on one ruled line. */
  .evidence__record-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .evidence__record-no {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
  }

  .evidence__record-name {
    font-size: var(--text-component);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .evidence__record-result {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-align: right;
  }

  /* PLATE: the artifact mounted in a recessed well with a caption
     strip. The well is what makes it read as archival — the image
     is an object sitting on a surface, not a content block. */
  .evidence__plate {
    display: grid;
    gap: 0;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--color-rule-on-paper);
    transition: border-color var(--duration-quick) var(--ease-standard);
  }

  .evidence__plate:hover,
  .evidence__plate:focus-visible {
    border-color: var(--color-accent);
  }

  .evidence__plate-well {
    display: block;
    padding: var(--space-4);
    background: var(--color-paper-inset);
  }

  .evidence__plate-well img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule-on-paper);
  }

  .evidence__plate-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .evidence__plate-kind {
    color: var(--color-text-on-paper-faint);
  }

  .evidence__plate-open {
    color: var(--color-accent-text);
  }

  .evidence__text-record {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-inset);
  }

  .evidence__result {
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
  }

  /* Catalogue data, set as a register. */
  .evidence__meta {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .evidence__meta > div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .evidence__meta > div:first-child {
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .evidence__meta dt {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .evidence__meta dd {
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-small);
  }

  /* --- responsive -------------------------------------------------- */

  @media (min-width: 48rem) {
    .evidence__drawer {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .evidence__panels {
      border-top: 0;
      border-left: 1px solid var(--color-rule-on-paper-strong);
    }
  }

  @media (max-width: 30rem) {
    .evidence__panels {
      padding: var(--space-3);
    }

    .evidence__plate-well {
      padding: var(--space-2);
    }

    .evidence__record-head {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .evidence__record-result {
      grid-column: 2;
      text-align: left;
    }

    .evidence__trigger {
      grid-template-columns: 2rem minmax(0, 1fr);
      padding-inline: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence__panel,
    .evidence__trigger,
    .evidence__plate {
      transition: none;
      animation: none;
    }
  }

  /* Progressive enhancement: without JS, all records show stacked. */
  html:not(.js) .evidence__panel,
  html:not(.js) .evidence__panel[hidden] {
    display: grid !important;
    animation: none;
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  html:not(.js) .evidence__index {
    display: none;
  }
</style>
