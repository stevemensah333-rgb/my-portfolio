---
import { credentials } from '../data/credentials';
import SectionFrame from './SectionFrame.astro';
---

<section id="evidence" class="evidence" aria-labelledby="evidence-title" data-workspace-section="evidence">
  <SectionFrame coordinate="06 / Evidence" surface="paper">
    <div class="page-shell evidence__layout">
      <header class="evidence__header">
        <p class="mono-label">Selected credentials &amp; recognition</p>
        <h2 id="evidence-title" class="evidence__title">Evidence</h2>
        <p class="evidence__intro">A few things that are easier to show than describe.</p>
      </header>

      <div class="evidence__grid" data-credential-evidence>
        <div class="evidence__index">
          <p class="mono-label evidence__index-label" id="evidence-index-label">Index</p>
          <ol class="evidence__list" role="tablist" aria-labelledby="evidence-index-label">
            {credentials.map((credential, index) => {
              const type = credential.evidenceImage ? 'image' : credential.evidenceDocument ? 'document' : 'record';
              return (
                <li role="presentation">
                  <button
                    type="button"
                    role="tab"
                    id={`evidence-tab-${credential.id}`}
                    class="evidence__trigger"
                    data-credential-trigger={credential.id}
                    data-evidence-type={type}
                    aria-controls={`credential-preview-${credential.id}`}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    tabindex={index === 0 ? '0' : '-1'}
                  >
                    <span class="evidence__trigger-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="evidence__trigger-copy">
                      <span class="evidence__trigger-name">{credential.name}</span>
                      <span class="evidence__trigger-meta mono-label">{type} · {credential.issuer ?? 'record'}</span>
                    </span>
                    <span class="evidence__trigger-result">{credential.result}</span>
                    <span class="evidence__trigger-mark" aria-hidden="true"></span>
                  </button>
                </li>
              );
            })}
          </ol>
        </div>

        <div class="evidence__panels">
          {credentials.map((credential, index) => (
            <article
              id={`credential-preview-${credential.id}`}
              class="evidence__panel"
              role="tabpanel"
              aria-labelledby={`evidence-tab-${credential.id}`}
              data-credential-panel={credential.id}
              data-active={index === 0 ? 'true' : 'false'}
              tabindex="0"
              hidden={index !== 0}
            >
              {credential.evidenceImage && credential.evidenceAlt && credential.evidenceWidth && credential.evidenceHeight ? (
                <a
                  class="evidence__image-link"
                  href={credential.evidenceImage}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Open full-size evidence for ${credential.name}`}
                >
                  <img
                    src={credential.evidenceImage}
                    alt={credential.evidenceAlt}
                    width={credential.evidenceWidth}
                    height={credential.evidenceHeight}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="evidence__image-caption mono-label">
                    Open full-size evidence <span aria-hidden="true">↗</span>
                  </span>
                </a>
              ) : (
                <div class="evidence__text-record">
                  <p class="mono-label">Evidence record</p>
                  <h3>{credential.name}</h3>
                  <p class="evidence__result">{credential.result}</p>
                </div>
              )}
              {(credential.issuer || credential.detail) && (
                <dl class="evidence__meta">
                  {credential.issuer && (
                    <div>
                      <dt class="mono-label">Issuer</dt>
                      <dd>{credential.issuer}</dd>
                    </div>
                  )}
                  {credential.detail && (
                    <div>
                      <dt class="mono-label">Detail</dt>
                      <dd>{credential.detail}</dd>
                    </div>
                  )}
                </dl>
              )}
              {credential.evidenceDocument && (
                <a class="text-link" href={credential.evidenceDocument} target="_blank" rel="noopener">
                  View document
                  <span class="text-link__arrow" aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))}
        </div>
        <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-evidence-status></p>
      </div>
    </div>
  </SectionFrame>
</section>

<script>
  import { reserveStackHeight } from '../scripts/initTraceTabs';

  for (const section of document.querySelectorAll<HTMLElement>('[data-credential-evidence]')) {
    const triggers = [...section.querySelectorAll<HTMLButtonElement>('[data-credential-trigger]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[data-credential-panel]')];
    const status = section.querySelector<HTMLElement>('[data-evidence-status]');
    reserveStackHeight(panels);

    const selectCredential = (id: string) => {
      for (const trigger of triggers) {
        const isActive = trigger.dataset.credentialTrigger === id;
        trigger.setAttribute('aria-selected', String(isActive));
        trigger.tabIndex = isActive ? 0 : -1;
      }

      for (const panel of panels) {
        const isActive = panel.dataset.credentialPanel === id;
        panel.dataset.active = String(isActive);
        panel.hidden = !isActive;
      }

      const label = triggers
        .find((trigger) => trigger.dataset.credentialTrigger === id)
        ?.querySelector('.evidence__trigger-name')
        ?.textContent
        ?.trim();
      if (status && label) status.textContent = `Showing evidence: ${label}`;
    };

    for (const trigger of triggers) {
      const id = trigger.dataset.credentialTrigger;
      if (!id) continue;

      // Click — primary interaction
      trigger.addEventListener('click', () => selectCredential(id));

      // Hover — only on hover-capable pointers (per A4 fix)
      trigger.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          selectCredential(id);
        }
      });

      // Keyboard nav: Arrow keys move between triggers; selection happens on click or Arrow
      trigger.addEventListener('keydown', (e) => {
        const visibleTriggers = triggers;
        const idx = visibleTriggers.indexOf(trigger);
        if (idx < 0) return;
        let next: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          next = (idx + 1) % visibleTriggers.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          next = (idx - 1 + visibleTriggers.length) % visibleTriggers.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          next = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          next = visibleTriggers.length - 1;
        }
        if (next !== null) {
          const t = visibleTriggers[next];
          if (t) {
            t.focus();
            selectCredential(t.dataset.credentialTrigger ?? '');
          }
        }
      });
    }
  }
</script>

<style>
  .evidence {
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .evidence__layout {
    display: grid;
    gap: var(--space-6);
  }

  .evidence__header {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-reading);
  }

  .evidence__title {
    margin: 0;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .evidence__intro {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
  }

  .evidence__grid {
    display: grid;
    gap: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  /* Index list */
  .evidence__index {
    display: grid;
    gap: var(--space-2);
  }

  .evidence__index-label {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper-muted);
  }

  .evidence__list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-rule-on-paper-soft);
  }

  .evidence__trigger {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-4);
    border: 0;
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .evidence__trigger-index {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    align-self: start;
    margin-top: 0.2rem;
  }

  .evidence__trigger-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .evidence__trigger-name {
    font-weight: 600;
    font-size: var(--text-small);
  }

  .evidence__trigger-meta {
    color: var(--color-text-on-paper-faint);
    font-size: 0.625rem;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .evidence__trigger-meta::before {
    display: none;
  }

  .evidence__trigger:hover .evidence__trigger-meta,
  .evidence__trigger:focus-visible .evidence__trigger-meta,
  .evidence__trigger[aria-selected='true'] .evidence__trigger-meta {
    opacity: 1;
    transform: translateY(0);
    color: var(--color-text-on-paper-muted);
  }

  @media (hover: none) {
    .evidence__trigger-meta {
      opacity: 1;
      transform: none;
    }
  }

  .evidence__trigger-result {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-align: right;
    align-self: start;
    margin-top: 0.2rem;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .evidence__trigger:hover .evidence__trigger-result,
  .evidence__trigger:focus-visible .evidence__trigger-result {
    color: var(--color-accent-text);
  }

  .evidence__trigger-mark {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-rule-on-paper);
    background: transparent;
    transition: all var(--duration-quick) var(--ease-standard);
    align-self: start;
    margin-top: 0.4rem;
  }

  .evidence__trigger:hover,
  .evidence__trigger:focus-visible {
    background: var(--color-paper-soft);
  }

  .evidence__trigger[aria-selected='true'] {
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .evidence__trigger[aria-selected='true'] .evidence__trigger-mark {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Panels */
  .evidence__panels {
    position: relative;
    padding: var(--space-5);
    background: var(--color-paper-soft);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .evidence__panel {
    display: grid;
    gap: var(--space-4);
  }

  .evidence__panel[hidden] {
    display: none !important;
  }

  @keyframes evidence-enter {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .evidence__panel[data-active='true'] {
    animation: evidence-enter var(--duration-base) var(--ease-standard);
  }

  .evidence__image-link {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-on-paper);
  }

  .evidence__image-link img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .evidence__image-caption {
    color: var(--color-text-on-paper-muted);
    text-align: right;
  }

  .evidence__text-record {
    display: grid;
    gap: var(--space-2);
  }

  .evidence__text-record h3 {
    margin: var(--space-2) 0 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .evidence__result {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
  }

  .evidence__meta {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .evidence__meta > div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .evidence__meta dt {
    color: var(--color-text-on-paper-muted);
  }

  .evidence__meta dd {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-on-paper);
  }

  @media (min-width: 48rem) {
    .evidence__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .evidence__panels {
      border-top: 0;
      border-left: 1px solid var(--color-rule-on-paper);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence__panel,
    .evidence__trigger {
      transition: none;
    }
  }

  /* Progressive enhancement: without JS, all credential panels show. */
  html:not(.js) .evidence__panel,
  html:not(.js) .evidence__panel[hidden] {
    display: grid !important;
    animation: none;
    margin-bottom: var(--space-5);
  }

  html:not(.js) .evidence__index {
    display: none;
  }
</style>
