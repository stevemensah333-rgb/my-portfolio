---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__mark" aria-hidden="true">SM</span>
      <div>
        <p class="site-footer__name">Stephen Mensah</p>
        <p class="mono-label site-footer__role">AI Engineering · Computer Science</p>
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <a class="site-footer__link" href="/">Index</a>
      <a class="site-footer__link" href="/work/">Work</a>
      <a class="site-footer__link" href="/lab/">Lab</a>
      <a class="site-footer__link" href="/profile/">Profile</a>
      <a class="site-footer__link" href="#contact">Contact</a>
    </nav>

    <p class="site-footer__meta">
      <span class="mono-label">© {year}</span>
      <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
    </p>
  </div>

  <p class="page-shell site-footer__tagline">
    Built and written by Stephen Mensah in Berekuso, Ghana. Content is grounded in public
    repositories; anything not yet verified is labelled UNKNOWN.
  </p>
</footer>

<style>
  /* The footer is the deepest surface on the page — below the
     contact terminus. It closes the environment. */
  .site-footer {
    background: var(--color-deck-deep);
    color: var(--color-text-on-canvas);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-footer__mark {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border: 1px solid var(--color-accent);
    background: transparent;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .site-footer__name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .site-footer__role {
    color: var(--color-text-on-canvas-muted);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }

  .site-footer__link {
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-small);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .site-footer__link:hover {
    color: var(--color-accent-text);
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-small);
  }

  .site-footer__meta a {
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .site-footer__meta a:hover {
    color: var(--color-accent-text);
  }

  .site-footer__tagline {
    margin: 0;
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px dashed var(--color-rule-on-canvas-soft);
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-small);
    line-height: 1.55;
    max-width: var(--width-reading);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-7);
    }

    .site-footer__nav {
      justify-self: center;
    }
  }
</style>
