---
import {
  illustrativeBadOutput,
  illustrativeValidOutput,
  sharedSyncareerStages,
  type SyncareerTraceStageId,
  type SyncareerTraceStageKind,
} from '../data/syncareerTrace';

type FullStage = {
  id: SyncareerTraceStageId;
  step: string;
  label: string;
  title: string;
  summary: string;
  detail: string;
  evidence: string;
  code: string | null;
  kind: SyncareerTraceStageKind;
};

const stages = [
  {
    ...sharedSyncareerStages.input,
    step: '01',
    summary: 'Degree, interests, activity, progress, weaknesses.',
    detail:
      'Syncareer supplies Claude with explicit context from the student profile so guidance can be tailored. Context includes degree, interests, skills, CV progress and interview activity.',
    code: null,
  },
  {
    ...sharedSyncareerStages.modelOutput,
    step: '02',
    summary: 'Mixed prose + inconsistent structure before constraints.',
    detail:
      'ILLUSTRATIVE EXAMPLE — not a historical Syncareer log. Shows the kind of format drift observed in production: malformed fields, prose bleed, missing required keys.',
    code: illustrativeBadOutput,
  },
  {
    ...sharedSyncareerStages.validation,
    step: '03',
    summary: 'Does output match product contract?',
    detail:
      'Gate that checks required fields and type expectations before the product uses the response. If validation fails, the path routes to failure diagnosis.',
    code: null,
  },
  {
    ...sharedSyncareerStages.failure,
    step: '04',
    summary: 'Formatting, context, structure.',
    detail:
      'Separate failures treated as distinct: inconsistent formatting, dropped context (activity/progress/weaknesses not retained), unpredictable response structure.',
    code: `// failure signals
- formatting varied
- context not always retained
- structure variable
// no measured failure rate supplied`,
  },
  {
    id: 'diagnosis',
    step: '05',
    label: 'DIAGNOSIS',
    title: 'Why it failed',
    summary: 'Prompt lacked explicit constraints; context not explicitly managed.',
    detail:
      'Root cause not reduced to one "AI problem". Each mode mapped to a specific missing constraint. Interpretation: prompt structure, context handling and expected output needed tighter control.',
    evidence: 'No invented root cause beyond observed behaviours.',
    code: null,
    kind: 'diagnosis',
  },
  {
    ...sharedSyncareerStages.intervention,
    step: '06',
    summary: 'Prompt restructuring + few-shot + explicit context + tighter constraints.',
    detail:
      'Implemented: restructured prompts, added few-shot examples to anchor expected structure, managed context explicitly, set clearer constraints around expected output. ILLUSTRATIVE pattern shown for constraint — not claiming exact historical prompt text.',
    code: `// illustrative constraint pattern
{
  "type": "object",
  "required": ["title","level","years"],
  "properties": {
    "title": {"type": "string"},
    "level": {"enum": ["junior","mid","senior"]},
    "years": {"type": "number"}
  }
}

// illustrative few-shot anchor
Example 1:
Input: CS student, 2yr exp
Output: {"title":"...","level":"mid"...}`,
  },
  {
    ...sharedSyncareerStages.output,
    step: '07',
    label: 'OUTPUT AFTERWARD',
    summary: 'Now conforms to product contract.',
    detail:
      'ILLUSTRATIVE valid output showing shape after intervention. Not claimed as historical Syncareer log. Measured reliability threshold not yet supplied — evidence boundary preserved.',
    code: illustrativeValidOutput,
  },
] satisfies FullStage[];
---

<section class="failure-trace" data-failure-trace aria-labelledby="trace-title">
  <header class="failure-trace__intro">
    <div>
      <p class="mono-label">Interactive failure trace / full inspector</p>
      <h3 id="trace-title">Inspect the path: input → validation → failure → fix → valid output.</h3>
    </div>
    <p class="failure-trace__legend">
      Click / focus a stage to reveal its detail. Keyboard: Tab + Enter, arrows to move.
      Values marked ILLUSTRATIVE are demo shapes, not historical logs.
    </p>
  </header>

  <div class="failure-trace__shell">
    <div class="failure-trace__rail" aria-hidden="true">
      <span class="failure-trace__rail-progress" data-rail-progress></span>
    </div>

    <div class="failure-trace__tablist" role="tablist" aria-label="Failure trace stages">
      {stages.map((stage, idx) => (
        <button
          role="tab"
          id={`tab-${stage.id}`}
          class="failure-trace__tab"
          data-stage-tab={stage.id}
          aria-controls={`panel-${stage.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          tabindex={idx === 0 ? '0' : '-1'}
          data-step={stage.step}
        >
          <span class="failure-trace__tab-meta">
            <span class="failure-trace__tab-step">{stage.step}</span>
            <span class="failure-trace__tab-label">{stage.label}</span>
          </span>
          <span class="failure-trace__tab-title">{stage.title}</span>
          <span class="failure-trace__tab-summary">{stage.summary}</span>
          <span class="failure-trace__tab-dot" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <div class="failure-trace__panels">
      {stages.map((stage, idx) => (
        <div
          role="tabpanel"
          id={`panel-${stage.id}`}
          aria-labelledby={`tab-${stage.id}`}
          class="failure-trace__panel"
          data-stage-panel={stage.id}
          data-active={idx === 0 ? 'true' : 'false'}
          tabindex="0"
          hidden={idx !== 0}
        >
          <header class="failure-trace__panel-header">
            <p class="mono-label">{stage.step} / {stage.label}</p>
            <h4>{stage.title}</h4>
            <p class="failure-trace__panel-detail">{stage.detail}</p>
          </header>

          {stage.code && (
            <div class="failure-trace__code">
              <div class="failure-trace__code-meta">
                <span>
                  {stage.kind === 'raw' ? 'ILLUSTRATIVE BAD OUTPUT' : stage.kind === 'valid' ? 'ILLUSTRATIVE VALID OUTPUT' : stage.kind === 'fail' ? 'Observed failure signals' : 'Illustrative pattern'}
                </span>
                <span class:list={['failure-trace__code-type', stage.kind === 'raw' && 'failure-trace__code-type--fail', stage.kind === 'valid' && 'failure-trace__code-type--pass']}>
                  {stage.kind}
                </span>
              </div>
              <pre><code>{stage.code}</code></pre>
              {stage.kind === 'raw' && (
                <p class="failure-trace__code-note">
                  Marked illustrative — not a historical Syncareer log. Used to show format drift type.
                </p>
              )}
              {stage.kind === 'valid' && (
                <p class="failure-trace__code-note">
                  Marked illustrative — shape matches product contract. No fabricated metrics.
                </p>
              )}
            </div>
          )}

          {stage.id === 'validation' && (
            <div class="failure-trace__validation-card">
              <span class="mono-label">Product expects</span>
              <strong>title, level, years, next_steps</strong>
              <span class="failure-trace__validation-rule" aria-hidden="true"></span>
              <span class="mono-label failure-trace__fail-text">Observed before fix</span>
              <strong class="failure-trace__fail-text">mixed prose + malformed fields</strong>
            </div>
          )}

          {stage.id === 'diagnosis' && (
            <div class="failure-trace__diagnosis">
              <div><span class="mono-label">Formatting</span><p>Needed explicit schema</p></div>
              <div><span class="mono-label">Context</span><p>Needed explicit re-injection</p></div>
              <div><span class="mono-label">Structure</span><p>Needed few-shot anchor</p></div>
            </div>
          )}

          <footer class="failure-trace__evidence">
            <span class="mono-label">Evidence</span>
            <p>{stage.evidence}</p>
          </footer>

          {(stage.id === 'failure' || stage.id === 'output') && (
            <p class="failure-trace__boundary">
              <span class="mono-label">Boundary</span>
              No measured before-and-after failure rate is claimed here. Evidence boundary preserved.
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { initTraceTabs } from '../scripts/initTraceTabs';

  const traceRoots = document.querySelectorAll<HTMLElement>('[data-failure-trace]');

  for (const root of traceRoots) {
    const rail = root.querySelector<HTMLElement>('[data-rail-progress]');
    initTraceTabs(root, {
      onSelect: (_id, index, count) => {
        if (!rail) return;
        const progress = (index / Math.max(count - 1, 1)) * 100;
        rail.style.setProperty('--progress', `${progress}%`);
        rail.dataset.step = String(index + 1);
      },
    });
  }
</script>

<style>
  .failure-trace {
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .failure-trace__intro {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .failure-trace__intro h3 {
    margin: var(--space-2) 0 0;
    max-width: 36ch;
    font-size: var(--text-component);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .failure-trace__legend {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .failure-trace__shell {
    position: relative;
    display: grid;
    overflow: hidden;
  }

  .failure-trace__rail {
    display: none;
  }

  .failure-trace__tablist {
    display: grid;
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
  }

  .failure-trace__tab {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: transparent;
    color: var(--color-text-on-paper-muted);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .failure-trace__tab:last-child { border-bottom: 0; }

  .failure-trace__tab-meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .failure-trace__tab-step {
    display: inline-flex;
    min-width: 2rem;
    justify-content: center;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .failure-trace__tab-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .failure-trace__tab-title {
    color: var(--color-text-on-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .failure-trace__tab-summary {
    color: var(--color-text-on-paper-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .failure-trace__tab-dot {
    position: absolute;
    left: 0;
    top: 50%;
    width: 2px;
    height: 1.5rem;
    background: transparent;
    transform: translateY(-50%);
    transition: background-color var(--duration-quick) var(--ease-standard);
  }

  .failure-trace__tab[data-active='true'] {
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper);
  }

  .failure-trace__tab[data-active='true'] .failure-trace__tab-dot {
    background: var(--color-accent);
  }

  .failure-trace__tab[data-past='true'] .failure-trace__tab-dot {
    background: var(--color-rule-on-paper);
  }

  .failure-trace__tab:hover,
  .failure-trace__tab:focus-visible {
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper);
  }

  .failure-trace__panels {
    padding: var(--space-5);
    background: var(--color-paper);
    min-height: 0;
    overflow: visible;
  }

  .failure-trace__panel {
    display: grid;
    gap: var(--space-4);
  }

  .failure-trace__panel[hidden] {
    display: none !important;
  }

  /* Progressive enhancement: without JS, every panel is shown. */
  html:not(.js) .failure-trace__panel,
  html:not(.js) .failure-trace__panel[hidden] {
    display: grid !important;
    margin-bottom: var(--space-5);
    border: 1px solid var(--color-rule-on-paper-soft);
    padding: var(--space-5);
  }

  html:not(.js) .failure-trace__tablist {
    display: none;
  }

  .failure-trace__panel-header h4 {
    margin: var(--space-2) 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .failure-trace__panel-detail {
    max-width: 40rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .failure-trace__code {
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    overflow: hidden;
  }

  .failure-trace__code-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .failure-trace__code-type {
    color: var(--color-accent);
  }

  .failure-trace__code-type--fail { color: var(--color-signal-fail); }
  .failure-trace__code-type--pass { color: var(--color-signal-pass); }

  .failure-trace__code pre {
    margin: 0;
    padding: var(--space-3);
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    max-height: 22rem;
  }

  .failure-trace__code-note {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .failure-trace__validation-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .failure-trace__validation-card strong {
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .failure-trace__validation-rule {
    height: 1px;
    background: var(--color-rule-on-paper);
    position: relative;
  }

  .failure-trace__validation-rule::after {
    content: '';
    position: absolute;
    right: 0;
    top: -0.25rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-accent);
    background: var(--color-paper);
  }

  .failure-trace__fail-text {
    color: var(--color-signal-fail);
  }

  .failure-trace__diagnosis {
    display: grid;
    gap: var(--space-2);
  }

  .failure-trace__diagnosis div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .failure-trace__diagnosis p {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .failure-trace__evidence {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .failure-trace__evidence p {
    margin: 0;
    max-width: 36rem;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .failure-trace__boundary {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent-tint) 30%, var(--color-paper));
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* Desktop bounded inspector */
  @media (min-width: 48rem) {
    .failure-trace__shell {
      grid-template-columns: 18rem minmax(0, 1fr);
      align-items: stretch;
    }

    .failure-trace__tablist {
      border-bottom: 0;
      border-right: 1px solid var(--color-rule-on-paper);
      display: grid;
      align-content: start;
      overflow-y: auto;
      max-height: 36rem;
    }

    .failure-trace__tab {
      border-bottom: 1px solid var(--color-rule-on-paper-soft);
    }

    .failure-trace__rail {
      display: block;
      position: absolute;
      left: calc(18rem - 1px);
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--color-rule-on-paper);
      pointer-events: none;
      z-index: 1;
    }

    .failure-trace__rail-progress {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--progress, 0%);
      background: var(--color-accent);
      transition: height var(--duration-base) var(--ease-standard);
    }

    .failure-trace__panels {
      padding: var(--space-5);
      max-height: 36rem;
      overflow-y: auto;
    }

    .failure-trace__diagnosis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.98rem) {
    .failure-trace__tablist {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }

    .failure-trace__tab {
      flex: 0 0 auto;
      min-width: 12rem;
      max-width: 16rem;
      border-right: 1px solid var(--color-rule-on-paper-soft);
      border-bottom: 0;
      scroll-snap-align: start;
    }

    .failure-trace__validation-card {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .failure-trace__validation-rule {
      width: 1px;
      height: 1.25rem;
      margin-left: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .failure-trace__rail-progress,
    .failure-trace__tab {
      transition: none;
    }
  }
</style>
