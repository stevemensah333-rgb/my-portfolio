---
interface Props { id: string; linked?: boolean; priority?: boolean; shared?: boolean; }
const {id,linked=true,priority=false,shared=true}=Astro.props;
---
<div class:list={['project-artifact',`project-artifact--${id}`,{'project-artifact--linked':linked}]} data-tilt transition:name={shared ? `artifact-${id}` : undefined}>
  <div class="artifact-top"><span>{id==='syncareer'?'Syncareer / product capture':id==='sessionbook'?'SessionBook / tool exchange':'Koranco / module map'}</span><span aria-hidden="true">{linked?'↗':'＋'}</span></div>
  {id==='syncareer'?<div class="capture-mat"><picture><source type="image/webp" srcset="/images/syncareer/dashboard-1440.webp 1440w, /images/syncareer/dashboard-1800.webp 1800w" sizes="(min-width: 900px) 55vw, 92vw"/><img src="/images/syncareer/dashboard-1440.png" width="2400" height="1302" alt="Real Syncareer dashboard: applications, CV strength and interview progress" fetchpriority={priority?'high':'auto'} loading={priority?'eager':'lazy'} /></picture><span class="capture-caption">A real product. One application record.</span></div>:
   id==='sessionbook'?<div class="booking-art"><div class="booking-question"><span class="booking-label">Caller</span><p>“Is there a time<br />on Friday?”</p></div><div class="booking-route"><span>Voice agent</span><b aria-hidden="true">↓</b><code>POST /tools/check_availability</code><b aria-hidden="true">↓</b><span class="booking-slot">09:00 <i aria-hidden="true"></i> Available</span></div><p class="artifact-note">Illustrative exchange · source-defined route · no live call</p></div>:
   <div class="farm-art"><div class="farm-origin"><span aria-hidden="true">⌁</span><p>One farm.<br />Three connected records.</p></div><div class="farm-modules"><span>Attendance<small>Presence</small></span><span>Produce<small>Output</small></span><span>Employees<small>People</small></span></div><p class="artifact-note">Conceptual module map · not a product screenshot</p></div>}
  {linked&&<span class="artifact-open">Open project <span aria-hidden="true">↗</span></span>}
</div>
<script>
const init=()=>{const media=matchMedia('(prefers-reduced-motion: reduce)');document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(el=>{if(el.dataset.tiltReady)return;el.dataset.tiltReady='1';let frame=0;const reset=()=>{cancelAnimationFrame(frame);el.style.removeProperty('transform')};el.addEventListener('pointermove',e=>{if(media.matches||e.pointerType!=='mouse')return;cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{const r=el.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5;const y=(e.clientY-r.top)/r.height-.5;el.style.transform=`perspective(1200px) rotateX(${-y*3}deg) rotateY(${x*3}deg)`})});el.addEventListener('pointerleave',reset);media.addEventListener('change',reset);document.addEventListener('astro:before-swap',reset,{once:true});})};init();document.addEventListener('astro:page-load',init);
</script>
<style>
.project-artifact{position:relative;border:1px solid #c8c3b5;background:var(--color-sheet-raised);box-shadow:0 12px 24px -20px #171a1b77;transform-origin:center;transition:transform 200ms var(--ease-standard);overflow:hidden;isolation:isolate}.artifact-top{display:flex;justify-content:space-between;gap:.5rem;padding:.8rem 1rem;font-size:.7rem;color:#4e5652;border-bottom:1px solid #d4cfc3}.artifact-top>span:last-child{color:var(--color-accent-text)}.capture-mat{background:#dce7d6;padding:clamp(1rem,3vw,3rem) clamp(1rem,3vw,3rem) 0}.capture-mat picture{display:block;box-shadow:0 12px 25px #194e471a;border:1px solid #bbcdb7}.capture-mat img{width:100%;height:auto}.capture-caption{display:block;font-size:.72rem;color:#194e47;padding:1rem 0}.booking-art{background:#e8ece7;padding:clamp(1.3rem,3vw,2.5rem);color:#193d36}.booking-question{display:flex;gap:1.5rem;align-items:start}.booking-label{font-family:var(--font-instrument);font-size:.65rem;border:1px solid #a8bab0;padding:.25rem .45rem}.booking-question p{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.5rem);line-height:1.2}.booking-route{display:grid;justify-items:center;gap:.5rem;margin-top:1.4rem}.booking-route>span:first-child{font-size:.75rem}.booking-route b{font-weight:400;color:#65796e}.booking-route code{font-size:clamp(.6rem,1vw,.8rem);background:#194e47;color:#f4f0e6;padding:.65rem .9rem}.booking-slot{display:flex;align-items:center;gap:1rem;background:#fffcf5;border:1px solid #b7c7bd;padding:.5rem 1rem;font-size:.8rem}.booking-slot i{width:5px;height:5px;border-radius:50%;background:#194e47}.artifact-note{font-size:.65rem;text-align:center;margin-top:1.5rem;color:#4e5652}.farm-art{padding:clamp(1.25rem,3vw,2.5rem);background:#ece2cd}.farm-origin{display:flex;gap:1.3rem;align-items:center}.farm-origin>span{font-size:4rem;color:#86603c;line-height:1}.farm-origin p{font-family:var(--font-display);font-size:clamp(1.5rem,2.5vw,2.2rem);line-height:1.15}.farm-modules{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid #bcb099}.farm-modules>span{font-size:clamp(.7rem,1.2vw,.9rem);font-weight:500}.farm-modules small{display:block;font-size:.65rem;font-weight:400;margin-top:.3rem;color:#665a48}.artifact-open{position:absolute;right:1rem;bottom:1rem;background:#171a1b;color:#fffcf5;padding:.5rem .85rem;font-size:.75rem;display:flex;gap:1.5rem;opacity:0;translate:0 5px;transition:opacity 160ms,translate 160ms;pointer-events:none}.project-artifact--linked:hover .artifact-open,:global(a:focus-visible) .artifact-open{opacity:1;translate:0 0}@media(hover:none){.artifact-open{opacity:1;translate:none;position:static;justify-content:space-between}}
</style>
