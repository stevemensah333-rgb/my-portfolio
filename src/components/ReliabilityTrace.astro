---
import { causalTrace } from '../data/syncareerInvestigation';

interface Props {
  /** Optional id used to disambiguate when multiple traces render on the same page. */
  instanceId?: string;
}

const { instanceId } = Astro.props;
const traceId = instanceId ? `reliability-trace-${instanceId}` : 'reliability-trace';
const copy = causalTrace;
---

<div class="trace trace--hero" data-reliability-trace>
    <header class="trace__topbar">
      <span id={`${traceId}-title`} class="trace__title">
        <span class="trace__title-prefix">▸</span> Reliability trace · CV rewrite
      </span>
      <span class="trace__status">
        <span class="trace__status-dot" aria-hidden="true"></span>
        <span data-trace-status-label>Ready</span>
      </span>
    </header>

    <div class="trace__engine" role="region" aria-label="Reliability trace">
      <!-- The rail is a causal chain, not a list. Each stage carries
           a data-phase: the two phases that matter are BREAK (the
           output failed the gate) and REPAIR (the contract that
           fixed it). The spine running through the nodes turns
           copper at the intervention, so the eye sees where the
           engineering happened before reading a word. -->
      <div class="trace__chain">
      <ol class="trace__rail" data-trace-rail aria-label="Causal stages">
        <li>
          <button type="button" class="trace__step" data-stage="raw" data-phase="emit" data-active="true" aria-current="step" data-readout="Unstructured model output — fluent bullet with no evidence">
            <span class="trace__step-node" aria-hidden="true"></span>
            <span class="trace__step-num">01</span>
            <span class="trace__step-label">Raw</span>
            <span class="trace__step-state" data-step-state>unstructured</span>
          </button>
        </li>
        <li>
          <button type="button" class="trace__step" data-stage="validate" data-phase="gate" data-readout="Contract gate — must cite requirement + evidence">
            <span class="trace__step-node" aria-hidden="true"></span>
            <span class="trace__step-num">02</span>
            <span class="trace__step-label">Validate</span>
            <span class="trace__step-state" data-step-state>check</span>
          </button>
        </li>
        <li>
          <button type="button" class="trace__step" data-stage="failed" data-phase="break" data-readout="Rewrite refused — no citations, risky claims">
            <span class="trace__step-node" aria-hidden="true"></span>
            <span class="trace__step-num">03</span>
            <span class="trace__step-label">Failed</span>
            <span class="trace__step-state trace__step-state--fail" data-step-state>invalid</span>
          </button>
        </li>
        <li>
          <button type="button" class="trace__step" data-stage="intervene" data-phase="repair" data-readout="Intervention — bounded prompts, citations, risk checks">
            <span class="trace__step-node" aria-hidden="true"></span>
            <span class="trace__step-num">04</span>
            <span class="trace__step-label">Intervene</span>
            <span class="trace__step-state trace__step-state--active" data-step-state>fix</span>
          </button>
        </li>
        <li>
          <button type="button" class="trace__step" data-stage="valid" data-phase="accept" data-readout="Cited output — ready for review, not auto-applied">
            <span class="trace__step-node" aria-hidden="true"></span>
            <span class="trace__step-num">05</span>
            <span class="trace__step-label">Valid</span>
            <span class="trace__step-state trace__step-state--valid" data-step-state>pass</span>
          </button>
        </li>
      </ol>
      <p class="trace__readout">
        <span class="mono-label mono-label--inverse mono-label--bare" data-trace-readout-label>Active · 01</span>
        <span data-trace-readout-text>Unstructured model output — fluent bullet with no evidence</span>
      </p>
      </div>

      <div class="trace__stage">
        <article class="trace__panel" data-panel="raw" data-panel-active="true">
          <header class="trace__panel-header">
            <span class="trace__panel-tag">raw</span>
            <p class="trace__panel-title">Unstructured model output</p>
          </header>
          <pre class="trace__code"><code data-code-raw>{copy.raw}</code><span class="trace__cursor" aria-hidden="true"></span></pre>
          <p class="trace__panel-note">
            Illustrative: a fluent bullet the supplied evidence does not support.
          </p>
        </article>

        <article class="trace__panel" data-panel="validate">
          <header class="trace__panel-header">
            <span class="trace__panel-tag">check</span>
            <p class="trace__panel-title">Proposal contract gate</p>
          </header>
          <ul class="trace__gate">
            {copy.gates.map((gate) => (
              <li>
                <span>{gate.label}</span>
                <i data-gate={gate.id} aria-hidden="true"></i>
                <b>{gate.rule}</b>
              </li>
            ))}
          </ul>
          <p class="trace__panel-note">
            Does the output match parseModelProposal — and cite requirement + evidence?
          </p>
        </article>

        <article class="trace__panel" data-panel="failed">
          <header class="trace__panel-header">
            <span class="trace__panel-tag trace__panel-tag--fail">invalid</span>
            <p class="trace__panel-title">Why this rewrite is refused</p>
          </header>
          <ul class="trace__failures">
            {copy.failureClasses.map((mode) => (
              <li><span>{mode.name}</span>{mode.note && <b>{mode.note}</b>}</li>
            ))}
          </ul>
          <p class="trace__panel-note">
            Failure classes from the evidence-grounding notes. No failure rate is claimed.
          </p>
        </article>

        <article class="trace__panel" data-panel="intervene">
          <header class="trace__panel-header">
            <span class="trace__panel-tag trace__panel-tag--active">fix</span>
            <p class="trace__panel-title">What the contract now requires</p>
          </header>
          <ol class="trace__interventions" data-intervention-list>
            {copy.interventions.map((item) => (
              <li data-revealed="false">{item}</li>
            ))}
          </ol>
        </article>

        <article class="trace__panel" data-panel="valid">
          <header class="trace__panel-header">
            <span class="trace__panel-tag trace__panel-tag--valid">pass</span>
            <p class="trace__panel-title">Cited output the product can review</p>
          </header>
          <pre class="trace__code trace__code--valid"><code data-code-valid>{copy.valid}</code><span class="trace__cursor trace__cursor--valid" aria-hidden="true"></span></pre>
          <p class="trace__panel-note">
            Fixture accepted by the revised validator. Not a live provider sample.
          </p>
        </article>
      </div>

      <footer class="trace__bottombar">
        <div class="trace__controls">
          <button type="button" class="trace__replay" data-replay aria-label="Replay reliability trace">
            <span class="trace__replay-mark" aria-hidden="true">↻</span>
            <span>Replay</span>
          </button>
          <button type="button" class="trace__replay trace__replay--ghost" data-step-prev aria-label="Previous stage">
            ← Prev
          </button>
          <button type="button" class="trace__replay trace__replay--ghost" data-step-next aria-label="Next stage">
            Next →
          </button>
        </div>
        <span class="trace__legend mono-label">
          Illustrative · not a historical log
        </span>
      </footer>

      <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-live></div>
    </div>
  </div>
</div>

<script>
  import { causalTrace } from '../data/syncareerInvestigation';

  const traces = document.querySelectorAll<HTMLElement>('[data-reliability-trace]');
  const rawText = causalTrace.raw;
  const validText = causalTrace.valid;
  const gateIds = causalTrace.gates.map((gate) => gate.id);

  for (const root of traces) {
    const rail = root.querySelector<HTMLElement>('[data-trace-rail]');
    if (!rail) continue;
    const steps = [...rail.querySelectorAll<HTMLElement>('.trace__step')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const codeRaw = root.querySelector<HTMLElement>('[data-code-raw]');
    const codeValid = root.querySelector<HTMLElement>('[data-code-valid]');
    const gates = [...root.querySelectorAll<HTMLElement>('[data-gate]')];
    const statusLabel = root.querySelector<HTMLElement>('[data-trace-status-label]');
    const live = root.querySelector<HTMLElement>('[data-live]');
    const replayBtn = root.querySelector<HTMLButtonElement>('[data-replay]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-step-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-step-next]');
    const interventionList = root.querySelector<HTMLElement>('[data-intervention-list]');
    const readoutLabel = root.querySelector<HTMLElement>('[data-trace-readout-label]');
    const readoutText = root.querySelector<HTMLElement>('[data-trace-readout-text]');

    if (!codeRaw || !codeValid || !live) continue;

    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = reducedQuery.matches;
    let activeRun = 0;
    let hasPlayed = false;
    let paused = false;
    let currentIndex = 0;

    const readouts = steps.map(s => s.dataset.readout ?? '');

    document.addEventListener('visibilitychange', () => {
      paused = document.hidden;
    });
    reducedQuery.addEventListener('change', (event) => {
      reduced = event.matches;
      if (reduced) {
        // Mid-run flip: cancel the engine and jump to the final state so
        // no information is left hidden behind cancelled animation.
        activeRun += 1;
        paused = false;
        populateStatic(steps.length - 1);
        setStatus('Complete · pass', 'pass');
        if (live) {
          live.textContent = 'Reliability trace: ungrounded rewrite failed validation; intervention produced a cited proposal.';
        }
      }
    });

    const wait = (ms: number, runId: number) => new Promise<boolean>((resolve) => {
      let elapsed = 0;
      const step = 50;
      const tick = () => {
        if (runId !== activeRun) { resolve(false); return; }
        if (!paused) elapsed += step;
        if (elapsed >= ms) resolve(true);
        else setTimeout(tick, step);
      };
      setTimeout(tick, step);
    });

    const typeInto = async (el: HTMLElement, text: string, runId: number, speed = 14) => {
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        if (runId !== activeRun) return false;
        while (paused) {
          if (!(await wait(100, runId))) return false;
        }
        if (runId !== activeRun) return false;
        el.textContent += text[i];
        if (!(await wait(speed + Math.random() * 6, runId))) return false;
      }
      return true;
    };

    const setReadout = (index: number, source: 'active' | 'hover') => {
      const stepNum = steps[index]?.querySelector('.trace__step-num')?.textContent?.trim() ?? String(index + 1).padStart(2, '0');
      if (readoutLabel) {
        readoutLabel.textContent = source === 'hover' ? `Inspect · ${stepNum}` : `Active · ${stepNum}`;
      }
      if (readoutText) readoutText.textContent = readouts[index] ?? '';
    };

    const setActive = (index: number) => {
      currentIndex = index;
      steps.forEach((s, i) => {
        s.dataset.active = String(i <= index);
        s.dataset.current = String(i === index);
        if (i === index) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      panels.forEach((p, i) => {
        p.dataset.panelActive = String(i === index);
        if (i === index) {
          p.classList.remove('reveal-enter');
          void p.offsetWidth;
          p.classList.add('reveal-enter');
        }
      });
      setReadout(index, 'active');
    };

    const setStatus = (text: string, tone: 'ready' | 'running' | 'fail' | 'pass') => {
      if (statusLabel) {
        statusLabel.textContent = text;
        statusLabel.dataset.tone = tone;
      }
    };

    const setGate = (gate: string, state: 'pass' | 'fail' | '') => {
      const el = gates.find((g) => g.dataset.gate === gate);
      if (!el) return;
      if (state) el.dataset.state = state;
      else delete el.dataset.state;
    };

    const setInterventions = (revealed: boolean) => {
      if (!interventionList) return;
      interventionList.querySelectorAll('li').forEach((li) => {
        (li as HTMLElement).dataset.revealed = String(revealed);
      });
    };

    const populateStatic = (index: number) => {
      codeRaw.textContent = index >= 0 ? rawText : '';
      codeValid.textContent = index >= 4 ? validText : '';
      for (const gate of gateIds) {
        if (index >= 4) setGate(gate, 'pass');
        else if (index >= 1) setGate(gate, 'fail');
        else setGate(gate, '');
      }
      setInterventions(index >= 3);
      panels.forEach((p) => p.classList.remove('is-typing'));
      setActive(index);
      const tones = ['running', 'running', 'fail', 'running', 'pass'] as const;
      const labels = [
        'Inspect · raw',
        'Inspect · validate',
        'Inspect · failed',
        'Inspect · intervene',
        'Inspect · valid',
      ];
      setStatus(labels[index] ?? 'Ready', tones[index] ?? 'ready');
    };

    const resetVisual = () => {
      codeRaw.textContent = '';
      codeValid.textContent = '';
      for (const gate of gateIds) setGate(gate, '');
      setInterventions(false);
      steps.forEach((s) => {
        s.dataset.active = 'false';
        s.dataset.current = 'false';
        s.removeAttribute('aria-current');
      });
      panels.forEach((p, i) => {
        p.dataset.panelActive = String(i === 0);
        p.classList.remove('is-typing', 'is-revealed');
      });
      const first = steps[0];
      if (first) first.dataset.active = 'true';
      setStatus('Ready', 'ready');
    };

    const inspect = (index: number, announce = true) => {
      activeRun += 1;
      populateStatic(index);
      if (announce) {
        const names = [
          'Stage 1: unstructured model output.',
          'Stage 2: proposal contract gate.',
          'Stage 3: rewrite refused.',
          'Stage 4: contract intervention.',
          'Stage 5: cited output ready for review.',
        ];
        live.textContent = names[index] ?? '';
      }
    };

    const play = async () => {
      const runId = ++activeRun;

      if (reduced) {
        populateStatic(steps.length - 1);
        setStatus('Complete · pass', 'pass');
        live.textContent = 'Reliability trace: ungrounded rewrite failed validation; intervention produced a cited proposal.';
        return;
      }

      resetVisual();
      setStatus('Running · raw', 'running');

      setActive(0);
      live.textContent = 'Stage 1: unstructured model output.';
      root.querySelector<HTMLElement>('[data-panel="raw"]')?.classList.add('is-typing');
      if (!(await typeInto(codeRaw, rawText, runId, 10))) return;
      root.querySelector<HTMLElement>('[data-panel="raw"]')?.classList.remove('is-typing');
      if (!(await wait(400, runId))) return;

      setActive(1);
      setStatus('Running · validate', 'running');
      live.textContent = 'Stage 2: proposal contract gate.';
      for (const gate of gateIds) {
        if (runId !== activeRun) return;
        setGate(gate, 'fail');
        if (!(await wait(140, runId))) return;
      }
      if (!(await wait(380, runId))) return;

      setActive(2);
      setStatus('Failed · invalid', 'fail');
      live.textContent = 'Stage 3: rewrite refused.';
      if (!(await wait(700, runId))) return;

      setActive(3);
      setStatus('Running · intervene', 'running');
      live.textContent = 'Stage 4: applying the revised contract.';
      if (interventionList) {
        const items = [...interventionList.querySelectorAll<HTMLElement>('li')];
        for (const item of items) {
          if (!(await wait(220, runId))) return;
          item.dataset.revealed = 'true';
        }
      }
      if (!(await wait(420, runId))) return;

      setActive(4);
      setStatus('Running · valid', 'running');
      live.textContent = 'Stage 5: cited output ready for review.';
      for (const gate of gateIds) {
        if (runId !== activeRun) return;
        setGate(gate, 'pass');
        if (!(await wait(110, runId))) return;
      }
      const validStep = root.querySelector<HTMLElement>('[data-panel="valid"]');
      validStep?.classList.add('is-typing');
      if (!(await typeInto(codeValid, validText, runId, 9))) return;
      validStep?.classList.remove('is-typing');
      setActive(4);
      setStatus('Complete · pass', 'pass');
      live.textContent = 'Trace complete: ungrounded rewrite failed; intervention produced a cited proposal.';
    };

    replayBtn?.addEventListener('click', () => {
      paused = false;
      hasPlayed = true;
      play();
    });

    prevBtn?.addEventListener('click', () => {
      inspect(Math.max(0, currentIndex - 1));
    });
    nextBtn?.addEventListener('click', () => {
      inspect(Math.min(steps.length - 1, currentIndex + 1));
    });

    steps.forEach((step, index) => {
      step.addEventListener('click', () => inspect(index));
      step.addEventListener('keydown', (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        let next: number | null = null;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % steps.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + steps.length) % steps.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = steps.length - 1;
        if (next === null) return;
        event.preventDefault();
        steps[next]?.focus();
        inspect(next);
      });
      // hover / focus reveals information without owning it
      step.addEventListener('pointerenter', () => setReadout(index, 'hover'));
      step.addEventListener('pointerleave', () => setReadout(currentIndex, 'active'));
      step.addEventListener('focus', () => setReadout(index, 'hover'));
      step.addEventListener('blur', () => setReadout(currentIndex, 'active'));
    });

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting && !hasPlayed) {
          hasPlayed = true;
          play();
        }
      }
    }, { threshold: 0.3 });

    io.observe(root);

    if (reduced) {
      populateStatic(steps.length - 1);
      root.classList.add('is-reduced');
    } else {
      resetVisual();
      root.classList.add('is-enhanced');
    }
  }
</script>

<style>
  /* ==========================================================
     RELIABILITY TRACE — the causal chain, made spatial.

     The rail carries a continuous SPINE. Circular nodes sit on it
     (the only curve in the system). The spine and node change
     tone by phase, so the shape of the story — emit, gate, BREAK,
     REPAIR, accept — is readable before any text is.

     State is never colour-only: the active stage also gains a
     filled node, a copper edge and a shifted background.
     ========================================================== */

  .trace {
    position: relative;
    background: var(--color-deck-soft);
    color: var(--color-text-on-canvas);
    border: 1px solid var(--color-rule-on-canvas);
  }

  .trace--hero {
    width: 100%;
  }

  .trace__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .trace__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trace__title-prefix {
    color: var(--color-accent-text);
  }

  .trace__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trace__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--color-accent);
    border-radius: 50%;
  }

  [data-trace-status-label][data-tone='running'] { color: var(--color-accent-text); }
  [data-trace-status-label][data-tone='fail'] { color: var(--color-signal-fail-text); }
  [data-trace-status-label][data-tone='pass'] { color: var(--color-signal-pass-text); }

  .trace__engine {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  /* Chain + readout are bounded together. This is the one real
     container inside the trace, and it exists because there IS a
     boundary: everything inside it is the live mechanism. */
  .trace__chain {
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck-soft);
  }

  .trace__rail {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* THE SPINE — one continuous line behind every node. It is the
     thing that makes this a trace rather than five rows. */
  .trace__rail::before {
    content: '';
    position: absolute;
    top: 1.15rem;
    bottom: 1.15rem;
    left: calc(var(--space-3) + 0.3125rem);
    width: 1px;
    background: var(--color-rule-on-canvas-strong);
  }

  .trace__step {
    position: relative;
    display: grid;
    grid-template-columns: 0.625rem 1.75rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    width: 100%;
    padding: var(--space-3);
    border: 0;
    border-left: 2px solid transparent;
    color: var(--color-text-on-canvas-muted);
    background: transparent;
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard);
  }

  /* ARC NODE — the stage marker. Hollow when pending, filled when
     reached. Phase drives the colour; fill drives the state, so
     the two are independent and neither is colour-only. */
  .trace__step-node {
    position: relative;
    z-index: 1;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    border: 1px solid var(--color-rule-on-canvas-strong);
    background: var(--color-deck-soft);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .trace__step[data-phase='break'] .trace__step-node {
    border-color: var(--color-signal-fail-bright);
  }

  .trace__step[data-phase='repair'] .trace__step-node {
    border-color: var(--color-accent-bright);
  }

  .trace__step[data-phase='accept'] .trace__step-node {
    border-color: var(--color-signal-pass-bright);
  }

  /* Reached stages fill their node — progress is a physical
     property of the chain, not a colour wash. */
  .trace__step[data-active='true'] .trace__step-node {
    background: var(--color-text-on-canvas-muted);
    border-color: var(--color-text-on-canvas-muted);
  }

  .trace__step[data-active='true'][data-phase='break'] .trace__step-node {
    background: var(--color-signal-fail-bright);
    border-color: var(--color-signal-fail-bright);
  }

  .trace__step[data-active='true'][data-phase='repair'] .trace__step-node {
    background: var(--color-accent-bright);
    border-color: var(--color-accent-bright);
  }

  .trace__step[data-active='true'][data-phase='accept'] .trace__step-node {
    background: var(--color-signal-pass-bright);
    border-color: var(--color-signal-pass-bright);
  }

  /* The CURRENT stage gets a ring — the one node under inspection. */
  .trace__step[data-current='true'] .trace__step-node {
    box-shadow: 0 0 0 3px var(--color-deck-soft), 0 0 0 4px var(--color-accent-bright);
  }

  .trace__step-num {
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .trace__step[data-current='true'] .trace__step-num {
    color: var(--color-accent-text);
  }

  .trace__step-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* State tags are metadata, not badges: no fill, no border box —
     just a mono word held by a hairline underline so it reads as a
     reading on an instrument. */
