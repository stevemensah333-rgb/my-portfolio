---
interface Props {
  variant?: 'hero' | 'portrait';
}

const { variant = 'hero' } = Astro.props;
---

{variant === 'hero' ? (
  <aside
    class="trace trace--hero"
    data-reliability-trace
    aria-labelledby="reliability-trace-title"
  >
    <header class="trace__topbar">
      <span id="reliability-trace-title" class="trace__title">
        <span class="trace__title-prefix">▸</span> Reliability trace
      </span>
      <span class="trace__status">
        <span class="trace__status-dot" aria-hidden="true"></span>
        <span data-trace-status-label>Ready</span>
      </span>
    </header>

    <div class="trace__engine" role="region" aria-label="Reliability trace animation">
      <ol class="trace__rail" data-trace-rail aria-label="Stages">
        <li class="trace__step" data-stage="raw" data-active="true">
          <span class="trace__step-num">01</span>
          <span class="trace__step-label">Input</span>
          <span class="trace__step-state" data-step-state>raw</span>
        </li>
        <li class="trace__step" data-stage="validate">
          <span class="trace__step-num">02</span>
          <span class="trace__step-label">Validate</span>
          <span class="trace__step-state" data-step-state>check</span>
        </li>
        <li class="trace__step" data-stage="failed">
          <span class="trace__step-num">03</span>
          <span class="trace__step-label">Failed</span>
          <span class="trace__step-state trace__step-state--fail" data-step-state>invalid</span>
        </li>
        <li class="trace__step" data-stage="intervene">
          <span class="trace__step-num">04</span>
          <span class="trace__step-label">Intervene</span>
          <span class="trace__step-state trace__step-state--active" data-step-state>fix</span>
        </li>
        <li class="trace__step" data-stage="valid">
          <span class="trace__step-num">05</span>
          <span class="trace__step-label">Output</span>
          <span class="trace__step-state trace__step-state--valid" data-step-state>pass</span>
        </li>
      </ol>

      <div class="trace__stage">
        <article class="trace__panel" data-panel="raw" data-panel-active="true">
          <header class="trace__panel-header">
            <span class="trace__panel-tag">raw</span>
            <h4 class="trace__panel-title">Unstructured model output</h4>
          </header>
          <pre class="trace__code"><code data-code-raw></code><span class="trace__cursor" aria-hidden="true"></span></pre>
          <p class="trace__panel-note">
            Illustrative: model responded with mixed prose and a malformed structure.
          </p>
        </article>

        <article class="trace__panel" data-panel="validate">
          <header class="trace__panel-header">
            <span class="trace__panel-tag">check</span>
            <h4 class="trace__panel-title">Schema validation gate</h4>
          </header>
          <ul class="trace__gate">
            <li><span>title</span><i data-gate="title"></i><b>required · string</b></li>
            <li><span>level</span><i data-gate="level"></i><b>required · enum</b></li>
            <li><span>years</span><i data-gate="years"></i><b>required · number</b></li>
            <li><span>next_steps</span><i data-gate="next_steps"></i><b>required · array</b></li>
          </ul>
          <p class="trace__panel-note">
            Gate: does the output match the product contract before use?
          </p>
        </article>

        <article class="trace__panel" data-panel="failed">
          <header class="trace__panel-header">
            <span class="trace__panel-tag trace__panel-tag--fail">invalid</span>
            <h4 class="trace__panel-title">Observed failure modes</h4>
          </header>
          <ul class="trace__failures">
            <li><span>01</span>Missing quotes around keys</li>
            <li><span>02</span>Dropped required fields</li>
            <li><span>03</span>Prose bleed between fields</li>
          </ul>
          <p class="trace__panel-note">
            Each mode observed in production — failure rate not claimed.
          </p>
        </article>

        <article class="trace__panel" data-panel="intervene">
          <header class="trace__panel-header">
            <span class="trace__panel-tag trace__panel-tag--active">fix</span>
            <h4 class="trace__panel-title">Constraint / retry / context fix</h4>
          </header>
          <ol class="trace__interventions" data-intervention-list>
            <li data-revealed="false">Explicit JSON schema + few-shot anchor</li>
            <li data-revealed="false">Context re-injection on every call</li>
            <li data-revealed="false">Tighter output constraints (enum, types)</li>
          </ol>
        </article>

        <article class="trace__panel" data-panel="valid">
          <header class="trace__panel-header">
            <span class="trace__panel-tag trace__panel-tag--valid">pass</span>
            <h4 class="trace__panel-title">Valid output</h4>
          </header>
          <pre class="trace__code trace__code--valid"><code data-code-valid></code><span class="trace__cursor trace__cursor--valid" aria-hidden="true"></span></pre>
          <p class="trace__panel-note">
            Shape matches the product contract — no fabricated metrics.
          </p>
        </article>
      </div>

      <footer class="trace__bottombar">
        <button type="button" class="trace__replay" data-replay aria-label="Replay reliability trace animation">
          <span class="trace__replay-mark" aria-hidden="true">↻</span>
          <span>Replay trace</span>
        </button>
        <span class="trace__legend mono-label" aria-hidden="true">
          Illustrative · not a historical log
        </span>
      </footer>

      <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-live></div>

      <noscript>
        <div class="trace__noscript">
          <p class="mono-label">No-JS fallback: raw output fails validation, intervention produces valid output.</p>
          <pre class="trace__code"><code>{`To get senior role you should...
- learn python
- build things

{
  title: Senior Developer
  level:`}</code></pre>
          <pre class="trace__code trace__code--valid"><code>{`{
  "title": "Senior Developer",
  "level": "senior",
  "years": 5,
  "next_steps": ["ship one AI feature", "add validation"]
}`}</code></pre>
        </div>
      </noscript>
    </div>
  </aside>
) : (
  <div class="trace trace--portrait" aria-hidden="true">
    <svg viewBox="0 0 180 58">
      <path d="M2 29 H48 V12 H91 V45 H134 V29 H178" class="trace__path" />
      <rect x="45" y="9" width="6" height="6" class="trace__point" />
      <rect x="88" y="42" width="6" height="6" class="trace__point trace__point--active" />
      <rect x="131" y="26" width="6" height="6" class="trace__point" />
    </svg>
  </div>
)}

<script>
  const traces = document.querySelectorAll<HTMLElement>('[data-reliability-trace]');

  const rawText = `To get senior role you should...
- learn python
- build things

{
  title: Senior Developer
  level:`;

  const validText = `{
  "title": "Senior Developer",
  "level": "senior",
  "years": 5,
  "next_steps": [
    "ship one AI feature",
    "add validation"
  ]
}`;

  for (const root of traces) {
    const rail = root.querySelector<HTMLElement>('[data-trace-rail]');
    if (!rail) continue;
    const steps = [...rail.querySelectorAll<HTMLElement>('.trace__step')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const codeRaw = root.querySelector<HTMLElement>('[data-code-raw]');
    const codeValid = root.querySelector<HTMLElement>('[data-code-valid]');
    const gates = [...root.querySelectorAll<HTMLElement>('[data-gate]')];
    const statusLabel = root.querySelector<HTMLElement>('[data-trace-status-label]');
    const live = root.querySelector<HTMLElement>('[data-live]');
    const replayBtn = root.querySelector<HTMLButtonElement>('[data-replay]');
    const interventionList = root.querySelector<HTMLElement>('[data-intervention-list]');

    if (!codeRaw || !codeValid || !live) continue;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeRun = 0;
    let hasPlayed = false;
    // Pause only on hover (not on focus) and never pause while the replay
    // button is hovered — this is the R1 fix from the audit.
    let paused = false;

    const isInteractiveChild = (target: EventTarget | null) =>
      target instanceof HTMLElement && Boolean(target.closest('[data-replay]'));

    root.addEventListener('mouseenter', (event) => {
      if (!isInteractiveChild(event.target)) paused = true;
    });
    root.addEventListener('mouseleave', () => { paused = false; });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) paused = true;
      else paused = false;
    });

    const wait = (ms: number, runId: number) => new Promise<boolean>((resolve) => {
      let elapsed = 0;
      const step = 50;
      const tick = () => {
        if (runId !== activeRun) { resolve(false); return; }
        if (!paused) elapsed += step;
        if (elapsed >= ms) resolve(true);
        else setTimeout(tick, step);
      };
      setTimeout(tick, step);
    });

    const typeInto = async (el: HTMLElement, text: string, runId: number, speed = 14) => {
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        if (runId !== activeRun) return false;
        while (paused) {
          if (!(await wait(100, runId))) return false;
        }
        if (runId !== activeRun) return false;
        el.textContent += text[i];
        if (!(await wait(speed + Math.random() * 6, runId))) return false;
      }
      return true;
    };

    const setActive = (index: number) => {
      steps.forEach((s, i) => {
        s.dataset.active = String(i <= index);
        s.dataset.current = String(i === index);
        if (i === index) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      panels.forEach((p, i) => {
        p.dataset.panelActive = String(i === index);
      });
    };

    const resetVisual = () => {
      codeRaw.textContent = '';
      codeValid.textContent = '';
      for (const g of gates) {
        g.dataset.gate = '';
      }
      if (interventionList) {
        interventionList.querySelectorAll('li').forEach(li => (li as HTMLElement).dataset.revealed = 'false');
      }
      steps.forEach(s => {
        s.dataset.active = 'false';
        s.dataset.current = 'false';
        s.removeAttribute('aria-current');
      });
      panels.forEach((p, i) => {
        p.dataset.panelActive = String(i === 0);
        p.classList.remove('is-typing', 'is-revealed');
      });
      const first = steps[0];
      if (first) first.dataset.active = 'true';
      if (statusLabel) statusLabel.textContent = 'Ready';
    };

    const setStatus = (text: string, tone: 'ready' | 'running' | 'fail' | 'pass') => {
      if (statusLabel) {
        statusLabel.textContent = text;
        statusLabel.dataset.tone = tone;
      }
    };

    const setGate = (gate: string, state: 'pass' | 'fail') => {
      const el = gates.find(g => g.dataset.gate === gate);
      if (el) el.dataset.state = state;
    };

    const play = async () => {
      const runId = ++activeRun;

      if (reduced) {
        // reduced motion: show final state immediately
        codeRaw.textContent = rawText;
        codeValid.textContent = validText;
        for (const gate of ['title', 'level', 'years', 'next_steps']) setGate(gate, 'fail');
        setGate('title', 'pass');
        setGate('level', 'pass');
        setGate('years', 'pass');
        setGate('next_steps', 'pass');
        if (interventionList) interventionList.querySelectorAll('li').forEach(li => (li as HTMLElement).dataset.revealed = 'true');
        setActive(steps.length - 1);
        setStatus('Complete · pass', 'pass');
        live.textContent = 'Reliability trace: raw output failed validation, intervention applied, valid output produced.';
        return;
      }

      resetVisual();
      setStatus('Running · raw', 'running');

      // Stage 0: raw
      setActive(0);
      live.textContent = 'Stage 1: unstructured model output.';
      root.querySelector<HTMLElement>('[data-panel="raw"]')?.classList.add('is-typing');
      if (!(await typeInto(codeRaw, rawText, runId, 10))) return;
      root.querySelector<HTMLElement>('[data-panel="raw"]')?.classList.remove('is-typing');
      if (!(await wait(400, runId))) return;

      // Stage 1: validate
      setActive(1);
      setStatus('Running · validate', 'running');
      live.textContent = 'Stage 2: schema validation gate.';
      // show pass → fail cascade for the gates
      for (const gate of ['title', 'level', 'years', 'next_steps']) {
        if (runId !== activeRun) return;
        setGate(gate, 'fail');
        if (!(await wait(140, runId))) return;
      }
      if (!(await wait(380, runId))) return;

      // Stage 2: failed
      setActive(2);
      setStatus('Failed · invalid', 'fail');
      live.textContent = 'Stage 3: output failed validation.';
      if (!(await wait(700, runId))) return;

      // Stage 3: intervention
      setActive(3);
      setStatus('Running · intervene', 'running');
      live.textContent = 'Stage 4: applying constraint, retry, context fix.';
      if (interventionList) {
        const items = [...interventionList.querySelectorAll<HTMLElement>('li')];
        for (const item of items) {
          if (!(await wait(220, runId))) return;
          item.dataset.revealed = 'true';
        }
      }
      if (!(await wait(420, runId))) return;

      // Stage 4: valid — gates pass, valid output typed
      setActive(4);
      setStatus('Running · valid', 'running');
      live.textContent = 'Stage 5: re-validation and valid output.';
      for (const gate of ['title', 'level', 'years', 'next_steps']) {
        if (runId !== activeRun) return;
        setGate(gate, 'pass');
        if (!(await wait(110, runId))) return;
      }
      const validStep = root.querySelector<HTMLElement>('[data-panel="valid"]');
      validStep?.classList.add('is-typing');
      if (!(await typeInto(codeValid, validText, runId, 9))) return;
      validStep?.classList.remove('is-typing');
      setActive(4);
      setStatus('Complete · pass', 'pass');
      live.textContent = 'Trace complete: raw output failed, intervention produced valid product output.';
    };

    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        paused = false; // R1 fix — never pause the replay interaction
        hasPlayed = true;
        play();
      });
    }

    // Visibility observer: play once at 30% visibility
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting && !hasPlayed) {
          hasPlayed = true;
          play();
        }
      }
    }, { threshold: 0.3 });

    io.observe(root);

    // If already in view on mount, play immediately
    if (!reduced) {
      resetVisual();
      root.classList.add('is-enhanced');
    } else {
      root.classList.add('is-reduced');
    }
  }
</script>

<style>
  .trace {
    position: relative;
    background: var(--color-canvas-soft);
    color: var(--color-text-on-canvas);
    border: 1px solid var(--color-rule-on-canvas);
    overflow: hidden;
  }

  .trace--hero {
    width: 100%;
  }

  /* Topbar */
  .trace__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .trace__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trace__title-prefix {
    color: var(--color-accent);
  }

  .trace__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trace__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--color-accent);
    border-radius: 50%;
    transition: background-color var(--duration-quick) var(--ease-standard);
  }

  [data-trace-status-label][data-tone='running'] { color: var(--color-accent); }
  [data-trace-status-label][data-tone='fail'] { color: var(--color-signal-fail); }
  [data-trace-status-label][data-tone='pass'] { color: var(--color-signal-pass); }

  [data-trace-status-label][data-tone='running'] ~ .trace__status-dot,
  [data-trace-status-label][data-tone='ready'] ~ .trace__status-dot {
    background: var(--color-accent);
  }

  [data-trace-status-label][data-tone='fail'] ~ .trace__status-dot {
    background: var(--color-signal-fail);
  }

  [data-trace-status-label][data-tone='pass'] ~ .trace__status-dot {
    background: var(--color-signal-pass);
  }

  /* Engine */
  .trace__engine {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }

  /* Rail */
  .trace__rail {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-rule-on-canvas);
  }

  .trace__step {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    color: var(--color-text-on-canvas-muted);
    background: var(--color-canvas-soft);
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .trace__step:last-child { border-bottom: 0; }

  .trace__step-num {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .trace__step-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .trace__step-state {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard);
  }

  .trace__step-state--fail {
    color: var(--color-signal-fail);
    border-color: color-mix(in srgb, var(--color-signal-fail) 50%, transparent);
  }

  .trace__step-state--active {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  .trace__step-state--valid {
    color: var(--color-signal-pass);
    border-color: color-mix(in srgb, var(--color-signal-pass) 50%, transparent);
  }

  .trace__step[data-active='true'] {
    color: var(--color-text-on-canvas);
    background: var(--color-canvas);
  }

  .trace__step[data-current='true'] {
    background: var(--color-canvas-inset);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  /* Stage */
  .trace__stage {
    position: relative;
    display: grid;
  }

  .trace__panel {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  .trace__panel[data-panel-active='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .trace__panel-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trace__panel-tag {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas-soft);
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .trace__panel-tag--fail {
    color: var(--color-signal-fail);
    border-color: color-mix(in srgb, var(--color-signal-fail) 50%, transparent);
  }

  .trace__panel-tag--active {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  .trace__panel-tag--valid {
    color: var(--color-signal-pass);
    border-color: color-mix(in srgb, var(--color-signal-pass) 50%, transparent);
  }

  .trace__panel-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-on-canvas);
  }

  /* Code blocks */
  .trace__code {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--color-text-on-canvas);
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 9.5rem;
    overflow: hidden;
    position: relative;
  }

  .trace__code--valid {
    border-color: color-mix(in srgb, var(--color-signal-pass) 50%, var(--color-rule-on-canvas));
  }

  .trace__cursor {
    display: inline-block;
    width: 0.5ch;
    height: 1.1em;
    margin-left: 1px;
    background: var(--color-accent);
    vertical-align: -0.15em;
    opacity: 0;
  }

  .trace__panel.is-typing .trace__cursor {
    opacity: 1;
    animation: trace-cursor-blink 1s step-end infinite;
  }

  .trace__cursor--valid {
    background: var(--color-signal-pass);
  }

  @keyframes trace-cursor-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  .trace__panel-note {
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }

  /* Gate validation list */
  .trace__gate {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-rule-on-canvas);
  }

  .trace__gate li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    background: var(--color-canvas-soft);
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }

  .trace__gate span {
    color: var(--color-text-on-canvas);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .trace__gate b {
    font-weight: 500;
    text-align: right;
  }

  .trace__gate i {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas);
    transition: background-color var(--duration-quick) var(--ease-standard), border-color var(--duration-quick) var(--ease-standard);
  }

  [data-gate][data-state='pass'] {
    background: var(--color-signal-pass);
    border-color: var(--color-signal-pass);
  }

  [data-gate][data-state='fail'] {
