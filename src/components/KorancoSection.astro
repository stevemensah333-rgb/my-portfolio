---
/**
 * KorancoSection — completed Ashesi Innovation Lab engagement with Koranco Farms.
 *
 * Built a farm management system with three core modules: attendance checking,
 * farm produce management, and employee management. Delivered as a completed
 * MVP through a 6-week Ashesi Innovation Lab project.
 */
import SectionFrame from './SectionFrame.astro';
---

<section
  id="koranco"
  class="koranco"
  aria-labelledby="koranco-title"
  data-workspace-section="koranco"
  data-workspace-dest="work"
>
  <SectionFrame
    coordinate="01.3 · Work / Koranco"
    status="MVP delivered"
    surface="paper"
    density="tight"
  >
    <div class="page-shell region-grid koranco__layout">
      <aside class="region-rail koranco__rail">
        <div class="region-index">
          <span class="region-index__no">01.3</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Completed engagement</span>
        </div>
        <p class="koranco__status">
          <span class="koranco__status-dot" aria-hidden="true"></span>
          MVP delivered
        </p>
      </aside>

      <div class="region-body koranco__body">
      <header class="koranco__header">
        <h2 id="koranco-title" class="koranco__title">Koranco Farms</h2>
        <p class="koranco__short">A farm management system built through the Ashesi Innovation Lab — attendance, produce and employee modules.</p>
        <p class="koranco__claim">
          Selected for a 6-week Ashesi Innovation Lab project with Koranco Farms. Built a farm
          management system addressing how production data is captured, organized and used — with
          attendance checking, farm produce management, and employee management modules.
        </p>
      </header>

      <div class="koranco__columns">
        <section class="koranco__panel" aria-labelledby="koranco-built-title">
          <p class="mono-label">What was built</p>
          <h3 id="koranco-built-title">Core modules delivered</h3>
          <ul class="koranco__list">
            <li>Attendance checking — track worker presence and shift data across the farm.</li>
            <li>Farm produce management — record, organize and monitor production output.</li>
            <li>Employee management — maintain worker records and operational assignments.</li>
          </ul>
        </section>

        <section class="koranco__panel" aria-labelledby="koranco-context-title">
          <p class="mono-label">Context</p>
          <h3 id="koranco-context-title">How it started</h3>
          <ul class="koranco__list">
            <li>Assessed how production data was captured, organized and used across the farm.</li>
            <li>Identified record-keeping gaps and production visibility issues as the core problems.</li>
            <li>Shaped the solution around the Innovation Lab brief and real farm workflows.</li>
          </ul>
        </section>

        <section class="koranco__panel koranco__panel--verified" aria-labelledby="koranco-verified-title">
          <p class="mono-label">Verified outcomes</p>
          <h3 id="koranco-verified-title">What was delivered</h3>
          <p class="koranco__none">Three working modules built and delivered as an MVP through the Ashesi Innovation Lab. No farm-side deployment or measured adoption data is claimed — the system was built, not deployed to production.</p>
        </section>
      </div>

      <aside class="koranco__boundary" aria-label="Evidence boundary">
        <span class="mono-label">Evidence boundary</span>
        <p>
          The farm management system was built and delivered as a working MVP through the Innovation Lab.
          No public repository, production deployment, or farm-side usage figures exist. This engagement
          is described from the Innovation Lab brief and my résumé.
        </p>
      </aside>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .koranco {
    background: var(--color-sheet-soft);
  }

  .koranco__rail {
    gap: var(--space-5);
  }

  .koranco__body {
    gap: var(--space-5);
  }

  .koranco__header {
    display: grid;
    gap: var(--space-4);
  }

  .koranco__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-signal-pass-text);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .koranco__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--color-signal-pass);
    border-radius: 50%;
  }

  .koranco__title {
    margin: 0;
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
  }

  .koranco__short {
    max-width: 32rem;
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.45;
  }

  .koranco__claim {
    max-width: var(--width-reading);
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* Three columns of an open register, not three cards. Each is
     headed by a rule; the "verified outcomes" column is the only
     one that changes ground, because its content (nothing proven
     yet) is the honest boundary and deserves the emphasis. */
  .koranco__columns {
    display: grid;
    gap: var(--space-5);
  }

  .koranco__panel {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .koranco__panel h3 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .koranco__list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .koranco__list li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .koranco__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.625rem;
    height: 1px;
    background: var(--color-accent);
  }

  .koranco__panel--verified {
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-paper);
    border-top-width: 2px;
    border-top-color: var(--color-text-on-paper);
    background: var(--color-sheet-inset);
  }

  .koranco__none {
    margin: var(--space-2) 0 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .koranco__boundary {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .koranco__boundary p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .koranco__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
      align-items: start;
    }
  }
</style>
