---
import {investigationStages} from '../data/syncareerInvestigation';
---
<div class="investigation-stages">
 {investigationStages.map(stage=><details id={`stage-${stage.id}`} class="stage-record"><summary><span class="stage-no">{stage.step}</span><span><span class="stage-label">{stage.label}</span><strong>{stage.title}</strong></span><span class="stage-plus" aria-hidden="true">+</span></summary><div class="stage-body"><p>{stage.detail}</p>{stage.artifact?.kind==='code'&&<figure class="source-slab on-deck"><figcaption>{stage.artifact.label}</figcaption><pre tabindex="0"><code>{stage.artifact.code}</code></pre></figure>}{stage.artifact?.kind==='checks'&&<ul>{stage.artifact.items.map(i=><li><strong>{i.name}</strong> — {i.note}</li>)}</ul>}{stage.artifact?.kind==='refusal'&&<dl>{stage.artifact.items.map(i=><div><dt>{i.name}</dt><dd>{i.value}</dd></div>)}</dl>}<p class="stage-cite"><strong>Source / evidence.</strong> {stage.evidence}</p><a class="text-link" href={`/lab/#lab-${stage.id}`}>Inspect this stage in the Lab ↗</a></div></details>)}
</div>
<script>
const openTarget=()=>{const target=document.getElementById(location.hash.slice(1));if(target instanceof HTMLDetailsElement)target.open=true;};openTarget();document.addEventListener('astro:page-load',openTarget);window.addEventListener('hashchange',openTarget);
</script>
<style>.stage-record{border-top:1px solid var(--rule);padding-block:1rem}.stage-record:last-child{border-bottom:1px solid var(--rule)}summary{display:flex;align-items:center;gap:1.25rem;list-style:none}summary::-webkit-details-marker{display:none}.stage-no{color:var(--color-accent-text);font: .8rem var(--font-instrument)}summary>span:nth-child(2){display:grid;gap:.3rem}.stage-label{font-size:.65rem;letter-spacing:.06em}.stage-record strong{font-weight:500;font-size:1.1rem}.stage-plus{margin-left:auto;font-size:1.5rem}.stage-record[open] .stage-plus{rotate:45deg}.stage-record:target{border-color:var(--color-accent-text)}.stage-body{display:grid;gap:1rem;padding-block:.5rem 1rem}.source-slab{padding:1.25rem}.source-slab figcaption,.stage-cite{font-size:.75rem;color:var(--color-text-on-paper-muted)}.source-slab pre{margin-top:1rem}.stage-body dt{font-weight:600}.stage-body dd{margin:0}.stage-cite strong{font-size:inherit}</style>
