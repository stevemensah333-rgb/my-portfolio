---
/*
  SectionFrame.astro
  -------------------
  The region wrapper. It does three jobs and nothing else:

    1. RHYTHM     — applies one of three vertical densities, so the
                    page reads as composed rather than as a uniform
                    scroll (`density` prop).
    2. SEAM       — draws the boundary between this region and the
                    one above: a structural 1px edge plus a short
                    copper tick at the gutter. Environment changes
                    (sheet → deck) are marked, not incidental.
    3. INDEX RULE — the signature opener: a mono coordinate, a rule
                    that runs to the page edge, and an optional
                    right-hand status. This is the same motif as the
                    `.mono-label` leading tick, at region scale.

  Everything else (layout, asymmetry, content) belongs to the
  section that uses this.

  Props
  -----
  coordinate?  : mono coordinate label (e.g. "01 · WORK / SYNCAREER")
  status?      : optional short mono text, right-aligned on the rule
  surface?     : 'paper' (default) | 'canvas' | 'inset'
  density?     : 'default' | 'major' | 'tight'
  seam?        : draw the top seam (default true)
  label?       : aria-label for the wrapping region
  as?          : element tag (default 'div')
*/

interface SectionFrameProps {
  coordinate?: string;
  status?: string;
  surface?: 'paper' | 'canvas' | 'inset';
  density?: 'default' | 'major' | 'tight';
  seam?: boolean;
  label?: string;
  as?: 'div' | 'section' | 'article' | 'aside' | 'header' | 'footer' | 'nav';
  class?: string;
  id?: string;
  'data-workspace-section'?: string;
  /** Human label the workspace rail shows while this region is in view. */
  'data-workspace-label'?: string;
}

const {
  coordinate,
  status,
  surface = 'paper',
  density = 'default',
  seam = true,
  label,
  as: Tag = 'div',
  class: className,
  id,
  'data-workspace-section': workspaceSection,
  'data-workspace-label': workspaceLabel,
} = Astro.props as SectionFrameProps;

const isDeck = surface === 'canvas';
---

<Tag
  class:list={[
    'section-frame',
    'region',
    density === 'major' && 'region--major',
    density === 'tight' && 'region--tight',
    isDeck && 'section-frame--canvas',
    surface === 'inset' && 'section-frame--inset',
    className,
  ]}
  role={label && Tag === 'div' ? 'region' : undefined}
  aria-label={label}
  id={id}
  data-workspace-section={workspaceSection}
  data-workspace-label={workspaceLabel}
>
  {seam && <span class="section-frame__seam" aria-hidden="true"></span>}

  {coordinate && (
    <div class="page-shell section-frame__index" aria-hidden="true">
      <span class="section-frame__coordinate">{coordinate}</span>
      <span class="section-frame__rule"></span>
      {status && <span class="section-frame__status">{status}</span>}
    </div>
  )}

  <slot />
</Tag>

<style>
  .section-frame {
    position: relative;
  }

  /* The SEAM — a structural edge with a registration tick anchored
     to the page gutter. It is the only thing that separates regions,
     so it has to be deliberate. Neutral: an environment change is
     structure, not a state. */
  .section-frame__seam {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    pointer-events: none;
  }

  .section-frame__seam::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--color-rule-on-paper-strong);
  }

  .section-frame__seam::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(2.5rem, 8vw, 5rem);
    height: 2px;
    background: var(--color-rule-on-paper-strong);
  }

  /* The INDEX RULE — coordinate, rule, status. The rule carries the
     eye across the field; the coordinate anchors it at the gutter,
     registering against the seam tick above it. It is pulled UP so
     it sits on the region's leading edge rather than floating in
     whitespace; the region's density padding then does its real work
     below it. */
  .section-frame__index {
    display: grid;
    grid-template-columns: auto minmax(var(--space-4), 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    margin-top: calc(var(--region-pad) * var(--region-scale, 1) * -1 + var(--space-4));
    padding-bottom: var(--section-gap);
  }

  .section-frame__coordinate,
  .section-frame__status {
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-instrument);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Both are coordinates, not states — neutral. */
  .section-frame__coordinate,
  .section-frame__status {
    color: var(--color-text-on-paper-muted);
  }

  .section-frame__rule {
    height: 1px;
    background: var(--color-rule-on-paper);
  }

  @media (max-width: 34rem) {
    .section-frame__index {
      grid-template-columns: auto minmax(var(--space-3), 1fr);
      padding-bottom: var(--space-5);
    }

    .section-frame__status {
      display: none;
    }

    /* At narrow widths the coordinate can exceed the gutter; let it
       wrap rather than force a horizontal scroll. */
    .section-frame__coordinate {
      white-space: normal;
    }
  }
</style>
