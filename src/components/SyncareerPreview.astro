---
/**
 * Compact homepage trailer for Syncareer.
 * The full engineering investigation lives at /work/syncareer/.
 *
 * VISUAL HIERARCHY (this pass) — the section previously gave every
 * subsection the same weight. It now has two dominant moments and
 * three quiet ones:
 *
 *   DOMINANT 1  the product surface (the thing that exists)
 *   DOMINANT 2  the failure (the reason the engineering happened)
 *   quiet       the investigation chain, the actions, the boundary
 *
 * Project metadata (index, status, evidence boundary) has left the
 * reading column entirely and become a margin apparatus, which is
 * what keeps the body a single readable spine.
 */
import { syncareer } from '../data/registry';
import { investigationStages, syncareerProduct } from '../data/syncareerInvestigation';
import ProductFrame from './ProductFrame.astro';
import SectionFrame from './SectionFrame.astro';
---

<section
  id="syncareer"
  class="sync-preview"
  aria-labelledby="syncareer-title"
  data-workspace-section="syncareer"
  data-workspace-dest="work"
>
  <SectionFrame
    coordinate="01.1 · Work / Syncareer"
    status="Live product"
    surface="paper"
    density="major"
  >
    <div class="page-shell region-grid sync-preview__grid">
      <!-- MARGIN APPARATUS: index, status, and the evidence boundary.
           None of it is required to read the body; all of it travels
           with the project. -->
      <aside class="region-rail sync-preview__rail">
        <div class="region-index">
          <span class="region-index__no">01.1</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Shipped product</span>
        </div>

        <p class="sync-preview__status">
          <span class="sync-preview__status-dot" aria-hidden="true"></span>
          Live · syncareer.me
        </p>
      </aside>

      <div class="region-body sync-preview__body">
        <header class="sync-preview__header">
          <h2 id="syncareer-title" class="sync-preview__title">{syncareer.name}</h2>
          <p class="sync-preview__short">{syncareer.short}</p>
          <p class="sync-preview__claim">
            A real product. A specific failure: ungrounded CV help. A rebuilt
            request/response contract so model output has to cite evidence before
            the product will accept it.
          </p>
        </header>

        <!-- DOMINANT 1 — the product surface. It breaks the reading
             column and runs to the region edge. -->
        <div class="sync-preview__product">
          <ProductFrame
            src1440="/images/syncareer/synai-context-1440.png"
            src1800="/images/syncareer/synai-context-1800.png"
            src2400="/images/syncareer/synai-context-2400.png"
            width={2400}
            height={1302}
            alt="Syncareer SynAI interface showing personalised career guidance based on profile, quick actions and a message input."
            label="Product surface / SynAI"
            caption="The live career workspace. AI help is a bounded task against supplied context — not a generic chatbot."
            address="syncareer.me"
          />
        </div>

        <!-- DOMINANT 2 — the failure. Framed on the failure tint with
             a heavy rust edge: the one place in the section where the
             palette changes, because this is the turning point. -->
        <div class="sync-preview__problem">
          <p class="mono-label mono-label--bare sync-preview__problem-label">The specific problem</p>
          <h3>The assistant saw a bullet. It could not see the evidence.</h3>
          <p class="sync-preview__problem-detail">{syncareerProduct.problem}</p>
        </div>

        <!-- QUIET — the chain is an index of what is inspectable, not
             a diagram. Numbered rows on a rule, no boxes. -->
        <div class="sync-preview__trail-block">
          <p class="mono-label mono-label--bare">Investigation · {investigationStages.length} stages</p>
          <ol class="sync-preview__trail" aria-label="Engineering investigation stages">
            {investigationStages.map((stage) => (
              <li>
                <a class="sync-preview__trail-link" href={`${syncareer.route}#stage-${stage.id}`}>
                  <span class="sync-preview__trail-step">{stage.step}</span>
                  <span class="sync-preview__trail-label">{stage.label}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="sync-preview__trail-note">
            Input → model output → validation → failure → diagnosis → intervention →
            output afterward. Open the investigation to inspect each hand-off.
          </p>
        </div>

        <!-- The evidence boundary rides in the margin at width and
             falls to the foot of the body on narrow screens, where a
             margin column does not exist. Same content, correct
             reading order in both cases. -->
        <aside class="sync-preview__boundary" aria-label="Evidence boundary">
          <span class="mono-label mono-label--bare">Evidence boundary</span>
          <p>{syncareer.claimLimit}</p>
        </aside>

        <div class="sync-preview__actions">
          <a class="button button--accent" href={syncareer.route}>
            Open the engineering investigation
          </a>
          <a
            class="text-link"
            href={syncareerProduct.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit the product
            <span class="text-link__arrow" aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href={syncareerProduct.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Source repository
            <span class="text-link__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .sync-preview {
    background: var(--color-sheet);
  }

  .sync-preview__grid {
    align-items: start;
  }

  /* --- margin apparatus ---------------------------------------- */

  .sync-preview__rail {
    gap: var(--space-5);
  }

  .sync-preview__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-signal-pass-text);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .sync-preview__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-signal-pass);
  }

  .sync-preview__boundary {
    display: grid;
    gap: var(--space-2);
    max-width: var(--width-reading);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .sync-preview__boundary p {
    margin: 0;
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* --- body ----------------------------------------------------- */

  .sync-preview__body {
    gap: var(--section-gap);
  }

  .sync-preview__header {
    display: grid;
    gap: var(--space-3);
  }

  /* FEATURE role — a project name is the second-largest type in the
     system. It earns that because a project is the subject. */
  .sync-preview__title {
    margin: 0;
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
  }

  .sync-preview__short {
    max-width: 32rem;
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.45;
  }

  .sync-preview__claim {
    max-width: var(--width-reading);
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .sync-preview__product {
    max-width: 52rem;
  }

  /* --- the failure ---------------------------------------------- */
  /* The only recoloured region in the section. A rust edge on the
     failure tint, offset out of the reading column so it physically
     interrupts the read — which is what the failure did. */

  .sync-preview__problem {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-6);
    border-left: 3px solid var(--color-signal-fail);
    background: var(--color-signal-fail-tint);
  }

  .sync-preview__problem-label {
    color: var(--color-signal-fail-text);
  }

  .sync-preview__problem h3 {
    margin: 0;
    max-width: 24ch;
    font-size: var(--text-component);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .sync-preview__problem-detail {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* --- investigation chain (quiet) ------------------------------- */

  .sync-preview__trail-block {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .sync-preview__trail {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .sync-preview__trail li {
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .sync-preview__trail-link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height-sm);
    padding-block: var(--space-2);
    color: var(--color-text-on-paper-muted);
    text-decoration: none;
    transition:
      color var(--duration-quick) var(--ease-standard),
      padding-left var(--duration-base) var(--ease-emphasized);
  }

  /* Hover shifts the row right — the link resolves toward its
     destination rather than just changing colour. */
  .sync-preview__trail-link:hover,
  .sync-preview__trail-link:focus-visible {
    padding-left: var(--space-2);
    color: var(--color-text-on-paper);
  }

  .sync-preview__trail-link:hover .sync-preview__trail-step,
  .sync-preview__trail-link:focus-visible .sync-preview__trail-step {
    color: var(--color-accent-text);
  }

  .sync-preview__trail-step {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .sync-preview__trail-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sync-preview__trail-note {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .sync-preview__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  /* --- responsive ------------------------------------------------ */

  @media (min-width: 60rem) {
    /* The chain becomes two columns at width: seven rows in one
       stack is a scroll, in two it is an index. */
    .sync-preview__trail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .sync-preview__trail li:nth-last-child(-n + 1) {
      border-bottom: 1px solid var(--color-rule-on-paper-soft);
    }
  }

  @media (max-width: 30rem) {
    .sync-preview__problem {
      padding: var(--space-4);
      padding-left: var(--space-4);
    }

    .sync-preview__claim {
      padding-left: var(--space-3);
    }
  }
</style>
