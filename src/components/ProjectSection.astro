---
/**
 * ProjectSection — the stage inspector for a project case page.
 *
 * Renders:
 *   1. Project header (claim, status, stack, evidence)
 *   2. Stage inspector (data-driven from the project's stages)
 *
 * Uses the shared initTraceTabs controller for the inspector.
 * Behaviour:
 *   - No-JS: every panel renders, stacked.
 *   - Keyboard: arrows / Home / End cycle stages, Enter activates.
 */
import type { Project, ProjectStage } from '../data/projects';
import { projects } from '../data/registry';
import SectionFrame from './SectionFrame.astro';

interface Props {
  project: Project;
  /** Section id for the page anchor. */
  anchorId: string;
  /** Coordinate label for the section frame. */
  coordinate: string;
  /** Rail index shown in the margin. Defaults to the project's order
      within the registry. */
  railIndex?: string;
}

const { project, anchorId, coordinate, railIndex } = Astro.props as Props;

const stages: ProjectStage[] = project.stages ?? [];
const projectOrder = projects.findIndex((p) => p.id === project.id) + 1;
const indexLabel = railIndex ?? String(projectOrder).padStart(2, '0');
---

<section
  id={anchorId}
  class="project"
  aria-labelledby={`${anchorId}-title`}
  data-workspace-section={anchorId}
>
  <SectionFrame
    coordinate={coordinate}
    status={project.status.replace(/-/g, ' ')}
    surface="paper"
    density="default"
  >
      <header class="page-shell region-grid project__header">
        <div class="region-rail project__rail">
          <div class="region-index">
            <span class="region-index__no">{indexLabel}</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">Project</span>
          </div>
          <p
            class:list={['project__status', `project__status--${project.status}`]}
          >
            <span aria-hidden="true" class="project__status-dot"></span>
            {project.status.replace(/-/g, ' ')}
          </p>
        </div>

        <div class="region-body project__headbody">
        <h2 id={`${anchorId}-title`} class="project__title">{project.name}</h2>
        <p class="project__short">{project.short}</p>
        <p class="project__claim">{project.claim}</p>

        <dl class="project__meta">
          <div>
            <dt class="mono-label">Stack</dt>
            <dd>
              <ul class="project__meta-list">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
          {project.evidence.length > 0 && (
            <div>
              <dt class="mono-label">Evidence</dt>
              <dd>
                <ul class="project__meta-list">
                  {project.evidence.map((ev) => (
                    <li>
                      {ev.kind === 'illustrative' ? (
                        <span>
                          <strong>{ev.label}</strong>
                          <span class="project__meta-note">{ev.note}</span>
                        </span>
                      ) : (
                        <a
                          href={ev.href}
                          target={ev.href.startsWith('http') ? '_blank' : undefined}
                          rel={ev.href.startsWith('http') ? 'noopener' : undefined}
                        >
                          {ev.label}
                          <span class="project__meta-ext" aria-hidden="true">↗</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
        </div>
      </header>

    <section
      class="page-shell project__inspector"
      aria-labelledby={`${anchorId}-trace-title`}
    >
        <header class="inspector__intro">
          <div>
            <p class="mono-label">Stage inspector</p>
            <h3 id={`${anchorId}-trace-title`}>
              Inspect the {String(stages.length).padStart(2, '0')} underlying stages.
            </h3>
          </div>
          <p class="inspector__legend">
            Select a stage to see what happened at each step. Keyboard: arrows move between stages, Enter activates.
            Items marked ILLUSTRATIVE are demo shapes, not historical logs.
          </p>
        </header>

      <div class="inspector__panel" data-trace-compact>
        <div
          class="inspector__rail"
          role="tablist"
          aria-label={`${project.name} stages`}
          aria-orientation="horizontal"
        >
          {stages.map((stage, idx) => (
            <button
              type="button"
              role="tab"
              id={`${anchorId}-tab-${stage.id}`}
              class="inspector__tab"
              data-stage-tab={stage.id}
              aria-controls={`${anchorId}-panel-${stage.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex={idx === 0 ? '0' : '-1'}
            >
              <span class="inspector__tab-step">{stage.step}</span>
              <span class="inspector__tab-label">{stage.label}</span>
              <span class="inspector__tab-node" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <div class="inspector__panels">
          {stages.map((stage, idx) => (
            <div
              role="tabpanel"
              id={`${anchorId}-panel-${stage.id}`}
              aria-labelledby={`${anchorId}-tab-${stage.id}`}
              class="inspector__panel-content"
              data-stage-panel={stage.id}
              data-active={idx === 0 ? 'true' : 'false'}
              tabindex="0"
              hidden={idx !== 0}
            >
              <header class="inspector__panel-header">
                <p class="mono-label">{stage.step} / {stage.label}</p>
                <h4>{stage.title}</h4>
                <p class="inspector__panel-detail">{stage.detail}</p>
              </header>

              {(stage.kind === 'raw' || stage.kind === 'valid') && stage.code && (
                <div class="code-panel">
                  <div class="code-panel__meta">
                    <span>{stage.codeLabel ?? (stage.kind === 'raw' ? 'ILLUSTRATIVE BAD OUTPUT' : 'ILLUSTRATIVE VALID OUTPUT')}</span>
                    <span class:list={['code-panel__type', stage.kind === 'raw' ? 'code-panel__type--fail' : 'code-panel__type--pass']}>
                      {stage.kind}
                    </span>
                  </div>
                  <pre tabindex="0"><code>{stage.code}</code></pre>
                </div>
              )}

              {stage.kind === 'validate' && (
                <div class="validation-card">
                  <div class="validation-card__side">
                    <span class="mono-label">Product expects</span>
                    <strong>{project.id === 'syncareer' ? 'requirement + evidence citations' : 'slot exists, free, time valid'}</strong>
                  </div>
                  <span class="validation-card__rule" aria-hidden="true"></span>
                  <div class="validation-card__side">
                    <span class="mono-label">Observed before fix</span>
                    <strong class="validation-card__fail">
                      {project.id === 'syncareer'
                        ? 'bullet-only rewrite, no citations'
                        : 'concurrent read sees free slot'}
                    </strong>
                  </div>
                </div>
              )}

              {stage.kind === 'fail' && stage.modes && (
                <ul class="failure-grid">
                  {stage.modes.map((mode) => (
                    <li>
                      <span class="mono-label">{mode.name}</span>
                      <p>{mode.note}</p>
                    </li>
                  ))}
                </ul>
              )}

              {stage.kind === 'intervene' && stage.fixes && (
                <ul class="fix-list">
                  {stage.fixes.map((fix) => <li>{fix}</li>)}
                </ul>
              )}

              <p class="evidence-line">
                <span class="mono-label">Evidence</span>
                {stage.evidence}
              </p>
            </div>
          ))}
        </div>

        <footer class="inspector__footer">
          <a class="text-link" href={project.route}>
            Explore the full case study
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </footer>
      </div>
    </section>

  </SectionFrame>
</section>

<script>
  import { initTraceTabs } from '../scripts/initTraceTabs';

  /* Re-initializes on `astro:page-load` (the ClientRouter swaps the
     shell without re-running bundled scripts); the marker keeps it
     idempotent and the run-scoped AbortController removes the previous
     run's window listeners. */
  let teardown: (() => void) | null = null;

  const init = () => {
    const roots = [...document.querySelectorAll<HTMLElement>('[data-trace-compact]')]
      .filter((traceRoot) => traceRoot.dataset.traceEnhanced !== '1');
    if (roots.length === 0) return;
    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();

    for (const traceRoot of roots) {
      traceRoot.dataset.traceEnhanced = '1';
      initTraceTabs(traceRoot, { signal: events.signal });
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .project {
    background: var(--color-sheet);
  }

  .project__header {
    padding-bottom: var(--space-5);
  }

  .project__rail {
    gap: var(--space-5);
  }

  .project__headbody {
    gap: var(--space-4);
  }

  .project__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project__status-dot {
    width: var(--node-status);
    height: var(--node-status);
    background: var(--color-accent);
    border-radius: 50%;
  }

  .project__status--live .project__status-dot {
    background: var(--color-signal-pass);
  }

  .project__status--mvp .project__status-dot {
    background: var(--color-signal-pass);
  }

  .project__status--in-development .project__status-dot {
    background: var(--color-accent);
  }

  .project__status--coursework .project__status-dot {
    background: var(--color-text-on-paper-muted);
  }

  .project__status--experiment .project__status-dot {
    background: var(--color-text-on-paper-muted);
  }

  .project__title {
    margin: 0;
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
  }

  .project__short {
    max-width: 32rem;
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.45;
  }

  /* The claim is hung on a copper rule — same treatment as Syncareer,
     so "what this project argues" is a recognisable slot. */
  .project__claim {
    max-width: var(--width-reading);
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .project__meta {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper-soft);
  }

  .project__meta > div {
    display: grid;
    gap: var(--space-2);
  }

  .project__meta dt {
    color: var(--color-text-on-paper-muted);
  }

  .project__meta dd {
    margin: 0;
  }

  .project__meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .project__meta-list li {
    padding-right: var(--space-3);
    border-right: 1px solid var(--color-rule-on-paper-soft);
  }

  .project__meta-list li:last-child {
    border-right: 0;
  }

  .project__meta-list a {
    color: var(--color-text-on-paper);
    font-weight: 600;
    text-decoration: none;
  }

  .project__meta-list a:hover {
    color: var(--color-accent-text);
  }

  .project__meta-ext {
    margin-left: var(--space-1);
    color: var(--color-accent-text);
    font-size: 0.75em;
  }

  .project__meta-note {
    display: block;
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-meta);
    font-weight: 400;
  }

  /* --- Inspector --- */
  /* The inspector is instrumentation: it runs at the concentrated
     rhythm, denser than the information blocks around it. */
  .project__inspector {
    padding-block: var(--section-block-tight);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .inspector__intro {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    max-width: var(--width-content);
  }

  .inspector__intro h3 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-component);
    font-weight: 600;
  }

  .inspector__legend {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
    max-width: var(--width-reading);
  }

  /* The light-side counterpart of the lab bench: one bounded
     instrument, one copper registration tick at the leading corner. */
  .inspector__panel {
    position: relative;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .inspector__panel::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
  }

  .inspector__rail {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    scrollbar-width: thin;
  }

  .inspector__rail::-webkit-scrollbar {
    height: 4px;
  }

  .inspector__rail::-webkit-scrollbar-thumb {
    background: var(--color-rule-on-paper);
  }

  .inspector__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height);
    padding: 0 var(--space-4);
    border: 0;
    border-right: 1px solid var(--color-rule-on-paper);
    background: transparent;
    color: var(--color-text-on-paper-muted);
    cursor: pointer;
    font: inherit;
    white-space: nowrap;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .inspector__tab:last-child {
    border-right: 0;
  }

  /* The light inspector uses the lab's stage vocabulary: bare mono
     numbers, an ARC NODE that fills when reached, and a copper
     inset edge on the active stage — so the reader who learns the
     mark in the Reliability Lab already knows how to read this rail. */
  .inspector__tab-step {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .inspector__tab-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .inspector__tab-node {
    width: var(--node-size);
    height: var(--node-size);
    border: 1px solid var(--color-rule-on-paper-strong);
    border-radius: 50%;
    background: var(--color-paper);
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard);
  }

  .inspector__tab:hover {
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
    color: var(--color-text-on-paper);
  }

  .inspector__tab[data-active='true'] {
    color: var(--color-text-on-paper);
    background: var(--color-paper);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .inspector__tab[data-active='true'] .inspector__tab-step {
    color: var(--color-accent-text);
  }

  .inspector__tab[data-active='true'] .inspector__tab-node {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .inspector__tab[data-past='true'] .inspector__tab-node {
    border-color: var(--color-text-on-paper-faint);
    background: var(--color-text-on-paper-faint);
  }

  /* Future stages: hollow node with a dotted edge — structure
     without dimming the label (WCAG 1.4.3 / 1.4.1). */
  .inspector__tab[data-future='true'] .inspector__tab-node {
    border-style: dotted;
    border-color: var(--color-rule-on-paper);
    background: transparent;
  }

  .inspector__panels {
    padding: var(--space-5);
  }

  .inspector__panel-content {
    display: grid;
    gap: var(--space-4);
    animation: inspector-enter var(--duration-reveal) var(--ease-emphasized);
  }

  @keyframes inspector-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .inspector__panel-content[hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .inspector__panel-content {
      animation: none;
    }
    .inspector__tab {
      transition: none;
    }
  }

  html:not(.js) .inspector__panel-content,
  html:not(.js) .inspector__panel-content[hidden] {
    display: grid !important;
  }

  html:not(.js) .inspector__rail {
    display: none;
  }

  .inspector__panel-header h4 {
    margin: var(--space-2) 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .inspector__panel-detail {
    max-width: 40rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .inspector__footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  /* Code panel */
  .code-panel {
    border: 1px solid var(--color-rule-on-paper-soft);
    background: var(--color-paper);
    overflow: hidden;
  }

  .code-panel__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    background: var(--color-paper-soft);
  }

  .code-panel__type {
    color: var(--color-accent-text);
  }

  .code-panel__type--fail {
    color: var(--color-signal-fail-text);
  }

  .code-panel__type--pass {
    color: var(--color-signal-pass-text);
  }

  .code-panel pre {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    max-height: 16rem;
  }

  /* Failure grid */
  .failure-grid {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .failure-grid li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--color-rule-on-paper-soft);
    background: var(--color-paper);
  }

  .failure-grid p {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-text-on-paper-muted);
  }

  /* Fix list */
  .fix-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fix-list li {
    position: relative;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-7);
    border: 1px solid var(--color-rule-on-paper-soft);
    background: var(--color-paper);
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-text-on-paper);
  }

  .fix-list li::before {
    content: '+';
    position: absolute;
    left: var(--space-3);
    top: var(--space-2);
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  /* Validation card */
  .validation-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-rule-on-paper-soft);
    background: var(--color-paper-soft);
  }

  .validation-card__side {
    display: grid;
    gap: var(--space-1);
  }

  .validation-card__side strong {
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .validation-card__fail {
    color: var(--color-signal-fail-text);
  }

  .validation-card__rule {
    height: 1px;
    background: var(--color-rule-on-paper);
    position: relative;
  }

  .validation-card__rule::after {
    content: '';
    position: absolute;
    right: 0;
    top: -0.25rem;
    width: var(--node-size);
    height: var(--node-size);
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-paper);
  }

  .evidence-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 47.99rem) {
    /* MOBILE EQUIVALENT — the stage rail wraps into rows instead of
       becoming a horizontal scroll strip: every stage is visible and
       tappable without sideways instrumentation. */
    .inspector__rail {
      flex-wrap: wrap;
      overflow-x: visible;
    }

    .inspector__tab {
      white-space: normal;
    }

    /* Code wraps instead of requiring sideways scrolling. */
    .code-panel pre {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      max-height: none;
    }
  }

  @media (min-width: 48rem) {
    .project__meta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-7);
    }

    .failure-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .fix-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inspector__intro {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: end;
      gap: var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .project__header {
      padding-bottom: var(--space-6);
    }
  }

