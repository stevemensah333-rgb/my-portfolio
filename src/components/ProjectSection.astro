---
/**
 * ProjectSection — the unified "viewer" for project content on the homepage.
 *
 * Renders:
 *   1. Project header (claim, status, stack)
 *   2. Product/visual surface (when the project has a ProductFrame image)
 *   3. Reliability narrative (optional — for projects with narrativeStates)
 *   4. Stage inspector (data-driven, used for every project)
 *
 * Uses the shared initTraceTabs controller for the inspector.
 * Behaviour:
 *   - No-JS: every panel renders, stacked.
 *   - Reduced motion: scroll-syncing is disabled; tabs still work.
 *   - Keyboard: arrows / Home / End cycle stages, Enter activates.
 */
import type { Project } from '../data/projects';
import { projects } from '../data/registry';
import ProductFrame from './ProductFrame.astro';
import SectionFrame from './SectionFrame.astro';

interface Props {
  project: Project;
  /** When true, render only the inspector — used for compact project slots. */
  inspectorOnly?: boolean;
  /** Section id for the homepage anchor. */
  anchorId: string;
  /** Coordinate label for the section frame. */
  coordinate: string;
  /** Show the narrative rail. */
  showNarrative?: boolean;
  /** Optional pre-illustration to slot above the inspector. */
  productFrame?: {
    src1440: string;
    src1800: string;
    src2400: string;
    width: number;
    height: number;
    alt: string;
    label: string;
    caption: string;
    address?: string;
    priority?: boolean;
  };
}

const {
  project,
  inspectorOnly = false,
  anchorId,
  coordinate,
  showNarrative = false,
  productFrame,
} = Astro.props as Props;

const narrativeStates = project.narrativeStates ?? [];
const projectOrder = projects.findIndex((p) => p.id === project.id) + 1;
---

<section
  id={anchorId}
  class="project"
  aria-labelledby={`${anchorId}-title`}
  data-workspace-section={anchorId}
>
  <SectionFrame coordinate={coordinate} surface="paper">
    {!inspectorOnly && (
      <header class="page-shell project__header">
        <div class="project__head-row">
          <p class="mono-label">
            Project · {String(projectOrder).padStart(2, '0')}
          </p>
          <p
            class:list={['mono-label', 'project__status', `project__status--${project.status}`]}
          >
            <span aria-hidden="true" class="project__status-dot"></span>
            {project.status.replace(/-/g, ' ')}
          </p>
        </div>
        <h2 id={`${anchorId}-title`} class="project__title">{project.name}</h2>
        <p class="project__short">{project.short}</p>
        <p class="project__claim">{project.claim}</p>

        <dl class="project__meta">
          <div>
            <dt class="mono-label">Stack</dt>
            <dd>
              <ul class="project__meta-list">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
          {project.evidence.length > 0 && (
            <div>
              <dt class="mono-label">Evidence</dt>
              <dd>
                <ul class="project__meta-list">
                  {project.evidence.map((ev) => (
                    <li>
                      {ev.kind === 'illustrative' ? (
                        <span>
                          <strong>{ev.label}</strong>
                          <span class="project__meta-note">{ev.note}</span>
                        </span>
                      ) : (
                        <a
                          href={ev.href}
                          target={ev.href.startsWith('http') ? '_blank' : undefined}
                          rel={ev.href.startsWith('http') ? 'noopener' : undefined}
                        >
                          {ev.label}
                          <span class="project__meta-ext" aria-hidden="true">↗</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </header>
    )}

    {!inspectorOnly && productFrame && (
      <div class="page-shell project__product">
        <ProductFrame
          src1440={productFrame.src1440}
          src1800={productFrame.src1800}
          src2400={productFrame.src2400}
          width={productFrame.width}
          height={productFrame.height}
          alt={productFrame.alt}
          label={productFrame.label}
          caption={productFrame.caption}
          address={productFrame.address ?? `${project.id}.me`}
          priority={productFrame.priority}
        />
      </div>
    )}

    {showNarrative && narrativeStates.length > 0 && (
      <section
        class="page-shell project__narrative"
        data-project-narrative={project.id}
        aria-labelledby={`${anchorId}-narrative-title`}
      >
        <header class="narrative__intro">
          <p class="mono-label">Reliability narrative</p>
          <h3 id={`${anchorId}-narrative-title`}>
            Failure, engineering response, then a product contract.
          </h3>
          <p>Each state maps to specific stages below.</p>
        </header>

        <nav class="narrative__rail" aria-label={`${project.name} narrative states`}>
          <p class="narrative__rail-meta">
            <span class="mono-label" data-narrative-position>01 / {String(narrativeStates.length).padStart(2, '0')}</span>
            <span class="narrative__rail-status">Current state</span>
          </p>
          <ol class="narrative__rail-list">
            {narrativeStates.map((state, index) => (
              <li>
                <button
                  type="button"
                  class="narrative__rail-btn"
                  data-narrative-control={state.id}
                  aria-controls={`${anchorId}-narrative-${state.id}`}
                  aria-current={index === 0 ? 'step' : undefined}
                >
                  <span class="narrative__rail-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="narrative__rail-label">{state.label}</span>
                  <span class="narrative__rail-tone" data-tone={state.tone}></span>
                </button>
              </li>
            ))}
          </ol>
          <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-narrative-announcement>
            Current state: {narrativeStates[0]?.label ?? ''}
          </p>
        </nav>

        <div class="narrative__sequence">
          {narrativeStates.map((state, index) => (
            <article
              id={`${anchorId}-narrative-${state.id}`}
              class="narrative__state"
              data-narrative-step={state.id}
              data-tone={state.tone}
              data-active={index === 0 ? 'true' : 'false'}
            >
              <header class="narrative__state-copy">
                <p class="narrative__state-kicker mono-label">
                  State {String(index + 1).padStart(2, '0')} / {state.label}
                </p>
                <h4>{state.title}</h4>
                <p class="narrative__state-summary">{state.summary}</p>
                <button
                  type="button"
                  class="text-link narrative__state-link"
                  data-select-trace-stage={state.primaryStageId}
                >
                  Inspect this state in the trace
                  <span class="text-link__arrow" aria-hidden="true">↓</span>
                </button>
              </header>
            </article>
          ))}
        </div>
      </section>
    )}

    <section
      class="page-shell project__inspector"
      aria-labelledby={`${anchorId}-trace-title`}
    >
      {!inspectorOnly && (
        <header class="inspector__intro">
          <div>
            <p class="mono-label">Stage inspector</p>
            <h3 id={`${anchorId}-trace-title`}>
              Inspect the {String(project.stages.length).padStart(2, '0')} underlying stages.
            </h3>
          </div>
          <p class="inspector__legend">
            Select a stage to see what happened at each step. Keyboard: arrows move between stages, Enter activates.
            Items marked ILLUSTRATIVE are demo shapes, not historical logs.
          </p>
        </header>
      )}

      <div class="inspector__panel" data-trace-compact data-trace-project={project.id}>
        <div
          class="inspector__rail"
          role="tablist"
          aria-label={`${project.name} stages`}
          aria-orientation="horizontal"
        >
          {project.stages.map((stage, idx) => (
            <button
              type="button"
              role="tab"
              id={`${anchorId}-tab-${stage.id}`}
              class="inspector__tab"
              data-stage-tab={stage.id}
              data-narrative-state={
                narrativeStates.find((s) => s.primaryStageId === stage.id)?.id ?? ''
              }
              aria-controls={`${anchorId}-panel-${stage.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex={idx === 0 ? '0' : '-1'}
              data-step={stage.step}
            >
              <span class="inspector__tab-step">{stage.step}</span>
              <span class="inspector__tab-label">{stage.label}</span>
              <span class="inspector__tab-dot" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <div class="inspector__panels">
          {project.stages.map((stage, idx) => (
            <div
              role="tabpanel"
              id={`${anchorId}-panel-${stage.id}`}
              aria-labelledby={`${anchorId}-tab-${stage.id}`}
              class="inspector__panel-content"
              data-stage-panel={stage.id}
              data-narrative-state={
                narrativeStates.find((s) => s.primaryStageId === stage.id)?.id ?? ''
              }
              data-active={idx === 0 ? 'true' : 'false'}
              tabindex="0"
              hidden={idx !== 0}
            >
              <header class="inspector__panel-header">
                <p class="mono-label">{stage.step} / {stage.label}</p>
                <h4>{stage.title}</h4>
                <p class="inspector__panel-detail">{stage.detail}</p>
              </header>

              {(stage.kind === 'raw' || stage.kind === 'valid') && stage.code && (
                <div class="code-panel">
                  <div class="code-panel__meta">
                    <span>{stage.kind === 'raw' ? 'ILLUSTRATIVE BAD OUTPUT' : 'ILLUSTRATIVE VALID OUTPUT'}</span>
                    <span class:list={['code-panel__type', stage.kind === 'raw' ? 'code-panel__type--fail' : 'code-panel__type--pass']}>
                      {stage.kind}
                    </span>
                  </div>
                  <pre><code>{stage.code}</code></pre>
                </div>
              )}

              {stage.kind === 'validate' && (
                <div class="validation-card">
                  <div class="validation-card__side">
                    <span class="mono-label">Product expects</span>
                    <strong>{project.id === 'syncareer' ? 'title, level, years, next_steps' : 'slot exists, free, time valid'}</strong>
                  </div>
                  <span class="validation-card__rule" aria-hidden="true"></span>
                  <div class="validation-card__side">
                    <span class="mono-label">Observed before fix</span>
                    <strong class="validation-card__fail">
                      {project.id === 'syncareer'
                        ? 'mixed prose + malformed fields'
                        : 'concurrent read sees free slot'}
                    </strong>
                  </div>
                </div>
              )}

              {stage.kind === 'fail' && stage.modes && (
                <ul class="failure-grid">
                  {stage.modes.map((mode) => (
                    <li>
                      <span class="mono-label">{mode.name}</span>
                      <p>{mode.note}</p>
                    </li>
                  ))}
                </ul>
              )}

              {stage.kind === 'intervene' && stage.fixes && (
                <ul class="fix-list">
                  {stage.fixes.map((fix) => <li>{fix}</li>)}
                </ul>
              )}

              <p class="evidence-line">
                <span class="mono-label">Evidence</span>
                {stage.evidence}
              </p>
            </div>
          ))}
        </div>

        <footer class="inspector__footer">
          <a class="text-link" href={project.route}>
            Explore the full case study
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </footer>
      </div>
    </section>

    {!inspectorOnly && project.claimLimit && (
      <aside class="page-shell project__boundary" aria-label="Evidence boundary">
        <span class="mono-label">Evidence boundary</span>
        <p>{project.claimLimit}</p>
      </aside>
    )}
  </SectionFrame>
</section>

<script>
  import { initTraceTabs } from '../scripts/initTraceTabs';

  for (const narrativeRoot of document.querySelectorAll<HTMLElement>('[data-project-narrative]')) {
    const section = narrativeRoot.closest('.project');
    const traceRoot = section?.querySelector<HTMLElement>('[data-trace-compact]');
    const steps = [...narrativeRoot.querySelectorAll<HTMLElement>('[data-narrative-step]')];
    const controls = [...narrativeRoot.querySelectorAll<HTMLButtonElement>('[data-narrative-control]')];
    const stageLinks = [...narrativeRoot.querySelectorAll<HTMLButtonElement>('[data-select-trace-stage]')];
    const position = narrativeRoot.querySelector<HTMLElement>('[data-narrative-position]');
    const announcement = narrativeRoot.querySelector<HTMLElement>('[data-narrative-announcement]');

    if (steps.length === 0 || controls.length === 0) continue;

    let syncingTrace = false;
    const traceController = traceRoot
      ? initTraceTabs(traceRoot, {
          onSelect: (_id, _index, _count, tab) => {
            const narrativeState = tab.dataset.narrativeState;
            if (!narrativeState || syncingTrace) return;
            setActiveState(narrativeState, { syncTrace: false, announce: true });
          },
        })
      : null;

    function setActiveState(stateId: string, options: { syncTrace?: boolean; announce?: boolean } = {}) {
      const activeIndex = steps.findIndex((step) => step.dataset.narrativeStep === stateId);
      if (activeIndex < 0) return;

      narrativeRoot.dataset.activeNarrativeState = stateId;
      steps.forEach((step) => {
        step.dataset.active = String(step.dataset.narrativeStep === stateId);
      });
      controls.forEach((control) => {
        const active = control.dataset.narrativeControl === stateId;
        if (active) control.setAttribute('aria-current', 'step');
        else control.removeAttribute('aria-current');
      });

      if (position) {
        position.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
      }
      if (options.announce && announcement) {
        const activeLabel =
          controls[activeIndex]?.querySelector<HTMLElement>('.narrative__rail-label')?.textContent?.trim() ?? stateId;
        announcement.textContent = `Current state: ${activeLabel}`;
      }

      if (options.syncTrace && traceController) {
        const stageId = steps[activeIndex]?.querySelector<HTMLButtonElement>('[data-select-trace-stage]')?.dataset.selectTraceStage;
        if (stageId) {
          syncingTrace = true;
          traceController.select(stageId);
          syncingTrace = false;
        }
      }
    }

    controls.forEach((control) => {
      control.addEventListener('click', () => {
        const stateId = control.dataset.narrativeControl;
        if (!stateId) return;
        const step = steps.find((candidate) => candidate.dataset.narrativeStep === stateId);
        if (step) step.scrollIntoView({ block: 'center', behavior: 'instant' });
        setActiveState(stateId, { syncTrace: true, announce: true });
      });
    });

    stageLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const stageId = link.dataset.selectTraceStage;
        if (!stageId || !traceRoot || !traceController) return;
        traceRoot.scrollIntoView({ block: 'center', behavior: 'instant' });
        traceController.select(stageId);
        traceRoot.querySelector<HTMLButtonElement>(`[data-stage-tab="${stageId}"]`)?.focus({ preventScroll: true });
      });
    });

    setActiveState(steps[0]?.dataset.narrativeStep ?? '', { announce: false });
  }
</script>

<style>
  .project {
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .project__header {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
  }

  .project__head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-on-paper-muted);
  }

  .project__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .project__status--live .project__status-dot {
    background: var(--color-signal-pass);
  }

  .project__status--in-progress .project__status-dot {
    background: var(--color-accent);
  }

  .project__status--built-for-learning .project__status-dot {
    background: var(--color-text-on-paper-muted);
  }

  .project__title {
    margin: 0;
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
  }

  .project__short {
    max-width: var(--width-reading);
    margin: var(--space-2) 0 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.4;
  }

  .project__claim {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .project__meta {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper-soft);
  }

  .project__meta > div {
    display: grid;
    gap: var(--space-2);
  }

  .project__meta dt {
    color: var(--color-text-on-paper-muted);
  }

  .project__meta dd {
    margin: 0;
  }

  .project__meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .project__meta-list li {
    padding-right: var(--space-3);
    border-right: 1px solid var(--color-rule-on-paper-soft);
  }

  .project__meta-list li:last-child {
    border-right: 0;
  }

  .project__meta-list a {
    color: var(--color-text-on-paper);
    font-weight: 600;
    text-decoration: none;
  }

  .project__meta-list a:hover {
    color: var(--color-accent);
  }

  .project__meta-ext {
    margin-left: var(--space-1);
    color: var(--color-accent);
    font-size: 0.75em;
  }

  .project__meta-note {
    display: block;
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-meta);
    font-weight: 400;
  }

  .project__product {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule-on-paper);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  /* --- Narrative --- */
  .project__narrative {
    padding-block: var(--section-block);
  }

  .narrative__intro {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
    margin-bottom: var(--space-7);
  }

  .narrative__intro h3 {
    margin: 0;
    max-width: 24ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .narrative__intro p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .narrative__rail {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .narrative__rail-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
  }

  .narrative__rail-status {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .narrative__rail-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .narrative__rail-list li {
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .narrative__rail-list li:first-child {
    border-top: 0;
  }

  .narrative__rail-btn {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: transparent;
    color: var(--color-text-on-paper-muted);
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .narrative__rail-btn:hover {
    color: var(--color-text-on-paper);
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
  }

  .narrative__rail-num {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .narrative__rail-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .narrative__rail-tone {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .narrative__rail-tone[data-tone='failure'] {
    border-color: var(--color-signal-fail);
    background: var(--color-signal-fail);
  }

  .narrative__rail-tone[data-tone='technical'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .narrative__rail-tone[data-tone='valid'] {
    border-color: var(--color-signal-pass);
    background: var(--color-signal-pass);
  }

  .narrative__rail-btn[aria-current='step'] {
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .narrative__rail-btn:focus-visible {
    outline-offset: -3px;
  }

  .narrative__sequence {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .narrative__state {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .narrative__state[data-tone='failure'] {
    border-color: color-mix(in srgb, var(--color-signal-fail) 40%, var(--color-rule-on-paper));
  }

  .narrative__state[data-tone='valid'] {
    border-color: color-mix(in srgb, var(--color-signal-pass) 40%, var(--color-rule-on-paper));
  }

  .narrative__state-copy {
    display: grid;
    gap: var(--space-3);
  }

  .narrative__state-kicker {
    color: var(--color-text-on-paper-muted);
  }

  .narrative__state-copy h4 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.08;
  }

  .narrative__state-summary {
    margin: 0;
    max-width: 34rem;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .narrative__state-link {
    color: var(--color-text-on-paper);
    justify-self: start;
  }

  /* --- Inspector --- */
  .project__inspector {
    padding-block: var(--section-block);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .inspector__intro {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    max-width: var(--width-content);
