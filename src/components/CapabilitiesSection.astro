type ToolkitItem = {
  id: string;
  name: string;
  featuredOrder: number | null;
  usedIn: { project: string; href?: string }[];
  evidence: string[];
  note?: string;
};

type ToolkitGroup = {
  category: string;
  items: ToolkitItem[];
};

const toolkit: ToolkitGroup[] = [
