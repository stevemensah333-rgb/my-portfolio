const allToolkitItems = toolkit.flatMap(group => group.items);
const primaryToolkitItems = allToolkitItems
  .filter(item => item.featuredOrder !== null)
  .sort((a, b) => (a.featuredOrder ?? 0) - (b.featuredOrder ?? 0));
const additionalToolkit = toolkit
  .map(group => ({
    ...group,
    items: group.items.filter(item => item.featuredOrder === null),
  }))
  .filter(group => group.items.length > 0);
const additionalToolCount = additionalToolkit.reduce((count, group) => count + group.items.length, 0);
const initialItemId = primaryToolkitItems[0]?.id;
---

<!--
  CAPABILITIES — an engineering index, not a card grid.

  The information model is unchanged. What changed is that the three
  parts no longer read as three repetitions of the same content:

    PRIMARY   a numbered index of capabilities, rendered as ruled
              rows with no container. Selecting one is inspection.
    SELECTED  the detail for the current row — the only bounded
              panel in the section, because it is the only thing
              with a real boundary (it is a viewport onto one item).
    MORE      the long tail, disclosed, set in a denser two-column
              register so it visibly ranks below the primary list.

  The section reads top-to-bottom as capability → evidence → tail.
-->
<section id="capabilities" class="toolkit" aria-labelledby="toolkit-title" data-workspace-section="capabilities">
  <SectionFrame
    coordinate="04.3 · Profile / Capabilities"
    status={`${primaryToolkitItems.length} primary · ${additionalToolCount} supporting`}
    surface="paper"
    density="tight"
  >
    <div class="page-shell region-grid" data-toolkit>
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">04.3</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Capabilities</span>
          <span class="region-index__note">Every entry is anchored to a project or an artifact.</span>
        </div>
      </aside>

      <div class="region-body toolkit__body">
        <header class="toolkit__header">
          <h2 id="toolkit-title" class="region-title">Capabilities</h2>
          <p class="region-lede">
            Project-relevant capabilities stay visible. Select one to see where I used it and what
            I actually did with it.
          </p>
        </header>

        <div class="toolkit__index">
          <section class="toolkit__primary" aria-labelledby="toolkit-primary-title">
            <header class="toolkit__primary-header">
              <h3 id="toolkit-primary-title">Project capabilities</h3>
              <p class="mono-label mono-label--bare">{primaryToolkitItems.length} selected</p>
            </header>
            <ul class="toolkit__primary-list" role="tablist" aria-label="Project capabilities">
              {primaryToolkitItems.map(item => {
                  const itemId = item.id;
                  const btnId = `toolkit-btn-${itemId}`;
                  const isInitial = itemId === initialItemId;
                  return (
                    <li class="toolkit__item" role="presentation">
                      <button
                        id={btnId}
                        type="button"
                        role="tab"
                        class="toolkit__trigger"
                        aria-controls={`toolkit-panel-${itemId}`}
                        aria-selected={isInitial ? 'true' : 'false'}
                        tabindex={isInitial ? 0 : -1}
                        data-active={String(isInitial)}
                        data-toolkit-trigger={itemId}
                      >
                        <span class="toolkit__trigger-step" aria-hidden="true">
                          {String(item.featuredOrder ?? '').padStart(2, '0')}
                        </span>
                        <span class="toolkit__trigger-name">{item.name}</span>
                        <span class="toolkit__trigger-mark" aria-hidden="true"></span>
                      </button>
                    </li>
                  );
                })}
            </ul>
          </section>

          <section class="toolkit__detail" data-toolkit-detail>
            {primaryToolkitItems.map(item => {
              const itemId = item.id;
              const btnId = `toolkit-btn-${itemId}`;
              const isInitial = itemId === initialItemId;
              return (
                <article
                  id={`toolkit-panel-${itemId}`}
                  class="toolkit__panel"
                  role="tabpanel"
                  aria-labelledby={btnId}
                  data-toolkit-detail-panel={itemId}
                  data-active={String(isInitial)}
                  tabindex="0"
                  hidden={!isInitial}
                >
                  <header class="toolkit__panel-header">
                    <p class="mono-label mono-label--bare">
                      <span class="toolkit__panel-step" aria-hidden="true">{String(item.featuredOrder ?? '').padStart(2, '0')}</span>
                      Selected
                    </p>
                    <strong class="toolkit__panel-name">{item.name}</strong>
                  </header>
                  <dl class="toolkit__panel-grid">
                    <div>
                      <dt class="mono-label mono-label--bare">Used in</dt>
                      <dd>
                        <ul class="toolkit__panel-list">
                          {item.usedIn.map(u => (
                            <li>
                              {u.href
                                ? <a href={u.href} target={u.href.startsWith('http') ? '_blank' : undefined} rel={u.href.startsWith('http') ? 'noopener' : undefined}>{u.project}</a>
                                : <span>{u.project}</span>}
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                    <div>
                      <dt class="mono-label mono-label--bare">Evidence</dt>
                      <dd>
                        <ul class="toolkit__panel-list">
                          {item.evidence.map(e => <li>{e}</li>)}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                  {item.note && <p class="toolkit__panel-note">{item.note}</p>}
                </article>
              );
            })}
            <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-toolkit-status></p>
          </section>
        </div>

        <details class="toolkit__more" data-toolkit-more>
          <summary>
            <span class="mono-label mono-label--bare">Supporting tools</span>
            <span class="toolkit__more-count">{additionalToolCount} entries</span>
            <span class="toolkit__more-mark" aria-hidden="true"></span>
          </summary>
          <div class="toolkit__more-groups">
            {additionalToolkit.map((group, groupIndex) => (
              <section class="toolkit__group" aria-labelledby={`toolkit-more-group-${groupIndex}`}>
                <h3 id={`toolkit-more-group-${groupIndex}`}>
                  <span class="mono-label mono-label--bare">{group.category}</span>
                </h3>
                <ul class="toolkit__group-list">
                  {group.items.map(item => (
                    <li>
                      <span class="toolkit__group-name">{item.name}</span>
                      <span class="toolkit__group-meta">
                        {item.usedIn.map((u) => u.project).join(' · ') || '—'}
                      </span>
                      <ul class="toolkit__group-evidence">
                        {item.evidence.map((e) => <li>{e}</li>)}
                      </ul>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </details>
      </div>
    </div>
  </SectionFrame>
</section>

<script>
  import { reserveStackHeight } from '../scripts/initTraceTabs';

  const toolkitRoot = document.querySelector('[data-toolkit]');

  if (toolkitRoot) {
    const triggers = [...toolkitRoot.querySelectorAll<HTMLButtonElement>('[data-toolkit-trigger]')];
    const detailPanels = [...toolkitRoot.querySelectorAll<HTMLElement>('[data-toolkit-detail-panel]')];
    const status = toolkitRoot.querySelector<HTMLElement>('[data-toolkit-status]');
    reserveStackHeight(detailPanels);

    const select = (id: string) => {
      if (!triggers.some(trigger => trigger.dataset.toolkitTrigger === id)) return;

      triggers.forEach(trigger => {
        const active = trigger.dataset.toolkitTrigger === id;
        trigger.setAttribute('aria-selected', String(active));
        trigger.tabIndex = active ? 0 : -1;
        trigger.dataset.active = String(active);
      });
      detailPanels.forEach(panel => {
        const active = panel.dataset.toolkitDetailPanel === id;
        panel.hidden = !active;
        panel.dataset.active = String(active);
      });

      const label = triggers
        .find((trigger) => trigger.dataset.toolkitTrigger === id)
        ?.querySelector('.toolkit__trigger-name')
        ?.textContent
        ?.trim();
      if (status && label) status.textContent = `Showing capability detail: ${label}`;
    };

    triggers.forEach(trigger => {
      const itemId = trigger.dataset.toolkitTrigger;
      if (!itemId) return;

      trigger.addEventListener('click', () => select(itemId));

      trigger.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          select(itemId);
        }
      });

      // A4 fix: do not select on focus. Keyboard nav uses Arrow keys
      // to move focus + change selection; tabbing through should not
      // mutate the visible detail panel.

      trigger.addEventListener('keydown', (e) => {
        const visibleTriggers = triggers;
        const idx = visibleTriggers.indexOf(trigger);
        if (idx < 0) return;
        let next: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          next = (idx + 1) % visibleTriggers.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          next = (idx - 1 + visibleTriggers.length) % visibleTriggers.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          next = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          next = visibleTriggers.length - 1;
        }
        if (next !== null) {
          const t = visibleTriggers[next];
          if (t) {
            t.focus();
            // Select on Arrow / Home / End so keyboard-only users see the
            // corresponding detail panel change (A4 fix — selection is NOT
            // driven by plain focus).
            const nextId = t.dataset.toolkitTrigger;
            if (nextId) select(nextId);
          }
        }
      });
    });

    const initial = triggers.find(trigger => trigger.getAttribute('aria-selected') === 'true')?.dataset.toolkitTrigger;
    if (initial) select(initial);
  }
</script>

<style>
  .toolkit {
    background: var(--color-sheet);
  }

  .toolkit__body {
    gap: var(--space-5);
  }

  .toolkit__header {
    display: grid;
    gap: var(--space-3);
  }

  /* The index: capability list and its detail viewport, side by side
     at width. They are one unit — hence one shared top rule. */
  .toolkit__index {
    display: grid;
    gap: var(--space-5);
  }

  /* --- primary list --------------------------------------------- */
  /* No container. Ruled rows carry the structure, the selected row
     carries a copper edge. A capability is a line item in an index,
     not a card. */

  .toolkit__primary {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .toolkit__primary-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule-on-paper-strong);
  }

  .toolkit__primary-header h3 {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0;
  }

  .toolkit__primary-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toolkit__item {
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .toolkit__trigger {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border: 0;
    border-left: 2px solid transparent;
    background: transparent;
    color: var(--color-text-on-paper-muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard),
      padding-left var(--duration-base) var(--ease-emphasized);
  }

  .toolkit__trigger:hover,
  .toolkit__trigger:focus-visible {
    color: var(--color-text-on-paper);
    padding-left: var(--space-2);
  }

  .toolkit__trigger-step {
    padding-left: var(--space-3);
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  /* The selection mark is an ARC NODE, matching the trace: hollow
     when unselected, filled copper when selected. Same vocabulary,
     same meaning — "this is the item under inspection". */
  .toolkit__trigger-mark {
    width: var(--node-size);
    height: var(--node-size);
    border-radius: 50%;
    border: 1px solid var(--color-rule-on-paper-strong);
    background: transparent;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard);
  }

  .toolkit__trigger[aria-selected='true'] {
    border-left-color: var(--color-accent);
    padding-left: var(--space-2);
    background: var(--color-sheet-soft);
    color: var(--color-text-on-paper);
  }

  .toolkit__trigger[aria-selected='true'] .toolkit__trigger-step {
    color: var(--color-accent-text);
  }

  .toolkit__trigger[aria-selected='true'] .toolkit__trigger-mark {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* --- detail viewport ------------------------------------------ */
  /* The one bounded panel in the section. It is bounded because it
     is genuinely a viewport: its contents swap. */

  .toolkit__detail {
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-sheet-high);
    min-height: 0;
  }

  .toolkit__panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .toolkit__panel[hidden] {
    display: none !important;
  }

  /* Progressive enhancement: without JS, every panel shows stacked. */
  html:not(.js) .toolkit__panel,
  html:not(.js) .toolkit__panel[hidden] {
    display: grid !important;
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  html:not(.js) .toolkit__primary {
    display: none;
  }

  .toolkit__panel-header {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .toolkit__panel-name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-on-paper);
  }

  /* The detail carries the same index the selected row shows, so
     capability → where used → evidence reads as one numbered record. */
  .toolkit__panel-step {
    margin-right: var(--space-2);
    color: var(--color-accent-text);
  }

  .toolkit__panel-grid {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .toolkit__panel-grid > div {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .toolkit__panel-grid dt {
    color: var(--color-text-on-paper-faint);
  }

  .toolkit__panel-grid dd {
    margin: 0;
  }

  .toolkit__panel-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Evidence items are hung on a short copper rule rather than a
     bullet square — the same leading-tick motif as .mono-label. */
  .toolkit__panel-list li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .toolkit__panel-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  .toolkit__panel-list a {
    color: var(--color-text-on-paper);
    font-weight: 600;
  }

  .toolkit__panel-note {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* --- supporting tools (the tail) -------------------------------- */
  /* Visibly subordinate: denser type, a recessed ground, and no
     container of its own beyond the disclosure boundary. */

  .toolkit__more {
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .toolkit__more summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    padding-block: var(--space-2);
    color: var(--color-text-on-paper);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .toolkit__more summary::-webkit-details-marker {
    display: none;
  }

  .toolkit__more summary:hover,
  .toolkit__more summary:focus-visible {
    color: var(--color-accent-text);
  }

  .toolkit__more-count {
    justify-self: start;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Disclosure marker: a plus that rotates to a cross. Shape carries
     the state, not just colour. */
  .toolkit__more-mark {
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  .toolkit__more-mark::before,
  .toolkit__more-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-accent);
  }

  .toolkit__more-mark::before {
    width: 100%;
    height: 1px;
  }

  .toolkit__more-mark::after {
    width: 1px;
    height: 100%;
  }

  .toolkit__more[open] .toolkit__more-mark {
    transform: rotate(45deg);
  }

  .toolkit__more-groups {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-4) var(--space-2);
  }

  .toolkit__group h3 {
    margin: 0 0 var(--space-2);
  }

  .toolkit__group-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toolkit__group-list li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) 0;
