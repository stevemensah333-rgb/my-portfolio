---
/**
 * CAPABILITIES — the old Toolkit, re-based around capabilities.
 *
 * The previous index led with technologies: a row per tool, detail
 * per tool. That inverted the hierarchy — a visitor should read
 * what Stephen can do first, and see the stack underneath. This
 * section is organised by four capabilities:
 *
 *   01 AI APPLICATIONS · 02 BACKEND · 03 PRODUCT ENGINEERING · 04 DATA / ML
 *
 * Selecting a capability reveals the evidence behind it — where the
 * capability was exercised and what was actually done — plus the
 * technologies that support it. Technologies are a mono line inside
 * a capability, never the visual hierarchy themselves.
 *
 * Deliberately absent: proficiency bars, percentages, ratings,
 * logo clouds. A capability claim is only as good as its evidence,
 * so the rows carry none of the vocabulary that would imply a
 * measured level.
 *
 * Every evidence line below is carried over from the previous
 * toolkit index and the project registry — nothing here is new
 * information about the projects themselves.
 */
import SectionFrame from './SectionFrame.astro';

type CapabilityEvidence = {
  text: string;
  /** Short mono attribution, e.g. a project or context name. */
  where: string;
  /** Shareable route for the artifact, when one exists. */
  href?: string;
};

type Capability = {
  id: string;
  name: string;
  /** One plain sentence on what the capability means in practice. */
  statement: string;
  /** Support, not hierarchy: the stack behind the capability. */
  technologies: string[];
  evidence: CapabilityEvidence[];
};

