const isExternal = (href?: string) => !!href && href.startsWith('http');
---

<!--
  CAPABILITIES — an index of what I do, each row a claim the rest of
  the site can check.

    LIST      four ruled rows. No containers, no chips grid — a
              capability is a line item, and selecting one is
              inspection (copper edge + filled node, the same open/
              selected vocabulary as Experience and Evidence).
    SELECTED  the bounded viewport beside the list: a plain
              statement of what the capability means, the supporting
              technologies set as a mono line, and the evidence —
              each item attributed to the project or context it came
              from, linked where a public artifact exists.

  No-JavaScript: every capability's detail shows, stacked. The
  information is never gated behind the selection.
-->
<section id="capabilities" class="capabilities" aria-labelledby="capabilities-title" data-workspace-section="capabilities" data-workspace-label="Capabilities">
  <SectionFrame
    coordinate="04.3 · Profile / Capabilities"
    status="Evidence-anchored"
    surface="paper"
    density="default"
  >
    <div class="page-shell region-grid" data-capabilities>
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">04.3</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Capabilities</span>
          <span class="region-index__note">Every line traces to a project or an artifact.</span>
        </div>
      </aside>

      <div class="region-body capabilities__body">
        <header class="capabilities__header">
          <h2 id="capabilities-title" class="region-title">What I can do</h2>
          <p class="region-lede">
            Four capabilities, each traced to the work where it was applied. The tools
            underneath support them — they are not the claim.
          </p>
        </header>

        <div class="capabilities__split">
          <section class="capabilities__list" aria-labelledby="capabilities-list-title">
            <h3 id="capabilities-list-title" class="visually-hidden">Capabilities</h3>
            <ul role="tablist" aria-label="Capabilities" class="capabilities__rows">
              {capabilities.map((capability, index) => {
                const isActive = capability.id === initialId;
                return (
                  <li role="presentation">
                    <button
                      type="button"
                      role="tab"
                      id={`cap-btn-${capability.id}`}
                      class="capabilities__trigger"
                      data-cap-trigger={capability.id}
                      aria-controls={`cap-panel-${capability.id}`}
                      aria-selected={isActive}
                      tabindex={isActive ? 0 : -1}
                    >
                      <span class="capabilities__trigger-no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                      <span class="capabilities__trigger-name">{capability.name}</span>
                      <span class="capabilities__trigger-mark" aria-hidden="true"></span>
                    </button>
                  </li>
                );
              })}
            </ul>
          </section>

          <section class="capabilities__detail">
            {capabilities.map((capability, index) => {
              const isActive = capability.id === initialId;
              return (
                <div
                  id={`cap-panel-${capability.id}`}
                  class="capabilities__panel"
                  role="tabpanel"
                  aria-labelledby={`cap-btn-${capability.id}`}
                  data-cap-panel={capability.id}
                  tabindex="0"
                  hidden={!isActive}
                >
                  <header class="capabilities__panel-head">
                    <span class="mono-label mono-label--bare">
                      <span class="capabilities__panel-step" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                      {capability.name}
                    </span>
                  </header>

                  <p class="capabilities__statement">{capability.statement}</p>

                  <p class="capabilities__tech">
                    <span class="capabilities__tech-label">Supports</span>
                    <span class="capabilities__tech-list">{capability.technologies.join(' · ')}</span>
                  </p>

                  <div class="capabilities__evidence">
                    <p class="mono-label mono-label--bare">Evidence</p>
                    <ul>
                      {capability.evidence.map((item) => (
                        <li>
                          <span class="capabilities__evidence-text">{item.text}</span>
                          {item.href ? (
                            <a
                              class="capabilities__evidence-where"
                              href={item.href}
                              rel={isExternal(item.href) ? 'noopener' : undefined}
                              target={isExternal(item.href) ? '_blank' : undefined}
                            >
                              {item.where}
                            </a>
                          ) : (
                            <span class="capabilities__evidence-where capabilities__evidence-where--static">{item.where}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              );
            })}
            <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-cap-status></p>
          </section>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<script>
  import { reserveStackHeight } from '../scripts/initTraceTabs';

  /* Re-initializes on `astro:page-load` (the ClientRouter swaps the
     shell without re-running bundled scripts); the marker keeps it
     idempotent and the run-scoped AbortController removes the previous
     run's window listeners. */
  let teardown: (() => void) | null = null;

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-capabilities]');
    if (!root || root.dataset.capabilitiesEnhanced === '1') return;
    root.dataset.capabilitiesEnhanced = '1';
    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();
    const signal = events.signal;

    {
    const STORAGE_KEY = 'workspace:capability';
    const readStored = () => {
      try {
        return sessionStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    };
    const writeStored = (id: string) => {
      try {
        sessionStorage.setItem(STORAGE_KEY, id);
      } catch {}
    };

    const triggers = [...root.querySelectorAll<HTMLButtonElement>('[data-cap-trigger]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-cap-panel]')];
    const status = root.querySelector<HTMLElement>('[data-cap-status]');
    reserveStackHeight(panels, signal);

    // The live region is for user-driven changes only; the initial
    // render must not announce anything on page load.
    let interacted = false;

    const select = (id: string) => {
      if (!triggers.some((trigger) => trigger.dataset.capTrigger === id)) return;

      for (const trigger of triggers) {
        const active = trigger.dataset.capTrigger === id;
        trigger.setAttribute('aria-selected', String(active));
        trigger.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) {
        const active = panel.dataset.capPanel === id;
        panel.hidden = !active;
      }

      const label = triggers
        .find((trigger) => trigger.dataset.capTrigger === id)
        ?.querySelector('.capabilities__trigger-name')
        ?.textContent
        ?.trim();
      if (status && label && interacted) status.textContent = `Showing capability: ${label}`;
      writeStored(id);
    };

    for (const trigger of triggers) {
      const id = trigger.dataset.capTrigger;
      if (!id) continue;

      trigger.addEventListener('click', () => {
        interacted = true;
        select(id);
      });

      // Hover-select only where hovering is a deliberate pointer
      // action (same rule the evidence drawer follows).
      trigger.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          interacted = true;
          select(id);
        }
      });

      trigger.addEventListener('keydown', (event) => {
        const index = triggers.indexOf(trigger);
        let next: number | null = null;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          next = (index + 1) % triggers.length;
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
          next = (index - 1 + triggers.length) % triggers.length;
        } else if (event.key === 'Home') {
          next = 0;
        } else if (event.key === 'End') {
          next = triggers.length - 1;
        }
        if (next === null) return;
        event.preventDefault();
        interacted = true;
        const target = triggers[next];
        if (target) {
          target.focus();
          select(target.dataset.capTrigger ?? '');
        }
      });
    }

    const stored = readStored();
    const hasStored = stored ? triggers.some((t) => t.dataset.capTrigger === stored) : false;
    const marked = triggers.find((trigger) => trigger.getAttribute('aria-selected') === 'true')?.dataset
      .capTrigger;
    const initial = hasStored ? stored! : marked;
    if (initial) select(initial);
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .capabilities {
    background: var(--color-sheet);
  }

  .capabilities__body {
    gap: var(--space-5);
  }

  .capabilities__header {
    display: grid;
    gap: var(--space-3);
  }

  .capabilities__split {
    display: grid;
    gap: var(--space-5);
  }

  /* --- the list -------------------------------------------------- */
  /* Ruled rows, no container, no chrome beyond the rules. A
     capability is a line item in an index. */

  .capabilities__rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .capabilities__rows li {
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .capabilities__trigger {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 0.5rem;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-3) 0;
    border: 0;
    border-left: 2px solid transparent;
    background: transparent;
    color: var(--color-text-on-paper-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard),
      padding-left var(--duration-base) var(--ease-emphasized);
  }

  .capabilities__trigger:hover,
  .capabilities__trigger:focus-visible {
    color: var(--color-text-on-paper);
    padding-left: var(--space-2);
  }

  .capabilities__trigger:focus-visible {
    outline-offset: -2px;
  }

  .capabilities__trigger-no {
    padding-left: var(--space-3);
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .capabilities__trigger-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Selection node: hollow when idle, filled copper when selected —
     the same "under inspection" mark the other Profile sections use. */
  .capabilities__trigger-mark {
    justify-self: end;
    width: var(--node-size);
    height: var(--node-size);
    border-radius: 50%;
    border: 1px solid var(--color-rule-on-paper-strong);
    background: transparent;
    transition:
      background-color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard);
  }

  .capabilities__trigger[aria-selected='true'] {
    border-left-color: var(--color-accent);
    background: var(--color-sheet-soft);
    color: var(--color-text-on-paper);
    padding-left: var(--space-2);
  }

  .capabilities__trigger[aria-selected='true'] .capabilities__trigger-no {
    color: var(--color-accent-text);
  }

  .capabilities__trigger[aria-selected='true'] .capabilities__trigger-mark {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* --- the selected capability ----------------------------------- */
  /* The one bounded panel in the section: it is a viewport whose
     contents swap, so it earns a frame. */

  .capabilities__detail {
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-sheet-high);
  }

  .capabilities__panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .capabilities__panel[hidden] {
    display: none !important;
  }

  .capabilities__panel-head {
    display: grid;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .capabilities__panel-step {
    margin-right: var(--space-2);
    color: var(--color-accent-text);
  }

  .capabilities__statement {
    margin: 0;
    max-width: 52ch;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* Technologies: support, so they read as a data line — one mono
     run, label and value, not a chip field. */
  .capabilities__tech {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }

  .capabilities__tech-label {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .capabilities__tech-list {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-instrument);
    letter-spacing: 0.02em;
    line-height: 1.6;
  }

  /* Evidence: each line is a thing done, attributed at the edge.
     Hung on the leading-tick motif, like the drawer captions. */
  .capabilities__evidence {
    display: grid;
    gap: var(--space-3);
  }

  .capabilities__evidence ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capabilities__evidence li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .capabilities__evidence-text {
    position: relative;
    padding-left: var(--space-5);
  }

  .capabilities__evidence-text::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.75rem;
    height: 1px;
    background: var(--color-accent);
  }

  .capabilities__evidence-where {
    justify-self: end;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-quick) var(--ease-standard);
  }

  .capabilities__evidence-where:hover,
  .capabilities__evidence-where:focus-visible {
    border-bottom-color: currentColor;
  }

  /* Attribution without a public artifact is set as plain data —
     not a dead link pretending to be one. */
  .capabilities__evidence-where--static {
    color: var(--color-text-on-paper-faint);
  }

  /* Progressive enhancement: without JS, every capability shows,
     stacked — the list of buttons would swap nothing. */
  html:not(.js) .capabilities__list {
    display: none;
  }

  html:not(.js) .capabilities__panel,
  html:not(.js) .capabilities__panel[hidden] {
    display: grid !important;
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  html:not(.js) .capabilities__detail {
    border-color: var(--color-rule-on-paper-strong);
  }

  @media (min-width: 48rem) {
    .capabilities__panel {
      padding: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .capabilities__split {
      grid-template-columns: minmax(13rem, 16.5rem) minmax(0, 1fr);
      column-gap: var(--rail-gap);
      align-items: start;
    }

    .capabilities__detail {
      position: sticky;
      top: var(--space-6);
    }

    .capabilities__evidence li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  /* Very narrow: the attribution drops under the line it belongs
     to rather than squeezing it. */
  @media (max-width: 24rem) {
    .capabilities__evidence li {
      grid-template-columns: minmax(0, 1fr);
    }

    .capabilities__evidence-where {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capabilities__trigger,
    .capabilities__trigger-mark,
    .capabilities__evidence-where {
      transition: none;
    }
  }
</style>
