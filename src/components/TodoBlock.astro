---
interface Props {
  title: string;
  detail: string;
}

const { title, detail } = Astro.props;
---

<aside class="todo" aria-label={`Missing information: ${title}`}>
  <p class="todo-label">TODO / Evidence required</p>
  <p class="todo-title">{title}</p>
  <p class="todo-detail">{detail}</p>
</aside>

<style>
  .todo {
    padding: var(--space-5);
    border: var(--border-width) dashed var(--color-text-secondary);
    background: var(--color-surface);
  }

  .todo p {
    margin: 0;
  }

  .todo-label {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .todo-title {
    margin-top: var(--space-3) !important;
    font-weight: 600;
  }

  .todo-detail {
    margin-top: var(--space-2) !important;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.55;
  }
</style>
