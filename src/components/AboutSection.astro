---
/**
 * ABOUT — the human register.
 *
 * The most open section in the portfolio: a real photograph and two
 * short paragraphs, set at the page's airiest rhythm. No instrument
 * vocabulary — no rail, no read-out, no tags — because this is the
 * person the instruments belong to. The SectionFrame seam and
 * coordinate stay: they are how the system marks a region. The
 * portrait is a transparent cut-out, so it has no box — it stands on
 * a single baseline rule, the same way it does in the home hero.
 *
 * The portrait is the real photograph (public/images/stephen.{png,webp},
 * 500×500): no canvas, no particles, no 3D, no reconstruction.
 *
 * The page-level h1 is the Profile opener; About is an h2 on the same
 * content register, so the human statement can be large without
 * breaking heading order.
 */
import SectionFrame from './SectionFrame.astro';
---

<section id="about" class="about" aria-labelledby="about-title" data-workspace-section="about" data-workspace-label="About">
  <SectionFrame coordinate="04.1 · Profile / About" surface="paper" density="major">
    <div class="page-shell about__grid">
      <figure class="about__portrait">
        <picture>
          <source type="image/webp" srcset="/images/stephen.webp" />
          <img
            src="/images/stephen.png"
            alt="Portrait of Stephen Mensah"
            width={500}
            height={500}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>

      <div class="about__body">
        <h2 id="about-title" class="about__title">A little about me.</h2>
        <div class="about__copy">
          <p>
            I’m a software engineer and a Computer Science student at Ashesi University in
            Berekuso, Ghana. I build software that involves AI and the backends underneath it:
            the API a feature calls, the record it changes, the interface someone reads the
            answer in.
          </p>
          <p>
            I’m particularly interested in what happens when AI-generated output has to work
            inside a real product — the context a model is given, structured output, validation
            before anything is stored, integrations, and what the application does when a
            response fails. That is the engineering I want to keep getting better at.
          </p>
          <p>
            The projects themselves live in <a href="/work/">Work</a> — Syncareer, SessionBook,
            a farm system for Koranco Farms. This page is the other half: where I’ve worked,
            what I can be relied on for, and the records to back it up.
          </p>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .about {
    background: var(--color-sheet);
  }

  .about__grid {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .about__body {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  /* About is the one section heading allowed display scale — it is a
     human statement, not a label. */
  .about__title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
  }

  .about__copy p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.7;
  }

  /* The one quiet link — out to the projects. */
  .about__copy a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  .about__copy a:hover {
    color: var(--color-accent-text);
  }

  /* The portrait is a transparent cut-out: no mat, no fill, no frame
     — any of those would draw back the rectangle the cut-out removes.
     Its cropped lower edge stands on one rule, the baseline it shares
     with the home hero. No caption, no read-out. */
  .about__portrait {
    width: min(100%, 14rem);
    margin: 0;
    border-bottom: 1px solid var(--color-rule-on-paper-strong);
  }

  .about__portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 60rem) {
    .about__grid {
      grid-template-columns: 13rem minmax(0, 1fr);
      column-gap: var(--rail-gap);
    }

    .about__portrait {
      width: 100%;
      /* Offset so the print hangs slightly below the opening line —
         the one place asymmetry is allowed to be loose. */
      margin-top: var(--space-5);
    }
  }
</style>
