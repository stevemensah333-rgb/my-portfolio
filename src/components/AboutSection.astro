---
import ReliabilityTrace from './ReliabilityTrace.astro';
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="page-shell about-layout">
    <header>
      <p class="technical-label">About</p>
      <h2 id="about-title">A little about me.</h2>
    </header>

    <div class="about-copy">
      <p>
        I'm a Computer Science student at Ashesi University. I'm curious, analytical and attentive,
        especially when details are easy to miss.
      </p>
    </div>

    <div class="portrait-composition">
      <picture class="about-portrait">
        <source
          srcset="/images/stephen-mensah-portrait-440.jpg 440w, /images/stephen-mensah-portrait-880.jpg 880w"
          sizes="(min-width: 64rem) 18rem, (min-width: 48rem) 20rem, calc(100vw - 2.5rem)"
        />
        <img
          src="/images/stephen-mensah-portrait-880.jpg"
          alt="Stephen Mensah"
          width="880"
          height="1100"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <ReliabilityTrace variant="portrait" />
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: clamp(3.25rem, 5.5vw, 5rem);
    border-top: var(--border-default);
    scroll-margin-top: 5rem;
  }

  .about-layout {
    display: grid;
    gap: var(--section-content-gap);
  }

  header p,
  header h2 {
    margin: 0;
  }

  header h2 {
    max-width: 12ch;
    margin-top: var(--section-heading-gap);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .about-copy {
    max-width: var(--width-reading);
  }

  .about-copy p {
    margin-bottom: var(--space-5);
    color: var(--color-text);
    font-size: var(--text-body-large);
    line-height: 1.6;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .about-portrait {
    display: block;
    width: 100%;
    padding: clamp(0.5rem, 1.5vw, 0.75rem);
    border: var(--border-default);
    border-radius: var(--radius-card);
    background: var(--color-surface-light);
    box-shadow: 0 1rem 2.5rem rgb(18 20 22 / 6%);
    transition:
      transform var(--duration-normal) var(--ease-emphasized),
      box-shadow var(--duration-normal) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
    will-change: transform;
  }

  .about-portrait:hover,
  .portrait-composition:focus-within .about-portrait {
    transform: translateY(-2px) rotate(0.2deg);
    border-color: color-mix(in srgb, var(--color-border) 50%, var(--color-accent));
    box-shadow: 0 1.25rem 3rem rgb(18 20 22 / 8%);
  }

  .about-portrait img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-card) / 2);
  }

  .portrait-composition {
    display: grid;
    width: min(100%, 20rem);
    gap: var(--space-3);
    justify-items: end;
  }

  @media (min-width: 48rem) {
    .about-layout {
      grid-template-columns: minmax(13rem, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
      align-items: start;
    }

    .about-copy,
    .portrait-composition {
      grid-column: 2;
    }
  }

  @media (min-width: 64rem) {
    .about-layout {
      grid-template-columns: minmax(13rem, 3fr) minmax(18rem, 5fr) minmax(14rem, 18rem);
    }

    .about-copy {
      grid-column: 2;
    }

    .portrait-composition {
      grid-column: 3;
      width: 100%;
    }
  }
</style>
