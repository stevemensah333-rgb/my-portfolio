---
/**
 * ABOUT — the quiet register.
 *
 * Deliberately the least structured section on the page: an open
 * two-column composition — portrait offset into the left margin,
 * prose at a comfortable measure — with no index rail, no ruled
 * insets and no read-out. The SectionFrame seam and coordinate stay
 * because they are how the system marks a region; inside About, the
 * instrument vocabulary is otherwise switched off.
 *
 * The page-level h1 is the Profile opener; About is an h2 on the
 * same display register, so the human statement can be large
 * without breaking heading order.
 */
import ParticlePortrait from './ParticlePortrait.astro';
import SectionFrame from './SectionFrame.astro';
---

<section id="about" class="about" aria-labelledby="about-title" data-workspace-section="about" data-workspace-label="About">
  <SectionFrame coordinate="04.1 · Profile / About" surface="paper" density="default">
    <div class="page-shell about__grid">
      <div class="about__portrait">
        <ParticlePortrait
          src="/images/stephen.png"
          alt="Stephen Mensah"
          width={800}
          height={800}
          srcset="/images/stephen-480.webp 480w, /images/stephen-800.webp 800w"
          sizes="(min-width: 60rem) 11.5rem, min(14rem, calc(100vw - 3rem))"
        />
      </div>

      <div class="about__body">
        <h2 id="about-title" class="about__title">A little about me.</h2>
        <div class="about__copy">
          <p>
            I'm a Computer Science student at Ashesi University in Berekuso, Ghana. I spend a lot
            of build time chasing the problems that only show up at the boundary — between a model
            and a contract, between a request and a database row, between what a system promises
            and what it actually does.
          </p>
          <p>
            Syncareer is my shipped product: a free career workspace for students whose
            AI help has to cite evidence before it applies — I pitched it to investors and
            secured seed funding. SessionBook is a voice-agent booking backend where the
            interesting problem was keeping concurrency, timezones and spoken confirmation
            honest. I also built a farm management system for Koranco Farms through the
            Ashesi Center for Entrepreneurship.
          </p>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .about {
    background: var(--color-sheet);
  }

  .about__grid {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .about__body {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  /* About is the one section heading allowed display scale — it is a
     human statement, not a label. */
  .about__title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
  }

  .about__copy p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.7;
  }

  /* The portrait is a small squared print hung in the margin — one
     hairline, no corner marks, no read-out. */
  .about__portrait {
    width: min(100%, 14rem);
    padding: var(--space-2);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-sheet-soft);
  }

  .about__portrait :global(.pportrait__readout) {
    display: none;
  }

  @media (min-width: 60rem) {
    .about__grid {
      grid-template-columns: 11.5rem minmax(0, 1fr);
      column-gap: var(--rail-gap);
    }

    .about__portrait {
      width: 100%;
      /* Offset so the print hangs slightly below the opening line —
         the one place asymmetry is allowed to be loose. */
      margin-top: var(--space-5);
    }
  }
</style>
