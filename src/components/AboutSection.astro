---
/**
 * ABOUT — the quiet register.
 *
 * Deliberately the least structured section on the page: one column
 * of prose at a comfortable measure, a portrait offset into the
 * margin, and no instrument vocabulary at all. It is the only place
 * where the visual system steps back, which is what makes it read
 * as a person rather than as another panel.
 *
 * Copy unchanged.
 */
import ParticlePortrait from './ParticlePortrait.astro';
import SectionFrame from './SectionFrame.astro';
---

<section id="about" class="about" aria-labelledby="about-title" data-workspace-section="about">
  <SectionFrame coordinate="04.1 · Profile / About" surface="paper" density="default">
    <div class="page-shell region-grid">
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">04.1</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">The engineer</span>
        </div>

        <div class="about__portrait">
          <ParticlePortrait
            src="/images/stephen.png"
            alt="Stephen Mensah"
            width={800}
            height={800}
            srcset="/images/stephen-480.webp 480w, /images/stephen-800.webp 800w"
            sizes="(min-width: 60rem) 11.5rem, min(100vw - 2rem, 14rem)"
          />
        </div>
      </aside>

      <div class="region-body about__body">
        <header class="about__header">
          <h1 id="about-title" class="about__title">A little about me.</h1>
        </header>

        <div class="about__copy">
          <p>
            I'm a Computer Science student at Ashesi University in Berekuso, Ghana. I spend a lot
            of build time chasing the problems that only show up at the boundary — between a model
            and a contract, between a request and a database row, between what a system promises
            and what it actually does.
          </p>
          <p>
            Syncareer is my shipped product: a free career workspace for students whose
            AI help has to cite evidence before it applies — I pitched it to investors and
            secured seed funding. SessionBook is a voice-agent booking backend where the
            interesting problem was keeping concurrency, timezones and spoken confirmation
            honest. I also built a farm management system for Koranco Farms through the
            Ashesi Innovation Lab.
          </p>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .about {
    background: var(--color-sheet);
  }

  .about__body {
    gap: var(--space-5);
  }

  /* About is the one heading in the system allowed to be larger than
     a section title — it is a human statement, not a label. Still
     well below the feature scale used by projects. */
  .about__title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .about__copy {
    display: grid;
    gap: var(--space-5);
    max-width: var(--width-reading);
  }

  .about__copy p {
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-body-large);
    line-height: 1.7;
  }

  /* The portrait sits in the margin column, small and squared, with
     one hairline. No corner marks: this is the section where the
     instrument vocabulary is switched off. */
  .about__portrait {
    width: min(100%, 14rem);
    padding: var(--space-2);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-sheet-soft);
  }

  @media (min-width: 60rem) {
    .about__portrait {
      width: 100%;
      max-width: var(--rail-col);
    }
  }
</style>
