---
interface Props {
  src1440: string;
  src1800: string;
  src2400: string;
  width: number;
  height: number;
  alt: string;
  label: string;
  caption: string;
  sizes?: string;
  priority?: boolean;
  address?: string;
}

const {
  src1440,
  src1800,
  src2400,
  width,
  height,
  alt,
  label,
  caption,
  sizes = '(min-width: 75rem) 72rem, calc(100vw - 2.5rem)',
  priority = false,
  address = 'syncareer.me',
} = Astro.props;

const toWebP = (src: string) => src.replace(/\.png$/i, '.webp');
---

<figure class="product-figure">
  <div class="product-frame">
    <div class="frame-bar" aria-hidden="true">
      <span class="frame-controls"><i></i><i></i><i></i></span>
      <span class="frame-address mono-label">{address}</span>
      <span class="frame-state mono-label">Live product</span>
    </div>
    <picture>
      <source
        type="image/webp"
        srcset={`${toWebP(src1440)} 1440w, ${toWebP(src1800)} 1800w, ${toWebP(src2400)} 2400w`}
        {sizes}
      />
      <source type="image/png" srcset={`${src1440} 1440w, ${src1800} 1800w, ${src2400} 2400w`} {sizes} />
      <img
        src={src1440}
        {alt}
        {width}
        {height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </picture>
    <span class="frame-mark frame-mark--bl" aria-hidden="true"></span>
    <span class="frame-mark frame-mark--br" aria-hidden="true"></span>
  </div>
  <figcaption class="product-caption">
    <span class="product-caption__label mono-label">{label}</span>
    <p>{caption}</p>
  </figcaption>
</figure>

<style>
  .product-figure {
    margin: 0;
  }

  .product-frame {
    position: relative;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
    overflow: hidden;
    transition:
      border-color var(--duration-quick) var(--ease-standard);
  }

  .product-figure:hover .product-frame,
  .product-figure:focus-within .product-frame {
    border-color: color-mix(in srgb, var(--color-rule-on-paper) 50%, var(--color-accent));
  }

  .frame-bar {
    display: grid;
    min-height: 2.25rem;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding-inline: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper-muted);
    background: var(--color-paper-soft);
  }

  .frame-controls {
    display: flex;
    gap: var(--space-2);
  }

  .frame-controls i {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-rule-on-paper);
    background: transparent;
  }

  .frame-controls i:last-child {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .frame-address {
    justify-self: center;
    color: var(--color-text-on-paper);
  }

  .frame-state {
    justify-self: end;
    color: var(--color-accent);
  }

  picture,
  img {
    display: block;
    width: 100%;
  }

  img {
    height: auto;
  }

  /* Signature corner marks on the product frame */
  .frame-mark {
    position: absolute;
    width: 0.625rem;
    height: 0.625rem;
    pointer-events: none;
  }

  .frame-mark::before,
  .frame-mark::after {
    content: '';
    position: absolute;
    background: var(--color-accent);
  }

  .frame-mark::before {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
  }

  .frame-mark::after {
    bottom: 0;
    left: 0;
    width: 1px;
    height: 100%;
  }

  .frame-mark--br { right: 0; left: auto; }
  .frame-mark--br::before { right: 0; left: auto; }
  .frame-mark--br::after { right: 0; left: auto; }

  .product-caption {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .product-caption__label {
    color: var(--color-accent);
  }

  .product-caption p {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  @media (max-width: 30rem) {
    .frame-bar {
      grid-template-columns: auto 1fr;
    }

    .frame-address {
      justify-self: end;
    }

    .frame-state {
      display: none;
    }
  }
</style>
