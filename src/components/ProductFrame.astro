---
interface Props {
  src1440: string;
  src1800: string;
  src2400: string;
  width: number;
  height: number;
  alt: string;
  label: string;
  caption: string;
  sizes?: string;
  priority?: boolean;
}

const {
  src1440,
  src1800,
  src2400,
  width,
  height,
  alt,
  label,
  caption,
  sizes = '(min-width: 75rem) 72rem, calc(100vw - 2.5rem)',
  priority = false,
} = Astro.props;

const toWebP = (src: string) => src.replace(/\.png$/i, '.webp');
---

<figure class="product-figure">
  <div class="product-frame">
    <div class="frame-bar" aria-hidden="true">
      <span class="frame-controls"><i></i><i></i><i></i></span>
      <span class="frame-address">syncareer.me</span>
      <span class="frame-state">Live product</span>
    </div>
    <picture>
      <source
        type="image/webp"
        srcset={`${toWebP(src1440)} 1440w, ${toWebP(src1800)} 1800w, ${toWebP(src2400)} 2400w`}
        {sizes}
      />
      <source type="image/png" srcset={`${src1440} 1440w, ${src1800} 1800w, ${src2400} 2400w`} {sizes} />
      <img
        src={src1440}
        {alt}
        {width}
        {height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </picture>
  </div>
  <figcaption><span>{label}</span><p>{caption}</p></figcaption>
</figure>

<style>
  .product-figure {
    margin: 0;
  }

  .product-frame {
    border: var(--border-default);
    border-radius: var(--radius-card);
    background: var(--color-surface-light);
    box-shadow: 0 1rem 2.75rem rgb(18 20 22 / 5%);
    overflow: hidden;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-medium) var(--ease-standard);
  }

  .product-figure:hover .product-frame {
    border-color: color-mix(in srgb, var(--color-border) 45%, var(--color-accent));
    box-shadow: 0 1.25rem 3rem rgb(18 20 22 / 8%);
  }

  .frame-bar {
    display: grid;
    min-height: 2.5rem;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3);
    align-items: center;
    padding-inline: var(--space-4);
    border-bottom: var(--border-default);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .frame-controls {
    display: flex;
    gap: var(--space-2);
  }

  .frame-controls i {
    width: 0.375rem;
    height: 0.375rem;
    border: var(--border-default);
  }

  .frame-controls i:last-child {
    border-color: var(--color-accent);
  }

  .frame-state {
    justify-self: end;
    color: var(--color-accent);
  }

  picture,
  img {
    display: block;
    width: 100%;
  }

  img {
    height: auto;
  }

  figcaption {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  figcaption span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  figcaption p {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  @media (max-width: 30rem) {
    .frame-bar {
      grid-template-columns: auto 1fr;
    }

    .frame-address {
      justify-self: end;
    }

    .frame-state {
      display: none;
    }
  }
</style>
