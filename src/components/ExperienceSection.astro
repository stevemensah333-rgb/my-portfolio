---
import SectionFrame from './SectionFrame.astro';

const experiences = [
  {
    role: 'Software Engineer Intern',
    organisation: 'Amalitech',
    dates: 'Aug 2026 — Present',
    description:
      'We are examining how farm production data is captured and used, then developing a system to improve record-keeping, production visibility, and operational decision-making.',
    meta: 'INTERNSHIP · SOFTWARE ENGINEERING',
  },
  {
    role: 'DataCamp Donates Program Coordinator',
    organisation: 'DataCamp',
    dates: 'Nov 2025 — Present',
    description:
      "Coordinate access to DataCamp's data science and AI learning resources for a group of 35+ learners. My role includes managing license distribution and helping participants stay engaged with the program.",
    meta: '35+ LEARNERS · DATA & AI EDUCATION',
  },
  {
    role: 'Student Library Assistant',
    organisation: 'Ashesi University',
    dates: 'Feb 2026 — May 2026',
    description:
      'Supported students with academic resources, research materials, printing, scanning, and database navigation. I also regularly helped people work through technical problems by translating unfamiliar processes into straightforward instructions.',
    meta: '50+ STUDENTS SUPPORTED · 30+ TECHNICAL-ASSISTANCE INTERACTIONS',
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <SectionFrame coordinate="04 / Experience" surface="paper">
    <div class="page-shell experience__layout">
      <header class="experience__header">
        <p class="mono-label">Experience</p>
        <h2 id="experience-title" class="experience__title">Where I've worked</h2>
      </header>

      <ol class="experience__list">
        {experiences.map((entry, index) => {
          return (
            <li class="experience__item">
              <details class="experience__entry" name="experience-entry">
                <summary class="experience__trigger">
                  <span class="experience__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span class="experience__heading">
                    <span class="experience__role">{entry.role}</span>
                    <span class="experience__org">{entry.organisation}</span>
                  </span>
                  <span class="experience__dates mono-label">{entry.dates}</span>
                  <span class="experience__indicator" aria-hidden="true">+</span>
                </summary>
                <div class="experience__panel">
                  <p>{entry.description}</p>
                  <p class="experience__meta mono-label">{entry.meta}</p>
                </div>
              </details>
            </li>
          );
        })}
      </ol>
    </div>
  </SectionFrame>
</section>

<style>
  .experience {
    background: var(--color-paper-soft);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .experience__layout {
    display: grid;
    gap: var(--space-7);
  }

  .experience__header {
    display: grid;
    gap: var(--space-3);
  }

  .experience__title {
    margin: 0;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .experience__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .experience__item {
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .experience__trigger {
    display: grid;
    width: 100%;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto 1rem;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding: var(--space-4) 0;
    background: transparent;
    color: var(--color-text-on-paper);
    font: inherit;
    text-align: left;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-quick) var(--ease-standard);
  }

  .experience__trigger::-webkit-details-marker {
    display: none;
  }

  .experience__trigger:hover {
    background: color-mix(in srgb, var(--color-paper-soft) 30%, var(--color-paper));
  }

  .experience__trigger:focus-visible {
    outline-offset: -2px;
  }

  .experience__index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .experience__heading {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .experience__role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-on-paper);
  }

  .experience__org {
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  .experience__dates {
    color: var(--color-accent);
    white-space: nowrap;
  }

  .experience__indicator {
    color: var(--color-accent);
    font-size: 1.125rem;
    font-weight: 400;
    transition: transform var(--duration-quick) var(--ease-standard);
  }

  .experience__entry[open] .experience__indicator {
    transform: rotate(45deg);
  }

  .experience__panel {
    max-width: 42rem;
    margin: 0 0 var(--space-4) calc(2.25rem + var(--space-4));
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }

  .experience__panel p {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.65;
  }

  .experience__meta {
    margin-top: var(--space-3);
    color: var(--color-text-on-paper-muted);
  }

  @media (max-width: 36rem) {
    .experience__trigger {
      grid-template-columns: 1.75rem minmax(0, 1fr) 1rem;
      gap: var(--space-2) var(--space-3);
    }

    .experience__dates {
      grid-column: 2;
      white-space: normal;
    }

    .experience__panel {
      margin-left: calc(1.75rem + var(--space-3));
    }
  }
</style>
