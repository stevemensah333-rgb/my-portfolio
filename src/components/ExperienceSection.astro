---
import SectionFrame from './SectionFrame.astro';

const experiences = [
  {
    role: 'Software Engineer — Applied Innovation Lab',
    organisation: 'Ashesi Center for Entrepreneurship',
    dates: 'Jul 2026 — Sep 2026',
    description:
      'Developed offline-first farm management software for Koranco Farms so field operations keep running uninterrupted in low-connectivity environments. Designed custom authentication and role-based authorization pipelines with FastAPI and PostgreSQL, and built a website for Koranco Farms to improve SEO and bring customers and visitors to contact or visit the farm.',
    meta: 'INNOVATION LAB · KORANCO FARMS · OFFLINE-FIRST · FASTAPI · POSTGRESQL',
  },
  {
    role: 'Software Engineer Intern',
    organisation: 'AmaliTech',
    dates: 'Aug 2026 — Sep 2026',
    description:
      'Engineered the backend for a mentor–mentee matching platform using FastAPI and Python, with JWT authentication for secure session management. Worked in a cross-functional group of 5 tech professionals from different engineering fields to develop a full-stack working MVP.',
    meta: 'INTERNSHIP · BACKEND · FASTAPI · JWT AUTH · MVP',
  },
  {
    role: 'Program Coordinator',
    organisation: 'Ashesi DataCamp Donates — DataCamp',
    dates: 'Nov 2025 — Present',
    description:
      "Coordinated learner access to DataCamp's AI and data science learning platform through the Donates Program, and supported 35+ students and community learners in accessing technical upskilling resources in data science, AI and programming.",
    meta: '35+ LEARNERS · DATA & AI EDUCATION',
  },
  {
    role: 'Student Library Assistant',
    organisation: 'Ashesi University',
    dates: 'Feb 2026 — May 2026',
    description:
      'Assisted 30+ patrons with technical difficulties regarding printing, scanning, and database navigation, translating complex technical processes into plain English.',
    meta: '30+ PATRONS · TECHNICAL SUPPORT',
  },
];
---

<!--
  EXPERIENCE — chronological and structured.

  The disclosure behaviour is unchanged. What changed:
  - the entries hang off a single continuous SPINE with an arc node
    per role, so the list reads as a sequence in time rather than as
    four independent rows;
  - dates are promoted into the row's own metadata column at width,
    so the chronology is scannable without opening anything;
  - the open state fills its node and runs a copper rule down the
    disclosed panel, which is the same open/inspect vocabulary the
    trace and toolkit use.

  Content mirrors the WORK EXPERIENCE section of the public résumé
  (public/Stephen-Mensah-Resume.pdf). When the résumé changes, update
  this array — roles, organisations, dates and descriptions.
-->
<section id="experience" class="experience" aria-labelledby="experience-title" data-workspace-section="experience">
  <SectionFrame coordinate="04.2 · Profile / Experience" surface="paper" density="default">
    <div class="page-shell region-grid">
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">04.2</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Chronology</span>
          <span class="region-index__note">{experiences.length} roles. Open any one for detail.</span>
        </div>
      </aside>

      <div class="region-body">
        <header class="experience__header">
          <h2 id="experience-title" class="region-title">Where I've worked</h2>
        </header>

        <ol class="experience__list">
          {experiences.map((entry, index) => {
            return (
              <li class="experience__item">
                <details class="experience__entry" name="experience-entry">
                  <summary class="experience__trigger">
                    <span class="experience__node" aria-hidden="true"></span>
                    <span class="experience__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="experience__heading">
                      <span class="experience__role">{entry.role}</span>
                      <span class="experience__org">{entry.organisation}</span>
                    </span>
                    <span class="experience__dates">{entry.dates}</span>
                    <span class="experience__indicator" aria-hidden="true"></span>
                  </summary>
                  <div class="experience__panel">
                    <p>{entry.description}</p>
                    <p class="experience__meta">{entry.meta}</p>
                  </div>
                </details>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .experience {
    background: var(--color-sheet-soft);
  }

  .experience__header {
    display: grid;
    gap: var(--space-3);
  }

  /* THE SPINE — one line through the whole chronology. */
  .experience__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience__list::before {
    content: '';
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: 0.25rem;
    width: 1px;
    background: var(--color-rule-on-paper-strong);
  }

  .experience__item {
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .experience__item:first-child {
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .experience__trigger {
    display: grid;
    width: 100%;
    grid-template-columns: 0.5rem 2rem minmax(0, 1fr) 0.875rem;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding: var(--space-4) 0;
    background: transparent;
    color: var(--color-text-on-paper);
    font: inherit;
    text-align: left;
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .experience__trigger::-webkit-details-marker {
    display: none;
  }

  .experience__trigger:focus-visible {
    outline-offset: -2px;
  }

  /* ARC NODE on the spine. Fills when the entry is open — the same
     "reached / inspecting" signal the trace uses. */
  .experience__node {
    position: relative;
    z-index: 1;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-rule-on-paper-strong);
    background: var(--color-sheet-soft);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  .experience__trigger:hover .experience__node {
    border-color: var(--color-accent);
  }

  .experience__entry[open] .experience__node {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .experience__index {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .experience__entry[open] .experience__index,
  .experience__trigger:hover .experience__index {
    color: var(--color-accent-text);
  }

  .experience__heading {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .experience__role {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-on-paper);
  }

  .experience__org {
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  /* Dates are METADATA: mono, muted, and at width they occupy their
     own column so the chronology is a scannable edge. */
  .experience__dates {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Disclosure marker: plus → cross, same as the toolkit. */
  .experience__indicator {
    position: relative;
    justify-self: end;
    width: 0.75rem;
    height: 0.75rem;
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  .experience__indicator::before,
  .experience__indicator::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-accent);
  }

  .experience__indicator::before {
    width: 100%;
    height: 1px;
  }

  .experience__indicator::after {
    width: 1px;
    height: 100%;
  }

  .experience__entry[open] .experience__indicator {
    transform: rotate(45deg);
  }

  .experience__panel {
    position: relative;
    max-width: 40rem;
    margin: 0 0 var(--space-5) calc(0.5rem + 2rem + (var(--space-4) * 2));
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-accent);
    animation: exp-enter var(--duration-reveal) var(--ease-emphasized);
  }

  @keyframes exp-enter {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .experience__panel p {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.65;
  }

  .experience__meta {
    margin-top: var(--space-3) !important;
    color: var(--color-text-on-paper-faint) !important;
    font-family: var(--font-mono);
    font-size: var(--text-micro) !important;
    letter-spacing: 0.05em;
    line-height: 1.5 !important;
  }

  @media (min-width: 48rem) {
    .experience__trigger {
      grid-template-columns: 0.5rem 2rem minmax(0, 1fr) auto 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience__panel {
      animation: none;
    }

    .experience__node,
    .experience__indicator {
      transition: none;
    }
  }

  @media (max-width: 36rem) {
    .experience__trigger {
      grid-template-columns: 0.5rem 1.75rem minmax(0, 1fr) 0.875rem;
      gap: var(--space-2) var(--space-3);
    }

    .experience__dates {
      grid-column: 3;
      white-space: normal;
    }

    .experience__panel {
      margin-left: calc(0.5rem + 1.75rem + (var(--space-3) * 2));
    }
  }
</style>
