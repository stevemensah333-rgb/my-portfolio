---
const experiences = [
  {
    role: 'Innovation Lab Project Participant',
    organisation: 'Ashesi Center for Entrepreneurship',
    dates: 'Jul 2026 — Present',
  },
  {
    role: 'DataCamp Donates Program Coordinator',
    organisation: 'DataCamp',
    dates: 'Nov 2025 — Present',
  },
  {
    role: 'Student Library Assistant',
    organisation: 'Ashesi University',
    dates: 'Feb 2026 — May 2026',
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="page-shell experience-layout">
    <header class="experience-header">
      <p class="technical-label">Experience</p>
      <h2 id="experience-title">Where I've worked</h2>
    </header>

    <ol class="experience-list">
      {experiences.map((entry, index) => (
        <li>
          <span class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="entry-heading">
            <h3>{entry.role}</h3>
            <p>{entry.organisation}</p>
          </div>
          <p class="entry-dates">{entry.dates}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--section-tight);
    border-top: var(--border-default);
    background: var(--color-surface);
    scroll-margin-top: 5rem;
  }

  .experience-layout {
    display: grid;
    gap: var(--space-7);
  }

  .experience-header p,
  .experience-header h2 {
    margin: 0;
  }

  .experience-header h2 {
    margin-top: var(--section-heading-gap);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .experience-list {
    margin: 0;
    padding: 0;
    border-top: var(--border-default);
    list-style: none;
  }

  .experience-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-default);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .experience-list li:hover {
    background: color-mix(in srgb, var(--color-surface) 70%, white);
    transform: translateX(2px);
  }

  .entry-heading h3,
  .entry-heading p,
  .entry-dates {
    margin: 0;
  }

  .entry-number {
    grid-row: 1 / span 2;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .entry-heading h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .entry-heading p,
  .entry-dates {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .entry-dates {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  @media (min-width: 48rem) {
    .experience-layout {
      grid-template-columns: minmax(13rem, 4fr) minmax(0, 8fr);
      gap: var(--space-7);
      align-items: start;
    }

    .experience-list li {
      grid-template-columns: 2rem minmax(12rem, 1fr) auto;
      column-gap: var(--space-4);
    }

    .entry-dates {
      text-align: right;
    }
  }
</style>
