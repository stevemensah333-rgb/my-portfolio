---
const experiences = [
  {
    role: 'Innovation Lab Project Participant', organisation: 'Ashesi Center for Entrepreneurship', dates: 'Jul 2026 — Present',
    description: 'Working with a team on a six-week Innovation Lab engagement for Koranco Farms. We are examining how farm production data is captured and used, then developing a system to improve record-keeping, production visibility, and operational decision-making.',
    meta: 'KORANCO FARMS · 6-WEEK ENGAGEMENT · FARM OPERATIONS',
  },
  {
    role: 'DataCamp Donates Program Coordinator', organisation: 'DataCamp', dates: 'Nov 2025 — Present',
    description: "Coordinate access to DataCamp's data science and AI learning resources for a group of 35+ learners. My role includes managing license distribution and helping participants stay engaged with the program.",
    meta: '35+ LEARNERS · DATA & AI EDUCATION',
  },
  {
    role: 'Student Library Assistant', organisation: 'Ashesi University', dates: 'Feb 2026 — May 2026',
    description: 'Supported students with academic resources, research materials, printing, scanning, and database navigation. I also regularly helped people work through technical problems by translating unfamiliar processes into straightforward instructions.',
    meta: '50+ STUDENTS SUPPORTED · 30+ TECHNICAL-ASSISTANCE INTERACTIONS',
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="page-shell experience-layout">
    <header class="experience-header">
      <p class="technical-label">Experience</p>
      <h2 id="experience-title">Where I've worked</h2>
    </header>

    <ol class="experience-list" data-experience-list>
      {experiences.map((entry, index) => {
        const panelId = `experience-panel-${index + 1}`;
        return (
          <li class="experience-entry">
            <button class="experience-trigger" type="button" aria-expanded="false" aria-controls={panelId}>
              <span class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="entry-heading"><span class="entry-role">{entry.role}</span><span class="entry-organisation">{entry.organisation}</span></span>
              <span class="entry-dates">{entry.dates}</span>
              <span class="entry-indicator" aria-hidden="true">+</span>
            </button>
            <div class="experience-panel" id={panelId} hidden>
              <p>{entry.description}</p>
              <p class="entry-meta">{entry.meta}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  const experienceLists = document.querySelectorAll<HTMLElement>('[data-experience-list]');
  experienceLists.forEach((list) => {
    const triggers = [...list.querySelectorAll<HTMLButtonElement>('.experience-trigger')];
    triggers.forEach((trigger) => {
      const panelId = trigger.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;
      trigger.addEventListener('click', () => {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        triggers.forEach((other) => {
          const otherPanel = document.getElementById(other.getAttribute('aria-controls') || '');
          other.setAttribute('aria-expanded', 'false');
          otherPanel?.setAttribute('hidden', '');
        });
        if (!expanded) {
          trigger.setAttribute('aria-expanded', 'true');
          panel.removeAttribute('hidden');
        }
      });
    });
  });
</script>

<style>
  .experience { padding-block: var(--section-tight); border-top: var(--border-default); background: var(--color-surface); scroll-margin-top: 5rem; }
  .experience-layout { display: grid; gap: var(--space-7); }
  .experience-header p, .experience-header h2 { margin: 0; }
  .experience-header h2 { margin-top: var(--section-heading-gap); font-size: var(--text-h2); font-weight: 600; letter-spacing: -0.035em; }
  .experience-list { margin: 0; padding: 0; border-top: var(--border-default); list-style: none; }
  .experience-entry { border-bottom: var(--border-default); }
  .experience-trigger { display: grid; width: 100%; grid-template-columns: 2rem minmax(0, 1fr) auto 1rem; gap: var(--space-2) var(--space-4); align-items: center; padding: var(--space-4) 0; border: 0; background: transparent; color: var(--color-text); font: inherit; text-align: left; cursor: pointer; transition: background-color var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard); }
  .experience-trigger:hover { background: color-mix(in srgb, var(--color-surface) 70%, white); transform: translateX(2px); }
  .experience-trigger:focus-visible { outline: 0.1875rem solid var(--color-accent); outline-offset: -2px; }
  .entry-number { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-label); }
  .entry-heading { display: grid; gap: var(--space-1); min-width: 0; }
  .entry-role { font-size: 1.0625rem; font-weight: 600; }
  .entry-organisation, .entry-dates { color: var(--color-text-secondary); font-size: var(--text-small); }
  .entry-dates { color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-label); white-space: nowrap; }
  .entry-indicator { color: var(--color-accent); font-size: 1.25rem; font-weight: 400; transition: transform var(--duration-fast) var(--ease-standard); }
  .experience-trigger[aria-expanded='true'] .entry-indicator { transform: rotate(45deg); }
  .experience-panel { max-width: 42rem; margin: 0 0 var(--space-4) calc(2rem + var(--space-4)); padding-left: var(--space-4); border-left: 2px solid var(--color-accent); animation: experience-reveal var(--duration-normal) var(--ease-standard); }
  .experience-panel p { margin: 0; color: var(--color-text-secondary); font-size: var(--text-small); line-height: 1.65; }
  .experience-panel .entry-meta { margin-top: var(--space-3); color: var(--color-text-secondary); font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.04em; }
  @keyframes experience-reveal { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
  @media (min-width: 48rem) { .experience-layout { grid-template-columns: minmax(13rem, 4fr) minmax(0, 8fr); gap: var(--space-7); align-items: start; } }
  @media (max-width: 36rem) { .experience-trigger { grid-template-columns: 1.5rem minmax(0, 1fr) 1rem; gap: var(--space-2) var(--space-3); } .entry-dates { grid-column: 2; white-space: normal; } .experience-panel { margin-left: calc(1.5rem + var(--space-3)); } }
  @media (prefers-reduced-motion: reduce) { .experience-trigger, .entry-indicator, .experience-panel { transition: none; animation: none; } }
</style>
