---
/**
 * EXPERIENCE — compact expandable records.
 *
 * Not a timeline: no spine, no nodes, no run of the eye down a
 * drawn line. The section is a short ledger of records — each row
 * states role, organisation and dates; opening it discloses the
 * description and metadata in place. One record opens at a time:
 * `name` on <details> makes that native, with a small script as a
 * fallback for engines that predate `name` support. Without
 * JavaScript the records simply open independently — same content,
 * looser discipline.
 *
 * Content mirrors the WORK EXPERIENCE section of the public résumé
 * (public/Stephen-Mensah-Resume.pdf). When the résumé changes,
 * update this array — roles, organisations, dates and descriptions.
 */
import SectionFrame from './SectionFrame.astro';

const experiences = [
  {
    role: 'Software Engineer — Applied Innovation Lab',
    organisation: 'Ashesi Center for Entrepreneurship',
    dates: 'Jul 2026 — Sep 2026',
    description:
      'Developed offline-first farm management software for Koranco Farms so field operations keep running uninterrupted in low-connectivity environments. Designed custom authentication and role-based authorization pipelines with FastAPI and PostgreSQL, and built a website for Koranco Farms to improve SEO and bring customers and visitors to contact or visit the farm.',
    meta: 'INNOVATION LAB · KORANCO FARMS · OFFLINE-FIRST · FASTAPI · POSTGRESQL',
  },
  {
    role: 'Software Engineer Intern',
    organisation: 'AmaliTech',
    dates: 'Aug 2026 — Sep 2026',
    description:
      'Engineered the backend for a mentor–mentee matching platform using FastAPI and Python, with JWT authentication for secure session management. Worked in a cross-functional group of 5 tech professionals from different engineering fields to develop a full-stack working MVP.',
    meta: 'INTERNSHIP · BACKEND · FASTAPI · JWT AUTH · MVP',
  },
  {
    role: 'Program Coordinator',
    organisation: 'Ashesi DataCamp Donates — DataCamp',
    dates: 'Nov 2025 — Present',
    description:
      "Coordinated learner access to DataCamp's AI and data science learning platform through the Donates Program, and supported 35+ students and community learners in accessing technical upskilling resources in data science, AI and programming.",
    meta: '35+ LEARNERS · DATA & AI EDUCATION',
  },
  {
    role: 'Student Library Assistant',
    organisation: 'Ashesi University',
    dates: 'Feb 2026 — May 2026',
    description:
      'Assisted 30+ patrons with technical difficulties regarding printing, scanning, and database navigation, translating complex technical processes into plain English.',
    meta: '30+ PATRONS · TECHNICAL SUPPORT',
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title" data-workspace-section="experience" data-workspace-label="Experience">
  <SectionFrame coordinate="04.2 · Profile / Experience" surface="paper" density="default">
    <div class="page-shell region-grid">
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">04.2</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Experience</span>
          <span class="region-index__note">{experiences.length} records. Open one at a time.</span>
        </div>
      </aside>

      <div class="region-body">
        <header class="experience__header">
          <h2 id="experience-title" class="region-title">Where I've worked</h2>
        </header>

        <ol class="experience__list">
          {experiences.map((entry, index) => {
            return (
              <li class="experience__item">
                <details class="experience__entry" name="experience-entry">
                  <summary class="experience__trigger">
                    <span class="experience__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="experience__heading">
                      <span class="experience__role">{entry.role}</span>
                      <span class="experience__org">{entry.organisation}</span>
                    </span>
                    <span class="experience__dates">{entry.dates}</span>
                    <span class="experience__indicator" aria-hidden="true"></span>
                  </summary>
                  <div class="experience__panel">
                    <p>{entry.description}</p>
                    <p class="experience__meta">{entry.meta}</p>
                  </div>
                </details>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </SectionFrame>
</section>

<script>
  (function () {
    const STORAGE_KEY = 'workspace:experience';
    const readStored = () => {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        const idx = raw === null ? NaN : parseInt(raw, 10);
        return Number.isNaN(idx) ? null : idx;
      } catch {
        return null;
      }
    };
    const writeStored = (idx: number | null) => {
      try {
        if (idx === null) sessionStorage.removeItem(STORAGE_KEY);
        else sessionStorage.setItem(STORAGE_KEY, String(idx));
      } catch {}
    };

    const entries = [...document.querySelectorAll<HTMLDetailsElement>('.experience__entry')];

    // Continuity: restore last opened record across view transitions / reloads.
    const stored = readStored();
    if (stored !== null && entries[stored]) {
      entries[stored].open = true;
    }

    for (const entry of entries) {
      entry.addEventListener('toggle', () => {
        const idx = entries.indexOf(entry);
        if (entry.open) {
          writeStored(idx);
          if (typeof HTMLDetailsElement !== 'undefined' && !('name' in HTMLDetailsElement.prototype)) {
            for (const other of entries) {
              if (other !== entry) other.open = false;
            }
          }
        } else {
          const anyOpen = entries.some((e) => e.open);
          if (!anyOpen) writeStored(null);
        }
      });
    }
  })();
</script>

<style>
  .experience {
    background: var(--color-sheet-soft);
  }

  .experience__header {
    display: grid;
    gap: var(--space-3);
  }

  .experience__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience__item {
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .experience__item:first-child {
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  /* Narrow default: the row is two lines — role + organisation, then
     dates underneath — with the marker held centred to the right. */
  .experience__trigger {
    display: grid;
    width: 100%;
    grid-template-columns: 1.75rem minmax(0, 1fr) 0.75rem;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-3) 0;
    background: transparent;
    color: var(--color-text-on-paper);
    font: inherit;
    text-align: left;
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .experience__index {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    padding-top: 0.35rem;
  }

  .experience__heading {
    grid-column: 2;
    grid-row: 1;
  }

  .experience__dates {
    grid-column: 2;
    grid-row: 2;
  }

  .experience__indicator {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .experience__trigger::-webkit-details-marker {
    display: none;
  }

  .experience__trigger:focus-visible {
    outline-offset: -2px;
  }

  .experience__index {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .experience__entry[open] .experience__index,
  .experience__trigger:hover .experience__index {
    color: var(--color-accent-text);
  }

  .experience__heading {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .experience__role {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-on-paper);
  }

  .experience__org {
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  /* Dates are metadata read in the same glance as the role — mono,
     quiet. Placement (under the role at width, beside it on wide
     rows) is handled by the grid rules above. */
  .experience__dates {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Disclosure marker: plus → cross, the same quiet affordance the
     evidence drawer and capabilities index use. */
  .experience__indicator {
    position: relative;
    justify-self: end;
    width: 0.75rem;
    height: 0.75rem;
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  .experience__indicator::before,
  .experience__indicator::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-accent);
  }

  .experience__indicator::before {
    width: 100%;
    height: 1px;
  }

  .experience__indicator::after {
    width: 1px;
    height: 100%;
  }

  .experience__entry[open] .experience__indicator {
    transform: rotate(45deg);
  }

  .experience__entry[open] .experience__trigger {
    color: var(--color-text-on-paper);
  }

  .experience__panel {
    position: relative;
    max-width: 44rem;
    margin: 0 0 var(--space-4) calc(1.75rem + var(--space-3));
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-accent);
    animation: exp-enter var(--duration-reveal) var(--ease-emphasized);
  }

  @keyframes exp-enter {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .experience__panel p {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.65;
  }

  .experience__meta {
    margin-top: var(--space-3) !important;
    color: var(--color-text-on-paper-faint) !important;
    font-family: var(--font-mono);
    font-size: var(--text-micro) !important;
    letter-spacing: 0.05em;
    line-height: 1.5 !important;
  }

  @media (min-width: 48rem) {
    /* One line per record: index · role/org · dates · marker. */
    .experience__trigger {
      grid-template-columns: 2rem minmax(0, 1fr) auto 0.75rem;
      align-items: center;
      padding-block: var(--space-4);
      gap: 0 var(--space-4);
    }

    .experience__index,
    .experience__indicator {
      grid-row: 1;
      align-self: center;
      padding-top: 0;
    }

    .experience__dates {
      grid-row: 1;
      grid-column: 3;
      justify-self: end;
      white-space: nowrap;
    }

    .experience__indicator {
      grid-column: 4;
    }

    .experience__panel {
      margin-left: calc(2rem + var(--space-4));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience__panel {
      animation: none;
    }

    .experience__indicator {
      transition: none;
    }
  }
</style>
