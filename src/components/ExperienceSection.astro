---
const experiences = [
  {
    role: 'DataCamp Donates Program Coordinator',
    organisation: 'DataCamp',
    dates: 'Nov 2025 — Present',
  },
  {
    role: 'Student Library Assistant',
    organisation: 'Ashesi University',
    dates: 'Feb 2026 — May 2026',
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="page-shell experience-layout">
    <header class="experience-header">
      <p class="technical-label">Experience</p>
      <h2 id="experience-title">Where I've worked</h2>
    </header>

    <ol class="experience-list">
      {experiences.map((entry) => (
        <li>
          <div class="entry-heading">
            <h3>{entry.role}</h3>
            <p>{entry.organisation}</p>
          </div>
          <p class="entry-dates">{entry.dates}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--section-compact);
    border-top: var(--border-default);
    background: var(--color-surface);
    scroll-margin-top: 5rem;
  }

  .experience-layout {
    display: grid;
    gap: var(--section-content-gap);
  }

  .experience-header p,
  .experience-header h2 {
    margin: 0;
  }

  .experience-header h2 {
    margin-top: var(--section-heading-gap);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .experience-list {
    margin: 0;
    padding: 0;
    border-top: var(--border-default);
    list-style: none;
  }

  .experience-list li {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: var(--border-default);
  }

  .entry-heading h3,
  .entry-heading p,
  .entry-dates {
    margin: 0;
  }

  .entry-heading h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .entry-heading p,
  .entry-dates {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .entry-dates {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  @media (min-width: 48rem) {
    .experience-layout {
      grid-template-columns: minmax(13rem, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
      align-items: start;
    }

    .experience-list li {
      grid-template-columns: minmax(12rem, 1fr) auto;
      column-gap: var(--space-6);
    }

    .entry-dates {
      text-align: right;
    }
  }
</style>
