---
interface Props {
  density?: number;
  variant?: 'hero' | 'case' | 'toolkit';
}
const { density = 14, variant = 'hero' } = Astro.props;

// Pre-calc positions – deterministic to avoid layout shift, very low contrast
const positions = Array.from({ length: density }, (_, i) => {
  // spread pseudo-random but stable: use prime multipliers
  const x = ((i * 37) % 100);
  const y = ((i * 61) % 100);
  const delay = (i * 0.7) % 6;
  const size = variant === 'hero' ? 2 : 1.8;
  return { x, y, delay, size, id: i };
});
---

<div class="ambient-field" data-variant={variant} aria-hidden="true">
  {positions.map(p => (
    <i style={`left:${p.x}%; top:${p.y}%; animation-delay:${p.delay}s; width:${p.size}px; height:${p.size}px;`}></i>
  ))}
</div>

<style>
  .ambient-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 1;
    animation: ambient-appear var(--duration-reveal) var(--ease-standard);
  }

  .ambient-field i {
    position: absolute;
    background: var(--color-text);
    border-radius: 50%;
    opacity: var(--ambient-dot-opacity);
    will-change: transform;
  }

  /* variant tweaks – hero slightly more visible than case */
  .ambient-field[data-variant='hero'] {
    --ambient-dot-opacity: 0.045;
  }
  .ambient-field[data-variant='case'] {
    --ambient-dot-opacity: 0.032;
  }
  .ambient-field[data-variant='toolkit'] {
    --ambient-dot-opacity: 0.028;
  }

  @keyframes ambient-appear {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes ambient-drift-1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(10px, -14px); }
  }

  @keyframes ambient-drift-2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-12px, 10px); }
  }

  @keyframes ambient-drift-3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(6px, 12px); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ambient-field i {
      animation-timing-function: var(--ease-standard);
      animation-iteration-count: infinite;
    }
    .ambient-field i:nth-child(3n+1) { animation-name: ambient-drift-1; animation-duration: 20s; }
    .ambient-field i:nth-child(3n+2) { animation-name: ambient-drift-2; animation-duration: 26s; }
    .ambient-field i:nth-child(3n) { animation-name: ambient-drift-3; animation-duration: 32s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-field { display: none; }
  }
</style>
