---
/**
 * CONTACT — the end of the environment.
 *
 * Decisive rather than loud. Three moves:
 *  1. The address IS the composition. The email is set at feature
 *     scale as the largest element on the surface — larger than the
 *     heading — so "how to reach Stephen" is unmissable.
 *  2. The section closes with a terminal rule: a full-width copper
 *     edge that reads as the bottom of the instrument.
 *  3. Secondary links become a ruled register, not buttons, so the
 *     one primary action stays unambiguous.
 *
 * No form, no chatbot. Copy and links unchanged.
 */
import { GMAIL_COMPOSE_URL, PUBLIC_EMAIL, PUBLIC_LINKS } from '../config/site';
import SectionFrame from './SectionFrame.astro';

const secondaryLinks = [
  { label: 'GitHub', href: PUBLIC_LINKS.github, opensNewTab: true },
  { label: 'LinkedIn', href: PUBLIC_LINKS.linkedin, opensNewTab: true },
  { label: 'Résumé', href: PUBLIC_LINKS.resume, opensNewTab: true },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title" data-workspace-section="contact">
  <SectionFrame coordinate="07 · Contact" status="End of environment" surface="canvas" density="major">
    <div class="page-shell region-grid">
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">07</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Contact</span>
        </div>
      </aside>

      <div class="region-body contact__body">
        <header class="contact__intro">
          <p class="mono-label mono-label--inverse">Start a conversation</p>
          <h2 id="contact-title" class="contact__title">Have an AI engineering role to discuss?</h2>
          <p class="contact__copy">
            I'm looking for entry-level AI engineering opportunities where I can contribute to product
            work and learn from experienced engineers.
          </p>
        </header>

        <!-- The address as the composition. -->
        <div class="contact__address">
          <p class="contact__address-label">
            <span class="mono-label mono-label--inverse">Direct</span>
          </p>
          <p class="contact__email">
            <a class="contact__email-link" href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>
          </p>
          <a
            class="button button--accent contact__button"
            href={GMAIL_COMPOSE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Email me <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul class="contact__secondary" aria-label="Other ways to find Stephen">
          {secondaryLinks.map((link) => (
            <li>
              <a
                class="contact__secondary-link"
                href={link.href}
                target={link.opensNewTab ? '_blank' : undefined}
                rel={link.opensNewTab ? 'noopener noreferrer' : undefined}
              >
                <span class="contact__secondary-label">{link.label}</span>
                <span class="contact__secondary-mark" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Terminal rule: the bottom edge of the environment. -->
    <div class="contact__terminus" aria-hidden="true">
      <span class="contact__terminus-rule"></span>
    </div>
  </SectionFrame>
</section>

<style>
  .contact {
    position: relative;
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
  }

  .contact__body {
    gap: var(--space-6);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .contact__title {
    margin: 0;
    max-width: 20ch;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
  }

  .contact__copy {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* --- the address ---------------------------------------------- */

  .contact__address {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule-on-canvas-strong);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .contact__address-label {
    margin: 0;
  }

  /* The single largest element on the closing surface. It breaks the
     rule that headings are quiet — deliberately, once, at the end. */
  .contact__email {
    margin: 0;
    font-size: clamp(1.375rem, 3.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .contact__email-link {
    color: var(--color-text-on-canvas);
    text-decoration: none;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 2px;
    transition:
      background-size var(--duration-reveal) var(--ease-emphasized),
      color var(--duration-quick) var(--ease-standard);
  }

  .contact__email-link:hover,
  .contact__email-link:focus-visible {
    color: var(--color-accent-text);
    background-size: 100% 2px;
  }

  .contact__button {
    justify-self: start;
  }

  /* --- secondary register ---------------------------------------- */

  .contact__secondary {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__secondary-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-rule-on-canvas);
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition:
      color var(--duration-quick) var(--ease-standard),
      padding-left var(--duration-base) var(--ease-emphasized);
  }

  .contact__secondary-link:hover,
  .contact__secondary-link:focus-visible {
    color: var(--color-accent-text);
    padding-left: var(--space-2);
  }

  .contact__secondary-label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .contact__secondary-mark {
    color: var(--color-accent-text);
  }

  /* --- terminus --------------------------------------------------- */

  .contact__terminus {
    display: grid;
    padding-top: var(--section-gap);
  }

  .contact__terminus-rule {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--color-accent) 0,
      var(--color-accent) clamp(3.5rem, 14vw, 9rem),
      var(--color-rule-on-canvas) clamp(3.5rem, 14vw, 9rem)
    );
  }

  /* --- responsive -------------------------------------------------- */

  @media (min-width: 48rem) {
    .contact__secondary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 60rem) {
    .contact__address {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--space-6);
    }

    .contact__address-label {
      grid-column: 1 / -1;
    }

    .contact__button {
      justify-self: end;
    }
  }
</style>
