---
import { GMAIL_COMPOSE_URL, PUBLIC_EMAIL, PUBLIC_LINKS } from '../config/site';

const secondaryLinks = [
  { label: 'GitHub', href: PUBLIC_LINKS.github, opensNewTab: true },
  { label: 'LinkedIn', href: PUBLIC_LINKS.linkedin, opensNewTab: true },
  { label: 'Résumé', href: PUBLIC_LINKS.resume, opensNewTab: true },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="page-shell contact-layout">
    <div class="contact-intro">
      <p class="technical-label">Start a conversation</p>
      <h2 id="contact-title">Have an AI engineering role to discuss?</h2>
      <p class="contact-copy">
        I'm looking for entry-level AI engineering opportunities where I can contribute to product work
        and learn from experienced engineers.
      </p>
    </div>

    <div class="contact-actions">
      <p class="contact-route"><span>Direct contact</span>{PUBLIC_EMAIL}</p>
      <a
        class="button email-button"
        href={GMAIL_COMPOSE_URL}
        target="_blank"
        rel="noopener noreferrer"
      >Email me <span aria-hidden="true">→</span></a>

      <ul class="secondary-links" aria-label="Other ways to find Stephen">
        {secondaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.opensNewTab ? '_blank' : undefined}
              rel={link.opensNewTab ? 'noopener noreferrer' : undefined}
            >
              {link.label}{link.opensNewTab && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))}
      </ul>

      <div class="contact-trace" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-tight);
    border-top: 1px solid rgb(247 246 242 / 18%);
    background: var(--color-text);
    color: var(--color-background);
    scroll-margin-top: 5rem;
  }

  .contact-layout {
    display: grid;
    gap: var(--section-content-gap);
  }

  .contact .technical-label,
  .contact-copy,
  .secondary-links a {
    color: #adb1b5;
  }

  .contact .technical-label::before {
    border-color: var(--color-accent);
  }

  .contact-intro > p,
  .contact-intro h2 {
    margin: 0;
  }

  .contact-intro h2 {
    max-width: 17ch;
    margin-top: var(--space-4);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.045em;
  }

  .contact-copy {
    max-width: 34rem;
    margin-top: var(--space-5) !important;
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .contact-actions {
    align-self: end;
    padding: var(--card-padding);
    border-top: 1px solid #44484c;
    border-bottom: 1px solid #44484c;
  }

  .contact-route {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-background);
    font-size: var(--text-small);
  }

  .contact-route span {
    color: #adb1b5;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .email-button {
    margin-top: var(--space-5);
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }

  .email-button:hover {
    border-color: #82a9ff;
    background: #245fd2;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 0.5rem 1.25rem rgb(47 111 237 / 28%);
  }

  .email-button:active {
    transform: translateY(0);
  }

  .secondary-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-5) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid #34383c;
    list-style: none;
  }

  .secondary-links a {
    position: relative;
    display: inline-flex;
    min-height: var(--control-height);
    align-items: center;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration-color: transparent;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .secondary-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    border-top: 1px solid currentColor;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .secondary-links a:hover {
    color: var(--color-background);
    text-decoration-color: currentColor;
    transform: translateY(-1px);
  }

  .secondary-links a:hover::after {
    opacity: 1;
    transform: translateY(0);
  }

  .secondary-links a:active {
    transform: translateY(0);
  }

  .contact-trace {
    display: flex;
    margin-top: var(--space-5);
  }

  .contact-trace i {
    position: relative;
    width: 25%;
    height: 0.5rem;
  }

  .contact-trace i::before {
    position: absolute;
    top: 0.25rem;
    right: 0;
    left: 0;
    border-top: 1px solid #484d52;
    content: '';
  }

  .contact-trace i::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid #6f7479;
    background: var(--color-text);
    content: '';
  }

  .contact-trace i:last-child::before,
  .contact-trace i:last-child::after {
    border-color: var(--color-accent);
  }

  .contact-trace i:last-child::after {
    background: var(--color-accent);
  }

  @media (min-width: 64rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 7fr) minmax(22rem, 5fr);
      align-items: end;
    }
  }
</style>
