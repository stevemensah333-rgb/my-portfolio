---
import { GMAIL_COMPOSE_URL, PUBLIC_EMAIL, PUBLIC_LINKS } from '../config/site';
import SectionFrame from './SectionFrame.astro';

const secondaryLinks = [
  { label: 'GitHub', href: PUBLIC_LINKS.github, opensNewTab: true },
  { label: 'LinkedIn', href: PUBLIC_LINKS.linkedin, opensNewTab: true },
  { label: 'Résumé', href: PUBLIC_LINKS.resume, opensNewTab: true },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title" data-workspace-section="contact">
  <SectionFrame coordinate="07 / Contact" surface="canvas">
    <div class="page-shell contact__layout">
      <div class="contact__intro">
        <p class="mono-label mono-label--inverse">Start a conversation</p>
        <h2 id="contact-title" class="contact__title">Have an AI engineering role to discuss?</h2>
        <p class="contact__copy">
          I'm looking for entry-level AI engineering opportunities where I can contribute to product
          work and learn from experienced engineers.
        </p>
      </div>

      <div class="contact__actions">
        <header class="contact__actions-header">
          <span class="mono-label mono-label--inverse">Direct contact</span>
          <p class="contact__email">
            <a class="contact__email-link" href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>
          </p>
        </header>

        <a
          class="button button--accent contact__button"
          href={GMAIL_COMPOSE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Email me <span aria-hidden="true">→</span>
        </a>

        <ul class="contact__secondary" aria-label="Other ways to find Stephen">
          {secondaryLinks.map((link) => (
            <li>
              <a
                class="contact__secondary-link"
                href={link.href}
                target={link.opensNewTab ? '_blank' : undefined}
                rel={link.opensNewTab ? 'noopener noreferrer' : undefined}
              >
                <span class="mono-label">{link.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="contact__status" aria-hidden="true">
          <span class="contact__status-row"></span>
          <span class="contact__status-row contact__status-row--accent"></span>
          <span class="contact__status-row"></span>
          <span class="contact__status-row contact__status-row--active"></span>
        </div>
      </div>
    </div>
  </SectionFrame>
</section>

<style>
  .contact {
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
  }

  .contact__layout {
    display: grid;
    gap: var(--space-7);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .contact__title {
    margin: 0;
    max-width: 18ch;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .contact__copy {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* Actions panel */
  .contact__actions {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas-soft);
  }

  .contact__actions-header {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .contact__email {
    margin: 0;
    color: var(--color-text-on-canvas);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .contact__email-link {
    color: inherit;
    text-decoration: none;
  }

  .contact__email-link:hover,
  .contact__email-link:focus-visible {
    color: var(--color-accent-text);
  }

  .contact__button {
    justify-self: stretch;
  }

  .contact__secondary {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .contact__secondary-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-rule-on-canvas);
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .contact__secondary-link:hover {
    color: var(--color-accent-text);
  }

  .contact__secondary-link span:last-child {
    color: var(--color-accent-text);
  }

  /* Status row — decorative terminal-style row of marks */
  .contact__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .contact__status-row {
    flex: 1;
    height: 1px;
    background: var(--color-rule-on-canvas);
  }

  .contact__status-row--accent {
    background: var(--color-accent);
  }

  .contact__status-row--active {
    background: var(--color-signal-pass);
  }

  @media (min-width: 48rem) {
    .contact__secondary {
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--color-rule-on-canvas);
    }

    .contact__secondary li {
      background: var(--color-canvas-soft);
    }

    .contact__secondary-link {
      padding: var(--space-3) var(--space-3);
      border-bottom: 0;
    }
  }

  @media (min-width: 64rem) {
    .contact__layout {
      grid-template-columns: minmax(0, 7fr) minmax(22rem, 5fr);
      align-items: end;
      gap: var(--space-8);
    }

    .contact__button {
      justify-self: start;
    }
  }
</style>
