---
/**
 * ContactSection — the closing composition, on every route.
 *
 * One invitation, the address at display size, and three actions that all
 * do something real:
 *
 *   Email Stephen   a plain `mailto:` — the visitor's own client, whatever
 *                   it is. Nothing here forces a webmail compose window.
 *   Copy email      a progressive enhancement, with explicit success and
 *                   failure copy. If the clipboard is unavailable the
 *                   address is selected instead, so ⌘/Ctrl + C still works.
 *   GitHub / LinkedIn / Résumé   real destinations; the résumé is the PDF.
 *
 * There is no form: there is no delivery behind one, and a form that
 * silently fails is worse than an address that works. That is stated, in
 * one line, rather than implied.
 *
 * The address is in the HTML as a link, so the whole block works with
 * JavaScript disabled; the copy button only appears when scripting runs.
 */
import { SITE, externalLinks } from '../config/site';

const mailto = `mailto:${SITE.email}`;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <span id="contact-section"></span>

  <div class="contact__inner page-shell">
    <div class="contact__head">
      <p class="eyebrow">Contact / The next step</p>
      <h2 id="contact-title">Tell me what<br />you’re building.</h2>
    </div>

    <div class="contact__panel">
      <p class="contact__lead">
        A role, a project, or a hard question about making an AI feature behave. Email reaches me
        directly — no form, no queue.
      </p>

      <a class="contact__email" href={mailto}>
        <span class="contact__email-text">{SITE.email}</span>
        <span class="contact__email-icon" aria-hidden="true">↗</span>
      </a>

      <div class="contact__actions">
        <a class="button contact__mail" href={mailto}>
          Email Stephen <span aria-hidden="true">↗</span>
        </a>
        <button
          class="button button--secondary contact__copy"
          type="button"
          data-copy-email={SITE.email}
          hidden
        >
          Copy email
        </button>
        <p class="contact__status" role="status" aria-live="polite" data-copy-status></p>
      </div>

      <ul class="contact__links" aria-label="Elsewhere">
        {
          externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class:list={['contact__link', `contact__link--${link.id}`]}
              >
                <span class="contact__link-name">{link.label}</span>
                <span class="contact__link-detail">{link.detail}</span>
                <span class="contact__link-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  /* Success and failure both get a sentence. The button never lies about
     what happened, and the status region is the thing that gets announced
     — the label change on the button is only a visual echo. */
  const reset = (button: HTMLButtonElement) => {
    button.textContent = 'Copy email';
    delete button.dataset.state;
  };

  const init = () =>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      if (button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;

      const panel = button.closest('.contact__panel');
      const status = panel?.querySelector<HTMLElement>('[data-copy-status]');

      const fallback = () => {
        /* No clipboard API, or the permission was refused. Select the
           address so the keyboard shortcut still works, and say so. */
        const address = panel?.querySelector<HTMLElement>('.contact__email-text');
        if (address) {
          const range = document.createRange();
          range.selectNodeContents(address);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        if (status) {
          status.dataset.state = 'error';
          status.textContent =
            'Copying is blocked in this browser. The address is selected — press Ctrl or ⌘ + C, or use Email Stephen.';
        }
        button.textContent = 'Copy failed';
        window.setTimeout(() => reset(button), 3200);
      };

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyEmail || '');
          if (status) {
            status.dataset.state = 'success';
            status.textContent = `${button.dataset.copyEmail} copied to your clipboard.`;
          }
          button.textContent = 'Copied';
          window.setTimeout(() => reset(button), 2400);
        } catch {
          fallback();
        }
      });
    });

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .contact {
    border-top: 1px solid var(--color-rule-on-paper-strong);
    background:
      radial-gradient(95% 80% at 12% 0%, rgba(194, 99, 47, 0.06), transparent 62%),
      var(--color-paper);
    padding-block: clamp(3rem, 6vw, 6rem) clamp(3rem, 6vw, 5.5rem);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .contact__head {
    min-width: 0;
  }

  .contact h2 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.6vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    margin: 0;
    max-width: 13ch;
  }

  .contact__panel {
    min-width: 0;
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  .contact__lead {
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 42ch;
  }

  /* The address is the largest thing in the panel after the heading: it
     is the action, so it should read like one. */
  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    min-height: 52px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.8vw, 2.15rem);
    line-height: 1.15;
    letter-spacing: -0.028em;
    color: var(--color-teal);
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 0.18rem;
    overflow-wrap: anywhere;
    transition: color var(--duration-quick) var(--ease-standard);
  }
  .contact__email:hover,
  .contact__email:focus-visible {
    color: var(--color-copper-text);
  }
  .contact__email-icon {
    font-family: var(--font-instrument);
    font-size: 0.62em;
    color: var(--color-copper-text);
  }
  .contact__email:hover .contact__email-icon {
    color: currentColor;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
    margin-top: 1.5rem;
  }
  .contact__actions .button {
    min-height: 48px;
  }
  .contact__mail {
    min-width: 12rem;
    justify-content: space-between;
  }

  .contact__status {
    flex-basis: 100%;
    margin: 0;
    min-height: 1.4em;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .contact__status:empty {
    min-height: 0;
  }
  /* State is carried by the words, not by the colour — the colour only
     reinforces it. */
  .contact__status[data-state='success'] {
    color: var(--color-signal-pass);
  }
  .contact__status[data-state='error'] {
    color: var(--color-signal-fail);
  }

  .contact__links {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }
  .contact__links li {
    border-bottom: 1px solid var(--color-rule);
  }
  .contact__link {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    align-items: baseline;
    min-height: 52px;
    padding: 0.7rem 0.25rem;
    text-decoration: none;
    color: var(--color-ink);
    transition:
      background var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }
  .contact__link-name {
    font-weight: 500;
    font-size: 0.92rem;
  }
  .contact__link-detail {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-ink-faint);
  }
  .contact__link-arrow {
    font-family: var(--font-instrument);
    font-size: 0.85rem;
    color: var(--color-copper-text);
  }
  .contact__link:hover,
  .contact__link:focus-visible {
    background: var(--color-paper-high);
    color: var(--color-teal);
  }
  .contact__link:hover .contact__link-detail,
  .contact__link:focus-visible .contact__link-detail {
    color: var(--color-ink-muted);
  }

  @media (max-width: 62rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .contact h2 {
      max-width: 16ch;
    }
    .contact__panel {
      padding-top: 0;
    }
  }

  @media (max-width: 46rem) {
    .contact h2 {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }
    .contact__actions .button {
      width: 100%;
    }
    .contact__mail {
      min-width: 0;
    }
    .contact__link {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .contact__link-detail {
      grid-column: 1;
      grid-row: 2;
    }
    .contact__link-arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }
</style>
