---
/**
 * CONTACT — the end of the information field.
 *
 * LIGHT = information. Reaching Stephen is a human act, not an
 * instrument readout. Three moves:
 *  1. The address IS the composition. The email is set in the
 *     display face, so "how to reach Stephen" is unmissable.
 *  2. Secondary links become a ruled register, not buttons, so the
 *     one primary action stays unambiguous.
 *  3. A structural terminus rule closes the field.
 *
 * No form, no chatbot. Copy and links unchanged.
 */
import { GMAIL_COMPOSE_URL, PUBLIC_EMAIL, PUBLIC_LINKS } from '../config/site';
import SectionFrame from './SectionFrame.astro';

const secondaryLinks = [
  { label: 'GitHub', href: PUBLIC_LINKS.github, opensNewTab: true },
  { label: 'LinkedIn', href: PUBLIC_LINKS.linkedin, opensNewTab: true },
  { label: 'Résumé', href: PUBLIC_LINKS.resume, opensNewTab: true },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title" data-workspace-section="contact" data-workspace-label="Contact">
  <SectionFrame coordinate="E · Contact" status="End of field" density="default">
    <div class="page-shell region-grid">
      <aside class="region-rail">
        <div class="region-index">
          <span class="region-index__no">E</span>
          <span class="region-index__rule"></span>
          <span class="region-index__name">Contact</span>
        </div>
      </aside>

      <div class="region-body contact__body">
        <header class="contact__intro">
          <p class="mono-label">Start a conversation</p>
          <h2 id="contact-title" class="contact__title">Have an AI engineering role to discuss?</h2>
          <p class="contact__copy">
            I’m looking for entry-level AI engineering opportunities where I can contribute to product
            work and learn from experienced engineers.
          </p>
        </header>

        <!-- The address as the composition. -->
        <div class="contact__address">
          <p class="contact__address-label">
            <span class="mono-label">Direct</span>
          </p>
          <p class="contact__email">
            <a class="contact__email-link" href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a>
          </p>
          <a
            class="button button--accent contact__button"
            href={GMAIL_COMPOSE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Email me <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul class="contact__secondary" aria-label="Other ways to find Stephen">
          {secondaryLinks.map((link) => (
            <li>
              <a
                class="contact__secondary-link"
                href={link.href}
                target={link.opensNewTab ? '_blank' : undefined}
                rel={link.opensNewTab ? 'noopener noreferrer' : undefined}
              >
                <span class="contact__secondary-label">{link.label}</span>
                <span class="contact__secondary-mark" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Terminal rule: the bottom edge of the environment. -->
    <div class="contact__terminus" aria-hidden="true">
      <span class="contact__terminus-rule"></span>
    </div>
  </SectionFrame>
</section>

<style>
  /* LIGHT = INFORMATION. Reaching Stephen is read, not operated, so
     this surface belongs on the sheet — as the doc comment above has
     always said. It takes the most forward light step (`high`), which
     is right for the primary action and keeps a visible step from the
     region before it on both Home and Profile; the dark ground is left
     to the footer chrome that follows, so the page still ends crisply.

     This also repairs a real defect: `.contact` was never in the dark
     registry in global.css, so the shared grammar inside it
     (`.mono-label`, `.region-index`, `.section-frame__coordinate`,
     the seam) kept its on-paper tokens and rendered at 1.86–2.63:1
     against the deck. On the sheet those tokens are correct as
     authored — no overrides needed. Measured on `sheet-high`: text
     6.74–16.93:1, the accent button fill 3.90:1, the terminus rule
     5.48:1, and 18.64:1 against the footer (the old deck→deck-deep
     boundary measured 1.05:1 — effectively invisible). */
  .contact {
    position: relative;
    background: var(--color-sheet-high);
    color: var(--color-text-on-paper);
  }

  /* The terminus rule is the field's bottom edge, so nothing follows
     it: the frame's bottom padding would leave a strip of sheet
     between the rule and the footer. The terminus keeps its own gap
     above the rule. */
  .contact > :global(.section-frame) {
    padding-bottom: 0;
  }

  .contact__body {
    gap: var(--space-6);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .contact__title {
    margin: 0;
    max-width: 20ch;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
  }

  .contact__copy {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* --- the address ---------------------------------------------- */

  .contact__address {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule-on-paper-strong);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .contact__address-label {
    margin: 0;
  }

  /* The single largest element on the closing surface. It breaks the
     rule that headings are quiet — deliberately, once, at the end.
     What it does not break is the type-role rule: a major statement
     is set in DISPLAY, like the hero name, the archive h1 and every
     case-study opening, and it uses the system's display tracking
     rather than a value of its own. */
  .contact__email {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    overflow-wrap: anywhere;
  }

  .contact__email-link {
    color: var(--color-text-on-paper);
    text-decoration: none;
    /* accent-deep is the accent's light-ground face — the same face
       the global focus ring uses — so the hover underline still clears
       3:1 against the sheet (5.48:1 on `sheet-high`). */
    background-image: linear-gradient(var(--color-accent-deep), var(--color-accent-deep));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 2px;
    transition:
      background-size var(--duration-reveal) var(--ease-emphasized),
      color var(--duration-quick) var(--ease-standard);
  }

  .contact__email-link:hover,
  .contact__email-link:focus-visible {
    color: var(--color-accent-text);
    background-size: 100% 2px;
  }

  .contact__button {
    justify-self: start;
  }

  /* --- secondary register ---------------------------------------- */

  .contact__secondary {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__secondary-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper);
    text-decoration: none;
    transition:
      color var(--duration-quick) var(--ease-standard),
      padding-left var(--duration-base) var(--ease-emphasized);
  }

  .contact__secondary-link:hover,
  .contact__secondary-link:focus-visible {
    color: var(--color-accent-text);
    padding-left: var(--space-2);
  }

  .contact__secondary-label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .contact__secondary-mark {
    color: var(--color-accent-text);
  }

  /* --- terminus --------------------------------------------------- */

  .contact__terminus {
    display: grid;
    padding-top: var(--section-gap);
  }

  .contact__terminus-rule {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--color-accent-deep) 0,
      var(--color-accent-deep) clamp(3.5rem, 14vw, 9rem),
      var(--color-rule-on-paper-strong) clamp(3.5rem, 14vw, 9rem)
    );
  }

  /* --- responsive -------------------------------------------------- */

  @media (min-width: 48rem) {
    .contact__secondary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 60rem) {
    .contact__address {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--space-6);
    }

    .contact__address-label {
      grid-column: 1 / -1;
    }

    .contact__button {
      justify-self: end;
    }
  }
</style>
