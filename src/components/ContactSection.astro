---
import { PUBLIC_EMAIL, PUBLIC_LINKS } from '../config/site';
---
<section id="contact" class="contact page-shell section" aria-labelledby="contact-title">
  <span id="contact-section"></span><div class="contact__label"><p class="eyebrow">The next conversation</p><span aria-hidden="true">↗</span></div>
  <h2 id="contact-title">Good work starts<br />with a conversation.</h2>
  <div class="contact__bottom">
    <div><a class="contact__email" href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a><div class="actions"><a class="button" href={`mailto:${PUBLIC_EMAIL}`}>Email Stephen <span aria-hidden="true">↗</span></a><button class="button button--secondary" data-copy-email={PUBLIC_EMAIL} hidden>Copy email</button><span class="copy-status" role="status" aria-live="polite"></span></div></div>
    <div class="contact__links">{Object.entries(PUBLIC_LINKS).map(([label,href])=>href&&<a href={href} target="_blank" rel="noopener">{label==='resume'?'Résumé':label==='github'?'GitHub':'LinkedIn'} <span aria-hidden="true">↗</span></a>)}</div>
  </div>
</section>
<script>
const init=()=>document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach(button=>{if(button.dataset.ready)return;button.dataset.ready='true';button.hidden=false;button.addEventListener('click',async()=>{const status=button.parentElement?.querySelector<HTMLElement>('[role="status"]');try{await navigator.clipboard.writeText(button.dataset.copyEmail||'');if(status)status.textContent='Email copied.';}catch{if(status)status.textContent='Copy unavailable. Select the email above or use Email Stephen.';}})});init();document.addEventListener('astro:page-load',init);
</script>
<style>
.contact{border-top:1px solid var(--rule)}.contact__label{display:flex;align-items:start;justify-content:space-between}.contact__label>span{font-size:4rem;line-height:1;color:var(--color-accent-text)}.contact h2{font-size:clamp(2.8rem,6.7vw,6.7rem);max-width:19ch;margin-bottom:3rem}.contact__bottom{display:flex;justify-content:space-between;gap:2rem;align-items:end}.contact__email{font-size:clamp(.95rem,2.2vw,1.7rem);overflow-wrap:anywhere}.contact__links{display:flex;gap:1.5rem;flex-wrap:wrap}.contact__links a{min-height:44px;display:flex;align-items:center;gap:1rem;font-size:.85rem}.copy-status{font-size:.8rem;max-width:28ch}@media(max-width:700px){.contact__bottom{flex-direction:column;align-items:start}.contact__label>span{font-size:3rem}.contact h2{margin-bottom:2rem}}
</style>
