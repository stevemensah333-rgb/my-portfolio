---
/*
  GutterAxis.astro
  ----------------
  Signature motif #2: a measured vertical axis.

  Previously this was an absolutely-positioned overlay that floated
  ticks along both page edges — decoration that happened to look
  technical. It is now a real layout element: a narrow column that
  a region places in its grid, carrying an origin label, evenly
  measured ticks, and an optional terminal label.

  It says one thing: this region has an origin and an extent.

  Props
  -----
  ticks?    : number of tick marks (default 6)
  surface?  : 'paper' (default) | 'canvas'
  origin?   : short mono label at the top of the axis
  terminus? : short mono label at the foot of the axis
*/

interface Props {
  ticks?: number;
  surface?: 'paper' | 'canvas';
  origin?: string;
  terminus?: string;
}

const { ticks = 6, surface = 'paper', origin, terminus } = Astro.props;
const tickArray = Array.from({ length: ticks }, (_, i) => i);
---

<div class:list={['axis', `axis--${surface}`]} aria-hidden="true">
  {origin && <span class="axis__cap">{origin}</span>}
  <div class="axis__scale">
    <span class="axis__spine"></span>
    {tickArray.map((i) => (
      <span class:list={['axis__tick', i % 2 === 0 && 'axis__tick--major']}></span>
    ))}
  </div>
  {terminus && <span class="axis__cap axis__cap--end">{terminus}</span>}
</div>

<style>
  .axis {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    justify-items: start;
    min-height: 100%;
  }

  .axis__cap {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .axis__cap--end {
    align-self: end;
  }

  .axis__scale {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-height: 6rem;
    padding-block: var(--space-1);
  }

  .axis__spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--color-rule-on-paper);
  }

  .axis__tick {
    width: 0.375rem;
    height: 1px;
    background: var(--color-rule-on-paper);
  }

  /* Every other tick is longer and copper — the measure reads as
     graduated rather than as a row of identical dashes. */
  .axis__tick--major {
    width: 0.75rem;
    background: var(--color-accent);
  }

  .axis--canvas .axis__cap {
    color: var(--color-text-on-canvas-faint);
  }

  .axis--canvas .axis__spine,
  .axis--canvas .axis__tick {
    background: var(--color-rule-on-canvas);
  }

  .axis--canvas .axis__tick--major {
    background: var(--color-accent);
  }
</style>
