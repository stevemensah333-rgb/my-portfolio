---
import { projects } from '../data/registry';
import {projectRecords,type ProjectId} from '../data/portfolio';
import ProjectArtifact from './ProjectArtifact.astro';
interface Props{id:ProjectId;sections:{id:string;label:string}[]}
const {id,sections}=Astro.props;const p=projects.find(p=>p.id===id)!;const r=projectRecords[id];
---
<header class="case-opening page-shell" id={id==='syncareer'?'product':'overview'}>
 <a class="back-link" href="/work/">← All work</a><p class="eyebrow">{p.name} / Engineering case study</p>
 <h1>{r.title}</h1>
 <div class="case-intro"><div><p class="lead">{r.summary}</p><div class="actions">{p.evidence.filter(e=>e.kind==='code'||e.kind==='product').map(e=><a class="text-link" href={e.href} target="_blank" rel="noopener">{e.label} ↗</a>)}</div></div><dl class="case-facts"><div><dt>My contribution</dt><dd>{r.role}</dd></div><div><dt>Project state</dt><dd>{r.status}</dd></div><div><dt>Implementation</dt><dd>{r.implementation}</dd></div><div><dt>Deployment</dt><dd>{r.deployment}</dd></div></dl></div>
 <ProjectArtifact id={id} priority />
 <p class="case-result"><strong>Known result.</strong> {r.result}</p>
 <p class="case-stack"><strong>Stack</strong> {p.stack.join(' / ')}</p>
 <nav class="case-nav" aria-label="Case study sections">{sections.map(s=><a href={`#${s.id}`}>{s.label}</a>)}</nav>
</header>
<style>
.case-result{
  margin-top: 1.5rem;
  font-size: 1rem;
  max-width: 85ch;
}
.case-stack{
  font-size: 0.8rem;
  color: var(--color-ink-faint);
  margin-top: 0.8rem;
}
.case-stack strong{
  margin-right: 1rem;
}
</style>
