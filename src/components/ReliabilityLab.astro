---
/**
 * Reliability Lab — one payload, seven stages, one instrument.
 *
 * The case study explains the investigation. This page lets a visitor
 * inspect the same records: select a stage, step, replay, and compare
 * the documented before/after. Each stage shows only its artifact, the
 * evidence class, and the transition that produced the state.
 *
 * No autoplay. The marker moves; reduced motion snaps it. Without
 * JavaScript every reading, including the comparison, stays in the page.
 */
import { labBoundary, labCompareCopy, labCopy, labStages } from '../data/reliabilityLab';
import { failureRecord, interventionRecord } from '../data/syncareerInvestigation';
import { syncareer } from '../data/registry';
import SectionFrame from './SectionFrame.astro';

const first = labStages[0];
const total = String(labStages.length).padStart(2, '0');
const beforeFixture = labStages.find((stage) => stage.id === 'model-output');
const afterFixture = labStages.find((stage) => stage.id === 'output');
const beforeCode = beforeFixture?.artifact?.kind === 'code' ? beforeFixture.artifact : null;
const afterCode = afterFixture?.artifact?.kind === 'code' ? afterFixture.artifact : null;
---

<section
  id="reliability-lab"
  class="lab on-deck"
  data-reliability-lab
  aria-labelledby="reliability-lab-title"
  data-workspace-section="reliability-lab"
>
  <SectionFrame coordinate="03 · Lab" status="cv.rewrite_bullet" surface="canvas" density="tight">
    <div class="page-shell lab__shell">
      <div class="lab__bench">
        <header class="lab__head">
          <h1 id="reliability-lab-title" class="lab__title">{labCopy.title}</h1>
          <a class="text-link" href={`${syncareer.route}#investigation`}>
            Syncareer case study
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </header>

        <noscript>
          <p class="lab__noscript">
            Stage controls need JavaScript. All seven readings and the before/after comparison are
            listed below. The explanation lives in the{' '}
            <a class="text-link" href={syncareer.route}>
              Syncareer case study
              <span class="text-link__arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </noscript>

        <nav class="lab__static-map" aria-label="Pipeline stages">
          <ol>
            {labStages.map((stage, index) => (
              <li>
                {index > 0 && <span class="lab__static-arrow" aria-hidden="true">→</span>}
                <a href={`#lab-${stage.id}`}>
                  <span>{stage.step}</span> {stage.label}
                </a>
              </li>
            ))}
          </ol>
          <a href="#lab-compare">Before / after</a>
        </nav>

        <div class="lab__track-scroll" data-lab-scroll>
          <div class="lab__track" data-lab-track>
            <div
              class="lab__rail"
              role="tablist"
              aria-label="Pipeline stages"
              aria-orientation="horizontal"
              aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End"
              data-lab-rail
            >
              {labStages.map((stage, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`lab-tab-${stage.id}`}
                  class="lab__node"
                  data-stage-tab={stage.id}
                  aria-controls={`lab-${stage.id}`}
                  aria-label={`${stage.step} ${stage.label}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <span class="lab__node-mark" aria-hidden="true"></span>
                  <span class="lab__node-step">{stage.step}</span>
                  <span class="lab__node-label">{stage.label}</span>
                </button>
              ))}
            </div>
            <span class="lab__line" data-lab-line aria-hidden="true"></span>
            <span class="lab__segment" data-lab-segment hidden aria-hidden="true"></span>
            <span class="lab__marker" data-lab-marker aria-hidden="true"></span>
          </div>
        </div>

        <div class="lab__transport" role="group" aria-label="Stage navigation">
          <button type="button" class="lab__btn" data-lab-prev disabled>
            {labCopy.prev}
          </button>
          <button type="button" class="lab__btn" data-lab-replay>
            <span class="lab__btn-icon" aria-hidden="true">↺</span>
            {labCopy.replay}
          </button>
          <button type="button" class="lab__btn" data-lab-next>
            {labCopy.next}
          </button>
          <button
            type="button"
            class="lab__btn lab__btn--compare"
            data-lab-compare
            aria-pressed="false"
            aria-controls="lab-compare"
          >
            {labCopy.compare}
          </button>
          <p class="lab__position" data-lab-position>
            <span class="lab__position-count">
              <span class="lab__position-step" data-lab-pos-step>{first?.step}</span>
              <span aria-hidden="true"> / {total} · </span>
            </span>
            <span data-lab-pos-label>{first?.label}</span>
          </p>
        </div>

        <div class="lab__well" data-lab-well>
          {labStages.map((stage) => {
            const artifact = stage.artifact;
            return (
              <div
                role="tabpanel"
                id={`lab-${stage.id}`}
                aria-labelledby={`lab-tab-${stage.id}`}
                class="lab__panel"
                data-stage-panel={stage.id}
                data-stage-state={stage.lab.state}
                data-stage-reading={stage.lab.readingLabel}
                tabindex="0"
                hidden={stage.id !== 'input'}
              >
                <header class="lab__stage-head">
                  <h2 class="lab__stage">
                    <span class="lab__stage-step">{stage.step}</span>
                    <span>{stage.label}</span>
                  </h2>
                  <p class="lab__stage-state">{stage.lab.state}</p>
                  <p class="lab__stage-reading">{stage.lab.readingLabel}</p>
                </header>

                <div class="lab__artifact">
                  {stage.id === 'diagnosis' && (
                    <figure class="lab__plate lab__gaps" data-tone="failure">
                      <figcaption class="lab__plate-label">{failureRecord.oldContract.label}</figcaption>
                      <dl>
                        <div>
                          <dt>Request</dt>
                          <dd>{failureRecord.oldContract.request}</dd>
                        </div>
                        {failureRecord.oldContract.gaps.map((gap) => (
                          <div data-missing="true">
                            <dt>{gap.field}</dt>
                            <dd>{gap.note}</dd>
                          </div>
                        ))}
                      </dl>
                      <p class="lab__source">{failureRecord.oldContract.source}</p>
                    </figure>
                  )}

                  {stage.id === 'intervention' && (
                    <div class="lab__plate lab__changes">
                      <p class="lab__plate-label">Documented responses</p>
                      <ol>
                        {interventionRecord.responses.map((item) => (
                          <li>
                            <p class="lab__change-name">{item.name}</p>
                            <p class="lab__change-note">{item.note}</p>
                          </li>
                        ))}
                      </ol>
                    </div>
                  )}

                  {artifact?.kind === 'code' && (
                    <figure
                      class="lab__plate lab__code"
                      data-tone={stage.tone}
                      data-illustrative={artifact.illustrative ? 'true' : undefined}
                    >
                      <figcaption class="lab__plate-label">{artifact.label}</figcaption>
                      <pre tabindex="0"><code>{artifact.code}</code></pre>
                    </figure>
                  )}

                  {artifact?.kind === 'checks' && artifact.items && (
                    <div class="lab__plate lab__checks">
                      <p class="lab__plate-label">{artifact.label}</p>
                      <ol>
                        {artifact.items.map((item) => (
                          <li>
                            <span class="lab__checks-name">{item.name}</span>
                            {item.note && <span class="lab__checks-note">{item.note}</span>}
                          </li>
                        ))}
                      </ol>
                    </div>
                  )}

                  {artifact?.kind === 'refusal' && artifact.items && (
                    <figure class="lab__plate lab__refusal" data-tone="failure">
                      <figcaption class="lab__plate-label">{artifact.label}</figcaption>
                      <dl>
                        {artifact.items.map((item) => (
                          <div>
                            <dt>{item.name}</dt>
                            <dd>{item.value}</dd>
                          </div>
                        ))}
                      </dl>
                    </figure>
                  )}
                </div>

                <dl class="lab__transition">
                  <div>
                    <dt>Received</dt>
                    <dd>{stage.lab.received}</dd>
                  </div>
                  <div>
                    <dt>Because</dt>
                    <dd>{stage.summary}</dd>
                  </div>
                  <div>
                    <dt>Produced</dt>
                    <dd>{stage.handedOff}</dd>
                  </div>
                </dl>

                <footer class="lab__cite">
                  <p>
                    <span class="lab__cite-label">Read from</span>
                    <span>{stage.evidence}</span>
                  </p>
                  <a class="text-link" href={`${syncareer.route}#stage-${stage.id}`}>
                    Open stage {stage.step} in the case study
                    <span class="text-link__arrow" aria-hidden="true">→</span>
                  </a>
                </footer>
              </div>
            );
          })}

          <div
            id="lab-compare"
            class="lab__compare"
            role="region"
            aria-labelledby="lab-compare-title"
            data-lab-compare-panel
            tabindex="-1"
            hidden
          >
            <header class="lab__stage-head">
              <h2 id="lab-compare-title" class="lab__stage">
                <span>{labCompareCopy.title}</span>
              </h2>
              <p class="lab__stage-state">{labCompareCopy.state}</p>
              <p class="lab__stage-reading" data-compare-note>{labCompareCopy.note}</p>
            </header>

            <p class="lab__plate-label lab__compare-label">{interventionRecord.comparison.label}</p>
            <div class="lab__split">
              <section class="lab__split-col lab__split-col--before" aria-labelledby="lab-compare-before">
                <h3 id="lab-compare-before">{labCompareCopy.before}</h3>
                <dl class="lab__pair">
                  {interventionRecord.comparison.items.map((item) => (
                    <div>
                      <dt>{item.name}</dt>
                      <dd>{item.before}</dd>
                    </div>
                  ))}
                </dl>
                <p class="lab__source">{failureRecord.oldContract.source}</p>
                {beforeCode && (
                  <figure class="lab__plate lab__code" data-tone="failure" data-illustrative="true">
                    <figcaption class="lab__plate-label">{beforeCode.label}</figcaption>
                    <pre tabindex="0"><code>{beforeCode.code}</code></pre>
                  </figure>
                )}
              </section>

              <section class="lab__split-col lab__split-col--after" aria-labelledby="lab-compare-after">
                <h3 id="lab-compare-after">{labCompareCopy.after}</h3>
                <dl class="lab__pair">
                  {interventionRecord.comparison.items.map((item) => (
                    <div>
                      <dt>{item.name}</dt>
                      <dd>{item.after}</dd>
                    </div>
                  ))}
                </dl>
                {afterCode && (
                  <figure class="lab__plate lab__code" data-illustrative="true">
                    <figcaption class="lab__plate-label">{afterCode.label}</figcaption>
                    <pre tabindex="0"><code>{afterCode.code}</code></pre>
                  </figure>
                )}
              </section>
            </div>

            <p class="lab__cite">
              <a class="text-link" href={`${syncareer.route}#intervention`}>
                Open the comparison in the case study
                <span class="text-link__arrow" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </div>

        <p id="lab-keys" class="lab__keys">{labCopy.keys}</p>
      </div>

      <aside class="lab__boundary" aria-label="Evidence boundary for the Reliability Lab">
        <p>{labBoundary.intro}</p>
        <p>{labBoundary.pointer}</p>
        <p>
          <a class="text-link" href={`${syncareer.route}#result`}>
            {labBoundary.pointerLabel}
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </p>
      </aside>

      <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-lab-live></p>
    </div>
  </SectionFrame>
</section>

<script>
  /**
   * One stage index and one compare flag drive the track, the reading,
   * the marker and the URL. Replay returns to input. Selecting a stage
   * leaves compare. Reduced motion is a direct state change: scroll is
   * instant, and the marker transition is cancelled in CSS.
   */
  let teardown: (() => void) | null = null;

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-reliability-lab]');
    if (!root) {
      teardown?.();
      teardown = null;
      return;
    }
    if (root.dataset.labEnhanced === '1') return;
    root.dataset.labEnhanced = '1';

    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();
    const signal = events.signal;

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-stage-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-stage-panel]')];
    const rail = root.querySelector<HTMLElement>('[data-lab-rail]');
    const track = root.querySelector<HTMLElement>('[data-lab-track]');
    const marker = root.querySelector<HTMLElement>('[data-lab-marker]');
    const segment = root.querySelector<HTMLElement>('[data-lab-segment]');
    const line = root.querySelector<HTMLElement>('[data-lab-line]');
    const previous = root.querySelector<HTMLButtonElement>('[data-lab-prev]');
    const replay = root.querySelector<HTMLButtonElement>('[data-lab-replay]');
    const next = root.querySelector<HTMLButtonElement>('[data-lab-next]');
    const compareBtn = root.querySelector<HTMLButtonElement>('[data-lab-compare]');
    const comparePanel = root.querySelector<HTMLElement>('[data-lab-compare-panel]');
    const posStep = root.querySelector<HTMLElement>('[data-lab-pos-step]');
    const posLabel = root.querySelector<HTMLElement>('[data-lab-pos-label]');
    const live = root.querySelector<HTMLElement>('[data-lab-live]');
    const well = root.querySelector<HTMLElement>('[data-lab-well]');
    const scroller = root.querySelector<HTMLElement>('[data-lab-scroll]');

    if (!rail || !track || tabs.length === 0 || panels.length !== tabs.length) return;

    const stageIds = tabs.map((tab) => tab.dataset.stageTab ?? '');
    const STORAGE_KEY = 'workspace:lab-stage';
    let activeIndex = 0;
    let comparing = false;
    let resizeTimer = 0;

    const clamp = (index: number) => Math.max(0, Math.min(tabs.length - 1, index));

    const readStored = () => {
      try {
        return sessionStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    };
    const writeStored = (id: string) => {
      try {
        sessionStorage.setItem(STORAGE_KEY, id);
      } catch {
        /* private mode */
      }
    };

    const stageText = (index: number) => {
      const tab = tabs[index];
      const panel = panels[index];
      return {
        step: tab?.querySelector('.lab__node-step')?.textContent?.trim() ?? '',
        label: tab?.querySelector('.lab__node-label')?.textContent?.trim() ?? '',
        state: panel?.dataset.stageState ?? '',
        reading: panel?.dataset.stageReading ?? '',
      };
    };

    const announceStage = (index: number, prefix = '') => {
      if (!live) return;
      const { step, label, state, reading } = stageText(index);
      live.textContent = `${prefix}Stage ${step}, ${label}. ${state}. ${reading}.`.replace(/\s+/g, ' ').trim();
    };

    const placeMarker = () => {
      if (!marker) return;
      const mark = tabs[activeIndex]?.querySelector<HTMLElement>('.lab__node-mark');
      if (!mark) return;
      const trackBox = track.getBoundingClientRect();
      const box = mark.getBoundingClientRect();
      const x = box.left - trackBox.left + box.width / 2;
      const y = box.top - trackBox.top + box.height / 2;
      marker.style.left = `${x}px`;
      marker.style.top = `${y}px`;
      if (line) line.style.top = `${y}px`;
      if (!segment) return;
      const prev = !comparing && activeIndex > 0
        ? tabs[activeIndex - 1]?.querySelector<HTMLElement>('.lab__node-mark')
        : null;
      if (!prev) {
        segment.hidden = true;
        return;
      }
      const prevBox = prev.getBoundingClientRect();
      const prevX = prevBox.left - trackBox.left + prevBox.width / 2;
      segment.hidden = false;
      segment.style.top = `${y}px`;
      segment.style.left = `${prevX}px`;
      segment.style.width = `${Math.max(0, x - prevX)}px`;
    };

    const scrollActive = () => {
      const tab = tabs[activeIndex];
      if (!tab || !scroller) return;
      const scrollerBox = scroller.getBoundingClientRect();
      const tabBox = tab.getBoundingClientRect();
      const delta = tabBox.left - scrollerBox.left - (scrollerBox.width - tabBox.width) / 2;
      if (Math.abs(delta) < 2) return;
      scroller.scrollTo({ left: scroller.scrollLeft + delta, behavior: 'auto' });
    };

    const render = () => {
      tabs.forEach((tab, index) => {
        const active = index === activeIndex;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        tab.dataset.past = String(index < activeIndex);
        tab.dataset.future = String(index > activeIndex);
      });
      panels.forEach((panel, index) => {
        panel.hidden = comparing || index !== activeIndex;
      });
      if (comparePanel) comparePanel.hidden = !comparing;
      compareBtn?.setAttribute('aria-pressed', String(comparing));
      root.dataset.comparing = comparing ? 'true' : 'false';
      if (previous) previous.disabled = activeIndex === 0;
      if (next) next.disabled = activeIndex === tabs.length - 1;
      const { step, label } = stageText(activeIndex);
      if (posStep) posStep.textContent = comparing ? '' : step;
      if (posLabel) posLabel.textContent = comparing ? 'Before / after' : label;
      placeMarker();
    };

    const writeStageHash = (index: number) => {
      const id = stageIds[index];
      if (!id) return;
      history.replaceState(null, '', `${location.pathname}${location.search}#lab-${id}`);
      writeStored(id);
    };

    const selectStage = (
      requested: number,
      options: { announce?: boolean; updateHash?: boolean; prefix?: string; focusPanel?: boolean } = {},
    ) => {
      const index = clamp(requested);
      const focusWasCompare = document.activeElement === comparePanel;
      comparing = false;
      activeIndex = index;
      render();
      scrollActive();
      if (options.updateHash) writeStageHash(index);
      if (options.focusPanel) panels[index]?.focus();
      else if (focusWasCompare) panels[index]?.focus();
      if (options.announce) announceStage(index, options.prefix);
    };

    const setCompare = (on: boolean, options: { announce?: boolean; updateHash?: boolean } = {}) => {
      const previousFocus = document.activeElement;
      comparing = on;
      render();
      if (options.updateHash) {
        if (on) history.replaceState(null, '', `${location.pathname}${location.search}#lab-compare`);
        else writeStageHash(activeIndex);
      }
      if (on && previousFocus instanceof Element && panels.some((panel) => panel.contains(previousFocus))) {
        comparePanel?.focus();
      }
      if (!on && previousFocus === comparePanel) panels[activeIndex]?.focus();
      if (options.announce && live) {
        if (on) {
          const note = comparePanel?.querySelector('[data-compare-note]')?.textContent?.trim() ?? '';
          live.textContent = `Comparing before and after. ${note}`;
        } else {
          announceStage(activeIndex);
        }
      }
    };

    const hashId = location.hash.startsWith('#lab-') ? location.hash.slice('#lab-'.length) : '';
    const hashIndex = stageIds.indexOf(hashId);
    const storedId = readStored();
    const storedIndex = storedId ? stageIds.indexOf(storedId) : -1;
    if (location.hash === '#lab-compare') {
      comparing = true;
      activeIndex = storedIndex >= 0 ? storedIndex : 0;
    } else if (hashIndex >= 0) {
      activeIndex = hashIndex;
    } else if (storedIndex >= 0) {
      activeIndex = storedIndex;
    }
    render();
    requestAnimationFrame(() => {
      placeMarker();
      if (hashIndex >= 0 || location.hash === '#lab-compare') scrollActive();
    });

    const stepFromKey = (key: string) => {
      if (key === 'ArrowRight' || key === 'ArrowDown') return activeIndex + 1;
      if (key === 'ArrowLeft' || key === 'ArrowUp') return activeIndex - 1;
      if (key === 'Home') return 0;
      if (key === 'End') return tabs.length - 1;
      return null;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        selectStage(index, { announce: true, updateHash: true });
      });
      tab.addEventListener('keydown', (event) => {
        const nextIndex = stepFromKey(event.key);
        if (nextIndex === null) return;
        event.preventDefault();
        const destination = clamp(nextIndex);
        selectStage(destination, { announce: true, updateHash: true });
        tabs[destination]?.focus();
      });
    });

    const onReadingKey = (event: KeyboardEvent) => {
      const target = event.target;
      if (!(target instanceof Element) || !(event.currentTarget instanceof Element)) return;
      if (target !== event.currentTarget && target.closest('pre, a, button, input, textarea, select')) return;
      const nextIndex = stepFromKey(event.key);
      if (nextIndex === null) return;
      event.preventDefault();
      selectStage(clamp(nextIndex), { announce: true, updateHash: true, focusPanel: true });
    };
    panels.forEach((panel) => panel.addEventListener('keydown', onReadingKey));
    comparePanel?.addEventListener('keydown', onReadingKey);

    previous?.addEventListener('click', () => selectStage(activeIndex - 1, { announce: true, updateHash: true }));
    next?.addEventListener('click', () => selectStage(activeIndex + 1, { announce: true, updateHash: true }));
    replay?.addEventListener('click', () => selectStage(0, { announce: true, updateHash: true, prefix: 'Replayed. ' }));
    compareBtn?.addEventListener('click', () => setCompare(!comparing, { announce: true, updateHash: true }));

    root.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target;
      if (!(target instanceof Element) || target.closest('pre, a, input, textarea, select')) return;
      if (event.key === 'r' || event.key === 'R') {
        event.preventDefault();
        selectStage(0, { announce: true, updateHash: true, prefix: 'Replayed. ' });
      } else if (event.key === 'c' || event.key === 'C') {
        event.preventDefault();
        setCompare(!comparing, { announce: true, updateHash: true });
      }
    });

    let touch: { x: number; y: number; block: boolean } | null = null;
    well?.addEventListener('touchstart', (event) => {
      if (event.touches.length !== 1) {
        touch = null;
        return;
      }
      const target = event.target;
      const point = event.touches[0];
      if (!point) return;
      touch = {
        x: point.clientX,
        y: point.clientY,
        block: target instanceof Element && Boolean(target.closest('pre, a, button')),
      };
    }, { passive: true, signal });
    well?.addEventListener('touchend', (event) => {
      if (!touch || touch.block) {
        touch = null;
        return;
      }
      const point = event.changedTouches[0];
      const origin = touch;
      touch = null;
      if (!point) return;
      const dx = point.clientX - origin.x;
      const dy = point.clientY - origin.y;
      if (Math.abs(dx) < 56 || Math.abs(dx) < Math.abs(dy) * 1.25) return;
      selectStage(activeIndex + (dx < 0 ? 1 : -1), { announce: true, updateHash: true });
    }, { passive: true, signal });
    well?.addEventListener('touchcancel', () => {
      touch = null;
    }, { signal });

    window.addEventListener('hashchange', () => {
      if (location.hash === '#lab-compare') {
        setCompare(true, { announce: true });
        return;
      }
      const index = location.hash.startsWith('#lab-') ? stageIds.indexOf(location.hash.slice('#lab-'.length)) : -1;
      if (index >= 0) {
        selectStage(index, { announce: true });
        writeStored(stageIds[index] ?? '');
      }
    }, { signal });

    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(placeMarker, 100);
    }, { signal });

    document.fonts?.ready.then(() => placeMarker()).catch(() => {});
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .lab {
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
    --lab-mark: 0.625rem;
    --lab-mark-top: 0.85rem;
  }

  .lab__shell {
    display: grid;
    gap: var(--space-4);
  }

  /* One framed instrument. The tick marks it as the live surface. */
  .lab__bench {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-canvas-strong);
