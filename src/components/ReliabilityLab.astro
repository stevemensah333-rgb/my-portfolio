---
/**
 * Reliability Lab — the portfolio's signature instrument.
 *
 * One canonical selected-stage state drives the rail, panel, position,
 * keyboard controls and deep link. No autoplay or second progress cursor.
 * The case study explains the investigation; this Lab exposes its shared
 * artifacts and concise, stage-specific system state.
 *
 * Without JavaScript every stage remains visible. Reduced motion disables
 * transitions; it does not remove or skip information.
 */
import { labStages, labCopy, labBoundary } from '../data/reliabilityLab';
import { syncareer } from '../data/registry';
import SectionFrame from './SectionFrame.astro';

const first = labStages[0];
const total = String(labStages.length).padStart(2, '0');
---

<section
  id="reliability-lab"
  class="lab on-deck"
  data-reliability-lab
  aria-labelledby="reliability-lab-title"
  data-workspace-section="reliability-lab"
>
  <!-- Instrumentation runs at the concentrated rhythm, not the
     block-major air reserved for the identity band and the close. -->
  <SectionFrame
    coordinate="03 · Lab / Reliability"
    status="Instrument"
    surface="canvas"
    density="default"
  >
    <div class="page-shell lab__shell">
      <!-- The header sits on the shared region grid: the index is a
         margin apparatus like every other section, and the bench below
         gets the full measure. One composition, both environments. -->
      <header class="lab__header region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">03</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">{labCopy.eyebrow}</span>
          </div>
        </aside>
        <div class="region-body lab__header-copy">
          <h1 id="reliability-lab-title" class="lab__title">{labCopy.title}</h1>
          <p class="lab__intro">{labCopy.intro}</p>
          <noscript>
            <p class="lab__noscript">
              Stage controls need JavaScript; all seven inspection records remain listed below. For
              the full explanation, open the{' '}
              <a class="text-link" href={syncareer.route}>
                Syncareer case study
                <span class="text-link__arrow" aria-hidden="true">→</span>
              </a>
            </p>
          </noscript>
        </div>
      </header>

      <div class="lab__bench">

        <!-- Pipeline: stage nodes + the payload travelling the track -->
        <div class="lab__railscroll">
          <div class="lab__railwrap">
            <div
              class="lab__rail"
              role="tablist"
              aria-label="Reliability pipeline stages"
              aria-orientation="horizontal"
              data-lab-rail
            >
              {labStages.map((stage, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`lab-tab-${stage.id}`}
                  class="lab__node"
                  data-stage-tab={stage.id}
                  aria-controls={`lab-panel-${stage.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <span class="lab__node-step" aria-hidden="true">{stage.step}</span>
                  <span class="lab__node-label">{stage.label}</span>
                  <span class="lab__node-mark" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <p class="lab__readout">
          <span class="mono-label mono-label--inverse" data-readout-label>
            Active · {first?.step}
          </span>
          <span data-readout-text>{first?.lab.state}</span>
        </p>

        <!-- Transport -->
        <div class="lab__transport" role="group" aria-label="Stage navigation">
          <button type="button" class="lab__btn lab__btn--ghost" data-lab-prev disabled>
            {labCopy.prev}
          </button>
          <button type="button" class="lab__btn" data-lab-replay>
            <span class="lab__btn-icon" aria-hidden="true">↺</span>
            {labCopy.replay}
          </button>
          <button type="button" class="lab__btn lab__btn--ghost" data-lab-next>
            {labCopy.next}
          </button>
          <p class="lab__position mono-label mono-label--inverse" data-lab-position>
            {first?.step} / {total} · {first?.label}
          </p>
        </div>

        <!-- Payload viewport: one panel per stage -->
        <div class="lab__viewport">
          {labStages.map((stage, index) => (
            <article
              role="tabpanel"
              id={`lab-panel-${stage.id}`}
              aria-labelledby={`lab-tab-${stage.id}`}
              class="lab__panel"
              data-stage-panel={stage.id}
              data-stage-state={stage.lab.state}
              tabindex="0"
              hidden={index !== 0}
            >
              <header class="lab__panel-top">
                <span class="lab__tag">{stage.step} / {stage.label}</span>
                {stage.lab.illustrative && (
                  <span class="lab__chip lab__chip--illus">illustrative fixture</span>
                )}
              </header>

              <h2 class="lab__panel-title">{stage.lab.state}</h2>

              <div class="lab__payload">
                {stage.artifact?.kind === 'code' && stage.artifact.code && (
                  <figure class="lab__code" data-tone={stage.tone}>
                    <figcaption class="mono-label mono-label--inverse">
                      {stage.artifact.label}
                    </figcaption>
                    <pre><code>{stage.artifact.code}</code></pre>
                  </figure>
                )}

                {stage.artifact?.kind === 'checks' && stage.artifact.items && (
                  <div class="lab__checks-block">
                    <p class="mono-label">{stage.artifact.label} · rules, not a run result</p>
                    <ul class="lab__checks" aria-label="Validation rules">
                      {stage.artifact.items.map((item) => (
                        <li>
                          <span class="lab__checks-name">{item.name}</span>
                          <span class="lab__checks-note">{item.note}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {stage.artifact?.kind === 'refusal' && stage.artifact.items && (
                  <dl class="lab__record">
                    {stage.artifact.items.map((item) => (
                      <div>
                        <dt>{item.name}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                {stage.artifact?.kind === 'compare' && stage.artifact.items && (
                  <dl class="lab__compare">
                    {stage.artifact.items.map((item) => (
                      <div>
                        <dt>{item.name}</dt>
                        <dd>
                          <span class="lab__compare-before">{item.before}</span>
                          <span class="lab__compare-arrow" aria-hidden="true">→</span>
                          <span>{item.after}</span>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>

              {stage.lab.inspection.length > 0 && (
                <dl class="lab__inspection">
                  {stage.lab.inspection.map((item) => (
                    <div>
                      <dt>{item.label}</dt>
                      <dd>{item.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {stage.lab.interventions && (
                <div class="lab__interventions">
                  <p class="mono-label">Interventions · canonical case-study record</p>
                  <ul>
                    {stage.lab.interventions.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              )}

              <p class="lab__handoff">
                <a class="text-link" href={`${syncareer.route}#stage-${stage.id}`}>
                  Open stage {stage.step} in the Syncareer case study
                  <span aria-hidden="true">↗</span>
                </a>
              </p>
            </article>
          ))}
        </div>
      </div>

      <aside class="lab__boundary" aria-label="Evidence boundary for the Reliability Lab">
        <p class="lab__boundary-intro">{labBoundary.intro}</p>
        <p class="lab__boundary-pointer">{labBoundary.pointer}</p>
        <p class="lab__case-link">
          <a class="text-link" href={`${syncareer.route}#result`}>
            {labBoundary.pointerLabel}
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </p>
      </aside>

      <p class="lab__keys mono-label mono-label--inverse">{labCopy.keys}</p>

      <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-lab-live></p>
    </div>
  </SectionFrame>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-reliability-lab]');

  if (root) {
    const rail = root.querySelector<HTMLElement>('[data-lab-rail]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-stage-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-stage-panel]')];
    const previous = root.querySelector<HTMLButtonElement>('[data-lab-prev]');
    const replay = root.querySelector<HTMLButtonElement>('[data-lab-replay]');
    const next = root.querySelector<HTMLButtonElement>('[data-lab-next]');
    const position = root.querySelector<HTMLElement>('[data-lab-position]');
    const stateLabel = root.querySelector<HTMLElement>('[data-readout-label]');
    const stateText = root.querySelector<HTMLElement>('[data-readout-text]');
    const live = root.querySelector<HTMLElement>('[data-lab-live]');

    if (rail && tabs.length > 0 && panels.length === tabs.length) {
      const stageIds = tabs.map((tab) => tab.dataset.stageTab ?? '');
      const panelById = new Map(panels.map((panel) => [panel.dataset.stagePanel ?? '', panel]));
      const verticalRail = window.matchMedia('(max-width: 57.99rem)');
      let activeIndex = 0;

      const setOrientation = () => {
        rail.setAttribute('aria-orientation', verticalRail.matches ? 'vertical' : 'horizontal');
      };
      setOrientation();
      verticalRail.addEventListener('change', setOrientation);

      const updateStage = (
        requestedIndex: number,
        options: { announce?: boolean; updateHash?: boolean } = {},
      ) => {
        const index = Math.max(0, Math.min(tabs.length - 1, requestedIndex));
        const tab = tabs[index];
        const id = stageIds[index];
        const panel = panelById.get(id ?? '');
        if (!tab || !id || !panel) return;

        // This index is the instrument's only mutable stage state.
        activeIndex = index;
        tabs.forEach((item, itemIndex) => {
          const active = itemIndex === index;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
          item.dataset.active = String(active);
          item.dataset.past = String(itemIndex < index);
          item.dataset.future = String(itemIndex > index);
        });
        panels.forEach((item, itemIndex) => {
          const active = itemIndex === index;
          item.hidden = !active;
          item.dataset.active = String(active);
        });

        const step = tab.querySelector('.lab__node-step')?.textContent?.trim() ?? '';
        const label = tab.querySelector('.lab__node-label')?.textContent?.trim() ?? '';
        if (stateLabel) stateLabel.textContent = `Active · ${step}`;
        if (stateText) stateText.textContent = panel.dataset.stageState ?? '';
        if (position) position.textContent = `${step} / ${String(tabs.length).padStart(2, '0')} · ${label}`;
        if (previous) previous.disabled = index === 0;
        if (next) next.disabled = index === tabs.length - 1;
        if (options.announce && live) live.textContent = `Stage ${step}, ${label}. ${panel.dataset.stageState ?? ''}.`;
        if (options.updateHash) {
          history.replaceState(null, '', `${location.pathname}${location.search}#lab-${id}`);
        }
      };

      const indexFromHash = () => stageIds.indexOf(location.hash.replace(/^#lab-/, ''));
      const hashIndex = location.hash.startsWith('#lab-') ? indexFromHash() : -1;
      const markedIndex = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      updateStage(hashIndex >= 0 ? hashIndex : Math.max(0, markedIndex));

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => updateStage(index, { announce: true, updateHash: true }));
        tab.addEventListener('keydown', (event) => {
          let nextIndex: number | null = null;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = activeIndex + 1;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = activeIndex - 1;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          if (nextIndex === null) return;
          event.preventDefault();
          const destination = Math.max(0, Math.min(tabs.length - 1, nextIndex));
          tabs[destination]?.focus();
          updateStage(destination, { announce: true, updateHash: true });
        });
      });

      previous?.addEventListener('click', () => updateStage(activeIndex - 1, { announce: true, updateHash: true }));
      next?.addEventListener('click', () => updateStage(activeIndex + 1, { announce: true, updateHash: true }));
      replay?.addEventListener('click', () => updateStage(0, { announce: true, updateHash: true }));

      window.addEventListener('hashchange', () => {
        const index = indexFromHash();
        if (location.hash.startsWith('#lab-') && index >= 0) updateStage(index, { announce: true });
      });
    }
  }
</script>

<style>
  .lab {
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
    --lab-fail: var(--color-signal-fail-bright);
  }

  .lab__shell {
    display: grid;
    gap: var(--space-5);
  }

  .lab__header-copy { gap: var(--space-3); }

  .lab__title {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-statement);
  }

  .lab__intro {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .lab__noscript {
    max-width: var(--width-reading);
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-on-canvas);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .lab__noscript .text-link { color: var(--color-accent-bright); }

  .lab__bench {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-canvas-strong);
    background: var(--color-deck-soft);
  }

  .lab__bench::before {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
    content: '';
  }

  .lab__railscroll { min-width: 0; }
  .lab__railwrap { width: 100%; }

  .lab__rail {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-block: 1px solid var(--color-rule-on-canvas);
  }

  .lab__node {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-1);
    min-width: 0;
    min-height: 5.5rem;
    padding: var(--space-2);
    border: 0;
    border-right: 1px solid var(--color-rule-on-canvas-soft);
    background: transparent;
    color: var(--color-text-on-canvas-muted);
    cursor: pointer;
    font: inherit;
    text-align: center;
  }

  .lab__node:last-child { border-right: 0; }

  .lab__node-step {
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
  }

  .lab__node-label {
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.035em;
    line-height: 1.35;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .lab__node-mark {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--color-rule-on-canvas-strong);
    border-radius: 50%;
    background: var(--color-deck);
  }

  .lab__node:hover,
  .lab__node:focus-visible {
    background: var(--color-deck-inset);
    color: var(--color-text-on-canvas);
  }

  .lab__node[aria-selected='true'] {
    background: var(--color-deck-inset);
    color: var(--color-text-on-canvas);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .lab__node[aria-selected='true'] .lab__node-step { color: var(--color-accent-text); }
  .lab__node[aria-selected='true'] .lab__node-mark {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .lab__node[data-past='true'] .lab__node-mark {
    border-color: var(--color-text-on-canvas-faint);
    background: var(--color-text-on-canvas-faint);
  }

  .lab__node[data-stage-tab='failure'][data-past='true'] .lab__node-mark {
    border-color: var(--lab-fail);
    background: var(--lab-fail);
  }

  .lab__node[data-future='true'] { color: var(--color-text-on-canvas-faint); }
  .lab__node[data-future='true'] .lab__node-mark { background: transparent; }

  .lab__readout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    min-height: 1.25rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .lab__transport {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .lab__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-accent);
    background: transparent;
    color: var(--color-accent-text);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .lab__btn:hover:not(:disabled),
  .lab__btn:focus-visible {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .lab__btn--ghost {
    border-color: var(--color-rule-on-canvas);
    color: var(--color-text-on-canvas);
  }

  .lab__btn--ghost:hover:not(:disabled),
  .lab__btn--ghost:focus-visible {
    border-color: var(--color-accent);
    background: transparent;
    color: var(--color-accent-text);
  }

  .lab__btn:disabled {
    border-color: var(--color-rule-on-canvas-soft);
    color: var(--color-text-on-canvas-faint);
    cursor: not-allowed;
  }

  .lab__btn-icon { font-size: 0.75rem; line-height: 1; }
  .lab__position { margin: 0 0 0 auto; }
  .lab__viewport { display: grid; }

  .lab__panel {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas-soft);
  }

  .lab__panel[hidden] { display: none; }
  .lab__panel:focus-visible { outline-offset: -2px; }

  .lab__panel-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .lab__tag,
  .lab__chip {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-rule-on-canvas);
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .lab__tag { background: var(--color-canvas); }
  .lab__chip--illus { border-style: dotted; }

  .lab__panel-title {
    margin: 0;
    color: var(--color-text-on-canvas);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-transform: capitalize;
  }

  .lab__payload { display: grid; gap: var(--space-3); min-width: 0; }
  .lab__code { display: grid; gap: var(--space-2); min-width: 0; margin: 0; }

  .lab__code pre {
    max-width: 100%;
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    tab-size: 2;
  }

  .lab__code[data-tone='failure'] pre { border-color: var(--color-signal-fail); }

  .lab__checks-block { display: grid; gap: var(--space-2); }
  .lab__checks-block > p { margin: 0; }

  .lab__checks {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-rule-on-canvas);
    list-style: none;
  }

  .lab__checks li {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3);
    background: var(--color-canvas);
  }

  .lab__checks-name,
  .lab__checks-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.55;
  }

  .lab__checks-name {
    color: var(--color-text-on-canvas);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lab__checks-note { color: var(--color-text-on-canvas-muted); }

  .lab__record,
  .lab__compare {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    border-left: 2px solid var(--color-signal-fail);
    background: var(--color-canvas);
  }

  .lab__compare { border-left-color: var(--color-accent); }

  .lab__record div,
  .lab__compare div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-canvas-soft);
  }

  .lab__record div:last-child,
  .lab__compare div:last-child { border-bottom: 0; }

  .lab__record dt,
  .lab__compare dt,
  .lab__inspection dt {
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lab__record dd,
  .lab__compare dd {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .lab__record dd { color: var(--color-text-on-canvas); }
  .lab__compare-before { color: var(--color-text-on-canvas-faint); }
  .lab__compare-arrow { color: var(--color-accent-text); }

  .lab__inspection {
    display: grid;
    gap: 0;
    margin: 0;
    border-block: 1px solid var(--color-rule-on-canvas);
  }

  .lab__inspection div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.32fr) minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-rule-on-canvas-soft);
  }

  .lab__inspection div:last-child { border-bottom: 0; }
  .lab__inspection dt { margin: 0; }
  .lab__inspection dd {
    margin: 0;
    color: var(--color-text-on-canvas-muted);
