---
/**
 * SessionBookArchitecture — inspectable signal path for the SessionBook case.
 *
 * Interaction design (selected as strongest):
 * - Reveals structure: 8 nodes, what exists vs in-progress, ownership.
 * - Reveals causality: signal travels from caller through backend to spoken response.
 * - Reveals transformation: each node receives and hands off; evidence shows what is real.
 * - Hover reveals information: readout shows owner + state + one-line summary, never owns info.
 * - Pointer is subtle, touch fallback (tap selects), reduced-motion disables travel.
 *
 * Uses shared initTraceTabs for roving tabindex, arrows, Home/End.
 * No-JS: diagram stays visible, every panel stacked.
 */

interface ArchNode {
  id: string;
  step: string;
  name: string;
  owner: string;
  state: 'present' | 'in-progress' | 'external' | 'written';
  stateLabel: string;
  detail: string[];
  evidence: string;
  readout: string;
}

const nodes: ArchNode[] = [
  {
    id: 'caller',
    step: '01',
    name: 'Caller',
    owner: 'Person',
    state: 'external',
    stateLabel: 'External actor',
    detail: [
      'A person on the phone. Not code that either SessionBook or AssemblyAI builds — the whole system exists to serve them.',
      'The caller never touches a form or a calendar. They hear options and choose one, which is the constraint that shapes everything downstream on this path.',
    ],
    evidence: 'Actor, not an artifact. Not part of the repository.',
    readout: 'Person on phone — hears options, chooses one. Constraint for everything downstream.',
  },
  {
    id: 'voice-agent',
    step: '02',
    name: 'Voice Agent',
    owner: 'AssemblyAI (runtime)',
    state: 'in-progress',
    stateLabel: 'In progress',
    detail: [
      'The conversational agent. It turns the caller\u2019s speech into text, decides what it needs to know next, runs the dialogue, and turns its replies back into speech. It runs on AssemblyAI\u2019s side.',
      'SessionBook\u2019s job is the agent document — name, voice, prompt, and the list of tools with their URLs — plus the backend those tools call. Today that document is the empty voice_agent/agent.json.',
    ],
    evidence: 'voice_agent/agent.json — present in the repo, empty (0 bytes).',
    readout: 'AssemblyAI runtime — STT, dialogue, TTS. SessionBook must supply agent.json (empty today).',
  },
  {
    id: 'http-tool-call',
    step: '03',
    name: 'HTTP tool call',
    owner: 'AssemblyAI executes · SessionBook defines',
    state: 'in-progress',
    stateLabel: 'In progress',
    detail: [
      'When the agent needs a fact — \u201ccould I book Saturday morning?\u201d — it makes an HTTPS request to a backend endpoint, carrying only the arguments its tool schema allows.',
      'Intended shape, per the reference: each tool declares a URL, an HTTP method, an argument schema, and a timeout. AssemblyAI performs the request; the caller\u2019s call never holds a WebSocket to SessionBook.',
    ],
    evidence: 'app/routers/tools.py — present in the repo, empty (0 bytes); no tool routes wired in main.py.',
    readout: 'Agent makes HTTPS request with only allowed args. No WebSocket to SessionBook.',
  },
  {
    id: 'backend',
    step: '04',
    name: 'SessionBook backend',
    owner: 'SessionBook',
    state: 'present',
    stateLabel: 'Present',
    detail: [
      'A FastAPI service. The service layer is written and async; the only endpoint served today is /health.',
      'The availability, booking and lookup functions exist in the service layer but are not yet behind HTTP routes — so what exists is the engine, and the endpoint surface is the next piece to wire.',
    ],
    evidence: 'app/main.py — FastAPI app with GET /health.',
    readout: 'FastAPI service — engine written, only /health wired. Endpoint surface is next.',
  },
  {
    id: 'booking-logic',
    step: '05',
    name: 'Booking / availability logic',
    owner: 'SessionBook',
    state: 'present',
    stateLabel: 'Present',
    detail: [
      'Two operations are written. check_availability returns the unbooked slots for a given date; book_slot atomically reserves one.',
      'Reservation takes a row lock (SELECT \u2026 FOR UPDATE), confirms the slot is still free, writes the booking, and returns a confirmation — so two concurrent callers cannot both claim the same slot. Datetimes are timezone-aware, anchored to Africa/Accra (the provider\u2019s zone), and persisted to Postgres 16.',
    ],
    evidence: 'app/services/booking_service.py; app/models.py (Provider, Slot, Booking); docker-compose.yml (Postgres 16).',
    readout: 'check_availability + book_slot with row lock. Timezone-aware, Africa/Accra.',
  },
  {
    id: 'response',
    step: '06',
    name: 'Response',
    owner: 'SessionBook',
    state: 'written',
    stateLabel: 'Written · not yet served',
    detail: [
      'The backend answers in values an agent can speak, not in status codes. Availability returns slots that already carry a spoken_label (\u201cSaturday, September 5 at 9:00 AM\u201d); a booking returns a confirmation_code plus a full spoken_confirmation sentence.',
      'These are written as Pydantic shapes and used by the service layer. The HTTP endpoints that would serve them to an agent are not wired yet.',
    ],
    evidence: 'app/schemas.py — AvailabilitySlot.spoken_label, BookingConfirmation.spoken_confirmation.',
    readout: 'Answers as spoken values, not status codes. Shapes written, routes not wired.',
  },
  {
    id: 'voice-agent-return',
    step: '07',
    name: 'Voice Agent',
    owner: 'AssemblyAI (runtime)',
    state: 'in-progress',
    stateLabel: 'In progress',
    detail: [
      'The same agent, on the way back. It receives the backend\u2019s response and decides what to say next.',
      'This is not a second system — it is the return pass through the one agent. Listing it separately keeps the forward and return paths distinct.',
    ],
    evidence: 'Same component as step 02.',
    readout: 'Same agent, return pass — receives backend response, decides what to say.',
  },
  {
    id: 'spoken-response',
    step: '08',
    name: 'Spoken response',
    owner: 'AssemblyAI speaks · SessionBook writes',
    state: 'in-progress',
    stateLabel: 'In progress',
    detail: [
      'The agent reads its answer aloud. The sentence it reads comes from the backend (spoken_confirmation), so the agent never has to reformat a timestamp or invent a code on air.',
      'SessionBook owns the wording; the voice that speaks it is AssemblyAI\u2019s text-to-speech.',
    ],
    evidence: 'booking_service.py — book_slot builds the spoken_confirmation sentence.',
    readout: 'Agent speaks backend sentence. SessionBook owns wording, AssemblyAI owns voice.',
  },
];
---

<div class="arch" data-arch>
  <div class="arch__frame">
    <div class="arch__railwrap">
      <div
        class="arch__rail"
        role="tablist"
        aria-label="SessionBook architecture — select a node to inspect"
        aria-orientation="vertical"
        data-arch-rail
      >
        {nodes.map((node, idx) => (
          <button
            type="button"
            role="tab"
            id={`arch-tab-${node.id}`}
            class="arch__node"
            data-stage-tab={node.id}
            data-state={node.state}
            data-readout={node.readout}
            aria-controls={`arch-panel-${node.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            tabindex={idx === 0 ? '0' : '-1'}
          >
            <span class="arch__step">{node.step}</span>
            <span class="arch__name">{node.name}</span>
            <span class="arch__badges">
              <span class:list={['arch__chip', `arch__chip--${node.state}`]}>{node.stateLabel}</span>
            </span>
            <span class="arch__owner">{node.owner}</span>
          </button>
        ))}
      </div>
      <div class="arch__track" aria-hidden="true">
        <span class="arch__track-line"></span>
        <span class="arch__track-fill" data-arch-fill></span>
        <span class="arch__cursor" data-arch-cursor></span>
      </div>
      <p class="arch__readout">
        <span class="mono-label" data-arch-readout-label>Active · 01</span>
        <span data-arch-readout-text>{nodes[0]?.readout}</span>
      </p>
    </div>

    <div class="arch__panels">
      {nodes.map((node, idx) => (
        <div
          role="tabpanel"
          id={`arch-panel-${node.id}`}
          aria-labelledby={`arch-tab-${node.id}`}
          class="arch__panel"
          data-stage-panel={node.id}
          data-state={node.state}
          data-active={idx === 0 ? 'true' : 'false'}
          tabindex="0"
          hidden={idx !== 0}
        >
          <header class="arch__panel-head">
            <p class="mono-label">{node.step} / {node.name}</p>
            <h3>{node.name}</h3>
          </header>
          <div class="arch__meta">
            <span class="arch__meta-owner">Owner · <strong>{node.owner}</strong></span>
            <span class:list={['arch__chip', `arch__chip--${node.state}`]}>{node.stateLabel}</span>
          </div>
          {node.detail.map((paragraph) => <p class="arch__body">{paragraph}</p>)}
          <p class="arch__evidence">
            <span class="mono-label">Evidence</span>
            {node.evidence}
          </p>
        </div>
      ))}
    </div>
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-arch-live></p>
</div>

<script>
  import { initTraceTabs } from '../scripts/initTraceTabs';

  const root = document.querySelector<HTMLElement>('[data-arch]');
  if (root) {
    const rail = root.querySelector<HTMLElement>('[data-arch-rail]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-stage-tab]')] as HTMLButtonElement[];
    const fill = root.querySelector<HTMLElement>('[data-arch-fill]');
    const cursor = root.querySelector<HTMLElement>('[data-arch-cursor]');
    const readoutLabel = root.querySelector<HTMLElement>('[data-arch-readout-label]');
    const readoutText = root.querySelector<HTMLElement>('[data-arch-readout-text]');
    const live = root.querySelector<HTMLElement>('[data-arch-live]');

    if (rail && tabs.length > 0) {
      const ids = tabs.map(t => t.dataset.stageTab ?? '').filter(Boolean);
      const count = ids.length;
      let activeIndex = 0;

      const readouts = tabs.map(t => t.dataset.readout ?? '');

      const setTrack = (index: number) => {
        if (!fill || !cursor) return;
        const pct = ((index + 0.5) / count) * 100;
        fill.style.height = `${pct}%`;
        cursor.style.top = `${pct}%`;
      };

      const setReadout = (index: number, source: 'active' | 'hover') => {
        const tab = tabs[index];
        const step = tab?.querySelector('.arch__step')?.textContent?.trim() ?? '';
        if (readoutLabel) {
          readoutLabel.textContent = source === 'hover' ? `Inspect · ${step}` : `Active · ${step}`;
        }
        if (readoutText) readoutText.textContent = readouts[index] ?? '';
      };

      const announce = (index: number) => {
        const tab = tabs[index];
        const name = tab?.querySelector('.arch__name')?.textContent?.trim() ?? '';
        const step = tab?.querySelector('.arch__step')?.textContent?.trim() ?? '';
        if (live) live.textContent = `Step ${step} ${name}. ${readouts[index] ?? ''}`;
      };

      initTraceTabs(root, {
        onSelect: (_id, index) => {
          activeIndex = index;
          setTrack(index);
          setReadout(index, 'active');
          // Selection always announces — click, Enter / Space, or arrows.
          announce(index);
          // reveal structure: past vs future
          tabs.forEach((t, i) => {
            if (i < index) {
              t.dataset.past = 'true';
              delete t.dataset.future;
            } else if (i > index) {
              t.dataset.future = 'true';
              delete t.dataset.past;
            } else {
              delete t.dataset.past;
              delete t.dataset.future;
            }
          });
        },
      });

      // hover / focus readout — reveals information, never owns it
      const indexOfNode = (target: EventTarget | null) => {
        const node = target instanceof Element ? target.closest<HTMLButtonElement>('.arch__node') : null;
        if (!node) return -1;
        return tabs.indexOf(node as HTMLButtonElement);
      };

      rail.addEventListener('pointerover', (e) => {
        const idx = indexOfNode(e.target);
        if (idx >= 0) setReadout(idx, 'hover');
      });
      rail.addEventListener('pointerout', (e) => {
        const idx = indexOfNode(e.target);
        if (idx >= 0) setReadout(activeIndex, 'active');
      });
      rail.addEventListener('focusin', (e) => {
        const idx = indexOfNode(e.target);
        if (idx >= 0) setReadout(idx, 'hover');
      });
      rail.addEventListener('focusout', (e) => {
        const idx = indexOfNode(e.target);
        if (idx >= 0) setReadout(activeIndex, 'active');
      });

      setTrack(0);
      setReadout(0, 'active');
    }
  }
</script>

<style>
  .arch__frame {
    display: grid;
    gap: 0;
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .arch__railwrap {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .arch__rail {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }

  .arch__node {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    grid-template-areas:
      'step name'
      'step badges'
      'step owner';
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    align-items: baseline;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
    color: var(--color-text-on-paper);
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--duration-quick) var(--ease-standard),
      background-color var(--duration-quick) var(--ease-standard),
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard);
  }

  /* signal path connectors */
  .arch__node::before {
    content: '';
    position: absolute;
    top: calc(100% + 1px);
    left: calc(50% - 1px);
    width: 1px;
    height: calc(var(--space-6) - 9px);
    background: var(--color-rule-on-paper);
    transition: background-color var(--duration-quick) var(--ease-standard);
  }

  .arch__node::after {
    content: '';
    position: absolute;
    top: calc(100% + var(--space-6) - 12px);
    left: calc(50% - 3px);
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--color-rule-on-paper);
    border-bottom: 1px solid var(--color-rule-on-paper);
    transform: rotate(45deg);
    transition: border-color var(--duration-quick) var(--ease-standard);
  }

  .arch__node:last-child::before,
  .arch__node:last-child::after {
    display: none;
  }

  .arch__node:hover,
  .arch__node:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-paper);
  }

  .arch__node[data-active='true'] {
    border-color: var(--color-accent);
    background: var(--color-paper);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .arch__node[data-past='true'] {
    /* Past / future are carried by connectors and borders; the labels
       stay at full contrast (WCAG 1.4.3 / 1.4.1). */
    opacity: 1;
  }

  .arch__node[data-past='true']::before,
  .arch__node[data-past='true']::after {
    background: var(--color-rule-on-paper);
    border-color: var(--color-rule-on-paper);
  }

  .arch__node[data-past='true'][data-state='present'] {
    opacity: 1;
  }

  .arch__node[data-past='true'][data-state='present']::before {
    background: var(--color-signal-pass);
  }

  .arch__node[data-future='true'] {
    opacity: 1;
    /* Future nodes read as "not yet reached" through the same dotted
       border vocabulary the state chips use — never through dim text. */
    border-style: dotted;
    background: var(--color-paper-soft);
  }

  .arch__node[data-active='true']::before {
    background: var(--color-accent);
  }

  .arch__node[data-active='true']::after {
    border-color: var(--color-accent);
  }

  .arch__node:focus-visible {
    outline-offset: -3px;
  }

  .arch__step {
    grid-area: step;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .arch__name {
    grid-area: name;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .arch__badges {
    grid-area: badges;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .arch__owner {
    grid-area: owner;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }

  .arch__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .arch__chip--present {
    border-color: var(--color-signal-pass);
    color: var(--color-signal-pass-text);
  }

  .arch__chip--in-progress {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .arch__chip--external {
    border-style: dotted;
    border-color: var(--color-rule-on-paper);
    color: var(--color-text-on-paper-muted);
  }

  .arch__chip--written {
    border-style: dashed;
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  /* track: reveals causality — where payload is in 8-node path */
  .arch__track {
    position: relative;
    height: 0.75rem;
    display: none;
  }

  .arch__track-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-rule-on-paper);
    transform: translateY(-50%);
  }

  .arch__track-fill {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform-origin: left;
    transform: translateY(-50%) scaleY(1);
    transition: height var(--duration-reveal) var(--ease-emphasized);
  }

  .arch__cursor {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
    transition: top var(--duration-reveal) var(--ease-emphasized), left var(--duration-reveal) var(--ease-emphasized);
  }

  .arch__readout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    min-height: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-on-paper-muted);
  }

  .arch__panels {
    padding: var(--space-5);
  }

  .arch__panel {
    display: grid;
    gap: var(--space-3);
    border-top: 2px solid var(--color-accent);
    animation: arch-enter var(--duration-reveal) var(--ease-emphasized);
  }

  @keyframes arch-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .arch__panel[hidden] {
    display: none !important;
  }

  html:not(.js) .arch__panel,
  html:not(.js) .arch__panel[hidden] {
    display: grid !important;
    border-top: 1px solid var(--color-rule-on-paper-soft);
    padding-top: var(--space-4);
    animation: none;
  }

  html:not(.js) .arch__panel + .arch__panel {
    margin-top: var(--space-4);
  }

  html:not(.js) .arch__readout,
  html:not(.js) .arch__track {
    display: none;
  }

  .arch__panel-head h3 {
    margin: var(--space-2) 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .arch__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .arch__meta-owner {
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  .arch__meta-owner strong {
    color: var(--color-text-on-paper);
    font-weight: 600;
  }

  .arch__body {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .arch__evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .arch__railwrap {
      padding: var(--space-6);
    }
    .arch__rail {
      gap: var(--space-6);
    }
  }

  @media (min-width: 64rem) {
    .arch__frame {
      grid-template-columns: minmax(15rem, 0.78fr) minmax(0, 1.22fr);
    }

    .arch__railwrap {
      border-bottom: 0;
      border-right: 1px solid var(--color-rule-on-paper);
      padding: var(--space-6);
      align-content: start;
      gap: var(--space-4);
    }

    .arch__rail {
      grid-template-columns: 1fr;
    }

    .arch__track {
      display: block;
      position: absolute;
      left: calc(var(--space-6) + 1rem);
      top: calc(var(--space-6) + 0.5rem);
      bottom: calc(var(--space-6) + 0.5rem);
      width: 1px;
      height: auto;
    }

    .arch__track-line {
      top: 0;
      bottom: 0;
      left: 50%;
      right: auto;
      width: 1px;
      height: 100%;
      transform: translateX(-50%);
    }

    .arch__track-fill {
      top: 0;
      bottom: auto;
      left: 50%;
      width: 1px;
      height: 0%;
      transform: translateX(-50%);
      transition: height var(--duration-reveal) var(--ease-emphasized);
    }

    .arch__cursor {
      left: 50%;
      top: 6.25%;
      transform: translate(-50%, -50%);
    }

    .arch__rail {
      padding-left: var(--space-7);
    }

    .arch__panels {
      padding: var(--space-6);
    }
  }

  @media (max-width: 30rem) {
    .arch__railwrap {
      padding: var(--space-4);
    }

    .arch__node {
      padding: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch__panel {
      animation: none;
    }
    .arch__track-fill,
    .arch__cursor,
    .arch__node {
      transition: none;
    }
  }
</style>
