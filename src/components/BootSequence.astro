---
/**
 * BootSequence — short startup transition supporting the environment concept.
 *
 * Rules from the brief:
 * - very short (≤ 600ms)
 * - skippable (click anywhere, Esc, or the skip button — which is a
 *   real button, so Enter / Space activate it when focused)
 * - never blocks content (content is underneath, boot is an overlay that fades)
 * - never repeats constantly (sessionStorage flag)
 * - disabled under reduced-motion (immediately hidden)
 * - no-JS fallback: hidden
 *
 * What it communicates:
 * - the workspace is an instrument with coordinates and registration marks
 * - it reveals structure: rail + canvas + paper environments exist
 */
---

<div id="boot" class="boot" data-boot hidden>
  <div class="boot__inner">
    <div class="boot__meta">
      <span class="mono-label mono-label--inverse boot__eyebrow" aria-hidden="true">Workspace · boot</span>
      <p class="boot__path" data-boot-path aria-hidden="true">00 / 07 · initializing</p>
    </div>
    <div class="boot__track" aria-hidden="true">
      <span class="boot__track-fill" data-boot-fill></span>
    </div>
    <button
      type="button"
      class="boot__skip mono-label mono-label--inverse"
      data-boot-skip
      aria-label="Skip boot animation"
    >
      Skip · Esc
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-boot]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const seen = (() => {
      try {
        return sessionStorage.getItem('workspace-boot-seen') === '1';
      } catch {
        return true;
      }
    })();

    const fill = root.querySelector<HTMLElement>('[data-boot-fill]');
    const path = root.querySelector<HTMLElement>('[data-boot-path]');
    const skipBtn = root.querySelector<HTMLButtonElement>('[data-boot-skip]');

    let raf = 0;
    const onKey = (e: KeyboardEvent) => {
      // Escape skips the animation. Enter / Space also skip — but only
      // while the overlay itself holds focus context (the skip button
      // handles its own activation natively).
      if (e.key === 'Escape') {
        e.preventDefault();
        cancelAnimationFrame(raf);
        hide();
      }
    };
    const onClick = () => {
      cancelAnimationFrame(raf);
      hide();
    };

    const hide = (immediate = false) => {
      document.removeEventListener('keydown', onKey);
      root.removeEventListener('click', onClick);
      try {
        sessionStorage.setItem('workspace-boot-seen', '1');
      } catch {}
      // If focus sat on the skip button, it is about to be hidden — hand
      // focus to the page's main region so keyboard users are not dropped
      // back to the top of the document.
      const skipHadFocus = skipBtn === document.activeElement;
      const finish = () => {
        root.hidden = true;
        root.dataset.state = 'done';
        if (skipHadFocus) document.getElementById('main-content')?.focus();
      };
      if (immediate) {
        finish();
        return;
      }
      root.dataset.state = 'out';
      setTimeout(finish, 220);
    };

    const run = () => {
      if (reduced || seen) {
        hide(true);
        return;
      }

      root.hidden = false;
      root.dataset.state = 'in';

      const total = document.querySelectorAll('[data-workspace-section]').length || 7;
      const totalLabel = String(total).padStart(2, '0');

      let progress = 0;
      const start = performance.now();
      const duration = 560;

      const tick = (now: number) => {
        const elapsed = now - start;
        progress = Math.min(1, elapsed / duration);
        const pct = progress * 100;
        if (fill) fill.style.width = `${pct}%`;
        if (path) {
          const cur = Math.min(total, Math.max(1, Math.floor(progress * total) + 1));
          path.textContent = `${String(cur).padStart(2, '0')} / ${totalLabel} · ${cur === total ? 'ready' : 'initializing'}`;
        }
        if (progress < 1) {
          raf = requestAnimationFrame(tick);
        } else {
          setTimeout(() => hide(), 120);
        }
      };
      raf = requestAnimationFrame(tick);

      document.addEventListener('keydown', onKey);
      root.addEventListener('click', onClick);
      skipBtn?.addEventListener('click', onClick);
    };

    run();
  }
</script>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .boot[hidden] {
    display: none !important;
  }

  .boot__inner {
    position: relative;
    width: min(22rem, calc(100vw - 2 * var(--page-gutter)));
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-canvas-soft);
    display: grid;
    gap: var(--space-4);
  }

  /* Single leading-corner registration tick — the same motif used
     by the lab bench, the inspector panel and the hero instrument.
     The boot is an instrument being initialised, not a four-crosshair
     registration frame (that pattern was removed from the system). */
  .boot__inner::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
  }

  .boot__meta {
    display: grid;
    gap: var(--space-2);
  }

  .boot__eyebrow {
    color: var(--color-text-on-canvas-muted);
  }

  .boot__path {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-on-canvas);
  }

  .boot__track {
    position: relative;
    height: 2px;
    background: var(--color-rule-on-canvas);
    overflow: hidden;
  }

  .boot__track-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background: var(--color-accent);
  }

  .boot__skip {
    justify-self: start;
    border: 1px solid var(--color-rule-on-canvas);
    background: transparent;
    color: var(--color-text-on-canvas-muted);
    padding: 0 var(--space-2);
    min-height: 1.75rem;
    cursor: pointer;
    font-size: 0.625rem;
  }

  .boot__skip:hover,
  .boot__skip:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  /* states */
  .boot[data-state='in'] {
    animation: boot-in var(--duration-reveal) var(--ease-emphasized);
  }

  .boot[data-state='out'] {
    animation: boot-out var(--duration-base) var(--ease-standard) forwards;
  }

  @keyframes boot-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes boot-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* no-JS: never show boot */
  :global(html:not(.js)) .boot {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .boot {
      display: none !important;
    }
  }
</style>
