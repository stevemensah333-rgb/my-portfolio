---
const principles = [
  {
    number: '01',
    title: 'Observe the failure',
    description: 'Name the behaviour, not a catch-all.',
  },
  {
    number: '02',
    title: 'Constrain what matters',
    description: 'Tie each constraint to an observed failure.',
  },
  {
    number: '03',
    title: 'Test beyond the happy path',
    description: 'One good response proves very little.',
  },
];
---

<section class="approach" aria-labelledby="approach-title">
  <div class="page-shell approach-layout">
    <header class="approach-header">
      <p class="technical-label">Engineering field notes</p>
      <h2 id="approach-title">How I approach AI features</h2>
    </header>

    <ol class="principle-list">
      {principles.map((principle) => (
        <li>
          <span class="principle-number" aria-hidden="true">{principle.number}</span>
          <div>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .approach {
    padding-block: var(--section-compact);
    border-top: var(--border-default);
    background: var(--color-surface-cool);
  }

  .approach-layout {
    display: grid;
    gap: var(--section-content-gap);
  }

  .approach-header p,
  .approach-header h2 {
    margin: 0;
  }

  .approach-header h2 {
    max-width: 12ch;
    margin-top: var(--section-heading-gap);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .principle-list {
    margin: 0;
    padding: 0;
    border-top: var(--border-default);
    list-style: none;
  }

  .principle-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: var(--border-default);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      padding-left var(--duration-fast) var(--ease-standard);
  }

  .principle-list li:hover {
    background: color-mix(in srgb, var(--color-surface-cool) 60%, white);
    padding-left: var(--space-2);
  }

  .principle-number {
    padding-top: 0.2rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .principle-list h3,
  .principle-list p {
    margin: 0;
  }

  .principle-list h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .principle-list p {
    max-width: 38rem;
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    .approach-layout {
      grid-template-columns: minmax(13rem, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
