---
/**
 * WorkspaceRail — the persistent navigation surface of the environment.
 *
 * Desktop (>= 64rem): a vertical rail on the left of the viewport,
 * listing destinations as numbered, mono-labelled rows. Active section
 * is tracked by an IntersectionObserver in the page-level script.
 *
 * Tablet/Mobile (< 64rem): a compact bar at the bottom of the viewport
 * with the same destinations rendered as icon-less, mono-labelled tabs.
 * A "menu" disclosure opens a drawer with the full destination list.
 *
 * The rail is keyboard-operable: Tab to move, Enter / Space to activate.
 * Each destination is a real link (or button for the in-page disclosure).
 * The current page is announced via aria-current.
 */
import { destinations } from '../config/workspace';

const isHomepage = Astro.url.pathname === '/';
const isCasePage = Astro.url.pathname.startsWith('/work/');
const homeHref = (id: string) => (isHomepage ? `#${id}` : `/#${id}`);

// Determine which workspace item should be marked as current based on the route
const currentDest = isCasePage ? 'work' : isHomepage ? 'work' : null;
---

<aside class="workspace-rail" data-workspace-rail aria-label="Workspace navigation">
  <div class="workspace-rail__brand">
    <span class="workspace-rail__brand-mark" aria-hidden="true">SM</span>
    <span class="workspace-rail__brand-text">
      <span class="workspace-rail__brand-name">Stephen Mensah</span>
      <span class="workspace-rail__brand-role mono-label">Engineering workspace</span>
    </span>
  </div>

  <div class="workspace-rail__header">
    <span class="mono-label workspace-rail__heading">Workspaces</span>
    <span class="workspace-rail__path mono-label" aria-live="polite" data-workspace-path>00 / 00</span>
  </div>

  <nav aria-label="Primary workspace destinations" class="workspace-rail__nav">
    <div class="workspace-rail__progress" aria-hidden="true">
      <span class="workspace-rail__progress-fill" data-workspace-progress></span>
    </div>
    <ol class="workspace-rail__list" data-workspace-list>
      {destinations.map((dest) => {
        const href = dest.kind === 'home' ? homeHref(dest.section) : dest.section;
        const isExternal = dest.kind === 'external';
        return (
          <li class="workspace-rail__item" data-workspace-item={dest.id}>
            <a
              class="workspace-rail__link"
              href={href}
              aria-current={dest.id === currentDest ? 'true' : undefined}
              data-workspace-link={dest.id}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              <span class="workspace-rail__index" aria-hidden="true">{dest.index}</span>
              <span class="workspace-rail__label">{dest.label}</span>
              <span class="workspace-rail__description mono-label">{dest.description}</span>
              <span class="workspace-rail__chev" aria-hidden="true">›</span>
            </a>
          </li>
        );
      })}
    </ol>
  </nav>

  <div class="workspace-rail__footer">
    <span class="workspace-rail__status mono-label" aria-live="polite" data-workspace-status>
      <span class="workspace-rail__status-dot" aria-hidden="true"></span>
      <span>Open to AI engineering roles</span>
    </span>
    <a class="workspace-rail__contact text-link" href={homeHref('contact')}>
      Start a conversation
      <span class="text-link__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<!-- Compact mobile / tablet bar -->
<nav class="workspace-bar" data-workspace-bar aria-label="Quick workspace destinations">
  <div class="workspace-bar__inner">
    <a
      class="workspace-bar__home"
      href="/"
      aria-label="Stephen Mensah — home"
      data-workspace-link="top"
    >
      <span class="workspace-bar__home-mark" aria-hidden="true">SM</span>
    </a>
    <ol class="workspace-bar__list">
      {destinations
        .filter((d) => d.kind !== 'external')
        .map((dest) => (
          <li class="workspace-bar__item" data-workspace-bar-item={dest.id}>
            <a
              class="workspace-bar__link"
              href={dest.kind === 'home' ? homeHref(dest.section) : dest.section}
              aria-current={dest.id === currentDest ? 'true' : undefined}
              data-workspace-link={dest.id}
            >
              <span class="workspace-bar__index" aria-hidden="true">{dest.index}</span>
              <span class="workspace-bar__label">{dest.label}</span>
            </a>
          </li>
        ))}
      <li class="workspace-bar__item">
        <button
          class="workspace-bar__more"
          type="button"
          aria-expanded="false"
          aria-controls="workspace-bar-drawer"
          data-workspace-bar-more
        >
          <span class="workspace-bar__index" aria-hidden="true">+</span>
          <span class="workspace-bar__label">More</span>
        </button>
      </li>
    </ol>
  </div>

  <div id="workspace-bar-drawer" class="workspace-bar__drawer" data-workspace-bar-drawer hidden>
    <div class="workspace-bar__drawer-inner page-shell">
      <p class="mono-label workspace-bar__drawer-eyebrow">All destinations</p>
      <ol class="workspace-bar__drawer-list">
        {destinations.map((dest) => {
          const href = dest.kind === 'home' ? homeHref(dest.section) : dest.section;
          return (
            <li>
              <a
                href={href}
                target={dest.kind === 'external' ? '_blank' : undefined}
                rel={dest.kind === 'external' ? 'noopener noreferrer' : undefined}
                class="workspace-bar__drawer-link"
              >
                <span class="workspace-bar__index" aria-hidden="true">{dest.index}</span>
                <span class="workspace-bar__drawer-label">{dest.label}</span>
                <span class="workspace-bar__drawer-description">{dest.description}</span>
                <span class="workspace-bar__drawer-chev" aria-hidden="true">
                  {dest.kind === 'external' ? '↗' : '→'}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-workspace-rail]');
  const bar = document.querySelector<HTMLElement>('[data-workspace-bar]');
  const pathLabel = rail?.querySelector<HTMLElement>('[data-workspace-path]');
  const progressFill = rail?.querySelector<HTMLElement>('[data-workspace-progress]');

  // --- Section tracking via IntersectionObserver -------------------------
  // Tracks which destination section is in view and reflects it on the rail.
  // The progress fill reveals structure: where you are in the workspace.
  const homeSections = document.querySelectorAll<HTMLElement>('main [data-workspace-section]');
  const homeLinkLookup = new Map<string, HTMLAnchorElement>();
  rail?.querySelectorAll<HTMLAnchorElement>('[data-workspace-link]').forEach((link) => {
    const id = link.dataset.workspaceLink;
    if (id) homeLinkLookup.set(id, link);
  });
  bar?.querySelectorAll<HTMLAnchorElement>('[data-workspace-link]').forEach((link) => {
    const id = link.dataset.workspaceLink;
    if (id && !homeLinkLookup.has(id)) homeLinkLookup.set(id, link);
  });

  const allSections = Array.from(homeSections);
  const sectionOrder = allSections.map((s) => s.dataset.workspaceSection ?? '');

  const setActive = (id: string) => {
    const section = allSections.find((s) => s.dataset.workspaceSection === id);
    if (!section) return;
    const order = sectionOrder.indexOf(id);
    const total = sectionOrder.filter(Boolean).length;
    if (pathLabel && order >= 0) {
      pathLabel.textContent = `${String(order + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }
    if (progressFill && order >= 0 && total > 0) {
      const pct = ((order + 1) / total) * 100;
      progressFill.style.height = `${pct}%`;
    }
    homeLinkLookup.forEach((link, linkId) => {
      if (linkId === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };

  if (allSections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) {
          const id = (visible.target as HTMLElement).dataset.workspaceSection;
          if (id) setActive(id);
        }
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    allSections.forEach((s) => observer.observe(s));
  }

  // --- Mobile drawer ----------------------------------------------------
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-workspace-bar-more]');
  const drawer = document.querySelector<HTMLElement>('[data-workspace-bar-drawer]');

  if (moreBtn && drawer) {
    const close = () => {
      moreBtn.setAttribute('aria-expanded', 'false');
      drawer.hidden = true;
      document.documentElement.classList.remove('bar-drawer-open');
    };
    moreBtn.addEventListener('click', () => {
      const open = moreBtn.getAttribute('aria-expanded') === 'true';
      if (open) close();
      else {
        moreBtn.setAttribute('aria-expanded', 'true');
        drawer.hidden = false;
        document.documentElement.classList.add('bar-drawer-open');
        drawer.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    drawer.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && moreBtn.getAttribute('aria-expanded') === 'true') {
        close();
        moreBtn.focus();
      }
    });
    const tabletUp = window.matchMedia('(min-width: 64rem)');
    tabletUp.addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .workspace-rail {
    display: none;
  }

  .workspace-bar {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-bar__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--page-gutter);
    min-height: 3.25rem;
  }

  .workspace-bar__home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .workspace-bar__home-mark {
    line-height: 1;
  }

  .workspace-bar__list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .workspace-bar__list::-webkit-scrollbar {
    display: none;
  }

  .workspace-bar__item {
    flex: 0 0 auto;
  }

  .workspace-bar__link,
  .workspace-bar__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-rule-on-canvas);
    background: transparent;
    color: var(--color-text-on-canvas);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard),
      background-color var(--duration-quick) var(--ease-standard);
  }

  .workspace-bar__index {
    color: var(--color-accent);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .workspace-bar__link:hover,
  .workspace-bar__link:focus-visible,
  .workspace-bar__more:hover,
  .workspace-bar__more:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .workspace-bar__link[aria-current='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-canvas-soft);
  }

  .workspace-bar__drawer {
    position: fixed;
    inset: 3.25rem 0 0 0;
    z-index: calc(var(--z-overlay) - 1);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    overflow-y: auto;
  }

  .workspace-bar__drawer-inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-7);
  }

  .workspace-bar__drawer-eyebrow {
    color: var(--color-text-on-canvas-muted);
  }

  .workspace-bar__drawer-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-bar__drawer-list li {
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-bar__drawer-link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-2) 0;
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .workspace-bar__drawer-link:hover,
  .workspace-bar__drawer-link:focus-visible {
    color: var(--color-accent);
  }

  .workspace-bar__drawer-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .workspace-bar__drawer-description {
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-meta);
    grid-column: 2;
  }

  .workspace-bar__drawer-chev {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  @media (min-width: 48rem) {
    .workspace-bar__inner {
      padding-block: var(--space-3);
      min-height: 3.5rem;
    }

    .workspace-bar__home {
      width: 2.25rem;
      height: 2.25rem;
    }

    .workspace-bar__link,
    .workspace-bar__more {
      min-height: 2.25rem;
      padding: 0 var(--space-3);
    }
  }

  /* Lock body scroll when drawer open */
  :global(html.bar-drawer-open),
  :global(html.bar-drawer-open body) {
    overflow: hidden;
  }

  @media (min-width: 64rem) {
    .workspace-bar {
      display: none;
    }

    .workspace-rail {
      position: sticky;
      top: 0;
      align-self: flex-start;
      display: grid;
      grid-template-rows: auto auto 1fr auto;
      align-content: start;
      gap: var(--space-4);
      width: 17rem;
      flex: 0 0 17rem;
      min-height: 100vh;
      padding: var(--space-5) 0 var(--space-5) var(--page-gutter);
      background: var(--color-canvas);
      color: var(--color-text-on-canvas);
      border-right: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__brand-mark {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid var(--color-accent);
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }

    .workspace-rail__brand-text {
      display: grid;
      gap: 2px;
      min-width: 0;
    }

    .workspace-rail__brand-name {
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .workspace-rail__brand-role {
      color: var(--color-text-on-canvas-muted);
    }

    .workspace-rail__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3);
      padding-bottom: var(--space-2);
    }

    .workspace-rail__heading {
      color: var(--color-text-on-canvas-muted);
    }

    .workspace-rail__path {
      color: var(--color-accent);
    }

    .workspace-rail__nav {
      position: relative;
      padding-left: var(--space-3);
    }

    .workspace-rail__progress {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--color-rule-on-canvas);
    }

    .workspace-rail__progress-fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 1px;
      height: 12%;
      background: var(--color-accent);
      transition: height var(--duration-reveal) var(--ease-emphasized);
    }

    @media (prefers-reduced-motion: reduce) {
      .workspace-rail__progress-fill {
        transition: none;
      }
    }

    .workspace-rail__list {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__item {
      border-bottom: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__link {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
      align-items: baseline;
      padding: var(--space-3) 0;
      color: var(--color-text-on-canvas-muted);
      text-decoration: none;
      transition:
        color var(--duration-quick) var(--ease-standard),
        background-color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link:hover,
    .workspace-rail__link:focus-visible {
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__link:hover .workspace-rail__description,
    .workspace-rail__link:focus-visible .workspace-rail__description {
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__index {
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
      transition: color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link:hover .workspace-rail__index,
    .workspace-rail__link:focus-visible .workspace-rail__index {
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__label {
      grid-column: 2;
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .workspace-rail__description {
      grid-column: 2;
      color: var(--color-text-on-canvas-muted);
      font-size: 0.6875rem;
      transition: color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__chev {
      grid-row: span 2;
      align-self: center;
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity var(--duration-quick) var(--ease-standard),
        transform var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link:hover .workspace-rail__chev,
    .workspace-rail__link:focus-visible .workspace-rail__chev {
      opacity: 1;
      transform: translateX(0);
    }

    .workspace-rail__link[aria-current='true'] {
      color: var(--color-text-on-canvas);
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-accent) 14%, transparent) 0,
        transparent 60%
      );
    }

    .workspace-rail__link[aria-current='true'] .workspace-rail__chev {
      opacity: 1;
      transform: translateX(0);
    }

    .workspace-rail__footer {
      display: grid;
      gap: var(--space-3);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__status {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-on-canvas-muted);
    }

    .workspace-rail__status-dot {
      width: 0.4375rem;
      height: 0.4375rem;
      background: var(--color-signal-pass);
      border-radius: 50%;
      animation: rail-status-pulse 3.6s var(--ease-standard) infinite;
    }

    @keyframes rail-status-pulse {
      0%,
      90%,
      100% {
        opacity: 1;
      }
      95% {
        opacity: 0.35;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .workspace-rail__status-dot {
        animation: none;
      }
    }

    .workspace-rail__contact {
      color: var(--color-text-on-canvas);
      align-self: start;
    }
  }
</style>
