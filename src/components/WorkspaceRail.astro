---
/**
 * WorkspaceRail — the persistent navigation surface of the site.
 *
 * Desktop (>= 64rem): a vertical rail on the left of the viewport with
 * two groups — PRIMARY (01 Home · 02 Work · 03 Lab · 04 Profile) and
 * UTILITIES (Résumé · Email). "Current" is derived from the route, not
 * from scroll position; an IntersectionObserver only drives the mono
 * path readout and the progress spine.
 *
 * Tablet/Mobile (< 64rem): a compact bar with the four primary
 * destinations plus a "More" disclosure that opens a drawer with the
 * full list and descriptions.
 *
 * The rail is keyboard-operable: every destination is a real link. The
 * current page is announced via aria-current="page".
 */
import {
  primaryDestinations,
  utilityDestinations,
  destinationForPath,
  type Destination,
} from '../config/workspace';

const currentId = destinationForPath(Astro.url.pathname);
const currentIndex = primaryDestinations.findIndex((dest) => dest.id === currentId);

const destHref = (dest: Destination) => dest.href;
---

<div class="workspace-rail" data-workspace-rail>
  <div class="workspace-rail__brand">
    <span class="workspace-rail__brand-mark" aria-hidden="true">SM</span>
    <span class="workspace-rail__brand-text">
      <span class="workspace-rail__brand-name">Stephen Mensah</span>
      <span class="workspace-rail__brand-role mono-label mono-label--bare">Engineering workspace</span>
    </span>
  </div>

  <div class="workspace-rail__header">
    <span class="mono-label workspace-rail__heading">Primary</span>
    <span class="workspace-rail__path mono-label mono-label--bare" data-workspace-path>
      {currentIndex >= 0
        ? `${primaryDestinations[currentIndex]?.index} / ${String(primaryDestinations.length).padStart(2, '0')}`
        : '— / —'}
    </span>
  </div>

  <nav aria-label="Primary site destinations" class="workspace-rail__nav">
    <div class="workspace-rail__progress" aria-hidden="true">
      <span
        class="workspace-rail__progress-fill"
        data-workspace-progress
        style={currentIndex >= 0 ? `height: ${((currentIndex + 1) / primaryDestinations.length) * 100}%` : ''}
      ></span>
    </div>
    <ol class="workspace-rail__list" data-workspace-list>
      {primaryDestinations.map((dest) => (
        <li class="workspace-rail__item" data-workspace-item={dest.id}>
          <a
            class="workspace-rail__link"
            href={destHref(dest)}
            aria-current={dest.id === currentId ? 'page' : undefined}
            data-workspace-link={dest.id}
          >
            <span class="workspace-rail__index" aria-hidden="true">{dest.index}</span>
            <span class="workspace-rail__label">{dest.label}</span>
            <span class="workspace-rail__chev" aria-hidden="true">›</span>
          </a>
        </li>
      ))}
    </ol>

    <span class="mono-label workspace-rail__group-heading">Utilities</span>
    <ol class="workspace-rail__list workspace-rail__list--utilities">
      {utilityDestinations.map((dest) => (
        <li class="workspace-rail__item" data-workspace-item={dest.id}>
          <a
            class="workspace-rail__link"
            href={destHref(dest)}
            data-workspace-link={dest.id}
            target={dest.external ? '_blank' : undefined}
            rel={dest.external ? 'noopener noreferrer' : undefined}
          >
            <span class="workspace-rail__index" aria-hidden="true">{dest.index}</span>
            <span class="workspace-rail__label">{dest.label}</span>
            <span class="workspace-rail__chev workspace-rail__chev--ext" aria-hidden="true">
              {dest.external ? '↗' : '→'}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="workspace-rail__footer">
    <span class="workspace-rail__status mono-label" data-workspace-status>
      <span class="workspace-rail__status-dot" aria-hidden="true"></span>
      <span>Open to AI engineering roles</span>
    </span>
    <a class="workspace-rail__contact text-link" href={utilityDestinations[1]?.href ?? '#'}>
      Start a conversation
      <span class="text-link__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</div>

<!-- Compact mobile / tablet bar -->
<nav class="workspace-bar" data-workspace-bar aria-label="Quick site destinations">
  <div class="workspace-bar__inner">
    <a
      class="workspace-bar__home"
      href="/"
      aria-label="Stephen Mensah — home"
      data-workspace-link="home"
    >
      <span class="workspace-bar__home-mark" aria-hidden="true">SM</span>
    </a>
    <ol class="workspace-bar__list">
      {primaryDestinations.map((dest) => (
        <li class="workspace-bar__item" data-workspace-bar-item={dest.id}>
          <a
            class="workspace-bar__link"
            href={destHref(dest)}
            aria-current={dest.id === currentId ? 'page' : undefined}
            data-workspace-link={dest.id}
          >
            <span class="workspace-bar__index" aria-hidden="true">{dest.index}</span>
            <span class="workspace-bar__label">{dest.label}</span>
          </a>
        </li>
      ))}
      <li class="workspace-bar__item">
        <button
          class="workspace-bar__more"
          type="button"
          aria-expanded="false"
          aria-controls="workspace-bar-drawer"
          data-workspace-bar-more
        >
          <span class="workspace-bar__index" aria-hidden="true">+</span>
          <span class="workspace-bar__label">More</span>
        </button>
      </li>
    </ol>
  </div>

  <div id="workspace-bar-drawer" class="workspace-bar__drawer" data-workspace-bar-drawer hidden>
    <div class="workspace-bar__drawer-inner page-shell">
      <p class="mono-label workspace-bar__drawer-eyebrow">All destinations</p>
      <ol class="workspace-bar__drawer-list">
        {[...primaryDestinations, ...utilityDestinations].map((dest) => (
          <li>
            <a
              href={destHref(dest)}
              target={dest.external ? '_blank' : undefined}
              rel={dest.external ? 'noopener noreferrer' : undefined}
              class="workspace-bar__drawer-link"
            >
              <span class="workspace-bar__index" aria-hidden="true">{dest.index}</span>
              <span class="workspace-bar__drawer-label">{dest.label}</span>
              <span class="workspace-bar__drawer-description">{dest.description}</span>
              <span class="workspace-bar__drawer-chev" aria-hidden="true">
                {dest.external ? '↗' : '→'}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-workspace-rail]');
  const pathLabel = rail?.querySelector<HTMLElement>('[data-workspace-path]');
  const progressFill = rail?.querySelector<HTMLElement>('[data-workspace-progress]');

  // --- Page-flow readout -----------------------------------------------
  // "Current" is route-based and set at render time. The observer below
  // only drives the mono path readout and the progress spine: where the
  // visitor is in the current page's flow (sections carry
  // data-workspace-section on every page).
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('main [data-workspace-section]'),
  );
  const sectionOrder = sections.map((s) => s.dataset.workspaceSection ?? '');

  const setActive = (id: string) => {
    const order = sectionOrder.indexOf(id);
    const total = sectionOrder.filter(Boolean).length;
    if (pathLabel && order >= 0 && total > 0) {
      pathLabel.textContent = `${String(order + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }
    if (progressFill && order >= 0 && total > 0) {
      progressFill.style.height = `${((order + 1) / total) * 100}%`;
    }
  };

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) {
          const id = (visible.target as HTMLElement).dataset.workspaceSection;
          if (id) setActive(id);
        }
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((s) => observer.observe(s));
  }

  // --- Mobile drawer ----------------------------------------------------
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-workspace-bar-more]');
  const drawer = document.querySelector<HTMLElement>('[data-workspace-bar-drawer]');
  // Page content behind the full-screen drawer: made inert while the
  // drawer is open so keyboard and screen-reader focus stay inside it.
  const drawerBackground = [
    ...document.querySelectorAll<HTMLElement>('main, body > footer, [data-workspace-rail]'),
  ];

  if (moreBtn && drawer) {
    const close = () => {
      moreBtn.setAttribute('aria-expanded', 'false');
      drawer.hidden = true;
      document.documentElement.classList.remove('bar-drawer-open');
      drawerBackground.forEach((el) => {
        el.inert = false;
      });
    };
    moreBtn.addEventListener('click', () => {
      const open = moreBtn.getAttribute('aria-expanded') === 'true';
      if (open) close();
      else {
        moreBtn.setAttribute('aria-expanded', 'true');
        drawer.hidden = false;
        document.documentElement.classList.add('bar-drawer-open');
        drawerBackground.forEach((el) => {
          el.inert = true;
        });
        drawer.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    drawer.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && moreBtn.getAttribute('aria-expanded') === 'true') {
        close();
        moreBtn.focus();
      }
    });
    const tabletUp = window.matchMedia('(min-width: 64rem)');
    tabletUp.addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .workspace-rail {
    display: none;
  }

  .workspace-bar {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    /* Single source of truth for the bar's height: the drawer and the
       bar row share it, so no gap can open between them at any width. */
    --workspace-bar-height: 3.25rem;
  }

  .workspace-bar__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--page-gutter);
    min-height: var(--workspace-bar-height);
  }

  .workspace-bar__home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent-text);
    text-decoration: none;
  }

  .workspace-bar__home-mark {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .workspace-bar__list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .workspace-bar__list::-webkit-scrollbar {
    display: none;
  }

  .workspace-bar__item {
    flex: 0 0 auto;
  }

  .workspace-bar__link,
  .workspace-bar__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-rule-on-canvas);
    background: transparent;
    color: var(--color-text-on-canvas);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--duration-quick) var(--ease-standard),
      border-color var(--duration-quick) var(--ease-standard),
      background-color var(--duration-quick) var(--ease-standard);
  }

  .workspace-bar__index {
    color: var(--color-accent-text);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .workspace-bar__link:hover,
  .workspace-bar__link:focus-visible,
  .workspace-bar__more:hover,
  .workspace-bar__more:focus-visible {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

  .workspace-bar__link[aria-current] {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
    background: var(--color-canvas-soft);
  }

  .workspace-bar__drawer {
    position: fixed;
    inset: var(--workspace-bar-height) 0 0 0;
    z-index: calc(var(--z-overlay) - 1);
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .workspace-bar__drawer-inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-7);
  }

  .workspace-bar__drawer-eyebrow {
    color: var(--color-text-on-canvas-muted);
  }

  .workspace-bar__drawer-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-bar__drawer-list li {
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-bar__drawer-link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-2) 0;
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .workspace-bar__drawer-link:hover,
  .workspace-bar__drawer-link:focus-visible {
    color: var(--color-accent-text);
  }

  .workspace-bar__drawer-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .workspace-bar__drawer-description {
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-meta);
    grid-column: 2;
  }

  .workspace-bar__drawer-chev {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
  }

  @media (min-width: 48rem) {
    .workspace-bar {
      --workspace-bar-height: 3.5rem;
    }

    .workspace-bar__inner {
      padding-block: var(--space-3);
      min-height: var(--workspace-bar-height);
    }

    .workspace-bar__home {
      width: 2.25rem;
      height: 2.25rem;
    }

    .workspace-bar__link,
    .workspace-bar__more {
      min-height: 2.25rem;
      padding: 0 var(--space-3);
    }
  }

  /* Lock body scroll when drawer open */
  :global(html.bar-drawer-open),
  :global(html.bar-drawer-open body) {
    overflow: hidden;
  }

  @media (min-width: 64rem) {
    .workspace-bar {
      display: none;
    }

    .workspace-rail {
      position: sticky;
      top: 0;
      align-self: flex-start;
      display: grid;
      grid-template-rows: auto auto 1fr auto;
      align-content: start;
      gap: var(--space-4);
      /* The rail is a control surface, not a sidebar: narrower than the
         old 17rem so it reads as an instrument edge bolted to the
         canvas, not as a second website. */
      width: 15rem;
      flex: 0 0 15rem;
      min-height: 100vh;
      padding: var(--space-5) 0 var(--space-4) var(--page-gutter);
      background: var(--color-canvas);
      color: var(--color-text-on-canvas);
      border-right: 1px solid var(--color-rule-on-canvas);
    }

    /* The brand stacks — mark, then name, then role — so nothing has
       to wrap in the narrower rail. It reads as an instrument's name
       plate, not a site header. */
    .workspace-rail__brand {
      display: grid;
      justify-items: start;
      gap: var(--space-3);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__brand-mark {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid var(--color-accent);
      color: var(--color-accent-text);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }

    .workspace-rail__brand-text {
      display: grid;
      gap: 2px;
      min-width: 0;
      width: 100%;
    }

    .workspace-rail__brand-name {
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .workspace-rail__brand-role {
      color: var(--color-text-on-canvas-muted);
      letter-spacing: 0.06em;
      white-space: nowrap;
    }

    .workspace-rail__header {
      display: grid;
      gap: var(--space-1);
      padding-bottom: var(--space-2);
    }

    .workspace-rail__heading {
      color: var(--color-text-on-canvas-muted);
    }

    .workspace-rail__path {
      color: var(--color-accent-text);
      white-space: nowrap;
    }

    .workspace-rail__nav {
      position: relative;
      display: grid;
      gap: var(--space-4);
      align-content: start;
      padding-left: var(--space-3);
    }

    .workspace-rail__progress {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--color-rule-on-canvas);
    }

    .workspace-rail__progress-fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 1px;
      height: 12%;
      background: var(--color-accent);
      transition: height var(--duration-reveal) var(--ease-emphasized);
    }

    @media (prefers-reduced-motion: reduce) {
      .workspace-rail__progress-fill {
        transition: none;
      }
    }

    .workspace-rail__list {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__item {
      border-bottom: 1px solid var(--color-rule-on-canvas);
    }

    /* Rows are compact index lines: number, name, edge. No captions,
       no wrapping — the caption layer lives in the mobile drawer. */
    .workspace-rail__link {
      display: grid;
      grid-template-columns: 1.75rem minmax(0, 1fr) auto;
      gap: var(--space-3);
      align-items: center;
      min-height: 2.75rem;
      padding: var(--space-2) 0;
      color: var(--color-text-on-canvas-muted);
      text-decoration: none;
      transition:
        color var(--duration-quick) var(--ease-standard),
        background-color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link:hover,
    .workspace-rail__link:focus-visible {
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__index {
      color: var(--color-accent-text);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
      transition: color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link:hover .workspace-rail__index,
    .workspace-rail__link:focus-visible .workspace-rail__index {
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__label {
      grid-column: 2;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .workspace-rail__chev {
      color: var(--color-accent-text);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity var(--duration-quick) var(--ease-standard),
        transform var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link:hover .workspace-rail__chev,
    .workspace-rail__link:focus-visible .workspace-rail__chev {
      opacity: 1;
      transform: translateX(0);
    }

    .workspace-rail__list--utilities .workspace-rail__chev {
      opacity: 1;
      transform: none;
      font-size: 0.75rem;
    }

    .workspace-rail__group-heading {
      color: var(--color-text-on-canvas-faint);
      padding-top: var(--space-2);
      border-top: 1px solid var(--color-rule-on-canvas-soft);
    }

    .workspace-rail__list--utilities .workspace-rail__link {
      min-height: 2.25rem;
    }

    /* ACTIVE — the rail's selected state borrows the lab's active-stage
       vocabulary: a copper edge, a copper index, full-contrast label,
       and a recessed ground. No wash, no chevron — one meaning. */
    .workspace-rail__link[aria-current] {
      color: var(--color-text-on-canvas);
      background: var(--color-canvas-inset);
      box-shadow: inset 2px 0 0 var(--color-accent);
    }

    .workspace-rail__link[aria-current] .workspace-rail__chev {
      opacity: 1;
      transform: translateX(0);
    }

    .workspace-rail__footer {
      display: grid;
      gap: var(--space-3);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__status {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-on-canvas-muted);
    }

    .workspace-rail__status-dot {
      width: 0.4375rem;
      height: 0.4375rem;
      background: var(--color-signal-pass);
      border-radius: 50%;
      animation: rail-status-pulse 3.6s var(--ease-standard) infinite;
    }

    @keyframes rail-status-pulse {
      0%,
      90%,
      100% {
        opacity: 1;
      }
      95% {
        opacity: 0.35;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .workspace-rail__status-dot {
        animation: none;
      }
    }

    .workspace-rail__contact {
      color: var(--color-text-on-canvas);
      align-self: start;
    }
  }
</style>
