---
/**
 * WorkspaceRail — the compact persistent navigation.
 *
 * Desktop: brand, four destinations, résumé and contact.
 * Phone: the same list in a native <details> disclosure, so the menu
 * opens and closes without JavaScript. Script only adds the comforts:
 * close on link activation, Escape, outside click, and re-close after
 * a client-side navigation.
 */
import { navItems, currentNavItem } from '../config/workspace';
import { SITE } from '../config/site';
const current = currentNavItem(Astro.url.pathname);
const primary = navItems.filter((item) => item.id !== 'home');
---
<header class="site-nav">
  <div class="site-nav__inner page-shell">
    <a href="/" class="site-brand" aria-label={`${SITE.name} — home`}>
      <span class="brand-mark" aria-hidden="true">SM</span>
      <span class="brand-name">{SITE.name}</span>
    </a>
    <nav class="site-nav__primary" aria-label="Main navigation">
      {primary.map((d) => (
        <a
          href={d.href}
          aria-current={current === d.id ? 'page' : undefined}
          target={d.external ? '_blank' : undefined}
          rel={d.external ? 'noopener' : undefined}
        >
          {d.label}
          {current === d.id && <span class="nav-indicator" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>
    <details class="menu">
      <summary class="menu__toggle">
        <span class="menu__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="menu__text">Menu</span>
      </summary>
      <nav class="menu__panel" aria-label="Main navigation">
        {navItems.map((d) => (
          <a
            href={d.href}
            aria-current={current === d.id ? 'page' : undefined}
            target={d.external ? '_blank' : undefined}
            rel={d.external ? 'noopener' : undefined}
          >
            <span>{d.label}</span>
            {current === d.id && <span class="nav-indicator" aria-hidden="true"></span>}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const init = () => {
    const menu = document.querySelector<HTMLDetailsElement>('details.menu');
    if (!menu) return;

    const close = (restoreFocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (restoreFocus) menu.querySelector('summary')?.focus();
    };

    if (menu.dataset.ready !== '1') {
      menu.dataset.ready = '1';
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => close());
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close(true);
      });
      document.addEventListener('click', (event) => {
        if (menu.open && !menu.contains(event.target as Node)) close();
      });
    }
    close();
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-paper-raised);
    background: color-mix(in srgb, var(--color-paper-raised) 92%, transparent);
    border-bottom: 1px solid var(--color-rule);
    backdrop-filter: blur(10px);
  }
  .site-nav__inner {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
    transition: color var(--duration-quick) var(--ease-standard);
  }
  .site-brand:hover {
    color: var(--color-copper-text);
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-rule-strong);
    font-family: var(--font-instrument);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    color: var(--color-teal);
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .site-nav__primary {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .site-nav__primary a {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color var(--duration-quick) var(--ease-standard);
  }
  .site-nav__primary a:hover,
  .site-nav__primary a[aria-current='page'] {
    color: var(--color-copper-text);
  }
  .nav-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    margin-top: 2px;
  }

  /* ---- phone menu ------------------------------------------- */
  .menu {
    display: none;
  }
  .menu__toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    margin-right: -0.6rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-instrument);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .menu__toggle::-webkit-details-marker {
    display: none;
  }
  .menu__bars {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu__bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--duration-quick) var(--ease-standard);
  }
  .menu[open] .menu__bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu[open] .menu__bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .menu[open] .menu__text {
    color: var(--color-copper-text);
  }

  /* The panel is positioned against the header, so it always spans
     exactly the viewport — no negative-offset arithmetic at narrow
     widths. Chrome lays out closed <details> content with
     `content-visibility: hidden`, so the panel is explicitly removed
     from layout while closed. */
  .menu:not([open]) .menu__panel {
    display: none;
  }
  .menu__panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    padding: 0.5rem var(--page-gutter) 1rem;
    background: var(--color-paper-raised);
    border-bottom: 1px solid var(--color-rule);
    box-shadow: 0 18px 30px -26px rgba(23, 26, 27, 0.5);
    display: grid;
  }
  .menu__panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 52px;
    padding-inline: 0.15rem;
    border-bottom: 1px solid var(--color-rule-soft);
    text-decoration: none;
    font-size: 1.05rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }
  .menu__panel a:last-child {
    border-bottom: 0;
  }
  .menu__panel a[aria-current='page'] {
    color: var(--color-copper-text);
  }

  @media (max-width: 800px) {
    .site-nav__primary {
      display: none;
    }
    .menu {
      display: block;
    }
    .site-nav__inner {
      min-height: 58px;
    }
  }

  @media (max-width: 26rem) {
    .brand-name {
      font-size: 1rem;
    }
    .menu__text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__bars i {
      transition: none;
    }
  }
</style>
