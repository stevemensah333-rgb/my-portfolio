---
/**
 * WorkspaceRail — the persistent control surface of the workspace.
 *
 * It is one component with two forms, not two navigations:
 *
 *   DESKTOP (>= 64rem)  a narrow vertical rail bolted to the left
 *                       edge of the field. It is a control surface,
 *                       not a second column of content: an index of
 *                       destinations, a separation for the two
 *                       utilities, and a state readout.
 *
 *   MOBILE  (< 64rem)   a compact control at the head of the page —
 *                       brand, current destination, and a disclosure
 *                       that opens the full list. It is not a shrunken
 *                       rail: one bar, one control, one panel.
 *
 * Both forms read from `config/workspace.ts`, so adding a destination
 * means editing one list. "Current" is derived from the route and set
 * at render time (`aria-current="page"`), so it is correct without
 * JavaScript and on first paint.
 *
 * The disclosure uses native <details>/<summary>: it opens, closes and
 * is keyboard-operable with no script at all. The script below only
 * enhances it (Escape, outside click, resizing to the rail form).
 */
import {
  primaryDestinations,
  utilityDestinations,
  destinationForPath,
  type Destination,
} from '../config/workspace';

const currentId = destinationForPath(Astro.url.pathname);
const current = primaryDestinations.find((dest) => dest.id === currentId) ?? null;
const total = String(primaryDestinations.length).padStart(2, '0');

const destHref = (dest: Destination) => dest.href;
const isCurrent = (dest: Destination) => dest.id === currentId;
---

<div class="workspace-chrome">
<!-- ================= DESKTOP: the rail ================= -->
<aside class="workspace-rail" data-workspace-rail>
  <a class="workspace-rail__brand" href="/" aria-label="Stephen Mensah — home">
    <span class="workspace-rail__mark" aria-hidden="true">SM</span>
    <span class="workspace-rail__name">Stephen Mensah</span>
  </a>

  <nav class="workspace-rail__nav" aria-label="Primary destinations">
    <ol class="workspace-rail__list">
      {
        primaryDestinations.map((dest) => (
          <li>
            <a
              class="workspace-rail__link"
              href={destHref(dest)}
              aria-current={isCurrent(dest) ? 'page' : undefined}
            >
              <span class="workspace-rail__index" aria-hidden="true">{dest.index}</span>
              <span class="workspace-rail__label">{dest.label}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="workspace-rail__caption">Utilities</p>

    <ol class="workspace-rail__list workspace-rail__list--utilities">
      {
        utilityDestinations.map((dest) => (
          <li>
            <a
              class="workspace-rail__link"
              href={destHref(dest)}
              target={dest.external ? '_blank' : undefined}
              rel={dest.external ? 'noopener noreferrer' : undefined}
            >
              <span class="workspace-rail__index" aria-hidden="true">{dest.index}</span>
              <span class="workspace-rail__label">{dest.label}</span>
              <span class="workspace-rail__mark-ext" aria-hidden="true">
                {dest.external ? '↗' : '→'}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="workspace-rail__state">
    <p class="workspace-rail__readout">
      <span class="workspace-rail__readout-index">{current ? `${current.index} / ${total}` : '— / —'}</span>
      <span class="workspace-rail__readout-section" data-rail-section></span>
    </p>
    <p class="workspace-rail__status">
      <span class="workspace-rail__dot" aria-hidden="true"></span>
      Open to AI engineering roles
    </p>
  </div>
</aside>

<!-- ================= MOBILE: the control ================= -->
<header class="workspace-control">
  <div class="workspace-control__bar">
    <a class="workspace-control__brand" href="/" aria-label="Stephen Mensah — home">
      <span class="workspace-control__mark" aria-hidden="true">SM</span>
      <span class="workspace-control__name">Stephen Mensah</span>
    </a>

    <p class="workspace-control__state">
      <span class="workspace-control__state-index" aria-hidden="true">
        {current ? current.index : '—'}
      </span>
      <span class="workspace-control__state-label">{current ? current.label : 'Workspace'}</span>
    </p>

    <details class="workspace-control__disclosure" data-workspace-menu>
      <summary class="workspace-control__toggle">
        <span class="workspace-control__toggle-label">Destinations</span>
        <span class="workspace-control__toggle-mark" aria-hidden="true"></span>
      </summary>

      <nav class="workspace-control__panel" aria-label="All destinations">
        <ol class="workspace-control__list">
          {
            primaryDestinations.map((dest) => (
              <li>
                <a
                  class="workspace-control__link"
                  href={destHref(dest)}
                  aria-current={isCurrent(dest) ? 'page' : undefined}
                >
                  <span class="workspace-control__index" aria-hidden="true">{dest.index}</span>
                  <span class="workspace-control__text">
                    <span class="workspace-control__link-label">{dest.label}</span>
                    <span class="workspace-control__link-note">{dest.description}</span>
                  </span>
                  <span class="workspace-control__chev" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ol>

        <p class="workspace-control__caption">Utilities</p>

        <ol class="workspace-control__list">
          {
            utilityDestinations.map((dest) => (
              <li>
                <a
                  class="workspace-control__link"
                  href={destHref(dest)}
                  target={dest.external ? '_blank' : undefined}
                  rel={dest.external ? 'noopener noreferrer' : undefined}
                >
                  <span class="workspace-control__index" aria-hidden="true">{dest.index}</span>
                  <span class="workspace-control__text">
                    <span class="workspace-control__link-label">{dest.label}</span>
                    <span class="workspace-control__link-note">{dest.description}</span>
                  </span>
                  <span class="workspace-control__chev" aria-hidden="true">
                    {dest.external ? '↗' : '→'}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </details>
  </div>
</header>
</div>

<script>
  /* --- Enhancements only ------------------------------------------
     The navigation itself is markup: real links, a real disclosure,
     aria-current set at render. Nothing here is required for it to
     work.

     The ClientRouter swaps the shell on client-side navigations but
     bundled module scripts execute once per full page load, so this
     init is re-run on `astro:page-load` (which also fires on initial
     load). The `data-*-enhanced` markers keep it idempotent, and the
     run-scoped AbortController tears down the previous generation's
     document/window-scoped listeners so nothing accumulates. */

  let teardown: (() => void) | null = null;
  let sectionObserver: IntersectionObserver | null = null;

  const init = () => {
    const chrome = document.querySelector<HTMLElement>('.workspace-chrome');
    if (!chrome || chrome.dataset.chromeEnhanced === '1') return;
    chrome.dataset.chromeEnhanced = '1';

    teardown?.();
    sectionObserver?.disconnect();
    sectionObserver = null;
    const events = new AbortController();
    teardown = () => events.abort();

    /* 1. State readout — where the visitor is inside the current page.
          Sections opt in with `data-workspace-section` and may publish
          a human label with `data-workspace-label`. */
    const railSection = document.querySelector<HTMLElement>('[data-rail-section]');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('main [data-workspace-section]'));

    if (railSection && sections.length > 1) {
      sectionObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          const target = visible.target as HTMLElement;
          const label = target.dataset.workspaceLabel ?? target.dataset.workspaceSection ?? '';
          if (label) railSection.textContent = `Section · ${label}`;
        },
        { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      sections.forEach((section) => sectionObserver!.observe(section));
    }

    /* 2. Mobile disclosure — Escape, outside click, and closing when
          the viewport grows into the rail form. */
    const menu = document.querySelector<HTMLDetailsElement>('[data-workspace-menu]');

    if (menu) {
      const railQuery = window.matchMedia('(min-width: 64rem)');
      const background = [
        ...document.querySelectorAll<HTMLElement>('main, body > footer, [data-workspace-rail]'),
      ];

      const setOpen = (open: boolean) => {
        menu.open = open;
      };

      menu.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('a')) setOpen(false);
      }, { signal: events.signal });

      document.addEventListener('click', (event) => {
        if (!menu.open) return;
        const target = event.target as HTMLElement;
        if (!target.closest('[data-workspace-menu]')) setOpen(false);
      }, { signal: events.signal });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          setOpen(false);
          menu.querySelector<HTMLElement>('summary')?.focus();
        }
      }, { signal: events.signal });

      // Keep the page behind the open panel out of the tab order.
      const syncBackground = () => {
        background.forEach((element) => {
          element.inert = menu.open;
        });
      };
      menu.addEventListener('toggle', syncBackground, { signal: events.signal });
      railQuery.addEventListener('change', () => setOpen(false), { signal: events.signal });
      syncBackground();
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* ============================================================
     SHARED
     The rail and the control are the same surface in two forms:
     deep charcoal (DARK = INSTRUMENTATION), because both are
     controls rather than reading material.

     `.workspace-chrome` is the single child of the shell, so the
     desktop grid never gains a ghost column from the unused form.
     ============================================================ */

  .workspace-chrome {
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
  }

  .workspace-rail,
  .workspace-control {
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
  }

  /* ============================================================
     MOBILE / TABLET — the compact control (< 64rem)
     One bar: brand · current destination · disclosure.
     Not a shrunken rail.
     ============================================================ */

  .workspace-chrome {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
  }

  .workspace-rail {
    display: none;
  }

  .workspace-control {
    position: relative;
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-control__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    width: min(100%, calc(var(--width-page) + (2 * var(--page-gutter))));
    min-height: var(--shell-control);
    margin-inline: auto;
    padding: var(--space-2) var(--page-gutter);
  }

  .workspace-control__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--color-text-on-canvas);
    text-decoration: none;
  }

  .workspace-control__mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-rule-on-canvas-strong);
    color: var(--color-text-on-canvas);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.04em;
  }

  .workspace-control__name {
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* At 375px the name collides with the state readout. The mark
     keeps the brand; the link's aria-label names it. */
  @media (max-width: 29.99rem) {
    .workspace-control__name {
      display: none;
    }
  }

  /* The current destination is always visible, so the control shows
     state even while it is closed. */
  .workspace-control__state {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .workspace-control__state-index {
    color: var(--color-accent-text);
  }

  /* Static so the open panel positions against `.workspace-control`,
     not against the summary's narrow box. */
  .workspace-control__disclosure {
    position: static;
  }

  .workspace-control__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-rule-on-canvas-strong);
    color: var(--color-text-on-canvas);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
    transition:
      border-color var(--duration-quick) var(--ease-standard),
      color var(--duration-quick) var(--ease-standard);
  }

  .workspace-control__toggle::-webkit-details-marker {
    display: none;
  }

  .workspace-control__toggle:hover,
  .workspace-control__toggle:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  /* A two-bar mark that becomes a single bar when the panel is open.
     One control, two states, no icon set. */
  .workspace-control__toggle-mark {
    position: relative;
    width: 0.75rem;
    height: 0.5rem;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transition: height var(--duration-quick) var(--ease-standard);
  }

  .workspace-control__disclosure[open] .workspace-control__toggle-mark {
    height: 0;
    border-bottom: 0;
  }

  .workspace-control__panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 2;
    max-height: calc(100vh - var(--shell-control) - 0.5rem);
    padding: var(--space-4) var(--page-gutter) var(--space-5);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck);
    box-shadow: 0 1.25rem 2rem rgb(0 0 0 / 40%);
  }

  .workspace-control__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .workspace-control__caption {
    margin: var(--space-4) 0 0;
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .workspace-control__list:last-child {
    margin-top: var(--space-2);
  }

  .workspace-control__link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-3);
    min-height: 3rem;
    padding: var(--space-3) var(--space-2) var(--space-3) var(--space-1);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    color: var(--color-text-on-canvas);
    text-decoration: none;
    transition:
      color var(--duration-quick) var(--ease-standard),
      background-color var(--duration-quick) var(--ease-standard);
  }

  .workspace-control__index {
    padding-top: 0.1em;
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.04em;
  }

  .workspace-control__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .workspace-control__link-label {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* CONTENT role: a description is prose, not instrument metadata. */
  .workspace-control__link-note {
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .workspace-control__chev {
    padding-top: 0.1em;
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-instrument);
  }

  .workspace-control__link:hover,
  .workspace-control__link:focus-visible {
    color: var(--color-accent-text);
  }

  .workspace-control__link:hover .workspace-control__chev,
  .workspace-control__link:focus-visible .workspace-control__chev {
    color: var(--color-accent-text);
  }

  /* ACTIVE / SELECTED — the same treatment as the rail: an orange
     leading edge, an orange index, full-contrast label. */
  .workspace-control__link[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--color-accent);
    padding-left: var(--space-3);
  }

  .workspace-control__link[aria-current='page'] .workspace-control__index {
    color: var(--color-accent-text);
  }

  @media (min-width: 40rem) {
    .workspace-control__panel {
      left: auto;
      right: var(--page-gutter);
      width: min(24rem, calc(100% - (2 * var(--page-gutter))));
      border: 1px solid var(--color-rule-on-canvas-strong);
      border-top: 1px solid var(--color-rule-on-canvas-strong);
    }
  }

  @media (max-width: 29.99rem) {
    .workspace-control__toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .workspace-control__toggle {
      padding: 0;
      width: 2.25rem;
      justify-content: center;
    }
  }

  /* ============================================================
     DESKTOP — the rail (>= 64rem)
     Narrow on purpose. It carries navigation, control and state;
     the content it points at lives in the field beside it.
     ============================================================ */

  @media (min-width: 64rem) {
    .workspace-chrome {
      position: sticky;
      top: 0;
      align-self: start;
      z-index: auto;
      width: var(--shell-rail);
      min-height: 100vh;
      border-right: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-control {
      display: none;
    }

    .workspace-rail {
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: var(--space-5);
      width: 100%;
      min-height: 100vh;
      padding: var(--space-5) 0 var(--space-5);
    }

    /* Name plate, stacked: mark then name. Architectural rather
       than a site header squeezed into a column. */
    .workspace-rail__brand {
      display: grid;
      justify-items: start;
      gap: var(--space-3);
      padding: 0 var(--space-4) var(--space-5);
      border-bottom: 1px solid var(--color-rule-on-canvas);
      color: var(--color-text-on-canvas);
      text-decoration: none;
      transition: color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__brand:hover {
      color: var(--color-accent-text);
    }

    .workspace-rail__mark {
      display: grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
      border: 1px solid var(--color-rule-on-canvas-strong);
      color: var(--color-text-on-canvas);
      font-family: var(--font-instrument);
      font-size: var(--text-instrument-sm);
      letter-spacing: 0.04em;
    }

    .workspace-rail__name {
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .workspace-rail__nav {
      display: grid;
      align-content: start;
      gap: var(--space-4);
      padding: 0 var(--space-4);
    }

    .workspace-rail__list {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__list li {
      border-bottom: 1px solid var(--color-rule-on-canvas);
    }

    /* An index line: number, name, optional external mark. No
       captions, no wrapping — the caption layer lives in the mobile
       panel. */
    .workspace-rail__link {
      position: relative;
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-3);
      min-height: 2.5rem;
      padding-right: var(--space-1);
      color: var(--color-text-on-canvas-muted);
      text-decoration: none;
      transition:
        color var(--duration-quick) var(--ease-standard),
        background-color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__link::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--space-4) * -1);
      width: 2px;
      background: var(--color-accent);
      opacity: 0;
      transition: opacity var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__index {
      color: var(--color-text-on-canvas-faint);
      font-family: var(--font-instrument);
      font-size: var(--text-instrument-sm);
      letter-spacing: 0.04em;
      transition: color var(--duration-quick) var(--ease-standard);
    }

    .workspace-rail__label {
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .workspace-rail__mark-ext {
      color: var(--color-text-on-canvas-faint);
      font-family: var(--font-instrument);
      font-size: 0.75rem;
    }

    .workspace-rail__link:hover,
    .workspace-rail__link:focus-visible {
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__link:hover .workspace-rail__index,
    .workspace-rail__link:focus-visible .workspace-rail__index {
      color: var(--color-accent-text);
    }

    /* ACTIVE / SELECTED — orange edge, orange index, full-contrast
       label, recessed ground. Four signals, one meaning. */
    .workspace-rail__link[aria-current='page'] {
      background: var(--color-deck-inset);
      color: var(--color-text-on-canvas);
    }

    .workspace-rail__link[aria-current='page']::before {
      opacity: 1;
    }

    .workspace-rail__link[aria-current='page'] .workspace-rail__index {
      color: var(--color-accent-text);
    }

    .workspace-rail__caption {
      margin: 0;
      color: var(--color-text-on-canvas-faint);
      font-family: var(--font-instrument);
      font-size: var(--text-instrument-sm);
      letter-spacing: var(--tracking-instrument);
      text-transform: uppercase;
    }

    /* STATE — the rail reports where the visitor is and what is
       open. Instrument type: this is a readout, not prose. */
    .workspace-rail__state {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-4) 0;
      border-top: 1px solid var(--color-rule-on-canvas);
    }

    .workspace-rail__readout {
      display: grid;
      gap: 2px;
      margin: 0;
      font-family: var(--font-instrument);
      font-size: var(--text-instrument-sm);
      letter-spacing: var(--tracking-instrument);
      text-transform: uppercase;
    }

    .workspace-rail__readout-index {
      color: var(--color-accent-text);
    }

    /* Reserved so the state block does not shift when the observer
       first reports a section. */
    .workspace-rail__readout-section {
      min-height: 1em;
      color: var(--color-text-on-canvas-faint);
    }

