---
import { primaryDestinations, destinationForPath, utilityDestinations } from '../config/workspace';
const current = destinationForPath(Astro.url.pathname);
---
<header class="site-nav">
  <div class="site-nav__inner page-shell">
    <a class="site-brand" href="/" aria-label="Stephen Mensah — home"><span class="brand-mark" aria-hidden="true">sm<span>↗</span></span><span>Stephen Mensah<span class="brand-sub">Software engineer</span></span></a>
    <nav aria-label="Main navigation">
      {primaryDestinations.filter(d=>d.id!=='home').map(d=><a href={d.href} aria-current={current===d.id?'page':undefined}>{d.id==='profile'?'About':d.label}<span class="nav-dot" aria-hidden="true"></span></a>)}
    </nav>
    <div class="nav-utilities">{utilityDestinations.map(d=><a href={d.href} target={d.external?'_blank':undefined} rel={d.external?'noopener':undefined}>{d.label}<span aria-hidden="true">↗</span></a>)}</div>
  </div>
</header>
<style>
.site-nav{position:sticky;top:0;z-index:50;background:#f4f0e6f5;border-bottom:1px solid var(--rule);backdrop-filter:blur(12px)}.site-nav__inner{min-height:80px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.site-brand{display:flex;align-items:center;gap:.8rem;text-decoration:none;font-size:.9rem;font-weight:600;line-height:1.4}.brand-mark{position:relative;font-family:var(--font-display);font-size:2rem;font-weight:650;letter-spacing:-.1em;padding-right:.5rem}.brand-mark>span{position:absolute;right:-.1rem;top:-.4rem;font:1rem var(--font-content);color:var(--color-accent-text)}.brand-sub{display:block;color:var(--color-text-on-paper-faint);font-size:.7rem;font-weight:400}.site-nav nav,.nav-utilities{display:flex;gap:1.8rem;align-items:center}.site-nav nav>a,.nav-utilities a{min-height:44px;display:flex;align-items:center;gap:.5rem;text-decoration:none;font-size:.85rem}.nav-utilities a:last-child{color:var(--color-accent-text)}.nav-dot{width:5px;height:5px;border-radius:50%;background:currentColor;visibility:hidden}a[aria-current] .nav-dot{visibility:visible}a[aria-current]{color:var(--color-accent-text)}.site-nav a:hover{color:var(--color-accent-text)}
@media(max-width:700px){.site-nav__inner{flex-wrap:wrap;gap:0 1rem;padding-block:.6rem;min-height:90px}.site-brand{font-size:.8rem}.brand-sub{display:none}.site-nav nav{order:3;width:100%;justify-content:center;gap:2rem;border-top:1px solid var(--rule);margin-top:.4rem}.nav-utilities{gap:1rem}.nav-utilities a{font-size:.75rem}.site-nav nav>a{min-height:36px}.brand-mark{font-size:1.7rem}}
</style>
