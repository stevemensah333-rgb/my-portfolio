---
/**
 * ParticlePortrait — the portfolio's single particle surface, enhanced.
 *
 * Interaction design (selected as meaningful):
 * - Reveals structure: portrait is made of data blocks sampled from real image.
 * - Reveals state: in-place (ink) vs displaced (amber = out of place).
 * - Reveals transformation: pointer displaces, spring recovers.
 * - Pointer-responsive: subtle when idle (no movement), displacement only within 64px radius.
 * - Touch fallback: tap triggers brief scatter then recovery — no hover needed.
 * - Reduced-motion fallback: static <img> remains, canvas hidden.
 * - Never obstructs reading: canvas is aria-hidden, pointer-events none, readout below.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Optional responsive WebP sources for the same portrait. */
  srcset?: string;
  sizes?: string;
}

const { src, alt, width, height, srcset, sizes } = Astro.props;
---

<div class="pportrait" data-particle-portrait>
  <picture>
    {srcset && <source type="image/webp" {srcset} {sizes} />}
    <img
      class="pportrait__img"
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      data-portrait-img
    />
  </picture>
  <canvas class="pportrait__canvas" data-portrait-canvas aria-hidden="true" hidden></canvas>
  <p class="pportrait__readout mono-label" data-portrait-readout aria-live="polite">
    <span data-readout-blocks>—</span>
    <span aria-hidden="true">·</span>
    <span data-readout-state>static image</span>
  </p>
</div>

<script>
  type Particle = {
    hx: number; hy: number;
    x: number; y: number;
    vx: number; vy: number;
    s: number;
    g: number;
  };

  /* Canvas cannot read CSS custom properties, so the ramp is
     mirrored here by hand. These are the sheet/deck greys and the
     copper accent from global.css §2 — keep them in sync if the
     palette moves. */
  const INK = ['#DAD2BD', '#A8A18E', '#7E7660', '#3D4349', '#15181C'];
  const ACCENT = '#C2632F';

  /* Re-initializes on `astro:page-load` (the ClientRouter swaps the
     shell without re-running bundled scripts); markers keep it
     idempotent and the run-scoped AbortController removes the previous
     run's document/media-query listeners and disconnects observers. */
  let teardown: (() => void) | null = null;

  const init = () => {
    const roots = [...document.querySelectorAll<HTMLElement>('[data-particle-portrait]')]
      .filter((root) => root.dataset.pportraitEnhanced !== '1');
    if (roots.length === 0) return;
    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();
    const signal = events.signal;

  for (const root of roots) {
    root.dataset.pportraitEnhanced = '1';
    const img = root.querySelector<HTMLImageElement>('[data-portrait-img]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-portrait-canvas]');
    const readoutBlocks = root.querySelector<HTMLElement>('[data-readout-blocks]');
    const readoutState = root.querySelector<HTMLElement>('[data-readout-state]');
    if (!img || !canvas) continue;

    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarseQuery = window.matchMedia('(pointer: coarse)');
    if (reducedQuery.matches) {
      if (readoutBlocks) readoutBlocks.textContent = '—';
      if (readoutState) readoutState.textContent = 'static image · reduced motion';
      continue;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) continue;

    let particles: Particle[] = [];
    let pointer: { x: number; y: number } | null = null;
    let looping = false;
    let raf = 0;
    let built = false;
    let visible = false;
    let cssWidth = 0;
    let cssHeight = 0;
    let displacedCount = 0;

    const STOP_SPEED = 0.02;

    // The readout reports discrete states, not per-frame telemetry: it
    // only touches the DOM when its text actually changes, so the live
    // region stays quiet during motion and the loop does no layout work.
    const setText = (el: HTMLElement | null, text: string) => {
      if (el && el.textContent !== text) el.textContent = text;
    };

    const updateReadout = () => {
      if (!readoutBlocks || !readoutState) return;
      const blocks = built ? `${particles.length} data blocks` : '—';
      const state = !built
        ? 'static image'
        : pointer
          ? 'displaced · amber = out of place'
          : displacedCount > 0
            ? 'recovering'
            : 'in place · move pointer to displace';
      setText(readoutBlocks, blocks);
      setText(readoutState, state);
    };

    const draw = () => {
      ctx.clearRect(0, 0, cssWidth, cssHeight);
      displacedCount = 0;
      for (let g = 0; g < INK.length; g += 1) {
        ctx.fillStyle = INK[g] ?? '#15181C';
        for (const p of particles) {
          if (p.g !== g) continue;
          const displaced = Math.abs(p.x - p.hx) + Math.abs(p.y - p.hy) > 1.5;
          if (displaced) {
            displacedCount += 1;
            continue;
          }
          ctx.fillRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s);
        }
      }
      ctx.fillStyle = ACCENT;
      for (const p of particles) {
        if (Math.abs(p.x - p.hx) + Math.abs(p.y - p.hy) <= 1.5) continue;
        ctx.fillRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s);
      }
    };

    const step = () => {
      const coarse = coarseQuery.matches;
      const radius = coarse ? 88 : 64;
      const r2 = radius * radius;
      for (const p of particles) {
        if (pointer) {
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < r2 && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const force = (1 - d / radius) * (coarse ? 2.4 : 1.9);
            p.vx += (dx / d) * force;
            p.vy += (dy / d) * force;
          }
        }
        p.vx += (p.hx - p.x) * 0.055;
        p.vy += (p.hy - p.y) * 0.055;
        p.vx *= 0.8;
        p.vy *= 0.8;
        p.x += p.vx;
        p.y += p.vy;
      }
    };

    const settled = () => {
      if (pointer) return false;
      for (const p of particles) {
        if (Math.abs(p.vx) + Math.abs(p.vy) > STOP_SPEED) return false;
        if (Math.abs(p.x - p.hx) + Math.abs(p.y - p.hy) > 0.5) return false;
      }
      return true;
    };

    const frame = () => {
      step();
      draw();
      updateReadout();
      if (visible && !settled()) {
        raf = requestAnimationFrame(frame);
      } else {
        looping = false;
        updateReadout();
      }
    };

    const kick = () => {
      if (looping || !built || !visible || document.hidden) return;
      looping = true;
      raf = requestAnimationFrame(frame);
    };

    const build = () => {
      if (img.naturalWidth === 0) return;
      const rect = root.getBoundingClientRect();
      cssWidth = Math.max(1, Math.round(rect.width));
      cssHeight = Math.max(1, Math.round(rect.height));
      if (cssWidth < 40 || cssHeight < 40) return;

      const coarse = coarseQuery.matches;
      const maxParticles = coarse ? 1200 : 2600;
      let cell = coarse ? 6 : 4;
      let cols = Math.max(8, Math.floor(cssWidth / cell));
      let rows = Math.max(8, Math.floor(cssHeight / cell));
      while (cols * rows > maxParticles && cell < 16) {
        cell += 1;
        cols = Math.max(8, Math.floor(cssWidth / cell));
        rows = Math.max(8, Math.floor(cssHeight / cell));
      }

      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const octx = off.getContext('2d', { willReadFrequently: true });
      if (!octx) return;
      octx.drawImage(img, 0, 0, cols, rows);
      let data: Uint8ClampedArray;
      try {
        data = octx.getImageData(0, 0, cols, rows).data;
      } catch {
        return;
      }

      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(cssWidth * dpr);
      canvas.height = Math.round(cssHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const next: Particle[] = [];
      for (let ry = 0; ry < rows; ry += 1) {
        for (let rx = 0; rx < cols; rx += 1) {
          const i = (ry * cols + rx) * 4;
          const a = data[i + 3] ?? 0;
          const r = data[i] ?? 255;
          const g = data[i + 1] ?? 255;
          const b = data[i + 2] ?? 255;
          if (a < 8) continue;
          const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
          if (lum > 0.87) continue;
          const ink = 1 - lum;
          const bucket = Math.min(INK.length - 1, Math.floor(ink * INK.length));
          const size = cell * Math.min(1, Math.max(0.18, 1.08 - lum));
          const hx = (rx + 0.5) * (cssWidth / cols);
          const hy = (ry + 0.5) * (cssHeight / rows);
          next.push({ hx, hy, x: hx, y: hy, vx: 0, vy: 0, s: size, g: bucket });
        }
      }
      if (next.length === 0) return;

      particles = next;
      built = true;
      canvas.hidden = false;
      root.dataset.resolved = 'true';
      draw();
      updateReadout();
    };

    const startWhenReady = () => {
      if (built || reducedQuery.matches) return;
      const ready = () => {
        if (img.naturalWidth > 0) build();
      };
      if (img.complete) ready();
      else img.addEventListener('load', ready, { once: true });
      img.addEventListener('error', () => { built = false; }, { once: true });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible = entry.isIntersecting;
          if (visible && !built) startWhenReady();
          if (visible) kick();
          else if (looping) {
            cancelAnimationFrame(raf);
            looping = false;
          }
        }
      },
      { rootMargin: '160px' },
    );
    observer.observe(root);
    events.signal.addEventListener('abort', () => observer.disconnect(), { once: true });

    // pointer — subtle, reveals state (amber = displaced)
    root.addEventListener('pointermove', (event) => {
      if (!built) return;
      const rect = root.getBoundingClientRect();
      pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      kick();
    });

    // touch fallback: tap scatters then recovers
    let touchTimer = 0;
    root.addEventListener('pointerdown', (event) => {
      if (!built) return;
      const rect = root.getBoundingClientRect();
      pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      kick();
      if (coarseQuery.matches) {
        clearTimeout(touchTimer);
        touchTimer = window.setTimeout(() => {
          pointer = null;
          kick();
        }, 900) as unknown as number;
      }
    });

    root.addEventListener('pointerleave', () => {
      pointer = null;
      kick();
    });
    root.addEventListener('pointercancel', () => {
      pointer = null;
      kick();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && looping) {
        cancelAnimationFrame(raf);
        looping = false;
      } else if (!document.hidden) {
        kick();
      }
    }, { signal });

    let resizeTimer = 0;
    const resizeObserver = new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (reducedQuery.matches) return;
        built = false;
        startWhenReady();
      }, 160) as unknown as number;
    });
    resizeObserver.observe(root);
    events.signal.addEventListener('abort', () => {
      window.clearTimeout(resizeTimer);
      resizeObserver.disconnect();
    }, { once: true });

    reducedQuery.addEventListener('change', (event) => {
      if (event.matches) {
        cancelAnimationFrame(raf);
        looping = false;
        built = false;
        canvas.hidden = true;
        delete root.dataset.resolved;
        if (readoutBlocks) readoutBlocks.textContent = '—';
        if (readoutState) readoutState.textContent = 'static image · reduced motion';
        observer.disconnect();
        resizeObserver.disconnect();
      }
    }, { signal });

    // initial readout
    updateReadout();
  }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .pportrait {
    position: relative;
    width: 100%;
    display: grid;
    gap: var(--space-2);
  }

  .pportrait__img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.05);
    transition: opacity var(--duration-reveal) var(--ease-standard);
  }

  .pportrait[data-resolved='true'] .pportrait__img {
    opacity: 0;
  }

  .pportrait__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pportrait__readout {
    justify-self: start;
    color: var(--color-text-on-paper-muted);
    font-size: 0.625rem;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard);
    pointer-events: none;
  }

  .pportrait:hover .pportrait__readout,
  .pportrait:focus-within .pportrait__readout {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: none) {
    .pportrait__readout {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pportrait__img {
      transition: none;
      opacity: 1;
    }

    .pportrait__canvas {
      display: none;
    }

    .pportrait__readout {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  :global(html:not(.js)) .pportrait__readout {
    display: none;
  }
</style>
