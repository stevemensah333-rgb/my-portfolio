---
import ScenarioLab from '../components/ScenarioLab.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, pageMeta } from '../config/site';

const { title, description, image, imageAlt } = pageMeta.lab;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Reliability Lab',
  description,
  url: new URL('/lab/', Astro.site).href,
  author: {
    '@type': 'Person',
    name: SITE.name,
    url: new URL('/', Astro.site).href,
  },
};
---

<BaseLayout {title} {description} {structuredData} {image} {imageAlt}>
  <ScenarioLab />
</BaseLayout>
