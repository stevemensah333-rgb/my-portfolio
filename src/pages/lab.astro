---
import ReliabilityLab from '../components/ReliabilityLab.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Reliability Lab — One payload, seven stages | Stephen Mensah';
const description =
  'Inspect the Syncareer request contract, validation rules, refusal path and output fixtures in a seven-stage Reliability Lab. Illustrative payloads are labelled; the case study remains the canonical explanation.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Reliability Lab',
  description,
  url: new URL('/lab/', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
};
---

<BaseLayout {title} {description} {structuredData}>
  <ReliabilityLab />
</BaseLayout>
