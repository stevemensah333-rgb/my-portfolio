---
import ScenarioLab from '../components/ScenarioLab.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Reliability Lab — one rewrite, five checks | Stephen Mensah';
const description =
  'An illustrative, deterministic demonstration: one CV bullet followed through the context a request carries, an answer that context cannot support, the gate that refuses it, a cited proposal that passes, and the person who still decides. Fixtures and local checks only — no model call, no captured incident, no measured result.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Reliability Lab',
  description,
  url: new URL('/lab/', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
};
---

<BaseLayout {title} {description} {structuredData}>
  <ScenarioLab />
</BaseLayout>
