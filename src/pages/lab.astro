---
import ReliabilityLab from '../components/ReliabilityLab.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Reliability Lab — One payload, seven stages | Stephen Mensah';
const description =
  'Inspect one Syncareer payload across seven stages: the request contract, validation rules, refusal, diagnosis, intervention, and labelled output fixtures. Before/after shows documented contract shapes and fixtures, not a captured run.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Reliability Lab',
  description,
  url: new URL('/lab/', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
};
---

<BaseLayout {title} {description} {structuredData}>
  <ReliabilityLab />
</BaseLayout>
