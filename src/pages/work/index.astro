---
/**
 * /work/ — the archive.
 *
 * Distinct from the homepage: the homepage argues that the work exists
 * and tells one project's story. This page is a register. Three projects
 * in three release states, one structure each, so they can be compared
 * at a glance and opened in a single click.
 *
 * The composition is short on purpose: a compact opener, then the three
 * entries. Syncareer is prominent by scale — wider object, larger type,
 * heavier rule — without changing the structure the other two use.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkEntry from '../../components/work/WorkEntry.astro';
import { pageMeta } from '../../config/site';

const { title, description, image, imageAlt } = pageMeta.work;
---

<BaseLayout {title} {description} {image} {imageAlt}>
  <section class="archive page-shell" aria-labelledby="archive-title">
    <header class="archive__head">
      <p class="eyebrow motion-rise" style="--i: 0">The workbench / Three projects</p>
      <div class="archive__head-grid">
        <h1 id="archive-title" class="motion-rise" style="--i: 1">
          Built to be<br /><em>looked into.</em>
        </h1>
        <div class="archive__head-note motion-rise" style="--i: 2">
          <p class="lead">
            Open any project for the decisions behind it. Each one keeps its capture or
            representation, its contribution, its release state and the limits of what has been
            verified in separate, labelled places.
          </p>
        </div>
      </div>
    </header>

    <h2 class="visually-hidden">Project case studies</h2>

    <div class="archive__entries">
      <WorkEntry id="syncareer" order={1} scale="feature" priority capture="opportunities" />
      <WorkEntry id="sessionbook" order={2} />
      <WorkEntry id="koranco" order={3} />
    </div>

    <footer class="archive__close">
      <p class="archive__limits">
        <span class="archive__limits-label">Still open</span>
        Syncareer’s grounding revision is in source, not redeployed. SessionBook has no retained
        call evidence. Koranco has no public source or production deployment.
      </p>
      <nav class="archive__links" aria-label="Elsewhere">
        <a class="text-link" href="/lab/">
          How I check the work <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/profile/">About Stephen <span aria-hidden="true">↗</span></a>
      </nav>
    </footer>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 4.5vw, 4rem);
  }

  /* ---- opener ---------------------------------------------- */
  /* Compact by design: the register has to start inside the first
     screen, so the opener states the frame and gets out of the way. */
  .archive__head {
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .archive__head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
  }
  .archive h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.4vw, 4.2rem);
    line-height: var(--leading-display);
    letter-spacing: -0.045em;
    margin: 0;
    max-width: 14ch;
  }
  .archive h1 em {
    font-style: normal;
    color: var(--color-teal);
  }
  .archive__head-note {
    padding-bottom: 0.35rem;
    min-width: 0;
  }
  .archive__head-note .lead {
    font-size: clamp(0.98rem, 1.2vw, 1.06rem);
    max-width: 44ch;
  }

  /* ---- register -------------------------------------------- */
  /* One register, three rows. Every entry uses the same two columns, so
     the copy starts on the same line in all three and the page can be
     read down the left edge. Syncareer is separated by scale and a
     heavier rule, not by a different structure. */
  .archive__entries {
    display: grid;
  }

  /* ---- close ----------------------------------------------- */
  .archive__close {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    margin-top: clamp(2rem, 3.5vw, 3rem);
    padding-top: clamp(1.25rem, 2.4vw, 1.75rem);
    border-top: 1px solid var(--color-rule);
  }
  .archive__limits {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 62ch;
  }
  .archive__limits-label {
    display: inline-block;
    margin-right: 0.55rem;
    font-family: var(--font-instrument);
    font-size: var(--size-label);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-copper-text);
  }
  .archive__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .archive__links .text-link {
    font-size: 0.86rem;
    color: var(--color-teal);
    text-underline-offset: 3px;
  }
  .archive__links .text-link:hover {
    color: var(--color-copper-text);
  }

  /* ---- narrow ---------------------------------------------- */
  @media (max-width: 60rem) {
    .archive__head-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
      align-items: start;
    }
    .archive__head-note {
      padding-bottom: 0;
    }
  }

  @media (max-width: 46rem) {
    .archive__close {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The opener arrives with the site's shared entrance class; the
     entries animate themselves. Nothing is gated on either. */
</style>
