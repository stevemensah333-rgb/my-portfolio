  .artifact__status {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-on-paper);
  }

  .artifact__dot {
    width: var(--node-status);
    height: var(--node-status);
    border-radius: 50%;
    background: var(--color-accent);
  }

  .artifact__status--live .artifact__dot,
  .artifact__status--mvp .artifact__dot {
    background: var(--color-signal-pass);
  }

  .artifact__stack {
    color: var(--color-text-on-paper-faint);
  }

  .artifact__open {
    margin-left: auto;
    color: var(--color-accent-text);
  }

  .artifact__link:hover .artifact__name,
  .artifact__link:focus-visible .artifact__name {
    color: var(--color-accent-text);
  }

  /* ---------- Scroll hint ------------------------------------- */

  .archive-hint {
    display: none;
  }

  /* ============================================================
     PILE MODE — wide and tall enough for the composition to live in
     one viewport. The grid is the resting (INSPECT) state.
     Must match `pileQuery` in the script.
     ============================================================ */

  @media (min-width: 60rem) and (min-height: 40rem) {
    .archive-stage__sticky {
      grid-template-rows: auto minmax(0, 1fr);
      gap: clamp(var(--space-5), 2.6vh, var(--space-7));
      height: calc(100svh - var(--shell-control));
      max-height: 60rem;
      padding-block: clamp(var(--space-5), 4vh, var(--space-8)) clamp(var(--space-5), 3.5vh, var(--space-7));
    }

    .archive-head {
      grid-template-columns: minmax(0, 1.8fr) minmax(17rem, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    .archive-head__instrument {
      display: block;
      padding-bottom: var(--space-1);
    }

    /* Compact head: title and lede share a line so the artifacts
       keep the height. */
    .archive-head__copy {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
      align-items: end;
    }

    .archive-head__copy > .mono-label {
      grid-column: 1 / -1;
    }

    .archive-head__lede {
      max-width: 40ch;
      font-size: var(--text-small);
    }

    .archive-field {
      min-height: 0;
    }

    /* 65 / 35 — one dominant artifact, two compact ones. */
    .archive-artifacts {
      grid-template-columns: minmax(0, 1.8fr) minmax(17rem, 1fr);
      grid-template-rows: minmax(0, 1.04fr) minmax(0, 0.96fr);
      grid-template-areas:
        'flagship second'
        'flagship third';
      gap: clamp(1.25rem, 3vh, 2.25rem) clamp(1.5rem, 3vw, 3rem);
      height: 100%;
    }

    .artifact {
      min-height: 0;
    }

    .artifact--flagship {
      grid-area: flagship;
    }

    .artifact--sessionbook,
    .artifact--koranco {
      width: auto;
      margin: 0;
      padding: 0;
    }

    .artifact--sessionbook {
      grid-area: second;
    }

    .artifact--koranco {
      grid-area: third;
    }

    .artifact__link {
      gap: var(--space-3);
    }

    .artifact__plate--captures {
      aspect-ratio: auto;
    }

    /* Fixed-height cells: sheets fit their cell instead of spilling. */
    .artifact__plate--code,
    .artifact__plate--record {
      overflow: hidden;
    }

    .code-sheet__body {
      mask-image:
        linear-gradient(to right, #000 88%, transparent),
        linear-gradient(to bottom, #000 78%, transparent);
      mask-composite: intersect;
    }

    .artifact__plate--record {
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4) var(--space-3);
    }

    .record-sheet__rows {
      align-content: start;
    }

    .record-sheet__row {
      padding-block: clamp(0.125rem, 0.7vh, 0.4rem);
      font-size: clamp(0.9375rem, 1.25vw, 1.125rem);
    }

    /* The sheet sizes to its cell; when the cell is short, the index
       turns sideways (three columns) so all three modules stay whole. */
    .artifact__plate--record {
      container-type: size;
    }

    @container (max-height: 10.5rem) {
      .record-sheet__rows {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-3);
        align-content: center;
      }

      .record-sheet__row {
        grid-template-columns: 1fr;
        gap: var(--space-1);
        padding-block: var(--space-1) var(--space-2);
        font-size: 0.875rem;
        line-height: 1.15;
      }
    }

    @container (max-height: 7.5rem) {
      .record-sheet__row span:first-child {
        display: none;
      }

      .record-sheet__row {
        padding-block: var(--space-1);
        font-size: 0.8125rem;
      }
    }

    /* Flagship label: a wide strip — name on the left, orientation
       on the right. */
    .artifact--flagship .artifact__label {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: var(--space-6);
      align-items: end;
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-rule-on-paper-strong);
    }

    .artifact--sessionbook .artifact__label,
    .artifact--koranco .artifact__label {
      gap: var(--space-1);
    }

    .artifact--sessionbook .artifact__detail,
    .artifact--koranco .artifact__detail {
      gap: var(--space-1);
    }

    .artifact--sessionbook .artifact__short,
    .artifact--koranco .artifact__short {
      font-size: 0.8125rem;
      line-height: 1.4;
    }

    .archive-hint {
      position: absolute;
      bottom: 0;
      left: 50%;
      z-index: 20;
      display: inline-flex;
      gap: var(--space-2);
      margin: 0;
      padding: var(--space-2) var(--space-3);
      background: var(--color-sheet-soft);
      color: var(--color-text-on-paper-muted);
      font-family: var(--font-instrument);
      font-size: var(--text-micro);
      letter-spacing: var(--tracking-instrument);
      text-transform: uppercase;
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%);
    }

    .archive-hint span {
      color: var(--color-accent-text);
    }

    /* Animated pile: the stage gains scroll length and pins its
       viewport. Only with JS and motion allowed. */
    .archive.is-animated .archive-stage {
      height: calc(100svh + 170svh);
    }

    .archive.is-animated .archive-stage__sticky {
      position: sticky;
      top: var(--shell-control);
    }

    /* While objects are piled, only the objects themselves take
       pointer input — never the empty grid cell under them. */
    .archive.is-animated .artifact__link {
      pointer-events: none;
    }

    .archive.is-animated .artifact__object,
    .archive.is-animated .artifact__label {
      pointer-events: auto;
    }
  }

  /* Short pile viewports: the secondary objects already say what
     they are (code sheet header, record stamp), so their kicker
     line yields its height to the artifact. */
  @media (min-width: 60rem) and (min-height: 40rem) and (max-height: 52rem) {
    .artifact--sessionbook .artifact__kicker,
    .artifact--koranco .artifact__kicker {
      display: none;
    }
  }

  /* Keyboard/focus hand-off animates briefly between states. */
  .archive.is-settling .artifact__object,
  .archive.is-settling .artifact__label,
