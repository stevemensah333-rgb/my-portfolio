---
import { projects, syncareer } from '../../data/registry';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Work — Project Archive | Stephen Mensah';
const description =
  'A project archive for inspecting Stephen Mensah\'s real engineering work, its visual artifacts, and the evidence behind each case study.';

const imageArtifacts = syncareer.evidence.filter((item) => item.kind === 'artifact-image');
const archiveEntries = projects.map((project, index) => ({
  project,
  index,
  isFlagship: project.id === 'syncareer',
}));

const responsiveAsset = (href: string, width: 1440 | 1800 | 2400, format: 'png' | 'webp') =>
  href.replace(/-2400\.png$/, `-${width}.${format}`);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work — Project Archive',
  description,
  url: new URL('/work/', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.name,
      url: new URL(project.route, Astro.site).href,
    })),
  },
};

const phases = [
  { index: '01', label: 'Cluster' },
  { index: '02', label: 'Separate' },
  { index: '03', label: 'Reveal' },
  { index: '04', label: 'Inspect' },
];
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  image="/images/syncareer/synai-context-2400.png"
  imageAlt="Syncareer SynAI interface showing personalised career guidance based on profile, quick actions and a message input."
  imageWidth={2400}
  imageHeight={1302}
  area="work"
>
  <article class="archive" data-archive>
    <header
      class="archive-hero page-shell"
      data-workspace-section="top"
      data-workspace-label="Archive"
    >
      <div class="archive-hero__rule" aria-hidden="true">
        <span class="mono-label">02 · Work</span>
        <span class="archive-hero__rule-line"></span>
        <span class="mono-label mono-label--bare">Project archive</span>
      </div>

      <div class="archive-hero__grid">
        <div class="archive-hero__copy">
          <p class="mono-label mono-label--state">Evidence-led projects</p>
          <h1>From a cluster to a set of cases.</h1>
          <p class="archive-hero__lede">
            The work starts as a physical stack. Scroll through it to separate the artifacts,
            reveal their shape, and choose the case you want to inspect.
          </p>
          <a class="text-link" href="#archive-cluster">
            Enter the archive <span class="text-link__arrow" aria-hidden="true">↓</span>
          </a>
        </div>

        <aside class="archive-hero__logic" aria-label="Archive interaction sequence">
          <p class="mono-label mono-label--bare">Scroll sequence</p>
          <ol>
            {phases.map((phase) => (
              <li>
                <span>{phase.index}</span>
                <span>{phase.label}</span>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </header>

    <section
      id="archive-cluster"
      class="archive-stage"
      data-archive-stage
      data-workspace-section="archive"
      data-workspace-label="Project archive"
      aria-labelledby="archive-stage-title"
    >
      <div class="archive-stage__sticky">
        <div class="archive-stage__topline page-shell">
          <p class="mono-label mono-label--bare">02 / Work / Archive</p>
          <div class="archive-stage__readout">
            <span class="archive-stage__readout-label">State</span>
            <span data-archive-state aria-live="polite">Cluster</span>
          </div>
        </div>

        <div class="archive-stage__heading page-shell">
          <div>
            <h2 id="archive-stage-title">A deliberate pile of engineering artifacts.</h2>
            <p>
              Keep scrolling. The offsets loosen, the flagship comes forward, and every card
              resolves into a direct route to its case study.
            </p>
          </div>
          <div class="archive-stage__meter" aria-hidden="true">
            <span data-archive-progress></span>
          </div>
        </div>

        <div class="archive-stage__workspace page-shell" data-archive-visual>
          <ol class="archive-stage__phases" aria-label="Archive scroll sequence">
            {phases.map((phase, phaseIndex) => (
              <li data-archive-phase={phaseIndex} data-active={phaseIndex === 0 ? 'true' : undefined}>
                <span>{phase.index}</span>
                <span>{phase.label}</span>
              </li>
            ))}
          </ol>

          <ol class="archive-stage__cards" aria-label="Projects">
            {archiveEntries.map(({ project, index, isFlagship }) => (
              <li
                class:list={['archive-card', isFlagship && 'archive-card--flagship']}
                data-archive-card
              >
                <a
                  class="archive-card__link"
                  href={project.route}
                  aria-labelledby={`archive-card-${project.id}-title`}
                >
                  <span class="archive-card__surface">
                    <span class="archive-card__header">
                      <span class="archive-card__kind">
                        {isFlagship ? 'Flagship case' : 'Project record'}
                      </span>
                      <span class:list={['archive-card__status', `archive-card__status--${project.status}`]}>
                        <span class="archive-card__status-dot" aria-hidden="true"></span>
                        {project.status.replace(/-/g, ' ')}
                      </span>
                    </span>

                    {isFlagship ? (
                      <span class="archive-card__screens" aria-label={`${project.name} visual artifacts`}>
                        {imageArtifacts.map((artifact, artifactIndex) => (
                          <span
                            class:list={[
                              'archive-card__screen',
                              artifactIndex === 0 && 'archive-card__screen--primary',
                            ]}
                          >
                            <picture>
                              <source
                                type="image/webp"
                                srcset={`${responsiveAsset(artifact.href, 1440, 'webp')} 1440w, ${responsiveAsset(artifact.href, 1800, 'webp')} 1800w, ${responsiveAsset(artifact.href, 2400, 'webp')} 2400w`}
                                sizes={artifactIndex === 0 ? '(min-width: 48rem) 51vw, 88vw' : '(min-width: 48rem) 15vw, 35vw'}
                              />
                              <img
                                src={artifact.href}
                                srcset={`${responsiveAsset(artifact.href, 1440, 'png')} 1440w, ${responsiveAsset(artifact.href, 1800, 'png')} 1800w, ${responsiveAsset(artifact.href, 2400, 'png')} 2400w`}
                                sizes={artifactIndex === 0 ? '(min-width: 48rem) 51vw, 88vw' : '(min-width: 48rem) 15vw, 35vw'}
                                width="2400"
                                height="1302"
                                alt={artifact.alt}
                                loading="lazy"
                                decoding="async"
                              />
                            </picture>
                          </span>
                        ))}
                      </span>
                    ) : (
                      <span class="archive-card__record" aria-hidden="true">
                        <span class="archive-card__record-index">{String(index + 1).padStart(2, '0')}</span>
                        <span class="archive-card__record-label">System record</span>
                        <span class="archive-card__record-name">{project.name}</span>
                        <span class="archive-card__record-rule"></span>
                        <span class="archive-card__record-stack">
                          {project.stack.slice(0, 3).map((item) => <span>{item}</span>)}
                        </span>
                      </span>
                    )}

                    <span class="archive-card__body">
                      <span class="archive-card__index">{String(index + 1).padStart(2, '0')}</span>
                      <span class="archive-card__name-wrap">
                        <h3 id={`archive-card-${project.id}-title`}>{project.name}</h3>
                        <span class="archive-card__short">{project.short}</span>
                      </span>
                    </span>

                    <span class="archive-card__footer">
                      <span class="archive-card__stack mono-label mono-label--bare">
                        {project.stack.slice(0, isFlagship ? 4 : 3).join(' · ')}
                      </span>
                      <span class="archive-card__inspect">
                        Inspect <span aria-hidden="true">↗</span>
                      </span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <p class="archive-stage__caption">
            <span class="mono-label mono-label--bare">Scroll to separate</span>
            <span aria-hidden="true">↓</span>
          </p>
        </div>
      </div>
    </section>

    <footer
      class="archive-end page-shell"
      data-workspace-section="inspect"
      data-workspace-label="Inspect"
    >
      <p class="mono-label">03 · Inspect</p>
      <div class="archive-end__copy">
        <h2>Choose an artifact to inspect.</h2>
        <p>
          Each project keeps its own route, evidence boundary, and technical record. The stack
          is only the index; the case study is where the decisions are explained.
        </p>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  /* The ClientRouter swaps the shell without re-running bundled
     scripts, so the pile engine re-initializes on `astro:page-load`
     (fired on first load too). The marker keeps it idempotent; the
     run-scoped AbortController removes the previous run's
     window/media-query listeners. */
  let teardown: (() => void) | null = null;

  const init = () => {
    const archive = document.querySelector<HTMLElement>('[data-archive]');
    if (!archive || archive.dataset.archiveEnhanced === '1') return;
    archive.dataset.archiveEnhanced = '1';

    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();
    const signal = events.signal;

    const stage = archive.querySelector<HTMLElement>('[data-archive-stage]');
    const visual = archive.querySelector<HTMLElement>('[data-archive-visual]');
    const sticky = archive.querySelector<HTMLElement>('.archive-stage__sticky');
    const cards = Array.from(archive.querySelectorAll<HTMLElement>('[data-archive-card]'));
    const phaseItems = Array.from(archive.querySelectorAll<HTMLElement>('[data-archive-phase]'));
    const stateReadout = archive.querySelector<HTMLElement>('[data-archive-state]');
    const progressReadout = archive.querySelector<HTMLElement>('[data-archive-progress]');

    if (stage && visual && sticky && cards.length > 0) {
    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopQuery = window.matchMedia('(min-width: 48rem)');
    const phaseLabels = ['Cluster', 'Separate', 'Reveal', 'Inspect'];
    const clusterLayouts = [
      { x: 0, y: 0, rotation: -2 },
      { x: 0.028, y: -0.05, rotation: 3.5 },
      { x: -0.03, y: 0.045, rotation: -4.5 },
    ];
    let frame = 0;
    let previousPhase = -1;
    let focusedCard: HTMLElement | null = null;
    let scrollBound = false;

    const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
    const lerp = (from: number, to: number, amount: number) => from + (to - from) * amount;

    const getProgress = () => {
      if (reducedQuery.matches) return 1;
      const travel = Math.max(stage.offsetHeight - sticky.offsetHeight, 1);
      const stageTop = stage.getBoundingClientRect().top;
      return clamp(-stageTop / travel, 0, 1);
    };

    const updatePhase = (progress: number) => {
      const phase = progress < 0.16 ? 0 : progress < 0.43 ? 1 : progress < 0.76 ? 2 : 3;
      if (phase === previousPhase) return;
      previousPhase = phase;
      stage.dataset.archivePhase = phaseLabels[phase].toLowerCase();
      if (stateReadout) stateReadout.textContent = phaseLabels[phase];
      phaseItems.forEach((item, index) => {
        item.dataset.active = index === phase ? 'true' : 'false';
      });
    };

    /* MOBILE EQUIVALENT: below 48rem the pile does not exist — the CSS
       stacks the cards in reading order and the transforms must not
       fight it, so the inline state is removed rather than computed. */
    const clearCard = (card: HTMLElement) => {
      for (const name of ['--card-x', '--card-y', '--card-rotation', '--card-lift', '--card-progress']) {
        card.style.removeProperty(name);
      }
      card.style.zIndex = '';
    };

    const update = () => {
      frame = 0;
      if (!desktopQuery.matches) {
        cards.forEach(clearCard);
        return;
      }
      const progress = getProgress();
      const width = visual.clientWidth;
      const height = visual.clientHeight;

      cards.forEach((card, index) => {
        const layout = clusterLayouts[index] ?? clusterLayouts[clusterLayouts.length - 1];
        const cardProgress = reducedQuery.matches
          ? 1
          : clamp((progress - (0.08 + index * 0.075)) / 0.67, 0, 1);
        const clusterX = layout.x * width;
        const clusterY = layout.y * height;
        const clusterRotation = layout.rotation;

        const finalPositions = [
          { x: -0.18 * width, y: 0.01 * height, rotation: -1 },
          { x: 0.29 * width, y: -0.19 * height, rotation: 1.5 },
          { x: 0.29 * width, y: 0.22 * height, rotation: -1.25 },
        ];
        const finalPosition = finalPositions[index] ?? finalPositions[finalPositions.length - 1];
        const x = lerp(clusterX, finalPosition.x, cardProgress);
        const y = lerp(clusterY, finalPosition.y, cardProgress);
        const rotation = lerp(clusterRotation, finalPosition.rotation, cardProgress);
        const lift = lerp(3 + (cards.length - index) * 2, 12 + (cards.length - index) * 3, cardProgress);

        card.style.setProperty('--card-x', `${x}px`);
        card.style.setProperty('--card-y', `${y}px`);
        card.style.setProperty('--card-rotation', `${rotation}deg`);
        card.style.setProperty('--card-lift', `${lift}px`);
        card.style.setProperty('--card-progress', cardProgress.toFixed(3));
        card.style.zIndex = focusedCard === card ? '40' : String(Math.round(10 + cardProgress * 10 - index));
      });

      if (progressReadout) progressReadout.style.width = `${progress * 100}%`;
      updatePhase(progress);
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    /* Scroll drives the pile only where the pile runs. Reduced motion
       gets the final state directly: one update, no scroll listener. */
    const bindScroll = () => {
      if (scrollBound) return;
      scrollBound = true;
      window.addEventListener('scroll', requestUpdate, { passive: true, signal });
    };
    const unbindScroll = () => {
      if (!scrollBound) return;
      scrollBound = false;
      window.removeEventListener('scroll', requestUpdate);
    };
    const syncMode = () => {
      if (desktopQuery.matches && !reducedQuery.matches) bindScroll();
      else unbindScroll();
      requestUpdate();
    };

    window.addEventListener('resize', requestUpdate, { passive: true, signal });
    reducedQuery.addEventListener('change', syncMode, { signal });
    desktopQuery.addEventListener('change', syncMode, { signal });
    syncMode();

    cards.forEach((card) => {
      const link = card.querySelector<HTMLAnchorElement>('a');
      if (!link) return;

      // Cards are absolute during the pile; raising the focused card
      // keeps its outline visible above its neighbours. Links already
      // provide the native Enter and touch activation paths.
      link.addEventListener('focusin', () => {
        focusedCard = card;
        card.style.zIndex = '40';
      }, { signal });

      link.addEventListener('focusout', () => {
        if (focusedCard !== card) return;
        focusedCard = null;
        requestUpdate();
      }, { signal });
    });
  }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .archive {
    border-bottom: var(--border-default);
  }

  .archive-hero {
    display: grid;
    gap: clamp(var(--space-6), 5vw, var(--space-9));
    padding-block: clamp(2rem, 6vw, 5.5rem) clamp(3rem, 7vw, 6.5rem);
  }

  .archive-hero__rule {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
  }

  .archive-hero__rule-line {
    height: 1px;
    background: var(--color-rule-on-paper);
  }

  .archive-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(12rem, 0.5fr);
    gap: clamp(var(--space-7), 8vw, var(--space-10));
    align-items: end;
  }

  .archive-hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .archive-hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.25rem, 8vw, 7.5rem);
    line-height: 0.94;
  }

  .archive-hero__lede {
    max-width: 38rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .archive-hero__logic {
    align-self: end;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .archive-hero__logic ol {
    display: grid;
    gap: 0;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .archive-hero__logic li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .archive-hero__logic li span:first-child {
    color: var(--color-accent-text);
  }

  .archive-stage {
    position: relative;
    min-height: 340vh;
    background: var(--color-paper-soft);
    border-top: 1px solid var(--color-rule-on-paper-strong);
    /* The pile may park a card a few px past the field edge at some
       desktop widths; clip horizontally so the document never gains a
       horizontal scrollbar. `clip` (not `hidden`) does not create a
       scroll container, so the sticky viewport keeps working. */
    overflow-x: clip;
  }

  .archive-stage__sticky {
    position: sticky;
    top: var(--shell-control);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    height: calc(100svh - var(--shell-control));
    min-height: 42rem;
    padding-block: var(--space-5) var(--space-6);
  }

  .archive-stage__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .archive-stage__readout {
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .archive-stage__readout-label {
    color: var(--color-text-on-paper-faint);
  }

  .archive-stage__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.42fr);
    gap: var(--space-6);
    align-items: end;
    padding-block: var(--space-4) var(--space-3);
  }

  .archive-stage__heading h2 {
    max-width: 25ch;
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
  }

  .archive-stage__heading p {
    max-width: 38rem;
    margin-top: var(--space-2);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .archive-stage__meter {
    align-self: end;
    height: 2px;
    margin-bottom: var(--space-2);
    background: var(--color-rule-on-paper);
  }

  .archive-stage__meter span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent);
    transition: width var(--duration-quick) linear;
  }

  .archive-stage__workspace {
    position: relative;
    min-height: 0;
  }

  .archive-stage__workspace::before,
  .archive-stage__workspace::after {
    position: absolute;
    z-index: 0;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .archive-stage__workspace::before {
    top: 0;
    left: 0;
    content: 'ARTIFACT FIELD';
  }

  .archive-stage__workspace::after {
    right: 0;
    bottom: 0;
    content: 'NORMAL SCROLL / NO DRAG';
  }

  .archive-stage__phases {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 5;
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-stage__phases li {
    display: grid;
    grid-template-columns: auto auto;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .archive-stage__phases li span:first-child {
    color: var(--color-text-on-paper-muted);
  }

  .archive-stage__phases li[data-active='true'],
  .archive-stage__phases li[data-active='true'] span:first-child {
    color: var(--color-accent-text);
  }

  .archive-stage__cards {
    position: absolute;
    inset: var(--space-6) 0 var(--space-5);
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(28rem, 35vw);
    opacity: 1;
    transform: translate3d(calc(-50% + var(--card-x, 0px)), calc(-50% + var(--card-y, 0px)), 0)
      rotate(var(--card-rotation, 0deg));
    transform-origin: center center;
    transition: opacity var(--duration-base) var(--ease-standard);
    will-change: transform;
  }

  .archive-card--flagship {
    width: min(51rem, 59vw);
  }

  .archive-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .archive-card__surface {
    display: grid;
    gap: var(--space-4);
    min-height: 100%;
    padding: clamp(var(--space-4), 2vw, var(--space-6));
    border: 1px solid var(--color-rule-on-paper-strong);
    background: var(--color-sheet-high);
    box-shadow: 0 var(--card-lift, 5px) 0 rgb(21 24 28 / 10%);
    transition:
      box-shadow var(--duration-base) var(--ease-emphasized),
      background-color var(--duration-quick) var(--ease-standard),
      transform var(--duration-base) var(--ease-emphasized);
  }

  .archive-card__link:hover .archive-card__surface,
  .archive-card__link:focus-visible .archive-card__surface {
    background: var(--color-sheet-raised);
    box-shadow: 0 calc(var(--card-lift, 5px) + 5px) 0 rgb(21 24 28 / 16%);
    transform: translateY(-3px);
  }

  .archive-card__header,
  .archive-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .archive-card__kind,
  .archive-card__status,
  .archive-card__inspect {
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .archive-card__kind {
    color: var(--color-accent-text);
  }

  .archive-card__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-on-paper-faint);
  }

  .archive-card__status-dot {
    width: var(--node-status);
    height: var(--node-status);
    border-radius: 50%;
    background: var(--color-accent);
  }

  .archive-card__status--live .archive-card__status-dot,
