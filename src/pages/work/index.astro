---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const title='Work — Stephen Mensah';
const description='Three engineering projects: Syncareer, SessionBook and Koranco Farms. Inspect the product, contribution, implementation and evidence.';
---
<BaseLayout {title} {description}>
 <section class="archive page-shell section"><header class="section-head"><div><p class="eyebrow">The workbench / Three projects</p><h1>Built to be<br /><em>looked into.</em></h1></div><p class="lead">Open a project for the decisions behind it. Product captures, source contracts and the limits of what’s been verified.</p></header><h2 class="visually-hidden">Project case studies</h2><div class="archive__projects"><div class="enter"><ProjectCard id="syncareer" priority/></div><div class="enter"><ProjectCard id="sessionbook"/></div><div class="enter"><ProjectCard id="koranco"/></div></div></section>
</BaseLayout>
<style>
.archive h1{font-size: clamp(3.5rem, 7vw, 7rem)}
.archive h1 em{font-style: normal; color: var(--color-teal)}
.archive .section-head{margin-bottom: 4rem}
.archive__projects{display: grid; grid-template-columns: 1fr 1fr; gap: 3rem}
.archive__projects > div:first-child{grid-column: 1 / -1}
.archive__projects > div{transform-origin: center}
.archive__projects > div:nth-child(2){animation-name: unstack-left}
.archive__projects > div:nth-child(3){animation-name: unstack-right}

@keyframes unstack-left{
  from{transform: translate(10%, -30px) rotate(-4deg); opacity: 0.7}
  to{transform: none; opacity: 1}
}

@keyframes unstack-right{
  from{transform: translate(-10%, -30px) rotate(4deg); opacity: 0.7}
  to{transform: none; opacity: 1}
}

@media (max-width: 650px) {
  .archive__projects{grid-template-columns: 1fr; gap: 2rem}
  .archive__projects > div:first-child{grid-column: auto}
  .archive .section-head{margin-bottom: 2rem}
}
</style>
