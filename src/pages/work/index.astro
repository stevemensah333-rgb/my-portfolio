---
/**
 * WORK — the project archive.
 *
 * One set of project objects, one composition. The CSS grid below IS
 * the final, inspectable composition (large flagship artifact on the
 * left, two compact secondary artifacts on the right, ~65/35). That
 * grid is what no-JS and reduced-motion visitors see.
 *
 * With JavaScript and motion allowed, a small scroll-linked engine
 * measures each artifact's resting place and offsets it into a compact
 * pile. Scroll progress through the stage then runs one deterministic
 * sequence: CLUSTER → SEPARATE → REVEAL → INSPECT. No physics, no drag,
 * no scroll hijacking — the page scrolls normally and only the
 * composition reads the progress.
 *
 * Every artifact is real project material or says plainly that none
 * exists (AGENTS.md §5–6):
 *   Syncareer    three interface captures of the live product
 *   SessionBook  an implementation excerpt from the public repository
 *   Koranco      a record sheet — no public repository or screenshots
 */
import { projects, syncareer, sessionbook, koranco } from '../../data/registry';
import type { Project } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Work — Project Archive | Stephen Mensah';
const description =
  'The things Stephen Mensah built: Syncareer, a live AI-integrated career workspace; SessionBook, a booking backend; and Koranco Farms, a farm management MVP. Each with its artifacts and evidence boundary.';

const captures = syncareer.evidence.filter(
  (item): item is Extract<(typeof syncareer.evidence)[number], { kind: 'artifact-image' }> =>
    item.kind === 'artifact-image',
);

/* SessionBook's artifact is the implementation excerpt that already
   lives in the registry (one canonical copy; labelled as it is on the
   case page). */
const sessionbookExcerpt = sessionbook.stages?.find((stage) => stage.id === 'model-output');
const sessionbookFixes = sessionbook.stages?.find((stage) => stage.id === 'intervention')?.fixes ?? [];

/* Koranco's record sheet repeats only the module names already stated
   on /work/koranco/ and in the registry. */
const korancoModules = ['Attendance checking', 'Farm produce management', 'Employee management'];

const statusLabel: Record<Project['status'], string> = {
  live: 'Live',
  mvp: 'MVP',
  'in-development': 'In development',
  coursework: 'Coursework',
  experiment: 'Experiment',
};

type Entry = {
  project: Project;
  number: string;
  role: string;
  artifact: string;
  meta: string;
};

const entries: Record<'syncareer' | 'sessionbook' | 'koranco', Entry> = {
  syncareer: {
    project: syncareer,
    number: '01',
    role: 'Flagship case',
    artifact: `${captures.length} interface captures`,
    meta: 'TypeScript · Supabase · Edge Functions',
  },
  sessionbook: {
    project: sessionbook,
    number: '02',
    role: 'Current project',
    artifact: 'Implementation excerpt',
    meta: 'FastAPI · Postgres',
  },
  koranco: {
    project: koranco,
    number: '03',
    role: 'Delivered MVP',
    artifact: 'Record only',
    meta: koranco.stack.join(' · '),
  },
};

const responsiveAsset = (href: string, width: 1440 | 1800 | 2400, format: 'png' | 'webp') =>
  href.replace(/-2400\.png$/, `-${width}.${format}`);
const srcset = (href: string, format: 'png' | 'webp') =>
  ([1440, 1800, 2400] as const).map((w) => `${responsiveAsset(href, w, format)} ${w}w`).join(', ');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work — Project Archive',
  description,
  url: new URL('/work/', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.name,
      url: new URL(project.route, Astro.site).href,
    })),
  },
};

const phases = ['Cluster', 'Separate', 'Reveal', 'Inspect'];
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  image="/images/syncareer/synai-context-2400.png"
  imageAlt="Syncareer SynAI interface showing personalised career guidance based on profile, quick actions and a message input."
  imageWidth={2400}
  imageHeight={1302}
  area="work"
>
  <article class="archive" data-archive>
    <section
      class="archive-stage"
      data-archive-stage
      data-workspace-section="top"
      data-workspace-label="Project archive"
      aria-labelledby="archive-title"
    >
      <div class="archive-stage__sticky">
        <header class="archive-head page-shell">
          <div class="archive-head__copy">
            <p class="mono-label mono-label--state">02 · Work · Project archive</p>
            <h1 id="archive-title">Things I built.</h1>
            <p class="archive-head__lede">
              A live career platform, a booking backend, and a farm management MVP. Each
              artifact opens a case study with its evidence and its limits.
            </p>
          </div>

          <!-- Scroll-state readout. Decorative mirror of the composition,
               so it is hidden from assistive technology; no information
               lives only here. -->
          <div class="archive-head__instrument" aria-hidden="true">
            <ol class="archive-phases">
              {phases.map((phase, index) => (
                <li data-archive-phase={index} data-active={index === 3 ? 'true' : undefined}>{phase}</li>
              ))}
            </ol>
            <span class="archive-meter"><span data-archive-progress></span></span>
          </div>
        </header>

        <div class="archive-field page-shell">
          <ol class="archive-artifacts" data-archive-field aria-label="Projects, flagship first">
            <!-- 01 · SYNCAREER — the largest object on the page. -->
            <li class="artifact artifact--flagship" data-artifact>
              <a
                class="artifact__link"
                href={syncareer.route}
                aria-labelledby="artifact-syncareer-name"
                aria-describedby="artifact-syncareer-short"
              >
                <span class="artifact__object" data-artifact-object>
                  <span class="artifact__tab" aria-hidden="true">
                    <span>{entries.syncareer.number}</span>{syncareer.name}
                  </span>
                  <span class="artifact__plate artifact__plate--captures">
                    {captures.map((capture, index) => (
                      <span
                        class:list={['capture', `capture--${index}`]}
                        data-capture={index}
                      >
                        <picture>
                          <source
                            type="image/webp"
                            srcset={srcset(capture.href, 'webp')}
                            sizes={index === 0 ? '(min-width: 60rem) 48vw, 92vw' : '(min-width: 60rem) 18vw, 36vw'}
                          />
                          <img
                            src={responsiveAsset(capture.href, 1440, 'png')}
                            srcset={srcset(capture.href, 'png')}
                            sizes={index === 0 ? '(min-width: 60rem) 48vw, 92vw' : '(min-width: 60rem) 18vw, 36vw'}
                            width="2400"
                            height="1302"
                            alt={capture.alt}
                            loading={index === 0 ? 'eager' : 'lazy'}
                            fetchpriority={index === 0 ? 'high' : undefined}
                            decoding="async"
                          />
                        </picture>
                      </span>
                    ))}
                  </span>
                </span>

                <span class="artifact__label" data-artifact-label>
                  <span class="artifact__heading">
                    <span class="artifact__kicker">
                      {entries.syncareer.number} · {entries.syncareer.role} · {entries.syncareer.artifact}
                    </span>
                    <h2 class="artifact__name" id="artifact-syncareer-name">{syncareer.name}</h2>
                  </span>
                  <span class="artifact__detail">
                    <span class="artifact__short" id="artifact-syncareer-short">{syncareer.short}</span>
                    <span class="artifact__meta">
                      <span class:list={['artifact__status', `artifact__status--${syncareer.status}`]}>
                        <span class="artifact__dot" aria-hidden="true"></span>{statusLabel[syncareer.status]}
                      </span>
                      <span class="artifact__stack">{entries.syncareer.meta}</span>
                      <span class="artifact__open">Open case study <span aria-hidden="true">→</span></span>
                    </span>
                  </span>
                </span>
              </a>
            </li>

            <!-- 02 · SESSIONBOOK — a code artifact from the repository. -->
            <li class="artifact artifact--sessionbook" data-artifact>
              <a
                class="artifact__link"
                href={sessionbook.route}
                aria-labelledby="artifact-sessionbook-name"
                aria-describedby="artifact-sessionbook-short"
              >
                <span class="artifact__object" data-artifact-object>
                  <span class="artifact__tab" aria-hidden="true">
                    <span>{entries.sessionbook.number}</span>{sessionbook.name}
                  </span>
                  <span class="artifact__plate artifact__plate--code on-deck">
                    <span class="code-sheet__head">
                      <span>{sessionbookExcerpt?.codeLabel ?? 'Implementation excerpt'}</span>
                      <span>check_availability</span>
                    </span>
                    {sessionbookExcerpt?.code && (
                      <pre class="code-sheet__body"><code>{sessionbookExcerpt.code}</code></pre>
                    )}
                    {sessionbookFixes.length > 0 && (
                      <span class="code-sheet__foot">{sessionbookFixes[0]}</span>
                    )}
                  </span>
                </span>

                <span class="artifact__label" data-artifact-label>
                  <span class="artifact__heading">
                    <span class="artifact__kicker">
                      {entries.sessionbook.number} · {entries.sessionbook.role} · {entries.sessionbook.artifact}
                    </span>
                    <h2 class="artifact__name" id="artifact-sessionbook-name">{sessionbook.name}</h2>
                  </span>
                  <span class="artifact__detail">
                    <span class="artifact__short" id="artifact-sessionbook-short">{sessionbook.short}</span>
                    <span class="artifact__meta">
                      <span class:list={['artifact__status', `artifact__status--${sessionbook.status}`]}>
                        <span class="artifact__dot" aria-hidden="true"></span>{statusLabel[sessionbook.status]}
                      </span>
                      <span class="artifact__stack">{entries.sessionbook.meta}</span>
                      <span class="artifact__open">Open <span aria-hidden="true">→</span></span>
                    </span>
                  </span>
                </span>
              </a>
            </li>

            <!-- 03 · KORANCO — a record sheet; says plainly there is no public artifact. -->
            <li class="artifact artifact--koranco" data-artifact>
              <a
                class="artifact__link"
                href={koranco.route}
                aria-labelledby="artifact-koranco-name"
                aria-describedby="artifact-koranco-short"
              >
                <span class="artifact__object" data-artifact-object>
                  <span class="artifact__tab" aria-hidden="true">
                    <span>{entries.koranco.number}</span>{koranco.name}
                  </span>
                  <span class="artifact__plate artifact__plate--record">
                    <span class="record-sheet__head">
                      <span>Module index</span>
                      <span class="record-sheet__stamp">No public artifact</span>
                    </span>
                    <span class="record-sheet__rows">
                      {korancoModules.map((module, index) => (
                        <span class="record-sheet__row">
                          <span>{String(index + 1).padStart(2, '0')}</span>
                          <span>{module}</span>
                        </span>
                      ))}
                    </span>
                  </span>
                </span>

                <span class="artifact__label" data-artifact-label>
                  <span class="artifact__heading">
                    <span class="artifact__kicker">
                      {entries.koranco.number} · {entries.koranco.role} · {entries.koranco.artifact}
                    </span>
                    <h2 class="artifact__name" id="artifact-koranco-name">{koranco.name}</h2>
                  </span>
                  <span class="artifact__detail">
                    <span class="artifact__short" id="artifact-koranco-short">{koranco.short}</span>
                    <span class="artifact__meta">
                      <span class:list={['artifact__status', `artifact__status--${koranco.status}`]}>
                        <span class="artifact__dot" aria-hidden="true"></span>{statusLabel[koranco.status]}
                      </span>
                      <span class="artifact__stack">{entries.koranco.meta}</span>
                      <span class="artifact__open">Open <span aria-hidden="true">→</span></span>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          </ol>

          <p class="archive-hint" aria-hidden="true" data-archive-hint>
            Scroll to separate <span>↓</span>
          </p>
        </div>
      </div>
    </section>

    <!-- The evidence boundary for the archive's own artifacts, stated
         in this view (AGENTS.md §5). -->
    <footer
      class="archive-boundary page-shell"
      data-workspace-section="boundary"
      data-workspace-label="Evidence boundary"
      aria-labelledby="archive-boundary-title"
    >
      <p class="mono-label">What the artifacts are</p>
      <div class="archive-boundary__body">
        <h2 id="archive-boundary-title">Every object above is real material, or says it isn’t.</h2>
        <dl class="archive-boundary__list">
          <div>
            <dt><a href={syncareer.route}>{syncareer.name}</a></dt>
            <dd>Screenshots of the live product’s interface.</dd>
          </div>
          <div>
            <dt><a href={sessionbook.route}>{sessionbook.name}</a></dt>
            <dd>An excerpt of the booking service code in the public repository.</dd>
          </div>
          <div>
            <dt><a href={koranco.route}>{koranco.name}</a></dt>
            <dd>No public repository or screenshots exist. The record lists the modules that were delivered.</dd>
          </div>
        </dl>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  /* ARCHIVE ENGINE — scroll progress → composition.
     The ClientRouter swaps pages without re-running bundled scripts,
     so init runs on `astro:page-load` (also fired on first load). A
     marker keeps it idempotent; an AbortController removes the
     previous run's listeners. */
  let teardown: (() => void) | null = null;

  const init = () => {
    const archive = document.querySelector<HTMLElement>('[data-archive]');
    if (!archive || archive.dataset.archiveEnhanced === '1') return;
    archive.dataset.archiveEnhanced = '1';

    teardown?.();
    const events = new AbortController();
    teardown = () => events.abort();
    const signal = events.signal;

    const stage = archive.querySelector<HTMLElement>('[data-archive-stage]');
    const field = archive.querySelector<HTMLElement>('[data-archive-field]');
    const sticky = archive.querySelector<HTMLElement>('.archive-stage__sticky');
    const hint = archive.querySelector<HTMLElement>('[data-archive-hint]');
    const meter = archive.querySelector<HTMLElement>('[data-archive-progress]');
    const phaseItems = Array.from(archive.querySelectorAll<HTMLElement>('[data-archive-phase]'));
    const items = Array.from(archive.querySelectorAll<HTMLElement>('[data-artifact]')).map((item) => ({
      item,
      object: item.querySelector<HTMLElement>('[data-artifact-object]')!,
      label: item.querySelector<HTMLElement>('[data-artifact-label]')!,
      captures: Array.from(item.querySelectorAll<HTMLElement>('[data-capture]')),
      rest: { cx: 0, cy: 0 },
    }));
    if (!stage || !field || !sticky || items.length === 0) return;

    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    /* Must match the CSS pile-mode query below. */
    const pileQuery = window.matchMedia('(min-width: 60rem) and (min-height: 40rem)');

    /* THE PILE. Offsets are fractions of the field, relative to its
       centre; scale shrinks each object so the cluster is compact.
       Back objects sit higher so every tab stays readable. Index
       order = stacking order: the flagship lies on top. */
    const pile = [
      { x: -0.03, y: 0.06, rotate: -1.6, scale: 0.66 },
      { x: 0.17, y: -0.14, rotate: 4.2, scale: 0.82 },
      { x: -0.19, y: -0.1, rotate: -5.4, scale: 0.82 },
    ];
    /* Flagship captures fan out from behind the primary screen. */
    const fanFrom = [
      { x: 0, y: 0, rotate: 0 },
      { x: -0.34, y: 0.12, rotate: -5 },
      { x: -0.28, y: -0.16, rotate: 6 },
    ];

    const clamp = (v: number, min = 0, max = 1) => Math.min(Math.max(v, min), max);
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    let mode: 'pile' | 'stack' | 'static' = 'static';
    let frame = 0;
    let forced = false;
    let previousPhase = -1;
    let fieldW = 0;
    let fieldH = 0;

    const clearAll = () => {
      for (const entry of items) {
        entry.object.style.transform = '';
        entry.item.style.zIndex = '';
        entry.label.style.opacity = '';
        entry.label.style.transform = '';
        entry.label.style.pointerEvents = '';
        entry.captures.forEach((capture) => (capture.style.transform = ''));
      }
      if (hint) hint.style.opacity = '';
    };

    /* Measure resting (untransformed) centres relative to the field.
       Runs on init and resize only, never per scroll frame. */
    const measure = () => {
      for (const entry of items) entry.object.style.transform = 'none';
      const fieldRect = field.getBoundingClientRect();
      fieldW = fieldRect.width;
      fieldH = fieldRect.height;
      for (const entry of items) {
        const rect = entry.object.getBoundingClientRect();
        entry.rest = {
          cx: rect.left - fieldRect.left + rect.width / 2,
          cy: rect.top - fieldRect.top + rect.height / 2,
        };
      }
    };

    const setPhase = (phase: number) => {
      if (phase === previousPhase) return;
      previousPhase = phase;
      stage.dataset.archivePhase = ['cluster', 'separate', 'reveal', 'inspect'][phase];
      phaseItems.forEach((li, index) => (li.dataset.active = index === phase ? 'true' : 'false'));
    };

    const stageProgress = () => {
      if (forced) return 1;
      const travel = Math.max(stage.offsetHeight - sticky.offsetHeight, 1);
      return clamp(-stage.getBoundingClientRect().top / travel);
    };

    /* DESKTOP: one progress value drives the whole sequence.
         0.00–0.12  CLUSTER   pile holds
         0.12–0.66  SEPARATE  objects travel to their places (staggered)
         0.45–0.78  REVEAL    captures fan out, labels arrive
         0.80–1.00  INSPECT   final composition, every route open */
    const renderPile = () => {
      const p = stageProgress();
      items.forEach((entry, index) => {
        const spot = pile[index] ?? pile[pile.length - 1];
        const e = ease(clamp((p - 0.12 - index * 0.06) / 0.42));
        const dx = fieldW / 2 + spot.x * fieldW - entry.rest.cx;
        const dy = fieldH / 2 + spot.y * fieldH - entry.rest.cy;
        const k = 1 - e;
        entry.object.style.transform =
          `translate3d(${(dx * k).toFixed(1)}px, ${(dy * k).toFixed(1)}px, 0) ` +
          `rotate(${(spot.rotate * k).toFixed(2)}deg) scale(${lerp(spot.scale, 1, e).toFixed(4)})`;
        entry.item.style.zIndex = String(10 - index);

        const r = ease(clamp((p - 0.5 - index * 0.06) / 0.2));
        entry.label.style.opacity = r.toFixed(3);
        entry.label.style.transform = `translate3d(0, ${((1 - r) * 14).toFixed(1)}px, 0)`;
        entry.label.style.pointerEvents = r > 0.6 ? '' : 'none';

        if (entry.captures.length > 1) {
          const f = ease(clamp((p - 0.45) / 0.28));
          entry.captures.forEach((capture, ci) => {
            if (ci === 0) return;
            const from = fanFrom[ci] ?? fanFrom[fanFrom.length - 1];
            const w = capture.offsetWidth;
            capture.style.transform =
              `translate3d(${(from.x * w * (1 - f)).toFixed(1)}px, ${(from.y * w * (1 - f)).toFixed(1)}px, 0) ` +
              `rotate(${(from.rotate * (1 - f)).toFixed(2)}deg)`;
          });
        }
      });

      if (hint) hint.style.opacity = String(1 - clamp(p / 0.12));
      if (meter) meter.style.transform = `scaleX(${p.toFixed(4)})`;
      setPhase(p < 0.12 ? 0 : p < 0.5 ? 1 : p < 0.8 ? 2 : 3);
    };

    /* NARROW: no pile, no pinning. Each artifact starts tucked under
       the one above (offset, slightly turned) and settles into place
       as it crosses the lower half of the viewport. Same four ideas,
       read one object at a time. */
    const stackTurn = [0, 2.4, -2.8];
    const renderStack = () => {
      const vh = window.innerHeight;
      items.forEach((entry, index) => {
        if (index === 0 || forced) {
          entry.object.style.transform = '';
          entry.label.style.opacity = '';
          entry.label.style.transform = '';
          return;
        }
        const top = entry.item.getBoundingClientRect().top;
        const e = ease(clamp((vh * 0.96 - top) / (vh * 0.5)));
        const k = 1 - e;
        entry.object.style.transform =
          `translate3d(0, ${(-48 * k).toFixed(1)}px, 0) rotate(${((stackTurn[index] ?? 0) * k).toFixed(2)}deg)`;
        entry.item.style.zIndex = String(index + 1);
        const r = clamp((e - 0.35) / 0.55);
        entry.label.style.opacity = r.toFixed(3);
        entry.label.style.transform = `translate3d(0, ${((1 - r) * 10).toFixed(1)}px, 0)`;
      });
    };

    const update = () => {
      frame = 0;
      if (mode === 'pile') renderPile();
      else if (mode === 'stack') renderStack();
    };
    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    const syncMode = () => {
      const next = reducedQuery.matches ? 'static' : pileQuery.matches ? 'pile' : 'stack';
      stage.dataset.archiveMode = next;
      archive.classList.toggle('is-animated', next !== 'static');
      clearAll();
      mode = next;
      previousPhase = -1;
      if (mode === 'pile') measure();
      if (mode === 'static') setPhase(3);
      update();
    };

    /* KEYBOARD: focusing any artifact presents the finished
       composition, so the focused link, its label and its outline are
       where they appear. Leaving the archive hands control back to
       scroll. A short settle class animates the change (not under
       reduced motion — that mode never runs this engine). */
    let settleTimer = 0;
    const settle = () => {
      archive.classList.add('is-settling');
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => archive.classList.remove('is-settling'), 480);
    };
    field.addEventListener('focusin', () => {
      if (forced || mode === 'static') return;
      forced = true;
      settle();
      requestUpdate();
    }, { signal });
    field.addEventListener('focusout', (event) => {
      if (field.contains(event.relatedTarget as Node | null)) return;
      if (!forced) return;
      forced = false;
      settle();
      requestUpdate();
    }, { signal });

    window.addEventListener('scroll', requestUpdate, { passive: true, signal });
    window.addEventListener('resize', () => {
      if (mode === 'pile') measure();
      requestUpdate();
    }, { passive: true, signal });
    reducedQuery.addEventListener('change', syncMode, { signal });
    pileQuery.addEventListener('change', syncMode, { signal });

    /* Fonts and the flagship image can shift the grid after first
       paint; re-measure once they settle. */
    document.fonts?.ready.then(() => { if (mode === 'pile') { measure(); requestUpdate(); } });
    window.addEventListener('load', () => { if (mode === 'pile') { measure(); requestUpdate(); } }, { once: true, signal });

    syncMode();
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* ============================================================
     THE ARCHIVE
     Default styles describe the FINAL composition. Motion is an
     overlay applied by the engine, never the source of layout.
     ============================================================ */

  .archive {
    border-bottom: var(--border-default);
  }

  .archive-stage {
    position: relative;
    background: var(--color-sheet-soft);
    /* The pile may lean an object past the field edge; clip (not
       hidden) so no horizontal scrollbar appears and sticky still
       works. */
    overflow-x: clip;
  }

  .archive-stage__sticky {
    display: grid;
    align-content: start;
    gap: clamp(var(--space-5), 3vw, var(--space-7));
    padding-block: clamp(var(--space-6), 4vw, var(--space-8)) clamp(var(--space-8), 6vw, var(--space-9));
  }

  /* ---------- Head ------------------------------------------- */

  .archive-head {
    display: grid;
    gap: var(--space-5);
    align-items: end;
  }

  .archive-head__copy {
    display: grid;
    gap: var(--space-3);
  }

  .archive-head h1 {
    margin: 0;
    font-size: var(--text-feature);
    line-height: var(--leading-statement);
  }

  .archive-head__lede {
    max-width: 44ch;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .archive-head__instrument {
    display: none;
  }

  .archive-phases {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
