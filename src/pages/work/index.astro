      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }

  /* ---------- Reduced motion ----------------------------------
     The engine does not run; this guards the hover lift too. */
  @media (prefers-reduced-motion: reduce) {
    .artifact__plate {
      transition: none;
    }

    .artifact__link:hover .artifact__plate,
    .artifact__link:focus-visible .artifact__plate {
      translate: none;
    }

    .artifact__object {
      will-change: auto;
    }
  }
</style>
