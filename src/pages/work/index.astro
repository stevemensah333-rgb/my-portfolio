  /* ---------- The catalogue label ----------------------------- */

  .artifact__label {
    display: grid;
    gap: var(--space-2);
  }

  .artifact__heading,
  .artifact__detail {
    display: grid;
    gap: var(--space-2);
  }

  .artifact__kicker,
  .artifact__status,
  .artifact__stack,
  .artifact__open {
    font-family: var(--font-instrument);
    font-size: var(--text-micro);
