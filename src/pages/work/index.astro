  }

  .code-sheet__head,
  .code-sheet__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-instrument);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
