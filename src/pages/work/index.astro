    width: 100%;
    height: 100%;
  }

  .capture img {
    object-fit: cover;
    object-position: top left;
  }

  .capture--0 {
    inset: 0 17% 12% 0;
    z-index: 1;
  }

  .capture--1,
  .capture--2 {
    z-index: 2;
    width: 36%;
    aspect-ratio: 2400 / 1302;
  }

  .capture--1 {
    top: 9%;
    right: 0;
  }

  .capture--2 {
    right: 9%;
    bottom: 0;
  }

  /* SessionBook: a code sheet — technical material, so it is set on
     the instrument surface (DARK = INSTRUMENTATION). */
  .artifact__plate--code {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    border-color: var(--color-deck-inset);
    background: var(--color-deck);
