  }

  .artifact__link:hover .artifact__plate,
  .artifact__link:focus-visible .artifact__plate {
    translate: 0 -4px;
  }

  /* Flagship: a set of real screen captures laid over one another. */
  .artifact__plate--captures {
    aspect-ratio: 16 / 10.5;
    border: 0;
    box-shadow: none;
  }

  .capture {
    position: absolute;
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-rule-on-paper-strong);
