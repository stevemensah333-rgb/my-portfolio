---
import { GMAIL_COMPOSE_URL } from '../../config/site';
import { sessionbook } from '../../data/registry';
import ProjectSection from '../../components/ProjectSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFrame from '../../components/SectionFrame.astro';

const title = `${sessionbook.name} — Backend Case Study | Stephen Mensah`;
const description = `${sessionbook.short} A FastAPI + Postgres service with double-booking protection, timezone correctness, and spoken-output design.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${sessionbook.name} — Backend Case Study`,
  headline: sessionbook.claim,
  description,
  url: new URL(sessionbook.route, Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  about: {
    '@type': 'SoftwareSourceCode',
    name: sessionbook.name,
    codeRepository: 'https://github.com/stevemensah333-rgb/sessionbook',
  },
};
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  ogType="article"
>
  <article class="case-page">
    <header id="overview" class="case-hero page-shell" data-workspace-section="top">
      <a class="back-link" href="/#sessionbook">← Back to workspace</a>

      <div class="case-opening">
        <div>
          <p class="mono-label">Case study · {sessionbook.name}</p>
          <h1>Concurrency, not the model, is the boundary.</h1>
          <p class="case-summary">
            {sessionbook.claim} This case study states what the repository actually
            implements — the verified booking engine — and what is honestly in progress.
          </p>
        </div>

        <aside class="product-record" aria-label={`${sessionbook.name} product record`}>
          <div class="record-heading">
            <p>Product record · 01</p>
            <span>{sessionbook.status === 'in-progress' ? 'In progress' : sessionbook.status}</span>
          </div>
          <p class="product-record__name">{sessionbook.name}</p>
          <dl>
            <div><dt>Type</dt><dd>Backend service</dd></div>
            <div><dt>Framework</dt><dd>FastAPI</dd></div>
            <div><dt>Database</dt><dd>Postgres 16</dd></div>
            <div><dt>Status</dt><dd>{sessionbook.status === 'in-progress' ? 'In progress — voice agent pending' : sessionbook.status}</dd></div>
            <div><dt>Evidence</dt><dd><a href="https://github.com/stevemensah333-rgb/sessionbook" target="_blank" rel="noopener">Source repository <span aria-hidden="true">↗</span></a></dd></div>
          </dl>
        </aside>
      </div>
    </header>

    <SectionFrame coordinate="01 / Trace context" surface="paper" data-workspace-section="sessionbook">
      <div class="page-shell trace-context">
        <div class="trace-context__copy">
          <p class="mono-label">Reliability trace</p>
          <h2>From caller request to confirmed booking.</h2>
          <p>
            The trace follows the booking service through the same stages as the
            Syncareer reliability case — request, validation, failure, diagnosis,
            intervention, output — applied here to the booking-engine domain.
          </p>
        </div>
      </div>
    </SectionFrame>

    <ProjectSection
      project={sessionbook}
      anchorId="trace"
      coordinate="02 / Stage inspector"
      showNarrative={false}
    />

    <SectionFrame coordinate="03 / Evidence & limitations" surface="paper" data-workspace-section="evidence">
      <div class="page-shell">
        <div class="outcome-grid">
          <section class="boundary-panel" aria-labelledby="boundary-title">
            <p class="mono-label">What this does not prove yet</p>
            <h2 id="boundary-title">Evidence boundary</h2>
            <ul class="boundary-list">
              <li data-state="known">Booking service implements double-booking protection</li>
              <li data-state="known">Pydantic contracts at the boundary</li>
              <li data-state="known">Timezone handling via ZoneInfo</li>
              <li data-state="known">Spoken-output design for the agent</li>
              <li data-state="missing">No AssemblyAI voice-agent integration implemented</li>
              <li data-state="missing">No HTTP tool routes implemented</li>
              <li data-state="missing">No migrations or test coverage supplied</li>
              <li data-state="missing">No deployment, latency, or live-call metrics</li>
            </ul>
          </section>

          <section class="boundary-panel" aria-labelledby="status-title">
            <p class="mono-label">Current status</p>
            <h2 id="status-title">What is being built next</h2>
            <ul class="boundary-list">
              <li data-state="known">Voice-agent JSON configuration</li>
              <li data-state="known">HTTP tools that point at the booking API</li>
              <li data-state="known">Alembic migration history</li>
              <li data-state="known">End-to-end test coverage</li>
            </ul>
            <p class="case-content-note">
              When those land, the case study is updated. Until then, the booking engine is the
              only verified surface.
            </p>
          </section>
        </div>
      </div>
    </SectionFrame>

    <div class="case-content page-shell">
      <section
        id="contact-section"
        class="contact-section"
        aria-labelledby="contact-title"
        data-workspace-section="contact"
      >
        <p class="mono-label">Contact</p>
        <h2 id="contact-title">Want to talk through the design?</h2>
        <a class="button" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">Email Stephen</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .case-page {
    border-bottom: var(--border-default);
  }

  .case-hero {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .case-opening {
    display: grid;
    gap: clamp(var(--space-5), 2.5vw, var(--space-6));
  }

  .back-link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    margin-bottom: var(--space-4);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .case-hero h1 {
    max-width: 18ch;
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-feature);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .case-summary {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .product-record {
    position: relative;
    align-self: end;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    overflow: hidden;
  }

  .record-heading {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .record-heading p,
  .record-heading span,
  .product-record dt {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .record-heading span {
    color: var(--color-accent);
  }

  .product-record h2 {
    margin-block: var(--space-5) var(--space-4);
    font-size: var(--text-component);
    font-weight: 600;
  }

  .product-record__name {
    margin: 0 0 var(--space-4);
    font-size: var(--text-component);
    font-weight: 600;
  }

  .product-record dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .product-record dl div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .product-record dd {
    margin: 0;
    font-size: var(--text-small);
  }

  .product-record a {
    font-weight: 600;
    color: var(--color-text-on-paper);
    text-decoration: none;
  }

  .product-record a:hover {
    color: var(--color-accent);
  }

  .trace-context {
    padding-block: var(--section-block);
  }

  .trace-context__copy {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .trace-context__copy h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .trace-context__copy p:last-child {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .outcome-grid {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .boundary-panel {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .boundary-panel h2 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
  }

  .boundary-list {
    display: grid;
    margin: var(--space-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-on-paper);
    list-style: none;
  }

  .boundary-list li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  .boundary-list li::before {
    position: absolute;
    left: 0;
    color: var(--color-text-on-paper-muted);
    content: '—';
    font-family: var(--font-mono);
  }

  .boundary-list li[data-state='known']::before {
    color: var(--color-signal-pass);
    content: '✓';
  }

  .boundary-list li[data-state='missing']::before {
    color: var(--color-signal-fail);
    content: '×';
  }

  .case-content {
    padding-bottom: var(--space-6);
  }

  .case-content section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .case-content-note {
    margin: var(--space-3) 0 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .contact-section h2 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .contact-section .button {
    margin-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    .outcome-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .case-opening {
      grid-template-columns: minmax(0, 7fr) minmax(19rem, 5fr);
      align-items: end;
    }
  }

  @media (max-width: 30rem) {
    .case-hero h1 {
      font-size: 1.75rem;
    }
  }
</style>
