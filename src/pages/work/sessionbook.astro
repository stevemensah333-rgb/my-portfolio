---
import { GMAIL_COMPOSE_URL } from '../../config/site';
import { sessionbook } from '../../data/registry';
import {
  sessionbookMeta,
  sessionbookPrimer,
  sessionbookQuestions,
  sessionbookBoundary,
} from '../../data/sessionbook';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFrame from '../../components/SectionFrame.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import SessionBookArchitecture from '../../components/SessionBookArchitecture.astro';
import SessionBookWalkthrough from '../../components/SessionBookWalkthrough.astro';

const title = `${sessionbook.name} — Voice-Agent Backend Case Study | Stephen Mensah`;
const description = `${sessionbook.name} is a FastAPI backend for voice-driven appointment booking using AssemblyAI Voice Agent capabilities: availability, atomic booking, and spoken responses. What the repo verifies, and what is still in progress.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${sessionbook.name} — Voice-Agent Backend Case Study`,
  headline: 'A small backend for a conversation it will never hear',
  description,
  url: new URL(sessionbook.route, Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  about: {
    '@type': 'SoftwareSourceCode',
    name: sessionbook.name,
    codeRepository: sessionbookMeta.repoUrl,
  },
};

const architectureSummary =
  'Caller → Voice Agent → HTTP tool call → SessionBook backend → booking / availability logic → response → Voice Agent → spoken response';
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  ogType="article"
>
  <article class="case-page">
    <!-- 00 · Overview -->
    <header id="overview" class="case-hero page-shell" data-workspace-section="top" data-workspace-dest="work">
      <a class="back-link" href="/#sessionbook">← Back to workspace</a>

      <div class="case-opening">
        <div class="case-opening__copy">
          <p class="mono-label">Backend case study · {sessionbook.name} · In development</p>
          <h1>A small backend for a conversation it will never hear.</h1>
          <p class="case-summary">
            {sessionbook.short} The engine that decides correctness — availability,
            atomic booking, spoken responses — is written. The voice agent that will
            talk to it is not wired up yet, and the page says so at every step.
          </p>
        </div>

        <aside class="product-record" aria-label={`${sessionbook.name} product record`}>
          <div class="record-heading">
            <p>System record · 02</p>
            <span>In development</span>
          </div>
          <p class="product-record__name">{sessionbook.name}</p>
          <p class="product-record__position">
            A backend utility for appointment / booking workflows using AssemblyAI
            Voice Agent capabilities. Small system, one interesting engineering
            problem.
          </p>
          <dl>
            <div><dt>Type</dt><dd>Backend utility (not a product)</dd></div>
            <div><dt>Role</dt><dd>Booking engine behind a voice agent</dd></div>
            <div><dt>Framework</dt><dd>FastAPI</dd></div>
            <div><dt>Database</dt><dd>Postgres 16 (local compose)</dd></div>
            <div><dt>Status</dt><dd>Voice-agent integration in progress</dd></div>
            <div>
              <dt>Source</dt>
              <dd>
                <a href={sessionbookMeta.repoUrl} target="_blank" rel="noopener">View repository <span aria-hidden="true">↗</span></a>
              </dd>
            </div>
            <div>
              <dt>Reference</dt>
              <dd>
                <a href={sessionbookMeta.tutorialUrl} target="_blank" rel="noopener">AssemblyAI HTTP-tools tutorial <span aria-hidden="true">↗</span></a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>

      <p class="case-note">
        Grounded in the SessionBook repository at commit {sessionbookMeta.repoCommit}
        ({sessionbookMeta.repoCommitDate}). The
        <a href={sessionbookMeta.tutorialUrl} target="_blank" rel="noopener">AssemblyAI HTTP-tools tutorial</a>
        is conceptual reference only — it shapes what is being aimed at, and is never
        presented as something SessionBook already does.
      </p>
    </header>

    <!-- 01 · Primer -->
    <SectionFrame coordinate="01 / Why this exists" surface="paper" data-workspace-section="primer" data-workspace-dest="work">
      <div class="page-shell primer">
        <div class="primer__intro">
          <p class="mono-label">Four anchors</p>
          <h2>The four questions the page answers.</h2>
        </div>
        <ol class="primer__grid">
          {sessionbookPrimer.map((item, idx) => (
            <li>
              <p class="mono-label primer__num">{String(idx + 1).padStart(2, '0')}</p>
              <h3>{item.question}</h3>
              <p class="primer__answer">{item.answer}</p>
              <p class="primer__evidence">{item.evidence}</p>
            </li>
          ))}
        </ol>
      </div>
    </SectionFrame>

    <!-- 02 · Architecture -->
    <SectionFrame
      coordinate="02 / Architecture"
      surface="paper"
      data-workspace-section="architecture" data-workspace-dest="work"
    >
      <div class="page-shell architecture">
        <header class="architecture__intro">
          <p class="mono-label">Inspect the path</p>
          <h2>Eight nodes, nothing more.</h2>
          <p>
            {architectureSummary}
          </p>
          <p class="architecture__note">
            Only the components that actually exist are shown. There is no queue, no
            message bus, no external calendar service, no analytics — none of that is
            in the repository, so none of it appears here.
          </p>
          <p class="architecture__legend">
            <span class="visually-hidden">Legend: </span>
            <span class="arch-chip arch-chip--present">Present</span>
            <span class="arch-chip arch-chip--in-progress">In progress</span>
            <span class="arch-chip arch-chip--written">Written, not served</span>
            <span class="arch-chip arch-chip--external">External actor</span>
          </p>
        </header>

        <SessionBookArchitecture />

        <div class="architecture__rows">
          <dl class="ownership">
            <div>
              <dt>SessionBook owns</dt>
              <dd>availability and booking logic · timezone correctness · reservation safety · what a confirmation sounds like</dd>
            </div>
            <div>
              <dt>AssemblyAI owns</dt>
              <dd>transcription · the dialogue · tool invocation · speech</dd>
            </div>
            <div>
              <dt>One distinction</dt>
              <dd>
                The stored agent configuration (name, voice, prompt, tool definitions)
                and the live booking data (slots, bookings) are separate concerns. The
                agent document describes what can be called; the database holds what is
                true right now.
              </dd>
            </div>
            <div>
              <dt>Shared boundary</dt>
              <dd>plain HTTP requests carrying only what the caller said — name, phone, chosen slot</dd>
            </div>
          </dl>
        </div>
      </div>
    </SectionFrame>

    <!-- 03 · Trace (data-driven from the registry) -->
    <ProjectSection
      project={sessionbook}
      anchorId="trace"
      coordinate="03 / Stage inspector"
      showNarrative={false}
    />

    <!-- 04 · Walkthrough -->
    <SectionFrame
      coordinate="04 / Call path"
      surface="paper"
      data-workspace-section="flow" data-workspace-dest="work"
    >
      <div class="page-shell flow">
        <header class="flow__intro">
          <p class="mono-label">Make the flow inspectable</p>
          <h2>Tool → request → processing → response.</h2>
          <p>
            Four steps, each labelled honest: real implementation excerpts are marked
            as excerpts, and scripted payloads are marked illustrative. Nothing here is
            a live capture — no call has ever run.
          </p>
        </header>

        <SessionBookWalkthrough />
      </div>
    </SectionFrame>

    <!-- 05 · Questions -->
    <SectionFrame coordinate="05 / Questions" surface="paper" data-workspace-section="questions" data-workspace-dest="work">
      <div class="page-shell questions">
        <header class="questions__intro">
          <p class="mono-label">Asked directly</p>
          <h2>Short answers to the questions that matter.</h2>
        </header>
        <ol class="questions__list">
          {sessionbookQuestions.map((item, idx) => (
            <li>
              <p class="mono-label questions__num">{String(idx + 1).padStart(2, '0')}</p>
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </li>
          ))}
        </ol>
      </div>
    </SectionFrame>

    <!-- 06 · Boundary -->
    <SectionFrame coordinate="06 / Evidence" surface="paper" data-workspace-section="evidence" data-workspace-dest="work">
      <div class="page-shell">
        <div class="boundary">
          <section class="boundary-panel" aria-labelledby="sb-known-title">
            <p class="mono-label">Verified in the repository</p>
            <h2 id="sb-known-title">What exists now</h2>
            <ul class="boundary-list">
              {sessionbookBoundary.known.map((item) => (
                <li data-state="known">{item}</li>
              ))}
            </ul>
          </section>

          <section class="boundary-panel" aria-labelledby="sb-missing-title">
            <p class="mono-label">Not yet true</p>
            <h2 id="sb-missing-title">Evidence boundary</h2>
            <ul class="boundary-list">
              {sessionbookBoundary.missing.map((item) => (
                <li data-state="missing">{item}</li>
              ))}
            </ul>
            <p class="boundary-note">
              UNKNOWN covers everything that depends on real traffic: call volume,
              latency, success rate, and how the agent behaves in conversation.
            </p>
          </section>
        </div>
      </div>
    </SectionFrame>

    <!-- Contact -->
    <div class="case-content page-shell">
      <section
        id="contact-section"
        class="contact-section"
        aria-labelledby="contact-title"
        data-workspace-section="contact"
      >
        <p class="mono-label">Contact</p>
        <h2 id="contact-title">Want to talk through the boundary design?</h2>
        <a class="button" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">Email Stephen</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .case-page {
    border-bottom: var(--border-default);
  }

  /* --- Hero ------------------------------------------------------- */
  .case-hero {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .case-opening {
    display: grid;
    gap: clamp(var(--space-5), 2.5vw, var(--space-6));
  }

  .back-link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    margin-bottom: var(--space-4);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent-text);
  }

  .case-opening__copy h1 {
    max-width: 18ch;
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-feature);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .case-summary {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .case-note {
    max-width: var(--width-reading);
    margin: var(--space-6) 0 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-meta);
    line-height: 1.5;
    border-top: 1px solid var(--color-rule-on-paper-soft);
    padding-top: var(--space-4);
  }

  .case-note a {
    color: var(--color-text-on-paper);
    font-weight: 600;
  }

  .case-note a:hover {
    color: var(--color-accent-text);
  }

  .product-record {
    position: relative;
    align-self: end;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    overflow: hidden;
  }

  .record-heading {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .record-heading p,
  .record-heading span,
  .product-record dt {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .record-heading span {
    color: var(--color-accent-text);
  }

  .product-record__name {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-component);
    font-weight: 600;
  }

  .product-record__position {
    margin: 0 0 var(--space-4);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .product-record dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .product-record dl div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .product-record dd {
    margin: 0;
    font-size: var(--text-small);
  }

  .product-record a {
    font-weight: 600;
    color: var(--color-text-on-paper);
    text-decoration: none;
  }

  .product-record a:hover {
    color: var(--color-accent-text);
  }

  /* --- Primer ----------------------------------------------------- */
  .primer {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .primer__intro,
  .architecture__intro,
  .flow__intro,
  .questions__intro {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .primer__intro h2,
  .architecture__intro h2,
  .flow__intro h2,
  .questions__intro h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .primer__grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: primer;
  }

  .primer__grid li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .primer__num {
    color: var(--color-accent-text);
  }

  .primer__grid h3 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
    line-height: 1.2;
  }

  .primer__answer {
    margin: 0;
    color: var(--color-text-on-paper);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .primer__evidence {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-meta);
    line-height: 1.5;
  }

  /* --- Architecture ---------------------------------------------- */
  .architecture {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .architecture__intro p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .architecture__note {
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  .architecture__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .arch-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.0625rem 0.5rem;
    border: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    line-height: 1.6;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .arch-chip--present {
    border-color: var(--color-signal-pass);
    color: var(--color-signal-pass-text);
  }

  .arch-chip--in-progress {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .arch-chip--written {
    border-style: dashed;
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .arch-chip--external {
    border-style: dotted;
  }

  .ownership {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .ownership div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-accent);
    background: var(--color-paper-soft);
  }

  .ownership dt {
    color: var(--color-text-on-paper);
    font-weight: 600;
    font-size: var(--text-small);
  }

  .ownership dd {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* --- Walkthrough ------------------------------------------------- */
  .flow {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .flow__intro p {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* --- Questions ---------------------------------------------------- */
  .questions {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .questions__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .questions__list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .questions__num {
    grid-row: span 2;
    color: var(--color-accent-text);
  }

  .questions__list h3 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
    line-height: 1.25;
  }

  .questions__list p:last-child {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* --- Boundary ----------------------------------------------------- */
  .boundary {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .boundary-panel {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .boundary-panel h2 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
  }

  .boundary-list {
    display: grid;
    margin: var(--space-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-on-paper);
    list-style: none;
  }

  .boundary-list li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .boundary-list li::before {
    position: absolute;
    left: 0;
    color: var(--color-text-on-paper-muted);
    content: '\2014';
    font-family: var(--font-mono);
  }

  .boundary-list li[data-state='known']::before {
    color: var(--color-signal-pass-text);
    content: '\2713';
  }

  .boundary-list li[data-state='missing']::before {
    color: var(--color-signal-fail-text);
    content: '\00d7';
  }

  .boundary-note {
    margin: var(--space-3) 0 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* --- Contact ------------------------------------------------------- */
  .case-content {
    padding-bottom: var(--space-6);
  }

  .contact-section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .contact-section h2 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .contact-section .button {
    margin-top: var(--space-3);
  }

  /* --- Responsive ---------------------------------------------------- */
  @media (min-width: 48rem) {
    .primer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ownership {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .boundary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .case-opening {
      grid-template-columns: minmax(0, 7fr) minmax(19rem, 5fr);
      align-items: end;
    }
  }

  @media (max-width: 30rem) {
    .case-opening__copy h1 {
      font-size: 1.75rem;
    }

    .questions__list li {
      grid-template-columns: 1fr;
    }

    .questions__num {
      grid-row: auto;
    }
  }
</style>
