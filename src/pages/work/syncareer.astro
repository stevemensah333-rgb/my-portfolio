---
/**
 * /work/syncareer — the canonical Syncareer case study.
 *
 * Structure (AGENTS.md §5): 01 PRODUCT → 02 FAILURE → 03 INVESTIGATION →
 * 04 INTERVENTION → 05 RESULT, with the seven-stage system inside 03.
 *
 * Composition: five sections, each anchored by a large artifact —
 *   01 PRODUCT       the SynAI interface (product record beside it)
 *   02 FAILURE       the documented old contract, as a dark slab
 *   03 INVESTIGATION the interactive seven-stage system (the spine)
 *   04 INTERVENTION  the before/after contract, at display scale
 *   05 RESULT        the evidence boundary itself
 *
 * Density rule: every fact is explained once, on the section that owns it
 * (see the doc comment in src/data/syncareerInvestigation.ts). The other
 * sections reference or visualise it — stage 04 points back to 02, stage 05
 * to 02 and 04, stage 06 to 04, and the deployment status lives only in 05.
 *
 * No JavaScript gates any of it: the whole story reads top to bottom, and
 * the Lab (/lab/) is where the same records become operable.
 */
import { GMAIL_COMPOSE_URL } from '../../config/site';
import { syncareer } from '../../data/registry';
import {
  evidenceBoundary,
  failureRecord,
  interventionRecord,
  syncareerProduct,
} from '../../data/syncareerInvestigation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFrame from '../../components/SectionFrame.astro';
import ProductFrame from '../../components/ProductFrame.astro';
import InvestigationSystem from '../../components/InvestigationSystem.astro';

const title = `${syncareer.name} — AI-Powered Career Platform Case Study | Stephen Mensah`;
const description = `${syncareer.name} is an AI-powered career platform built for students: saved opportunity → evidence → CV → interview → outcome. How its CV assistant was rebuilt to cite requirement and evidence — and what is still unverified.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${syncareer.name} — AI-Powered Career Platform Case Study`,
  headline: 'An AI-powered career platform for students, and the contract around its model output',
  description,
  url: new URL(syncareer.route, Astro.site).href,
  image: new URL('/images/syncareer/synai-context-2400.png', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  about: {
    '@type': 'SoftwareApplication',
    name: syncareer.name,
    url: 'https://syncareer.me/',
  },
};

// Evidence links travel with the project record (single source).
const recordLinks = syncareer.evidence.filter(
  (ev) => ev.kind === 'product' || ev.kind === 'code',
);

const [dashboard, opportunities] = syncareerProduct.surfaces;
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  image="/images/syncareer/synai-context-2400.png"
  imageAlt="Syncareer SynAI career-guidance interface"
  imageWidth={2400}
  imageHeight={1302}
  ogType="article"
>
  <article class="case-page case-syncareer">
    <!-- ── 01 PRODUCT · the product and its largest artifact ────────── -->
    <header
      id="product"
      class="case-hero page-shell"
      data-workspace-section="product"
      data-workspace-label="Product"
    >
      <a class="back-link" href="/work/">← Back to the work archive</a>

      <div class="case-opening">
        <div class="case-opening__copy">
          <p class="mono-label mono-label--state">Case study · {syncareer.name} · Live</p>
          <h1>A real product, with AI help that has to cite its evidence.</h1>
          <p class="case-summary">{syncareer.claim}</p>
          <p class="case-scope">{syncareerProduct.scope}</p>
        </div>

        <aside class="product-record" aria-label={`${syncareer.name} product record`}>
          <div class="record-heading">
            <p>Product record · 01</p>
            <span>Live</span>
          </div>
          <p class="product-record__name">{syncareer.name}</p>
          <dl>
            {syncareerProduct.record.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
            {recordLinks.map((ev) => (
              <div>
                <dt>Evidence</dt>
                <dd>
                  <a href={ev.href} target="_blank" rel="noopener">
                    {ev.label} <span aria-hidden="true">↗</span>
                  </a>
                </dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>

      <div class="case-hero__artifact">
        <ProductFrame
          src1440="/images/syncareer/synai-context-1440.png"
          src1800="/images/syncareer/synai-context-1800.png"
          src2400="/images/syncareer/synai-context-2400.png"
          width={2400}
          height={1302}
          alt="Syncareer SynAI interface showing a personalised introduction using Stephen’s degree, interests and profile skills, with career guidance, CV tips, interview preparation and skill-gap actions."
          label="01 / AI feature and context"
          caption="SynAI makes the context visible before it offers anything: degree, interests and profile skills, with career guidance, CV tips, interview preparation and skill-gap actions."
          sizes="(min-width: 64rem) min(78rem, calc(100vw - 14rem)), calc(100vw - 2.25rem)"
          priority={true}
        />
      </div>
    </header>

    <!-- ── 01 PRODUCT · the workspace the assistant runs inside ─────── -->
    <section
      class="case-surfaces"
      aria-labelledby="surfaces-title"
      data-workspace-section="product-surfaces"
      data-workspace-label="Product surfaces"
    >
      <div class="page-shell case-surfaces__grid">
        <div class="case-surfaces__intro">
          <p class="mono-label">The workspace around the assistant</p>
          <h2 id="surfaces-title">Opportunity, evidence, CV, interview — one record.</h2>
          <p class="case-surfaces__lede">
            The assistant is one surface inside a product that already worked. These are the
            screens the application record lives on: what is in progress, what is saved, and
            where CV tailoring starts.
          </p>
        </div>

        <div class="case-surfaces__frame case-surfaces__frame--wide">
          <ProductFrame
            src1440="/images/syncareer/dashboard-1440.png"
            src1800="/images/syncareer/dashboard-1800.png"
            src2400="/images/syncareer/dashboard-2400.png"
            width={2400}
            height={1302}
            alt="Syncareer dashboard showing career readiness, application, CV strength and interview progress."
            label={dashboard.label}
            caption={dashboard.caption}
            address={dashboard.address}
            sizes="(min-width: 64rem) 42rem, calc(100vw - 2.25rem)"
          />
        </div>

        <div class="case-surfaces__frame case-surfaces__frame--narrow">
          <ProductFrame
            src1440="/images/syncareer/opportunities-1440.png"
            src1800="/images/syncareer/opportunities-1800.png"
            src2400="/images/syncareer/opportunities-2400.png"
            width={2400}
            height={1303}
            alt="Syncareer opportunities interface showing job search, match score, and interview / CV tailoring actions."
            label={opportunities.label}
            caption={opportunities.caption}
            address={opportunities.address}
            sizes="(min-width: 64rem) 26rem, calc(100vw - 2.25rem)"
          />
        </div>
      </div>
    </section>

    <!-- ── 02 FAILURE · the one canonical explanation ───────────────── -->
    <SectionFrame
      id="failure"
      coordinate="02 · Failure"
      status="Documented, not captured"
      surface="paper"
      density="default"
      as="section"
      label="Failure"
      data-workspace-section="failure"
      data-workspace-label="Failure"
    >
      <div class="page-shell failure">
        <div class="failure__statement">
          <h2>{failureRecord.statement}</h2>
          <p class="failure__explain">{failureRecord.explanation}</p>
          <p class="failure__impact">{failureRecord.impact}</p>
        </div>

        <div class="failure__field">
          <!-- The large failure artifact: the old contract as documented —
               what was sent, and what its absence of checks meant. -->
          <figure class="failure__slab">
            <figcaption class="failure__slab-label mono-label mono-label--inverse">
              {failureRecord.oldContract.label} · documented shape
            </figcaption>
            <dl class="failure__slab-rows">
              <div>
                <dt>request</dt>
                <dd>{failureRecord.oldContract.request}</dd>
              </div>
              {failureRecord.oldContract.gaps.map((gap) => (
                <div data-missing="true">
                  <dt>{gap.field}</dt>
                  <dd>
                    <span class="failure__gap" aria-hidden="true">—</span> {gap.note}
                  </dd>
                </div>
              ))}
            </dl>
            <figcaption class="failure__slab-source">{failureRecord.oldContract.source}</figcaption>
          </figure>

          <div class="failure__classes">
            <p class="mono-label">Observed failure classes</p>
            <ol>
              {failureRecord.classes.map((item, index) => (
                <li>
                  <span class="failure__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <h3>{item.name}</h3>
                  <p>{item.note}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <p class="failure__known">
          <span class="mono-label">How this is known</span>
          <span>{failureRecord.known}</span>
        </p>
      </div>
    </SectionFrame>

    <!-- ── 03 INVESTIGATION · the seven-stage system ────────────────── -->
    <SectionFrame
      id="investigation"
      coordinate="03 · Investigation"
      status="01 → 07 · one payload"
      surface="paper"
      density="major"
      as="section"
      label="Investigation"
      data-workspace-section="investigation"
      data-workspace-label="Investigation"
    >
      <div class="page-shell">
        <InvestigationSystem />
      </div>
    </SectionFrame>

    <!-- ── 04 INTERVENTION · what changed ───────────────────────────── -->
    <SectionFrame
      id="intervention"
      coordinate="04 · Intervention"
      status="Four documented responses"
      surface="paper"
      density="default"
      as="section"
      label="Intervention"
      data-workspace-section="intervention"
      data-workspace-label="Intervention"
    >
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">04</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">What changed</span>
          </div>
          <p class="region-index__note">A contract, not a new AI stack.</p>
        </aside>

        <div class="region-body intervention">
          <h2 class="intervention__title">The repair is a contract.</h2>
          <p class="intervention__lede">{interventionRecord.lede}</p>

          <!-- The large before/after artifact: the canonical contract
               comparison, rendered once at display scale. The Lab’s
               diagnosis stage re-exposes it at instrument scale. -->
          <div class="intervention__compare">
            <p class="mono-label">{interventionRecord.comparison.label}</p>
            <table>
              <thead>
                <tr>
                  <th scope="col">Contract</th>
                  <th scope="col">Before</th>
                  <th scope="col">After</th>
                </tr>
              </thead>
              <tbody>
                {interventionRecord.comparison.items.map((item) => (
                  <tr>
                    <th scope="row">{item.name}</th>
                    <td class="intervention__before">{item.before}</td>
                    <td>{item.after}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <ol class="intervention__responses">
            {interventionRecord.responses.map((item, index) => (
              <li>
                <p class="intervention__mark">
                  <span class="mono-label mono-label--bare">{String(index + 1).padStart(2, '0')}</span>
                  <span class="intervention__name">{item.name}</span>
                </p>
                <p class="intervention__note">{item.note}</p>
              </li>
            ))}
          </ol>

          <p class="intervention__stack">{interventionRecord.stack}</p>

          <p class="intervention__pointer">
            <a class="text-link" href="#result">
              Deployment status and the evidence boundary
              <span class="text-link__arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </SectionFrame>

    <!-- ── 05 RESULT · the evidence that exists ─────────────────────── -->
    <SectionFrame
      id="result"
      coordinate="05 · Result"
      status="No measured rate"
      surface="paper"
      density="default"
      as="section"
      label="Result"
      data-workspace-section="result"
      data-workspace-label="Result"
    >
      <div class="page-shell result">
        <div class="result__intro">
          <h2>What this shows — and what it does not.</h2>
          <p class="result__statement">{evidenceBoundary.statement}</p>
        </div>

        <div class="outcome-grid">
          <section class="boundary-panel boundary-panel--known" aria-labelledby="result-verified">
            <p class="mono-label">In tracked source</p>
            <h3 id="result-verified">Verified</h3>
            <ul class="boundary-list">
              {evidenceBoundary.known.map((item) => (
                <li data-state="known">
                  {item.text}
                  <span class="result__cite">{item.cite}</span>
                </li>
              ))}
            </ul>
          </section>

          <div class="result__side">
            <section class="boundary-panel boundary-panel--missing" aria-labelledby="result-unmeasured">
              <p class="mono-label">Never measured · not supplied</p>
              <h3 id="result-unmeasured">Not measured</h3>
              <ul class="boundary-list">
                {evidenceBoundary.missing.map((item) => (
                  <li data-state="missing">{item.text}</li>
                ))}
              </ul>
            </section>

            <aside class="result__numbers" aria-label={evidenceBoundary.numbers.label}>
              <p class="mono-label">{evidenceBoundary.numbers.label}</p>
              <p>{evidenceBoundary.numbers.body}</p>
            </aside>
          </div>
        </div>
      </div>
    </SectionFrame>

    <div class="case-content page-shell">
      <section
        id="contact-section"
        class="contact-section"
        aria-labelledby="contact-title"
        data-workspace-section="contact"
      >
        <p class="mono-label">Contact</p>
        <h2 id="contact-title">Want to talk through the engineering?</h2>
        <a class="button" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">Email Stephen</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  /* In-page anchors land below the sticky mobile control. */
  :global(.case-syncareer section[id]) {
    scroll-margin-top: 4.5rem;
  }

  /* ── 01 PRODUCT ──────────────────────────────────────────────────── */

  .case-scope {
    max-width: var(--width-reading);
    margin: var(--space-4) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-rule-on-paper-strong);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .case-hero__artifact {
    margin-top: clamp(var(--space-6), 4vw, var(--space-8));
  }

  .case-surfaces {
    padding-block: var(--section-block);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .case-surfaces__grid {
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
  }

  .case-surfaces__intro {
    display: grid;
    gap: var(--space-3);
  }

  .case-surfaces__intro h2 {
    margin: 0;
    max-width: 26ch;
    font-size: var(--text-section);
    font-weight: 600;
  }

  .case-surfaces__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* ── 02 FAILURE ──────────────────────────────────────────────────── */

  .failure {
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
  }

  .failure__statement {
    display: grid;
    gap: var(--space-3);
    padding-left: var(--space-5);
    border-left: 3px solid var(--color-signal-fail);
  }

  .failure__statement h2 {
    margin: 0;
    max-width: 20ch;
    font-size: var(--text-feature);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }

  .failure__explain,
  .failure__impact {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .failure__explain {
    font-size: var(--text-body);
  }

  .failure__impact {
    color: var(--color-text-on-paper);
  }

  .failure__classes {
    display: grid;
    gap: var(--space-3);
  }

  .failure__classes ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-on-paper-strong);
    list-style: none;
  }

  .failure__classes li {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .failure__num {
    color: var(--color-signal-fail-text);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: var(--tracking-instrument);
  }

  .failure__classes h3 {
    margin: 0;
    font-size: var(--text-component);
  }

  .failure__classes p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .failure__known {
    display: grid;
    gap: var(--space-2);
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* The large failure artifact: the old contract as a payload under
     inspection — a dark slab in the light page, the same instrument
     language the spine uses. The absence is the point, so the missing
     fields are marked in fail signal, not hidden. */
  .failure__field {
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
  }

  .failure__slab {
    margin: 0;
    border: 1px solid var(--color-rule-on-canvas-strong);
    background: var(--color-deck-soft);
  }

  .failure__slab-label {
    display: block;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .failure__slab-rows {
    margin: 0;
  }

  .failure__slab-rows > div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-canvas-soft);
  }

  .failure__slab-rows > div:last-child {
    border-bottom: 0;
  }

  .failure__slab-rows dt {
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .failure__slab-rows dd {
    margin: 0;
    color: var(--color-text-on-canvas);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .failure__slab-rows [data-missing='true'] dd {
    color: var(--color-signal-fail-bright);
  }

  .failure__slab-source {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck);
    color: var(--color-text-on-canvas-faint);
    font-size: var(--text-instrument-sm);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .failure__slab-rows > div {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: baseline;
    }
  }

  /* ── 04 INTERVENTION ─────────────────────────────────────────────── */

  .intervention {
    display: grid;
    gap: var(--space-5);
  }

  .intervention__title {
    margin: 0;
    max-width: 26ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.15;
  }

  .intervention__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* The large before/after artifact — the canonical contract comparison,
     at display scale. The rows state the change; the four responses below
     state the engineering behind it. Nothing here is re-narrated. */
  .intervention__compare {
    display: grid;
    gap: var(--space-3);
    max-width: 56rem;
  }

  .intervention__compare table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .intervention__compare th,
  .intervention__compare td {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    vertical-align: top;
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .intervention__compare thead th {
    padding-block: var(--space-2);
    border-bottom: 2px solid var(--color-rule-on-paper-strong);
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-instrument);
    text-transform: uppercase;
  }

  .intervention__compare tbody th {
    width: 7rem;
    font-weight: 600;
  }

  .intervention__compare tbody td {
    color: var(--color-text-on-paper);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .intervention__before {
    color: var(--color-text-on-paper-faint);
  }

  .intervention__responses {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-rule-on-paper-strong);
    list-style: none;
  }

  .intervention__responses li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .intervention__mark {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin: 0;
  }

  .intervention__mark .mono-label {
    color: var(--color-accent-text);
  }

  .intervention__name {
    font-size: var(--text-component);
    font-weight: 600;
  }

  .intervention__note {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .intervention__stack {
    max-width: var(--width-reading);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .intervention__pointer {
    margin: 0;
  }

  /* ── 05 RESULT ───────────────────────────────────────────────────── */

  .result {
    display: grid;
    gap: clamp(var(--space-6), 3.5vw, var(--space-8));
  }

  .result__intro {
    display: grid;
    gap: var(--space-3);
  }

  .result__intro h2 {
    margin: 0;
    max-width: 30ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.15;
  }

  .result__statement {
    max-width: var(--width-content);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .result__cite {
    display: block;
    margin-top: var(--space-1);
