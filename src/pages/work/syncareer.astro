---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../components/case/CaseStudy.astro';
import NotVerified from '../../components/case/NotVerified.astro';
import ProductFrame from '../../components/ProductFrame.astro';
import {
  failureRecord,
  interventionRecord,
  evidenceBoundary,
  syncareerProduct,
} from '../../data/syncareerInvestigation';
import { projectRecords } from '../../data/portfolio';
import { syncareer } from '../../data/registry';
import { SITE, caseMeta, SOCIAL_IMAGE } from '../../config/site';

/* The two captions come from the product record, so the case page and
   the Lab describe the same screens the same way. */
const dashboard = syncareerProduct.surfaces.find((surface) => surface.id === 'dashboard')!;
const opportunities = syncareerProduct.surfaces.find((surface) => surface.id === 'opportunities')!;

const meta = caseMeta({
  name: syncareer.name,
  summary: projectRecords.syncareer.summary,
  image: '/social/syncareer.png',
  imageAlt: 'Syncareer — a live career platform, shown with the dashboard capture from the deployed product.',
});
const { title, description, image, imageAlt } = meta;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Syncareer',
  description,
  url: new URL(syncareer.route, Astro.site).href,
  author: { '@type': 'Person', name: SITE.name },
  codeRepository: 'https://github.com/stevemensah333-rgb/syncareer',
};
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  {image}
  {imageAlt}
  imageWidth={SOCIAL_IMAGE.width}
  imageHeight={SOCIAL_IMAGE.height}
  ogType="article"
>
  <CaseStudy id="syncareer">
    <Fragment slot="visual">
      <div class="captures">
        <div class="captures__lead" style="view-transition-name: artifact-syncareer">
          <ProductFrame
            src1440="/images/syncareer/dashboard-1440.png"
            src1800="/images/syncareer/dashboard-1800.png"
            src2400="/images/syncareer/dashboard-2400.png"
            width={2400}
            height={1302}
            alt="Syncareer dashboard showing career readiness, applications, CV strength and interview progress for one student."
            label="Dashboard / the record"
            caption={dashboard.caption}
            sizes="(min-width: 64rem) min(80rem, calc(100vw - 5rem)), calc(100vw - 2.5rem)"
            priority
          />
        </div>

        <div class="captures__pair">
          <ProductFrame
            src1440="/images/syncareer/opportunities-1440.png"
            src1800="/images/syncareer/opportunities-1800.png"
            src2400="/images/syncareer/opportunities-2400.png"
            width={2400}
            height={1303}
            alt="Syncareer opportunities interface showing job search, match score, and interview and CV tailoring actions."
            label="Opportunities / application workflow"
            caption={opportunities.caption}
            sizes="(min-width: 64rem) 40vw, calc(100vw - 2.5rem)"
          />
          <ProductFrame
            src1440="/images/syncareer/synai-context-1440.png"
            src1800="/images/syncareer/synai-context-1800.png"
            src2400="/images/syncareer/synai-context-2400.png"
            width={2400}
            height={1302}
            alt="Syncareer SynAI interface showing career guidance built from a student profile, quick actions and a message input."
            label="SynAI / context"
            caption="Profile context and quick actions in the existing platform."
            sizes="(min-width: 64rem) 40vw, calc(100vw - 2.5rem)"
          />
        </div>
      </div>
    </Fragment>

    <Fragment slot="problem">
      <p>{failureRecord.explanation}</p>

      <div class="case-shape">
        <div class="case-shape__head">
          <span class="case-shape__label">{failureRecord.oldContract.label}</span>
          <span class="case-shape__class">Documented shape</span>
        </div>
        <div class="case-shape__row">
          <span class="case-shape__key">request</span>
          <span class="case-shape__value">{failureRecord.oldContract.request}</span>
        </div>
        {failureRecord.oldContract.gaps.map((gap) => (
          <div class="case-shape__row">
            <span class="case-shape__key">{gap.field}</span>
            <span class="case-shape__value">{gap.note}</span>
          </div>
        ))}
        <p class="case-shape__foot">{failureRecord.oldContract.source}</p>
      </div>


    </Fragment>

    <Fragment slot="contribution">
      <p>{syncareerProduct.scope}</p>

      <ul class="role-list">
        <li>
          <strong>The contract</strong> — what a request may carry, and what a reply must cite
          before the interface can use it.
        </li>
        <li>
          <strong>The checks</strong> — validation and grounding between the model and the
          interface, not inside a prompt.
        </li>
        <li>
          <strong>The review surface</strong> — accept, edit, reject or undo stays with the person.
          Nothing reaches the saved CV on its own.
        </li>
      </ul>
    </Fragment>

    <Fragment slot="decisions">
      <p>{interventionRecord.lede}</p>

      <div class="case-compare">
        <div class="case-compare__head" aria-hidden="true">
          <span>Contract</span>
          <span>Before</span>
          <span>After</span>
        </div>
        {interventionRecord.comparison.items.map((item) => (
          <div class="case-compare__row">
            <span class="case-compare__name">{item.name}</span>
            <span class="case-compare__cell" data-role="Before">{item.before}</span>
            <span class="case-compare__cell case-compare__cell--after" data-role="After">
              {item.after}
            </span>
          </div>
        ))}
      </div>

      <details class="case-deeper">
        <summary>Four engineering decisions</summary>
        <div class="case-deeper__body">
          {interventionRecord.responses.map((response) => (
            <div>
              <h3>{response.name}</h3>
              <p>{response.note}</p>
            </div>
          ))}
          <p>{interventionRecord.stack}</p>
        </div>
      </details>

      <div class="case-lab">
        <p>
          <strong>The gate is on the Lab page.</strong> Write a bullet, choose what it cites, and
          watch the check decide. One example passes with four invented claims in it, which is the
          point.
        </p>
        <ul class="case-lab__links">
          <li><a href="/lab/">Open the Reliability Lab ↗</a></li>
          <li><a href="/lab/#lab-invented">A passing sentence that is entirely made up</a></li>
        </ul>
      </div>
    </Fragment>

    <Fragment slot="result">
      <p>{projectRecords.syncareer.result}</p>

      <dl class="case-states">
        <div>
          <dt>Live product</dt>
          <dd>
            <strong>Deployed.</strong> The existing platform is public at syncareer.me, and the
            captures above come from it.
          </dd>
        </div>
        <div>
          <dt>Grounding revision</dt>
          <dd>
            <strong>In source, awaiting deployment.</strong> The live platform does not run it yet.
          </dd>
        </div>
      </dl>

      <p class="case-sub">In source</p>
      <ul class="case-evidence case-evidence--known">
        {evidenceBoundary.known.slice(0, 4).map((item) => (
          <li>{item.text} <small>{item.cite}</small></li>
        ))}
      </ul>
    </Fragment>

    <Fragment slot="limits">
      <NotVerified
        lead="The repository shows a repaired contract. It doesn’t show that the model got better."
        items={evidenceBoundary.missing.map((item) => item.text)}
        closing={`The project’s own notes score five fixed examples against a six-part rubric: 8/30 for the old contract, 29/30 for the revised one. Those are marks on fixtures that compare two contract versions, not live-model scores.`}
      />
    </Fragment>

    <Fragment slot="sources">
      <ul class="case-sources">
        <li>
          <a href="https://syncareer.me/" target="_blank" rel="noopener">Live product</a>
          <span class="case-sources__tag">syncareer.me</span>
          <span>The deployed platform the captures come from.</span>
        </li>
        <li>
          <a href="https://github.com/stevemensah333-rgb/syncareer" target="_blank" rel="noopener">
            Source repository
          </a>
          <span class="case-sources__tag">GitHub</span>
          <span>Contract, handler, prompts and the Deno tests.</span>
        </li>
        <li>
          <a
            href="https://github.com/stevemensah333-rgb/syncareer/blob/main/docs/CONTEXTUAL_ASSISTANT_V2.md"
            target="_blank"
            rel="noopener">Contract handoff</a
          >
          <span class="case-sources__tag">docs</span>
          <span>The project’s own record of what changed, what was tested, and what was not.</span>
        </li>
        <li>
          <a href="/lab/">Reliability Lab</a>
          <span class="case-sources__tag">This site</span>
          <span>Stage-by-stage source inspection, plus the labelled fixtures.</span>
        </li>
      </ul>

      <p class="case-note">
        Files cited: <code>contract.ts</code>, <code>handler.ts</code>,
        <code>parseModelProposal</code>, <code>index.test.ts</code>.
      </p>
    </Fragment>
  </CaseStudy>
</BaseLayout>

<style>
  .captures {
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.75rem);
  }
  .captures__lead {
    min-width: 0;
  }
  .captures__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.75rem);
    align-items: start;
  }

  .role-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }
  .role-list li {
    padding: 0.65rem 0 0.1rem;
    border-bottom: 1px solid var(--color-rule-soft);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-on-paper-muted);
    max-width: 62ch;
  }
  .role-list strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 46rem) {
    .captures__pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
