---
import { GMAIL_COMPOSE_URL } from '../../config/site';
import { syncareer } from '../../data/registry';
import ProjectSection from '../../components/ProjectSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFrame from '../../components/SectionFrame.astro';
import ProductFrame from '../../components/ProductFrame.astro';

const title = `${syncareer.name} — Career Workspace Case Study | Stephen Mensah`;
const description = `${syncareer.name} is an opportunity-first career workspace: saved opportunity → tailored CV → interview preparation → outcome. How its AI help was grounded in cited evidence — and what is still unverified.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${syncareer.name} — Career Workspace Case Study`,
  headline: 'Evidence-grounded AI in a real career product',
  description,
  url: new URL(syncareer.route, Astro.site).href,
  image: new URL('/images/syncareer/synai-context-2400.png', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  about: {
    '@type': 'SoftwareApplication',
    name: syncareer.name,
    url: 'https://syncareer.me/',
  },
};
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  image="/images/syncareer/synai-context-2400.png"
  imageAlt="Syncareer SynAI career-guidance interface"
  imageWidth={2400}
  imageHeight={1302}
  ogType="article"
>
  <article class="case-page">
    <header id="overview" class="case-hero page-shell" data-workspace-section="top">
      <a class="back-link" href="/#syncareer">← Back to workspace</a>

      <div class="case-opening">
        <div>
          <p class="mono-label">Case study · {syncareer.name} · Live</p>
          <h1>A real product, with AI help that cites its evidence.</h1>
          <p class="case-summary">
            {syncareer.claim} This case study is the same trace that runs on the
            homepage — opened as its own surface so each stage can be inspected in depth.
          </p>
        </div>

        <aside class="product-record" aria-label={`${syncareer.name} product record`}>
          <div class="record-heading">
            <p>Product record · 01</p>
            <span>Built product</span>
          </div>
          <p class="product-record__name">{syncareer.name}</p>
          <dl>
            <div><dt>Product</dt><dd>Career workspace (free to use)</dd></div>
            <div><dt>AI feature</dt><dd>Contextual assistant + interview practice</dd></div>
            <div><dt>AI provider</dt><dd>Lovable AI gateway</dd></div>
            <div><dt>Evidence</dt><dd>Product interface + source repo</dd></div>
            <div><dt>Website</dt><dd><a href="https://syncareer.me/" target="_blank" rel="noopener">Visit {syncareer.name} <span aria-hidden="true">↗</span></a></dd></div>
          </dl>
        </aside>
      </div>

      <div class="case-product-hero">
        <ProductFrame
          src1440="/images/syncareer/synai-context-1440.png"
          src1800="/images/syncareer/synai-context-1800.png"
          src2400="/images/syncareer/synai-context-2400.png"
          width={2400}
          height={1302}
          alt="Syncareer SynAI interface showing a personalised introduction using Stephen's degree, interests and profile skills, with career guidance, CV tips, interview preparation and skill-gap actions."
          label="01 / AI feature and context"
          caption="SynAI makes the product context visible: degree, interests and profile skills inform the career-guidance interface."
          priority={true}
        />
      </div>
    </header>

    <SectionFrame coordinate="01 / Trace context" surface="paper" data-workspace-section="syncareer">
      <div class="page-shell trace-context">
        <div class="trace-context__copy">
          <p class="mono-label">Reliability trace</p>
          <h2>From raw model output to product-ready.</h2>
          <p>
            The trace follows the same stages used in the homepage inspector — input,
            output, validation, failure, diagnosis, intervention, and the resulting valid
            output — opened here so each transition is visible.
          </p>
        </div>
      </div>
    </SectionFrame>

    <SectionFrame coordinate="02 / Product journey" surface="paper" data-workspace-section="journey">
      <div class="page-shell journey">
        <div class="journey__copy">
          <p class="mono-label">What the product does</p>
          <h2>One journey: opportunity to outcome.</h2>
          <p>
            Syncareer is free to use — no tiers, no gating. Every screen serves the path from
            a saved opportunity to a stronger application and a tracked outcome.
          </p>
        </div>
        <ol class="journey__steps">
          <li>
            <p class="mono-label">01 · Opportunity</p>
            <h3>Save real opportunities.</h3>
            <p>External job aggregation for the student&apos;s major and region, with market intelligence and alumni outcomes for context. The assistant explains requirements, compares them against supplied evidence, and suggests research questions.</p>
          </li>
          <li>
            <p class="mono-label">02 · Evidence / CV</p>
            <h3>Build the CV from cited evidence.</h3>
            <p>Structured CV editor with AI bullet rewrites against a selected requirement and selected evidence, a deterministic CV Strength Score, skill-gap analysis, export and a public portfolio. Every rewrite must cite its sources; nothing applies automatically.</p>
          </li>
          <li>
            <p class="mono-label">03 · Interview preparation</p>
            <h3>Practise against the role.</h3>
            <p>A voice interview simulator with an AI interviewer and feedback, plus practice questions and feedback explanations. Interview generation runs in deployed-only functions, so its exact prompts cannot be audited from the repo — and LLM output is intentionally not treated as a testing contract.</p>
          </li>
          <li>
            <p class="mono-label">04 · Next action</p>
            <h3>Move the application forward.</h3>
            <p>Application workspaces with follow-up drafts, organised notes and clarified next actions, plus counsellor booking and messaging. Drafts use only supplied facts, with placeholders where facts are missing.</p>
          </li>
          <li>
            <p class="mono-label">05 · Outcome</p>
            <h3>Track what happened.</h3>
            <p>Applications, stages and outcomes stay connected so each round feeds the next. No placement rates or success percentages are claimed.</p>
          </li>
        </ol>
        <div class="journey__decisions">
          <p class="mono-label">Product / system decisions</p>
          <p>React + Vite frontend on Supabase (Auth, Postgres with row-level security, database functions, edge functions), hosted on Lovable Cloud — no custom API server. Authorization is enforced server-side; route guards are UX only.</p>
        </div>
      </div>
    </SectionFrame>

    <ProjectSection
      project={syncareer}
      anchorId="trace"
      coordinate="03 / Stage inspector"
      showNarrative={true}
    />

    <SectionFrame coordinate="04 / Evidence & limitations" surface="paper" data-workspace-section="evidence">
      <div class="page-shell">
        <div class="outcome-grid">
          <section class="boundary-panel" aria-labelledby="boundary-title">
            <p class="mono-label">What this does not prove yet</p>
            <h2 id="boundary-title">Evidence boundary</h2>
            <ul class="boundary-list">
              <li data-state="known">Observed failure classes identified</li>
              <li data-state="known">Revised request/response contract implemented</li>
              <li data-state="missing">No before-and-after model outputs supplied</li>
              <li data-state="missing">No repeatable evaluation supplied</li>
              <li data-state="missing">No measured failure rate supplied</li>
              <li data-state="missing">Some AI functions are deployed-only (prompts unauditable)</li>
            </ul>
          </section>

          <section class="traction-panel" aria-labelledby="product-result-title">
            <p class="mono-label">Product traction · not a reliability measure</p>
            <h2 id="product-result-title">What came of {syncareer.name}</h2>
            <dl class="traction-metrics">
              <div><dt>Sign-ups</dt><dd>80+</dd></div>
              <div><dt>Daily page visits</dt><dd>About 50</dd></div>
            </dl>
            <p>
              Self-reported from the founder's product analytics. These numbers show product
              use. They are not presented as evidence that the LLM became more reliable.
            </p>
          </section>
        </div>
      </div>
    </SectionFrame>

    <div class="case-content page-shell">
      <section
        id="contact-section"
        class="contact-section"
        aria-labelledby="contact-title"
        data-workspace-section="contact"
      >
        <p class="mono-label">Contact</p>
        <h2 id="contact-title">Want to talk through the engineering?</h2>
        <a class="button" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">Email Stephen</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .case-page {
    border-bottom: var(--border-default);
  }

  .case-hero {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .case-opening {
    display: grid;
    gap: clamp(var(--space-5), 2.5vw, var(--space-6));
  }

  .back-link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    margin-bottom: var(--space-4);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .case-hero h1 {
    max-width: 18ch;
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-feature);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .case-summary {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .product-record {
    position: relative;
    align-self: end;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    overflow: hidden;
  }

  .record-heading {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .record-heading p,
  .record-heading span,
  .product-record dt {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .record-heading span {
    color: var(--color-accent);
  }

  .product-record h2 {
    margin-block: var(--space-5) var(--space-4);
    font-size: var(--text-component);
    font-weight: 600;
  }

  .product-record__name {
    margin: 0 0 var(--space-4);
    font-size: var(--text-component);
    font-weight: 600;
  }

  .product-record dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .product-record dl div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .product-record dd {
    margin: 0;
    font-size: var(--text-small);
  }

  .product-record a {
    font-weight: 600;
    color: var(--color-text-on-paper);
    text-decoration: none;
  }

  .product-record a:hover {
    color: var(--color-accent);
  }

  .case-product-hero {
    margin-top: var(--space-6);
  }

  .trace-context {
    padding-block: var(--section-block);
  }

  .trace-context__copy {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .trace-context__copy h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .trace-context__copy p:last-child {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .journey {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .journey__copy {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .journey__copy h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .journey__copy p:last-child {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .journey__steps {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: journey;
  }

  .journey__steps li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .journey__steps h3 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .journey__steps p:last-child {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .journey__decisions {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .journey__decisions p:last-child {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .outcome-grid {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .boundary-panel,
  .traction-panel {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .boundary-panel h2,
  .traction-panel h2 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
  }

  .boundary-list {
    display: grid;
    margin: var(--space-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-on-paper);
    list-style: none;
  }

  .boundary-list li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  .boundary-list li::before {
    position: absolute;
    left: 0;
    color: var(--color-text-on-paper-muted);
    content: '—';
    font-family: var(--font-mono);
  }

  .boundary-list li[data-state='known']::before {
    color: var(--color-signal-pass);
    content: '✓';
  }

  .boundary-list li[data-state='missing']::before {
    color: var(--color-signal-fail);
    content: '×';
  }

  .traction-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-3) 0;
    border-block: 1px solid var(--color-rule-on-paper);
  }

  .traction-metrics div {
    display: flex;
    min-height: 6.5rem;
    flex-direction: column-reverse;
    justify-content: space-between;
    padding: var(--space-4);
  }

  .traction-metrics div + div {
    border-left: 1px solid var(--color-rule-on-paper);
  }

  .traction-metrics dt {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .traction-metrics dd {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 650;
  }

  .case-content {
    padding-bottom: var(--space-6);
  }

  .case-content section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .contact-section h2 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .contact-section .button {
    margin-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    .journey__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .outcome-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .case-opening {
      grid-template-columns: minmax(0, 7fr) minmax(19rem, 5fr);
      align-items: end;
    }
  }

  @media (max-width: 30rem) {
    .case-hero h1 {
      font-size: 1.75rem;
    }

    .traction-metrics {
      grid-template-columns: 1fr;
    }

    .traction-metrics div + div {
      border-top: 1px solid var(--color-rule-on-paper);
      border-left: 0;
    }
  }
</style>
