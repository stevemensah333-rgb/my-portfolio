---
import { GMAIL_COMPOSE_URL } from '../../config/site';
import { syncareer } from '../../data/registry';
import {
  evidenceBoundary,
  investigationDecisions,
  syncareerProduct,
} from '../../data/syncareerInvestigation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFrame from '../../components/SectionFrame.astro';
import ProductFrame from '../../components/ProductFrame.astro';
import SyncareerInvestigation from '../../components/SyncareerInvestigation.astro';
import ReliabilityTrace from '../../components/ReliabilityTrace.astro';

const title = `${syncareer.name} — Career Workspace Case Study | Stephen Mensah`;
const description = `${syncareer.name} is an opportunity-first career workspace: saved opportunity → tailored CV → interview preparation → outcome. How its AI help was grounded in cited evidence — and what is still unverified.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${syncareer.name} — Career Workspace Case Study`,
  headline: 'Evidence-grounded AI in a real career product',
  description,
  url: new URL(syncareer.route, Astro.site).href,
  image: new URL('/images/syncareer/synai-context-2400.png', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Stephen Mensah',
    url: new URL('/', Astro.site).href,
  },
  about: {
    '@type': 'SoftwareApplication',
    name: syncareer.name,
    url: 'https://syncareer.me/',
  },
};
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  image="/images/syncareer/synai-context-2400.png"
  imageAlt="Syncareer SynAI career-guidance interface"
  imageWidth={2400}
  imageHeight={1302}
  ogType="article"
>
  <article class="case-page">
    <header id="overview" class="case-hero page-shell" data-workspace-section="top" data-workspace-dest="work">
      <a class="back-link" href="/#syncareer">← Back to workspace</a>

      <div class="case-opening">
        <div>
          <p class="mono-label">Case study · {syncareer.name} · Live</p>
          <h1>A real product, with AI help that has to cite its evidence.</h1>
          <p class="case-summary">
            {syncareer.short} {syncareerProduct.problem} {syncareerProduct.built}
          </p>
        </div>

        <aside class="product-record" aria-label={`${syncareer.name} product record`}>
          <div class="record-heading">
            <p>Product record · 01</p>
            <span>Built product</span>
          </div>
          <p class="product-record__name">{syncareer.name}</p>
          <dl>
            <div><dt>Product</dt><dd>Career workspace (free to use)</dd></div>
            <div><dt>AI feature</dt><dd>Contextual assistant + interview practice</dd></div>
            <div><dt>AI path</dt><dd>career-guidance v2 · Lovable AI gateway</dd></div>
            <div><dt>Tracked model</dt><dd>google/gemini-2.5-flash</dd></div>
            <div>
              <dt>Website</dt>
              <dd>
                <a href={syncareerProduct.liveUrl} target="_blank" rel="noopener">
                  Visit {syncareer.name} <span aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>
                <a href={syncareerProduct.repoUrl} target="_blank" rel="noopener">
                  GitHub repository <span aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>

      <div class="case-product-hero">
        <ProductFrame
          src1440="/images/syncareer/synai-context-1440.png"
          src1800="/images/syncareer/synai-context-1800.png"
          src2400="/images/syncareer/synai-context-2400.png"
          width={2400}
          height={1302}
          alt="Syncareer SynAI interface showing a personalised introduction using Stephen's degree, interests and profile skills, with career guidance, CV tips, interview preparation and skill-gap actions."
          label="01 / AI feature and context"
          caption="SynAI makes the product context visible: degree, interests and profile skills inform the career-guidance interface."
          priority={true}
        />
      </div>
    </header>

    <section class="case-trace-band on-deck" data-workspace-section="trace" data-workspace-dest="work">
    <SectionFrame coordinate="01 · Causal path" status="Instrument" surface="canvas" density="default">
      <div class="page-shell case-trace">
        <div class="case-trace__copy">
          <p class="mono-label">Reliability trace</p>
          <h2>Raw output is not a product feature.</h2>
          <p>
            Replay the path, or inspect a stage. Unstructured rewrite → validation
            → refusal → intervention → cited output. The animation is the same
            causal story as the investigation below.
          </p>
        </div>
        <ReliabilityTrace instanceId="case" />
      </div>
    </SectionFrame>
    </section>

    <SectionFrame coordinate="02 · Investigation" surface="paper" data-workspace-section="syncareer" data-workspace-dest="work">
      <div class="page-shell case-investigation">
        <SyncareerInvestigation />
      </div>
    </SectionFrame>

    <SectionFrame coordinate="03 · Decisions" surface="paper" data-workspace-section="decisions" data-workspace-dest="work">
      <div class="page-shell case-decisions">
        <header class="case-decisions__intro">
          <p class="mono-label">What Stephen actually built</p>
          <h2>The engineering decisions that mattered.</h2>
        </header>
        <ul class="case-decisions__list">
          {investigationDecisions.map((item) => (
            <li>
              <p class="mono-label">{item.label}</p>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
        <p class="case-decisions__stack">
          React + Vite frontend on Supabase (Auth, Postgres with row-level security,
          database functions, edge functions), hosted on Lovable Cloud — no custom
          API server. Authorization is enforced server-side; route guards are UX only.
          Interview generation runs in deployed-only functions, so its exact prompts
          cannot be audited from the repository.
        </p>
      </div>
    </SectionFrame>

    <SectionFrame coordinate="04 · Product surfaces" surface="paper" data-workspace-section="surfaces" data-workspace-dest="work">
      <div class="page-shell case-surfaces">
        <header class="case-surfaces__intro">
          <p class="mono-label">The product around the contract</p>
          <h2>Opportunity, CV, interview — one workspace.</h2>
        </header>
        <div class="case-surfaces__grid">
          <ProductFrame
            src1440="/images/syncareer/dashboard-1440.png"
            src1800="/images/syncareer/dashboard-1800.png"
            src2400="/images/syncareer/dashboard-2400.png"
            width={2400}
            height={1302}
            alt="Syncareer dashboard showing career readiness, application, CV strength and interview progress."
            label="02 / Dashboard"
            caption="Readiness, applications, CV strength and interview progress in one place."
            address="syncareer.me/dashboard"
          />
          <ProductFrame
            src1440="/images/syncareer/opportunities-1440.png"
            src1800="/images/syncareer/opportunities-1800.png"
            src2400="/images/syncareer/opportunities-2400.png"
            width={2400}
            height={1303}
            alt="Syncareer opportunities interface showing job search, match score, and interview / CV tailoring actions."
            label="03 / Opportunities"
            caption="Saved opportunities feed CV tailoring and interview practice. Match scores are product UI, not a claimed hiring probability."
            address="syncareer.me/opportunities"
          />
        </div>
      </div>
    </SectionFrame>

    <SectionFrame coordinate="05 · Evidence & limitations" surface="paper" data-workspace-section="evidence" data-workspace-dest="work">
      <div class="page-shell">
        <div class="outcome-grid">
          <section class="boundary-panel" aria-labelledby="boundary-known-title">
            <p class="mono-label">Verified in the repository</p>
            <h2 id="boundary-known-title">What this shows</h2>
            <ul class="boundary-list">
              {evidenceBoundary.known.map((item) => (
                <li data-state="known">{item}</li>
              ))}
            </ul>
          </section>

          <section class="boundary-panel" aria-labelledby="boundary-title">
            <p class="mono-label">What this does not prove yet</p>
            <h2 id="boundary-title">Evidence boundary</h2>
            <ul class="boundary-list">
              {evidenceBoundary.missing.map((item) => (
                <li data-state="missing">{item}</li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </SectionFrame>

    <div class="case-content page-shell">
      <section
        id="contact-section"
        class="contact-section"
        aria-labelledby="contact-title"
        data-workspace-section="contact"
      >
        <p class="mono-label">Contact</p>
        <h2 id="contact-title">Want to talk through the engineering?</h2>
        <a class="button" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">Email Stephen</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .case-page {
    border-bottom: var(--border-default);
  }

  .case-hero {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .case-opening {
    display: grid;
    gap: clamp(var(--space-5), 2.5vw, var(--space-6));
  }

  .back-link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    margin-bottom: var(--space-4);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent-text);
  }

  .case-hero h1 {
    max-width: 18ch;
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-feature);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .case-summary {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .product-record {
    position: relative;
    align-self: end;
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
    overflow: hidden;
  }

  .record-heading {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .record-heading p,
  .record-heading span,
  .product-record dt {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .record-heading span {
    color: var(--color-accent-text);
  }

  .product-record__name {
    margin: 0 0 var(--space-4);
    font-size: var(--text-component);
    font-weight: 600;
  }

  .product-record dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .product-record dl div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .product-record dd {
    margin: 0;
    font-size: var(--text-small);
  }

  .product-record a {
    font-weight: 600;
    color: var(--color-text-on-paper);
    text-decoration: none;
  }

  .product-record a:hover {
    color: var(--color-accent-text);
  }

  .case-product-hero {
    margin-top: var(--space-6);
  }

  /* PRE-EXISTING BUG, fixed here: the band used SectionFrame
     surface="canvas" (which sets on-canvas TEXT colours) but never
     painted a deck background, so the heading rendered near-white on
     cream — roughly 1.3:1. The band now carries the deck it was
     always styled for. */
  .case-trace-band {
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
  }

  .case-trace {
    display: grid;
    gap: var(--space-6);
  }

  .case-trace__copy {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .case-trace__copy h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    color: var(--color-text-on-canvas);
  }

  .case-trace__copy p:last-child {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .case-trace .mono-label {
    color: var(--color-text-on-canvas-muted);
  }

  .case-investigation {
    padding-block: var(--section-block);
  }

  .case-decisions {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .case-decisions__intro {
    display: grid;
    gap: var(--space-3);
  }

  .case-decisions__intro h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .case-decisions__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-decisions__list li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper);
  }

  .case-decisions__list p:last-child {
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .case-decisions__stack {
    margin: 0;
    max-width: var(--width-reading);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .case-surfaces {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .case-surfaces__intro {
    display: grid;
    gap: var(--space-3);
  }

  .case-surfaces__intro h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .case-surfaces__grid {
    display: grid;
    gap: var(--space-6);
  }

  .outcome-grid {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .boundary-panel {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-rule-on-paper);
    background: var(--color-paper-soft);
  }

  .boundary-panel h2 {
    margin: 0;
    font-size: var(--text-component);
    font-weight: 600;
  }

  .boundary-list {
    display: grid;
    margin: var(--space-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-on-paper);
    list-style: none;
  }

  .boundary-list li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-small);
  }

  .boundary-list li::before {
    position: absolute;
    left: 0;
    color: var(--color-text-on-paper-muted);
    content: '—';
    font-family: var(--font-mono);
  }

  .boundary-list li[data-state='known']::before {
    color: var(--color-signal-pass-text);
    content: '✓';
  }

  .boundary-list li[data-state='missing']::before {
    color: var(--color-signal-fail-text);
    content: '×';
  }

  .case-content {
    padding-bottom: var(--space-6);
  }

  .case-content section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule-on-paper);
  }

  .contact-section h2 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
  }

  .contact-section .button {
    margin-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    .case-decisions__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .case-surfaces__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .outcome-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .case-opening {
      grid-template-columns: minmax(0, 7fr) minmax(19rem, 5fr);
      align-items: end;
    }

    .case-trace {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }

  @media (max-width: 30rem) {
    .case-hero h1 {
      font-size: 1.75rem;
    }

    .case-decisions__list {
      grid-template-columns: 1fr;
    }
  }
</style>
