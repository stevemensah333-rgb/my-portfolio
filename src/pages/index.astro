---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkbenchHero from '../components/home/WorkbenchHero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import LabPreview from '../components/home/LabPreview.astro';
import PersonSection from '../components/home/PersonSection.astro';
import { PUBLIC_LINKS } from '../config/site';

const title = 'Stephen Mensah — Software engineer';
const description =
  'I build AI-powered products and the systems behind them. Syncareer, SessionBook and Koranco Farms — with the decisions, source and limits of each.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  jobTitle: 'Software engineer',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.webp', Astro.site).href,
  sameAs: [PUBLIC_LINKS.github, PUBLIC_LINKS.linkedin],
};
---

<BaseLayout {title} {description} {structuredData}>
  <WorkbenchHero />
  <SelectedWork />
  <LabPreview />
  <PersonSection />
</BaseLayout>
