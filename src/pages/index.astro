---
import { GMAIL_COMPOSE_URL } from '../config/site';
import { projects } from '../data/registry';
import ReliabilityTrace from '../components/ReliabilityTrace.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GutterAxis from '../components/GutterAxis.astro';
import SectionFrame from '../components/SectionFrame.astro';
import { labCopy } from '../data/reliabilityLab';

const title = 'Stephen Mensah — Software Engineer building reliable AI features';
const description =
  'Stephen Mensah is a software engineer who builds and debugs LLM-powered software, with attention to reliability, validation, integration, and production behavior.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.png', Astro.site).href,
  sameAs: ['https://github.com/stevemensah333-rgb', 'https://www.linkedin.com/in/stephen-mensah-867538348/'],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Ashesi University',
  },
  jobTitle: 'Software Engineer',
  description,
  knowsAbout: [
    'LLM reliability',
    'Evidence-grounded AI integration',
    'Structured output validation',
    'FastAPI',
    'Postgres',
    'Concurrent transaction design',
  ],
};
---

<BaseLayout {title} {description} {structuredData} ogType="profile">
  <!-- 01 HOME · orientation + concise proof -->
  <section class="hero on-deck" aria-labelledby="hero-title" data-workspace-section="top">
    <div class="page-shell hero__shell">
      <div class="hero__identity">
        <div class="hero__axis">
          <GutterAxis ticks={5} surface="canvas" origin="00" terminus="Hero" />
        </div>

        <div class="hero__message">
          <p class="mono-label mono-label--inverse hero__eyebrow">
            AI Engineering · Software Reliability
          </p>
          <h1 id="hero-title" class="hero__headline">
            <span class="hero__line">I make AI features</span>
            <span class="hero__line hero__line--accent">reliable enough to ship.</span>
          </h1>
          <p class="hero__support">
            I build and debug LLM-powered software. I pay attention to what happens when model
            output has to fit an actual product.
          </p>
          <div class="hero__actions" role="group" aria-label="Primary actions">
            <a class="button button--accent" href="/work/">Explore the work</a>
            <a class="text-link" href="/lab/">
              Open the Lab
              <span class="text-link__arrow" aria-hidden="true">→</span>
            </a>
            <a class="text-link" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">
              Email me
              <span class="text-link__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <dl class="hero__coords" aria-label="Site coordinates">
        <div><dt>Status</dt><dd><span class="signal-dot" aria-hidden="true"></span>Open to AI engineering roles</dd></div>
        <div><dt>Based</dt><dd>Berekuso, Ghana</dd></div>
        <div><dt>Year</dt><dd>2026 · B.Sc. Computer Science</dd></div>
        <div><dt>Work</dt><dd>{projects.length} projects</dd></div>
      </dl>

      <!-- CONCISE PROOF: the claim, running. The full investigation lives
           at /work/syncareer/ and the instrument at /lab/ — this is the
           condensed causal path, derived from the canonical record. -->
      <div class="hero__instrument">
        <p class="hero__instrument-label">
          <span class="mono-label mono-label--inverse">The claim, running</span>
          <span class="hero__instrument-hint">Step through it — or let it play.</span>
        </p>
        <ReliabilityTrace instanceId="hero" />
      </div>
    </div>
  </section>

  <!-- 02 WORK · entry -->
  <section id="work" class="work-entry" aria-labelledby="work-entry-title" data-workspace-section="work">
    <SectionFrame coordinate="02 · Work" status="Archive" surface="paper" density="default">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">02</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">Project archive</span>
          </div>
        </aside>

        <div class="region-body">
          <header class="work-entry__header">
            <h2 id="work-entry-title" class="work-entry__title">The work.</h2>
            <p class="work-entry__lede">
              Three projects, each with a case study and an honest evidence boundary.
              Syncareer, the flagship, is a live career workspace whose AI help has to
              cite its evidence.
            </p>
          </header>

          <ol class="work-entry__list">
            {projects.map((project, index) => (
              <li>
                <a class="work-entry__row" href={project.route}>
                  <span class="work-entry__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="work-entry__name">{project.name}</span>
                  <span class="work-entry__status">
                    <span class="work-entry__status-dot" aria-hidden="true"></span>
                    {project.status.replace(/-/g, ' ')}
                  </span>
                  <span class="work-entry__chev" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>

          <a class="text-link work-entry__all" href="/work/">
            Open the work archive
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <!-- 03 LAB · entry -->
  <section id="lab" class="lab-entry on-deck" aria-labelledby="lab-entry-title" data-workspace-section="lab">
    <SectionFrame coordinate="03 · Lab" status="Instrument" surface="canvas" density="default">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">03</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">Instrumentation</span>
          </div>
        </aside>

        <div class="region-body">
          <h2 id="lab-entry-title" class="lab-entry__title">{labCopy.title}</h2>
          <p class="lab-entry__lede">
            The Syncareer investigation, opened as an instrument: run it, step it, or
            inspect any stage directly. Items marked ILLUSTRATIVE are fixtures, not logs.
          </p>
          <a class="button button--accent lab-entry__cta" href="/lab/">
            Open the instrument
            <span class="lab-entry__chev" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <!-- 04 PROFILE · entry -->
  <section id="profile" class="profile-entry" aria-labelledby="profile-entry-title" data-workspace-section="profile">
    <SectionFrame coordinate="04 · Profile" surface="paper" density="default">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">04</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">The person</span>
          </div>
        </aside>

        <div class="region-body">
          <h2 id="profile-entry-title" class="profile-entry__title">Profile.</h2>
          <p class="profile-entry__lede">
            The person behind the work — and the credentials that are easier to show
            than describe.
          </p>
          <ul class="profile-entry__areas">
            <li><a href="/profile/#about">About</a></li>
            <li><a href="/profile/#experience">Experience</a></li>
            <li><a href="/profile/#capabilities">Capabilities</a></li>
            <li><a href="/profile/#evidence">Evidence</a></li>
          </ul>
          <a class="text-link profile-entry__cta" href="/profile/">
            Open the profile
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <ContactSection />
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ============================================================
     HERO — the identity band.

     Composition:
       ┌ axis ┬──────────── headline (full measure) ───────────┐
       │      │ eyebrow / headline / support / actions          │
       ├──────┴────────────────────────────────────────────────┤
       │ coordinates — a ruled strip, four cells, inline        │
       ├───────────────────────────────────────────────────────┤
       │ the claim, running — the trace, inset into the band    │
       └───────────────────────────────────────────────────────┘

     The homepage orients and proves; the work lives at /work/,
     the instrument at /lab/, the person at /profile/.
     ============================================================ */

  .hero {
    position: relative;
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--color-rule-on-canvas-soft) 1px, transparent 1px);
    background-size: 8rem 100%;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 45%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 45%);
    pointer-events: none;
  }

  .hero__shell {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(2.5rem, 5.5vw, 5rem) clamp(3rem, 6vw, 5.5rem);
  }

  .hero__identity {
    display: grid;
    gap: var(--space-4);
  }

  .hero__axis {
    display: none;
  }

  .hero__message {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
  }

  .hero__eyebrow {
    color: var(--color-accent-text);
  }

  .hero__headline {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-text-on-canvas);
    text-wrap: balance;
  }

  .hero__line {
    display: block;
  }

  .hero__line--accent {
    color: var(--color-accent-text);
  }

  .hero__support {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-1);
  }

  .hero__actions .text-link {
    color: var(--color-text-on-canvas);
  }

  .hero__coords {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.045em;
  }

  .hero__coords > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-canvas-soft);
  }

  .hero__coords > div:last-child {
    border-bottom: 0;
  }

  .hero__coords dt {
    color: var(--color-text-on-canvas-faint);
    text-transform: uppercase;
  }

  .hero__coords dd {
    margin: 0;
    color: var(--color-text-on-canvas);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .signal-dot {
    flex: 0 0 auto;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-1px);
    animation: signal-blink 2.8s var(--ease-standard) infinite;
  }

  @keyframes signal-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-dot {
      animation: none;
    }
  }

  .hero__instrument {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck-deep);
  }

  .hero__instrument::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .hero__instrument-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .hero__instrument-hint {
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
  }

  /* --- responsive ------------------------------------------------ */

  @media (min-width: 40rem) {
    .hero__coords {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .hero__coords > div:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (min-width: 60rem) {
    .hero__shell {
      gap: var(--space-7);
    }

    .hero__identity {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      column-gap: var(--rail-gap);
    }

    .hero__axis {
      display: block;
      align-self: stretch;
    }

    .hero__coords {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-5);
    }

    .hero__coords > div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      align-content: start;
      border-bottom: 0;
      border-left: 1px solid var(--color-rule-on-canvas-soft);
      padding-inline: var(--space-4);
    }

    .hero__coords > div:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .hero__instrument {
      padding: var(--space-5);
    }
  }

  @media (min-width: 80rem) {
    .hero__headline {
      max-width: 14ch;
    }
  }

  @media (max-width: 30rem) {
    .hero__shell {
      gap: var(--space-5);
    }

    .hero__coords > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      padding-block: var(--space-2);
    }

    .hero__instrument {
      padding: var(--space-3);
      margin-inline: calc(var(--page-gutter) * -0.5);
    }
  }

  /* ============================================================
     ENTRY BANDS — Work / Lab / Profile.
     Orientation only: one heading, one line, one route in. The
     content itself lives on its own page, so nothing is stated
     twice on this page.
     ============================================================ */

  .work-entry {
    background: var(--color-sheet);
  }

  .work-entry__header {
    display: grid;
    gap: var(--space-3);
  }

  .work-entry__title {
    margin: 0;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
  }

  .work-entry__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .work-entry__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .work-entry__list li {
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  .work-entry__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--space-3) var(--space-4);
    min-height: 3.25rem;
    padding-block: var(--space-3);
    color: var(--color-text-on-paper);
    text-decoration: none;
    transition:
      color var(--duration-quick) var(--ease-standard),
      padding-left var(--duration-base) var(--ease-emphasized);
  }

  .work-entry__row:hover,
  .work-entry__row:focus-visible {
    padding-left: var(--space-2);
    color: var(--color-accent-text);
  }

  .work-entry__index {
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
  }

  .work-entry__name {
    font-size: var(--text-body-large);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .work-entry__status {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .work-entry__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .work-entry__chev {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard);
  }

  .work-entry__row:hover .work-entry__chev,
  .work-entry__row:focus-visible .work-entry__chev {
    opacity: 1;
    transform: translateX(0);
  }

  .work-entry__all {
    justify-self: start;
  }

  /* --- lab entry ------------------------------------------------- */

  .lab-entry {
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
  }

  .lab-entry__title {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    color: var(--color-text-on-canvas);
  }

  .lab-entry__lede {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .lab-entry__cta {
    justify-self: start;
    margin-top: var(--space-2);
  }

  .lab-entry__chev {
    margin-left: var(--space-2);
  }

  /* --- profile entry --------------------------------------------- */

  .profile-entry {
    background: var(--color-sheet-soft);
  }

  .profile-entry__title {
    margin: 0;
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
  }

  .profile-entry__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .profile-entry__areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile-entry__areas a {
    color: var(--color-text-on-paper);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .profile-entry__areas a:hover,
  .profile-entry__areas a:focus-visible {
    color: var(--color-accent-text);
  }

  .profile-entry__cta {
    justify-self: start;
  }

  @media (max-width: 40rem) {
    .work-entry__row {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .work-entry__status {
      grid-column: 2;
    }

    .work-entry__chev {
      display: none;
    }
  }
</style>
