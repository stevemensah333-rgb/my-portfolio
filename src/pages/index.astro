---
import { GMAIL_COMPOSE_URL } from '../config/site';
import { projects } from '../data/registry';
import ReliabilityTrace from '../components/ReliabilityTrace.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFrame from '../components/SectionFrame.astro';
import { labCopy, labStages } from '../data/reliabilityLab';

const title = 'Stephen Mensah — Software Engineer building reliable AI features';
const description =
  'Stephen Mensah is a software engineer who builds and debugs LLM-powered software, with attention to reliability, validation, integration, and production behavior.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.png', Astro.site).href,
  sameAs: ['https://github.com/stevemensah333-rgb', 'https://www.linkedin.com/in/stephen-mensah-867538348/'],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Ashesi University',
  },
  jobTitle: 'Software Engineer',
  description,
  knowsAbout: [
    'LLM reliability',
    'Evidence-grounded AI integration',
    'Structured output validation',
    'FastAPI',
    'Postgres',
    'Concurrent transaction design',
  ],
};
---

<BaseLayout {title} {description} {structuredData} ogType="profile" area="home">
  <!-- 01 HOME · orientation, then the claim running.
       Spacious: this is the one page that owes the visitor room. -->
  <section class="hero" aria-labelledby="hero-title" data-workspace-section="top" data-workspace-label="Home">
    <div class="page-shell hero__shell">
      <div class="hero__message">
        <p class="mono-label hero__eyebrow">AI Engineering · Software Reliability</p>
        <h1 id="hero-title" class="hero__headline">
          <span class="hero__line">I make AI features</span>
          <span class="hero__line">reliable enough to ship.</span>
        </h1>
        <p class="hero__support">
          I build and debug LLM-powered software. I pay attention to what happens when model
          output has to fit an actual product.
        </p>
        <div class="hero__actions" role="group" aria-label="Primary actions">
          <a class="button button--accent" href="/work/">Explore the work</a>
          <a class="text-link" href="/lab/">
            Open the Lab
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">
            Email me
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Coordinates: a ruled strip, not a card. -->
      <dl class="hero__coords" aria-label="Site coordinates">
        <div><dt>Status</dt><dd><span class="signal-dot" aria-hidden="true"></span>Open to AI engineering roles</dd></div>
        <div><dt>Based</dt><dd>Berekuso, Ghana</dd></div>
        <div><dt>Year</dt><dd>2026 · B.Sc. Computer Science</dd></div>
        <div><dt>Work</dt><dd>{projects.length} projects</dd></div>
      </dl>

      <!-- The one instrument on this page. Dark, because this is the
           surface something is operated on. Offset from the text
           column and registered against the coordinate rule. -->
      <div class="hero__instrument instrument">
        <p class="hero__instrument-label">
          <span class="mono-label">The claim, running</span>
          <span class="hero__instrument-hint">Step through it — or let it play.</span>
        </p>
        <ReliabilityTrace instanceId="hero" />
      </div>
    </div>
  </section>

  <!-- 02 WORK · entry. Visual: the archive is the composition. -->
  <section id="work" class="work-entry" aria-labelledby="work-entry-title" data-workspace-section="work" data-workspace-label="Work">
    <SectionFrame coordinate="02 · Work" status="Archive">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">02</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">Project archive</span>
          </div>
        </aside>

        <div class="region-body">
          <header class="work-entry__header">
            <h2 id="work-entry-title" class="work-entry__title">The work.</h2>
            <p class="work-entry__lede">
              Three projects, each with a case study and an honest evidence boundary.
              Syncareer, the flagship, is a live career workspace whose AI help has to
              cite its evidence.
            </p>
          </header>

          <ol class="work-entry__list">
            {projects.map((project, index) => (
              <li>
                <a class="work-entry__row" href={project.route}>
                  <span class="work-entry__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="work-entry__name">{project.name}</span>
                  <span class="work-entry__stack">{project.stack.slice(0, 3).join(' · ')}</span>
                  <span class="work-entry__status">
                    <span class="work-entry__status-dot" aria-hidden="true"></span>
                    {project.status.replace(/-/g, ' ')}
                  </span>
                  <span class="work-entry__chev" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>

          <a class="text-link work-entry__all" href="/work/">
            Open the work archive
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <!-- 03 LAB · entry. The instrument, indexed: the seven stages are
       the same stages the instrument runs. -->
  <section id="lab" class="lab-entry" aria-labelledby="lab-entry-title" data-workspace-section="lab" data-workspace-label="Lab">
    <SectionFrame coordinate="03 · Lab" status="Instrument">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">03</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">Instrumentation</span>
          </div>
        </aside>

        <div class="region-body">
          <h2 id="lab-entry-title" class="lab-entry__title">{labCopy.title}</h2>
          <p class="lab-entry__lede">
            The Syncareer investigation, opened as an instrument: run it, step it, or
            inspect any stage directly. Items marked ILLUSTRATIVE are fixtures, not logs.
          </p>

          <ol class="lab-entry__scale instrument">
            {labStages.map((stage) => (
              <li class="lab-entry__node">
                <span class="lab-entry__node-step">{stage.step}</span>
                <span class="lab-entry__node-label">{stage.label}</span>
              </li>
            ))}
          </ol>

          <a class="button button--accent lab-entry__cta" href="/lab/">
            Open the instrument
            <span class="lab-entry__chev" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <!-- 04 PROFILE · entry. Structured: a ruled register. -->
  <section id="profile" class="profile-entry" aria-labelledby="profile-entry-title" data-workspace-section="profile" data-workspace-label="Profile">
    <SectionFrame coordinate="04 · Profile">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">04</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">The person</span>
          </div>
        </aside>

        <div class="region-body">
          <h2 id="profile-entry-title" class="profile-entry__title">Profile.</h2>
          <p class="profile-entry__lede">
            The person behind the work — and the credentials that are easier to show
            than describe.
          </p>
          <ul class="profile-entry__areas">
            <li><a href="/profile/#about"><span>About</span><span class="profile-entry__note">Who this is</span></a></li>
            <li><a href="/profile/#experience"><span>Experience</span><span class="profile-entry__note">Where I have worked</span></a></li>
            <li><a href="/profile/#capabilities"><span>Capabilities</span><span class="profile-entry__note">Anchored to projects</span></a></li>
            <li><a href="/profile/#evidence"><span>Evidence</span><span class="profile-entry__note">Credentials, shown</span></a></li>
          </ul>
          <a class="text-link profile-entry__cta" href="/profile/">
            Open the profile
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <ContactSection />
  <SiteFooter slot="footer" /></BaseLayout>

<style>
  /* ============================================================
     HOME — spacious, light, human.

     LIGHT = information. The identity, the archive, the person
     are all read surfaces. The only dark object on this page is
     the instrument: the claim, running, and the seven-stage
     scale that points at the Lab.

     Composition:
       1. Identity — display statement, support, actions
       2. Coordinates — a ruled instrument strip
       3. Instrument — offset, contained, overlapping the strip
       4. Work — a visual index, not a card grid
       5. Lab — a measured stage scale, contained in the field
       6. Profile — a structured register
     ============================================================ */

  .hero {
    position: relative;
    background: var(--color-sheet);
    color: var(--color-text-on-paper);
  }

  .hero__shell {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(3rem, 7vw, 6.5rem) clamp(2.75rem, 6vw, 5.5rem);
  }

  .hero__message {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    max-width: 40rem;
  }

  .hero__headline {
    margin: 0;
    max-width: 11ch;
    font-size: var(--text-display);
  }

  .hero__line {
    display: block;
  }

  .hero__support {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  /* Coordinates are instrument metadata sitting in an information
     field — a ruled strip, not a card. */
  .hero__coords {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-paper-strong);
    border-bottom: 1px solid var(--color-rule-on-paper);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.04em;
  }

  .hero__coords > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper-soft);
  }

  .hero__coords > div:last-child {
    border-bottom: 0;
  }

  .hero__coords dt {
    color: var(--color-text-on-paper-faint);
    text-transform: uppercase;
  }

  .hero__coords dd {
    margin: 0;
    color: var(--color-text-on-paper);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  /* Status — one of the four meanings of orange. */
  .signal-dot {
    flex: 0 0 auto;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-1px);
  }

  /* The instrument is the one dark object: inset, slightly offset,
     overlapping the coordinate rule. Selective rounded containment. */
  .hero__instrument {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-canvas-strong);
    border-radius: var(--radius-contain);
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
  }

  .hero__instrument::before {
    content: '';
    position: absolute;
    top: -1px;
    left: var(--space-4);
    width: var(--mark-length);
    height: var(--mark-stroke);
    background: var(--color-accent);
  }

  .hero__instrument-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .hero__instrument-hint {
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.04em;
  }

  @media (min-width: 40rem) {
    .hero__coords {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .hero__coords > div:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (min-width: 64rem) {
    .hero__shell {
      grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
      grid-template-areas:
        "message message"
        "coords  instrument";
      column-gap: var(--rail-gap);
      row-gap: var(--space-6);
      align-items: start;
    }

    .hero__message {
      grid-area: message;
      max-width: 42rem;
    }

    .hero__coords {
      grid-area: coords;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-self: start;
    }

    .hero__instrument {
      grid-area: instrument;
      padding: var(--space-5);
      /* Occasional overlap: the instrument sits slightly on the
         coordinate rule, so the two surfaces share an edge. */
      margin-top: calc(var(--space-5) * -1);
    }
  }

  @media (min-width: 80rem) {
    .hero__headline {
      max-width: 10ch;
    }
  }

  @media (max-width: 30rem) {
    .hero__shell {
      gap: var(--space-5);
      padding-block: var(--space-7) var(--space-6);
    }

    .hero__coords > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      padding-block: var(--space-2);
    }

    .hero__instrument {
      padding: var(--space-3);
      margin-inline: calc(var(--page-gutter) * -0.35);
    }
  }

  /* ============================================================
     WORK — visual. The archive is the composition: a ruled
     index, the flagship row given more measure, no cards.
     ============================================================ */

  .work-entry {
    background: var(--color-sheet-high);
  }

  .work-entry__header {
    display: grid;
    gap: var(--space-3);
  }

  .work-entry__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-statement);
  }

  .work-entry__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .work-entry__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .work-entry__list li {
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  /* Flagship first: more vertical measure, larger name. Hierarchy
     without a second pattern. */
  .work-entry__list li:first-child .work-entry__row {
    min-height: 4.25rem;
    padding-block: var(--space-4);
  }

  .work-entry__list li:first-child .work-entry__name {
    font-size: var(--text-component);
  }

  .work-entry__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas:
      "index name   chev"
      "index stack  status";
    align-items: baseline;
    column-gap: var(--space-3);
    row-gap: 2px;
    min-height: 3rem;
    padding-block: var(--space-3);
    color: var(--color-text-on-paper);
    text-decoration: none;
  }

  .work-entry__row:hover,
  .work-entry__row:focus-visible {
    color: var(--color-accent-text);
  }

  .work-entry__index {
    grid-area: index;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.05em;
  }

  .work-entry__name {
    grid-area: name;
    font-size: var(--text-body-large);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .work-entry__stack {
    grid-area: stack;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.04em;
  }

  .work-entry__status {
    grid-area: status;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    justify-self: end;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .work-entry__status-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .work-entry__chev {
    grid-area: chev;
    color: var(--color-accent-text);
    font-family: var(--font-instrument);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard);
  }

  .work-entry__row:hover .work-entry__chev,
  .work-entry__row:focus-visible .work-entry__chev {
    opacity: 1;
    transform: translateX(0);
  }

  .work-entry__all {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .work-entry__row {
      grid-template-columns: 2.25rem minmax(0, 1fr) minmax(8rem, 0.7fr) auto auto;
      grid-template-areas: "index name stack status chev";
      align-items: center;
    }
  }

  /* ============================================================
     LAB — the instrument, indexed. Light field, dark scale.
     ============================================================ */

  .lab-entry {
    background: var(--color-sheet);
  }

  .lab-entry__title {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-statement);
  }

  .lab-entry__lede {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* A measured axis of the seven stages. Dark because it is an
     instrument preview, not a card of content. */
  .lab-entry__scale {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(4.5rem, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    border: 1px solid var(--color-rule-on-canvas-strong);
    border-radius: var(--radius-contain);
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
    scrollbar-width: thin;
  }

  .lab-entry__node {
    display: grid;
    gap: var(--space-2);
    min-width: 4.5rem;
    padding: var(--space-4) var(--space-3);
    border-right: 1px solid var(--color-rule-on-canvas);
  }

  .lab-entry__node:last-child {
    border-right: 0;
  }

  .lab-entry__node-step {
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.08em;
  }

  .lab-entry__node-label {
    color: var(--color-text-on-canvas);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .lab-entry__cta {
    justify-self: start;
  }

  .lab-entry__chev {
    margin-left: var(--space-2);
  }

  /* ============================================================
     PROFILE — structured. A ruled register, two lines per area.
     ============================================================ */

  .profile-entry {
    background: var(--color-sheet-soft);
  }

  .profile-entry__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-statement);
  }

  .profile-entry__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .profile-entry__areas {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .profile-entry__areas a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 3.25rem;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .profile-entry__note {
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-small);
    font-weight: 400;
  }

  .profile-entry__areas a:hover,
  .profile-entry__areas a:focus-visible {
    color: var(--color-accent-text);
  }

  .profile-entry__cta {
    justify-self: start;
  }

  @media (max-width: 40rem) {
    .work-entry__row {
      grid-template-columns: 2rem minmax(0, 1fr);
      grid-template-areas:
        "index name"
        "index stack"
        "index status";
    }

    .work-entry__chev {
      display: none;
    }

    .work-entry__status {
      justify-self: start;
    }

    .profile-entry__areas a {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
