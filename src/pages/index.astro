---
import { PUBLIC_EMAIL } from '../config/site';
import { projects } from '../data/registry';
import InteractiveName from '../components/home/InteractiveName.astro';
import StephenPortrait from '../components/home/StephenPortrait.astro';
import ProofTeaser from '../components/home/ProofTeaser.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFrame from '../components/SectionFrame.astro';

const title = 'Stephen Mensah — Software Engineer building reliable AI features';
const description =
  'Stephen Mensah is a software engineer who builds and debugs LLM-powered software, with attention to reliability, validation, integration, and production behavior.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.png', Astro.site).href,
  sameAs: ['https://github.com/stevemensah333-rgb', 'https://www.linkedin.com/in/stephen-mensah-867538348/'],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Ashesi University',
  },
  jobTitle: 'Software Engineer',
  description,
  knowsAbout: [
    'LLM reliability',
    'Evidence-grounded AI integration',
    'Structured output validation',
    'FastAPI',
    'Postgres',
    'Concurrent transaction design',
  ],
};
---

<BaseLayout {title} {description} {structuredData} ogType="profile" area="home">
  <section class="hero" aria-labelledby="hero-title" data-workspace-section="top" data-workspace-label="Home">
    <div class="page-shell hero__shell">
      <!-- 1 · WHO — the identity marker. Masthead scale, not a poster. -->
      <div class="hero__identity">
        <InteractiveName />
      </div>

      <!-- 2 · WHAT — the dominant element of the viewport. -->
      <div class="hero__message">
        <h1 id="hero-title" class="hero__headline">I make AI features <em>reliable enough</em> to ship.</h1>
        <p class="hero__support">
          I build and debug LLM-powered software: the context a model sees, the checks
          its answers must pass, and what happens when they don’t.
        </p>
        <div class="hero__actions" role="group" aria-label="Primary actions">
          <a class="button button--accent" href={`mailto:${PUBLIC_EMAIL}`}>Email me <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/work/">Explore the work <span class="text-link__arrow" aria-hidden="true">→</span></a>
        </div>
        <p class="hero__availability"><span aria-hidden="true"></span>Open to entry-level AI engineering roles</p>
      </div>

      <!-- 3 · PROOF — a compact signpost toward the engineering work. -->
      <div class="hero__proof"><ProofTeaser /></div>

      <!-- The human focal object. Last in reading order; beside the
           text column from 48rem, after the proof cue below it. -->
      <div class="hero__portrait"><StephenPortrait /></div>
    </div>
  </section>

  <!-- 02 WORK · entry. Visual: the archive is the composition. -->
  <section id="work" class="work-entry" aria-labelledby="work-entry-title" data-workspace-section="work" data-workspace-label="Work">
    <SectionFrame coordinate="02 · Work" status="Archive">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">02</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">Project archive</span>
          </div>
        </aside>

        <div class="region-body">
          <header class="work-entry__header">
            <h2 id="work-entry-title" class="work-entry__title">The work.</h2>
            <p class="work-entry__lede">
              Three projects, each with a case study and an honest evidence boundary.
              Syncareer, the flagship, is a live career workspace whose AI help has to
              cite its evidence.
            </p>
          </header>

          <ol class="work-entry__list">
            {projects.map((project, index) => (
              <li>
                <a class="work-entry__row" href={project.route}>
                  <span class="work-entry__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="work-entry__name">{project.name}</span>
                  <span class="work-entry__stack">{project.stack.slice(0, 3).join(' · ')}</span>
                  <span class:list={['work-entry__status', `work-entry__status--${project.status}`]}>
                    <span class="work-entry__status-dot" aria-hidden="true"></span>
                    {project.status.replace(/-/g, ' ')}
                  </span>
                  <span class="work-entry__chev" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>

          <a class="text-link work-entry__all" href="/work/">
            Open the work archive
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <!-- 04 PROFILE · entry. Structured: a ruled register. -->
  <section id="profile" class="profile-entry" aria-labelledby="profile-entry-title" data-workspace-section="profile" data-workspace-label="Profile">
    <SectionFrame coordinate="04 · Profile">
      <div class="page-shell region-grid">
        <aside class="region-rail">
          <div class="region-index">
            <span class="region-index__no">04</span>
            <span class="region-index__rule"></span>
            <span class="region-index__name">The person</span>
          </div>
        </aside>

        <div class="region-body">
          <h2 id="profile-entry-title" class="profile-entry__title">Profile.</h2>
          <p class="profile-entry__lede">
            The person behind the work — and the credentials that are easier to show
            than describe.
          </p>
          <ul class="profile-entry__areas">
            <li><a href="/profile/#about"><span>About</span><span class="profile-entry__note">Who this is</span></a></li>
            <li><a href="/profile/#experience"><span>Experience</span><span class="profile-entry__note">Where I have worked</span></a></li>
            <li><a href="/profile/#capabilities"><span>Capabilities</span><span class="profile-entry__note">Anchored to projects</span></a></li>
            <li><a href="/profile/#evidence"><span>Evidence</span><span class="profile-entry__note">Credentials, shown</span></a></li>
          </ul>
          <a class="text-link profile-entry__cta" href="/profile/">
            Open the profile
            <span class="text-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </SectionFrame>
  </section>

  <ContactSection />
  <SiteFooter slot="footer" /></BaseLayout>

<style>
  /* Home-only composition; the established shell and other areas are unchanged.

     THE HIERARCHY (AGENTS.md §11). One dominant typographic idea:
     the statement. The name is the identity marker above it at
     masthead scale, the portrait is the human anchor beside it, and
     the proof cue is a small signpost at the foot of the text
     column. Three things, in reading order — WHO, WHAT, PROOF. */
  .hero { background: var(--color-sheet); color: var(--color-text-on-paper); }
  .hero__shell {
    display: grid;
    gap: 2.25rem;
    padding-block: clamp(1.75rem, 3vw, 2.75rem) clamp(2.5rem, 5vw, 4.25rem);
  }
  .hero__identity {
    min-width: 0;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-rule-on-paper-strong);
  }
  .hero__message {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    container-type: inline-size;
  }

  /* THE STATEMENT — the largest type in the viewport. It carries the
     display weight/tracking from the global h1 rule; only the scale
     is hero-specific. Like the name, it is sized against its own
     column (`cqi`), so the two keep their ratio (~1.3–1.5×) at every
     width, with or without the desktop rail. */
  .hero__headline {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(2.375rem, 9.6cqi, 4.25rem);
    line-height: 1.04;
  }
  .hero__headline em { font-style: normal; color: var(--color-accent-ink); }
  .hero__support { max-width: 40ch; margin: 0; color: var(--color-text-on-paper-muted); font-size: var(--text-body-large); line-height: 1.6; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .hero__availability { display: flex; align-items: baseline; gap: 0.5rem; margin: 0; font-size: 0.75rem; color: var(--color-text-on-paper-faint); }
  /* The same "open to roles" mark the control rail carries — one
     meaning, one size, one colour. */
  .hero__availability span { width: var(--node-status); height: var(--node-status); flex-shrink: 0; background: var(--color-accent); border-radius: 50%; }
  .hero__portrait { min-width: 0; }
  .hero__proof { min-width: 0; }

  /* ASYMMETRICAL COMPOSITION. A dominant text column (WHO → WHAT →
     PROOF, in that order) against one strong portrait region that
     sits at the top of the second column and leaves the space under
     it empty. Not three columns, not three equal blocks. Any extra
     height goes to the last row, so the text column never spreads. */
  @media (min-width: 48rem) {
    .hero__shell {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "identity portrait"
        "message  portrait"
        "proof    portrait";
      column-gap: clamp(2rem, 4vw, 4.5rem);
      row-gap: clamp(1.75rem, 2.4vw, 2.5rem);
    }
    .hero__identity { grid-area: identity; }
    .hero__message { grid-area: message; }
    .hero__proof { grid-area: proof; align-self: start; }
    .hero__portrait { grid-area: portrait; align-self: start; }
  }

  /* ============================================================
     WORK — visual. The archive is the composition: a ruled
     index, the flagship row given more measure, no cards.
     ============================================================ */

  .work-entry {
    background: var(--color-sheet-high);
  }

  .work-entry__header {
    display: grid;
    gap: var(--space-3);
  }

  .work-entry__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-statement);
  }

  .work-entry__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .work-entry__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .work-entry__list li {
    border-bottom: 1px solid var(--color-rule-on-paper);
  }

  /* Flagship first: more vertical measure, larger name. Hierarchy
     without a second pattern. */
  .work-entry__list li:first-child .work-entry__row {
    min-height: 4.25rem;
    padding-block: var(--space-4);
  }

  .work-entry__list li:first-child .work-entry__name {
    font-size: var(--text-component);
  }

  .work-entry__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas:
      "index name   chev"
      "index stack  status";
    align-items: baseline;
    column-gap: var(--space-3);
    row-gap: 2px;
    min-height: 3rem;
    padding-block: var(--space-3);
    color: var(--color-text-on-paper);
    text-decoration: none;
  }

  .work-entry__row:hover,
  .work-entry__row:focus-visible {
    color: var(--color-accent-text);
  }

  .work-entry__index {
    grid-area: index;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.05em;
  }

  .work-entry__name {
    grid-area: name;
    font-size: var(--text-body-large);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .work-entry__stack {
    grid-area: stack;
    color: var(--color-text-on-paper-faint);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.04em;
  }

  .work-entry__status {
    grid-area: status;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    justify-self: end;
    color: var(--color-text-on-paper-muted);
    font-family: var(--font-instrument);
    font-size: var(--text-instrument-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .work-entry__status-dot {
    width: var(--node-status);
    height: var(--node-status);
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* One status, one colour, everywhere it appears. Live and mvp read
     as pass in the archive and on a project record, so they read as
     pass here too; only work still in flight keeps the attention
     accent. */
  .work-entry__status--live .work-entry__status-dot,
  .work-entry__status--mvp .work-entry__status-dot {
    background: var(--color-signal-pass);
  }

  .work-entry__chev {
    grid-area: chev;
    color: var(--color-accent-text);
    font-family: var(--font-instrument);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--duration-quick) var(--ease-standard),
      transform var(--duration-quick) var(--ease-standard);
  }

  .work-entry__row:hover .work-entry__chev,
  .work-entry__row:focus-visible .work-entry__chev {
    opacity: 1;
    transform: translateX(0);
  }

  .work-entry__all {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .work-entry__row {
      grid-template-columns: 2.25rem minmax(0, 1fr) minmax(8rem, 0.7fr) auto auto;
      grid-template-areas: "index name stack status chev";
      align-items: center;
    }
  }

  /* ============================================================
     PROFILE — structured. A ruled register, two lines per area.
     ============================================================ */

  .profile-entry {
    background: var(--color-sheet-soft);
  }

  .profile-entry__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-statement);
  }

  .profile-entry__lede {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-paper-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .profile-entry__areas {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-paper-strong);
  }

  .profile-entry__areas a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 3.25rem;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-paper);
    color: var(--color-text-on-paper);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-standard);
  }

  .profile-entry__note {
    color: var(--color-text-on-paper-faint);
    font-size: var(--text-small);
    font-weight: 400;
  }

  .profile-entry__areas a:hover,
  .profile-entry__areas a:focus-visible {
    color: var(--color-accent-text);
  }

  .profile-entry__cta {
    justify-self: start;
  }

  @media (max-width: 40rem) {
    .work-entry__row {
      grid-template-columns: 2rem minmax(0, 1fr);
      grid-template-areas:
        "index name"
        "index stack"
        "index status";
    }

    .work-entry__chev {
      display: none;
    }

    .work-entry__status {
      justify-self: start;
    }

    .profile-entry__areas a {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
