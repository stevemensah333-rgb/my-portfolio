---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkbenchHero from '../components/home/WorkbenchHero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import LabPreview from '../components/home/LabPreview.astro';
import PersonSection from '../components/home/PersonSection.astro';
import { SITE, PUBLIC_LINKS, pageMeta } from '../config/site';

const { title, description, image, imageAlt } = pageMeta.home;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'Software engineer',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.webp', Astro.site).href,
  sameAs: [PUBLIC_LINKS.github, PUBLIC_LINKS.linkedin],
};
---

<BaseLayout {title} {description} {structuredData} {image} {imageAlt}>
  <WorkbenchHero />
  <SelectedWork />
  <LabPreview />
  <PersonSection />
</BaseLayout>
