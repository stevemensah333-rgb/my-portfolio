---
import { GMAIL_COMPOSE_URL, PUBLIC_LINKS } from '../config/site';
import { projects, sessionbook } from '../data/registry';
import ReliabilityTrace from '../components/ReliabilityTrace.astro';
import ReliabilityLab from '../components/ReliabilityLab.astro';
import ProjectSection from '../components/ProjectSection.astro';
import SyncareerPreview from '../components/SyncareerPreview.astro';
import KorancoSection from '../components/KorancoSection.astro';
import TechnicalToolkitSection from '../components/TechnicalToolkitSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GutterAxis from '../components/GutterAxis.astro';

const title = 'Stephen Mensah — Software Engineer building reliable AI features';
const description =
  'Stephen Mensah is a software engineer who builds and debugs LLM-powered software, with attention to reliability, validation, integration, and production behavior.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.png', Astro.site).href,
  sameAs: [PUBLIC_LINKS.github, PUBLIC_LINKS.linkedin].filter(
    (value): value is string => Boolean(value),
  ),
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Ashesi University',
  },
  jobTitle: 'Software Engineer',
  description,
  knowsAbout: [
    'LLM reliability',
    'Evidence-grounded AI integration',
    'Structured output validation',
    'FastAPI',
    'Postgres',
    'Concurrent transaction design',
  ],
};
---

<BaseLayout {title} {description} {structuredData} ogType="profile">
  <section class="hero on-deck" aria-labelledby="hero-title" data-workspace-section="top">
    <div class="page-shell hero__shell">
      <!-- IDENTITY: the axis measures it, the headline owns the
           full width, and the coordinates sit inline underneath as
           a ruled strip rather than as a sidebar card. -->
      <div class="hero__identity">
        <div class="hero__axis">
          <GutterAxis ticks={5} surface="canvas" origin="00" terminus="Hero" />
        </div>

        <div class="hero__message">
          <p class="mono-label mono-label--inverse hero__eyebrow">
            AI Engineering · Software Reliability
          </p>
          <h1 id="hero-title" class="hero__headline">
            <span class="hero__line">I make AI features</span>
            <span class="hero__line hero__line--accent">reliable enough to ship.</span>
          </h1>
          <p class="hero__support">
            I build and debug LLM-powered software. I pay attention to what happens when model
            output has to fit an actual product.
          </p>
          <div class="hero__actions" role="group" aria-label="Primary actions">
            <a class="button button--accent" href="#syncareer">See the proof</a>
            <a class="text-link" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">
              Email me
              <span class="text-link__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <dl class="hero__coords" aria-label="Site coordinates">
        <div><dt>Status</dt><dd><span class="signal-dot" aria-hidden="true"></span>Open to AI engineering roles</dd></div>
        <div><dt>Based</dt><dd>Berekuso, Ghana</dd></div>
        <div><dt>Year</dt><dd>2026 · B.Sc. Computer Science</dd></div>
        <div><dt>Workspace</dt><dd>{projects.length} projects</dd></div>
      </dl>

      <!-- SYSTEM TRACE: the instrument is inset into the hero, not
           stacked below it. The label band above it is what joins
           the two: the identity states the claim, the trace is the
           claim running. -->
      <div class="hero__instrument">
        <p class="hero__instrument-label">
          <span class="mono-label mono-label--inverse">The claim, running</span>
          <span class="hero__instrument-hint">Step through it — or let it play.</span>
        </p>
        <ReliabilityTrace instanceId="hero" />
      </div>
    </div>
  </section>

  <SyncareerPreview />

  <!-- Work · SessionBook -->
  <ProjectSection
    project={sessionbook}
    anchorId="sessionbook"
    railIndex="01.2"
    coordinate={`01.2 · Work / ${sessionbook.name}`}
    showNarrative={false}
  />

  <!-- Work · Koranco (ongoing engagement, no inspector) -->
  <KorancoSection />

  <!-- Reliability Lab · the signature instrument, as its own workspace -->
  <ReliabilityLab />

  <TechnicalToolkitSection />
  <ExperienceSection />
  <AboutSection />
  <EvidenceSection />
  <ContactSection />
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ============================================================
     HERO — the identity band.

     Composition:
       ┌ axis ┬──────────── headline (full measure) ───────────┐
       │      │ eyebrow / headline / support / actions          │
       ├──────┴────────────────────────────────────────────────┤
       │ coordinates — a ruled strip, four cells, inline        │
       ├───────────────────────────────────────────────────────┤
       │ the claim, running — the trace, inset into the band    │
       └───────────────────────────────────────────────────────┘

     Two decisions carry the authority:
     1. The headline is given the full measure instead of sharing a
        row with the trace, so identity and instrument are separated
        by ORDER and DENSITY rather than by a column split.
     2. The trace is inset — it sits on the deeper deck step, framed,
        with a label band that names its relationship to the claim.
        It reads as part of the identity, not as a component below it.
     ============================================================ */

  .hero {
    position: relative;
    background: var(--color-deck);
    color: var(--color-text-on-canvas);
    isolation: isolate;
  }

  /* A faint measured field behind the hero — 1px lines on an 8rem
     grid, fading out downward. It gives the band depth without any
     gradient, image or particle. Purely decorative, so it is behind
     everything and invisible to assistive tech. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--color-rule-on-canvas-soft) 1px, transparent 1px);
    background-size: 8rem 100%;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 45%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 45%);
    pointer-events: none;
  }

  .hero__shell {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(2.5rem, 5.5vw, 5rem) clamp(3rem, 6vw, 5.5rem);
  }

  /* --- identity ------------------------------------------------ */

  .hero__identity {
    display: grid;
    gap: var(--space-4);
  }

  .hero__axis {
    display: none;
  }

  .hero__message {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
  }

  .hero__eyebrow {
    color: var(--color-accent-text);
  }

  /* IDENTITY role: the only display-scale type in the system. */
  .hero__headline {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-text-on-canvas);
    text-wrap: balance;
  }

  .hero__line {
    display: block;
  }

  .hero__line--accent {
    color: var(--color-accent-text);
  }

  .hero__support {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-1);
  }

  .hero__actions .text-link {
    color: var(--color-text-on-canvas);
  }

  /* --- coordinates --------------------------------------------- */
  /* A ruled strip, not a card: hairline top and bottom, cells
     divided by single rules. Dense, scannable, zero container. */

  .hero__coords {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--color-rule-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.045em;
  }

  .hero__coords > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule-on-canvas-soft);
  }

  .hero__coords > div:last-child {
    border-bottom: 0;
  }

  .hero__coords dt {
    color: var(--color-text-on-canvas-faint);
    text-transform: uppercase;
  }

  .hero__coords dd {
    margin: 0;
    color: var(--color-text-on-canvas);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .signal-dot {
    flex: 0 0 auto;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-1px);
    animation: signal-blink 2.8s var(--ease-standard) infinite;
  }

  @keyframes signal-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-dot {
      animation: none;
    }
  }

  /* --- instrument ---------------------------------------------- */
  /* The trace is INSET: it sits on the deep deck step with a framed
     edge and a copper registration tick, so it reads as recessed
     into the identity band rather than placed on top of it. */

  .hero__instrument {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-rule-on-canvas);
    background: var(--color-deck-deep);
  }

  .hero__instrument::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .hero__instrument-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .hero__instrument-hint {
    color: var(--color-text-on-canvas-faint);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
  }

  /* --- responsive ---------------------------------------------- */

  @media (min-width: 40rem) {
    .hero__coords {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .hero__coords > div:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (min-width: 60rem) {
    .hero__shell {
      gap: var(--space-7);
    }

    /* The axis appears only where there is room for it to mean
       something: it measures the identity block's height. */
    .hero__identity {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      column-gap: var(--rail-gap);
    }

    .hero__axis {
      display: block;
      align-self: stretch;
    }

    .hero__coords {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-5);
    }

    .hero__coords > div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      align-content: start;
      border-bottom: 0;
      border-left: 1px solid var(--color-rule-on-canvas-soft);
      padding-inline: var(--space-4);
    }

    .hero__coords > div:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .hero__instrument {
      padding: var(--space-5);
    }
  }

  @media (min-width: 80rem) {
    .hero__headline {
      max-width: 14ch;
    }
  }

  @media (max-width: 30rem) {
    .hero__shell {
      gap: var(--space-5);
    }

    .hero__coords > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      padding-block: var(--space-2);
    }

    .hero__instrument {
      padding: var(--space-3);
      margin-inline: calc(var(--page-gutter) * -0.5);
    }
  }
</style>
