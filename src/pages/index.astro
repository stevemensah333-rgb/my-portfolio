---
import { GMAIL_COMPOSE_URL, PUBLIC_LINKS } from '../config/site';
import { projects, syncareer, sessionbook } from '../data/registry';
import ReliabilityTrace from '../components/ReliabilityTrace.astro';
import ProjectSection from '../components/ProjectSection.astro';
import KorancoSection from '../components/KorancoSection.astro';
import SectionFrame from '../components/SectionFrame.astro';
import TechnicalToolkitSection from '../components/TechnicalToolkitSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GutterAxis from '../components/GutterAxis.astro';

const title = 'Stephen Mensah — Software Engineer building reliable AI features';
const description =
  'Stephen Mensah is a software engineer who builds and debugs LLM-powered software, with attention to reliability, validation, integration, and production behavior.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen.png', Astro.site).href,
  sameAs: [PUBLIC_LINKS.github, PUBLIC_LINKS.linkedin].filter(
    (value): value is string => Boolean(value),
  ),
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Ashesi University',
  },
  jobTitle: 'Software Engineer',
  description,
  knowsAbout: [
    'LLM reliability',
    'Evidence-grounded AI integration',
    'Structured output validation',
    'FastAPI',
    'Postgres',
    'Concurrent transaction design',
  ],
};
---

<BaseLayout {title} {description} {structuredData} ogType="profile">
  <section class="hero" aria-labelledby="hero-title" data-workspace-section="top">
    <div class="hero__canvas">
      <GutterAxis position="left" ticks={5} surface="canvas" />
      <GutterAxis position="right" ticks={5} surface="canvas" />

      <div class="hero__grid">
        <aside class="hero__meta" aria-label="Site coordinates">
          <p class="mono-label mono-label--inverse">Session · Hero</p>
          <dl class="hero__coords">
            <div><dt>Status</dt><dd><span class="signal-dot" aria-hidden="true"></span>Open to AI engineering roles</dd></div>
            <div><dt>Based</dt><dd>Berekuso, Ghana</dd></div>
            <div><dt>Year</dt><dd>2026 · B.Sc. Computer Science</dd></div>
            <div><dt>Workspace</dt><dd>{projects.length} projects</dd></div>
          </dl>
        </aside>

        <div class="hero__message">
          <p class="mono-label mono-label--inverse hero__eyebrow">
            <span aria-hidden="true">/</span>
            AI Engineering · Software Reliability
          </p>
          <h1 id="hero-title" class="hero__headline">
            <span class="hero__line">I make AI features</span>
            <span class="hero__line">reliable enough to ship.</span>
          </h1>
          <p class="hero__support">
            I build and debug LLM-powered software. I pay attention to what happens when model
            output has to fit an actual product.
          </p>
          <div class="hero__actions" aria-label="Primary actions">
            <a class="button button--accent" href="#syncareer">See the proof</a>
            <a class="text-link" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">
              Email me
              <span class="text-link__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <ReliabilityTrace instanceId="hero" />
      </div>
    </div>
  </section>

  <!-- Work · Syncareer -->
  <ProjectSection
    project={syncareer}
    anchorId="syncareer"
    coordinate={`01 / Work · ${syncareer.name}`}
    showNarrative={true}
    productFrame={{
      src1440: '/images/syncareer/synai-context-1440.png',
      src1800: '/images/syncareer/synai-context-1800.png',
      src2400: '/images/syncareer/synai-context-2400.png',
      width: 2400,
      height: 1302,
      alt: 'Syncareer SynAI interface showing personalised career guidance based on profile, quick actions and a message input.',
      label: 'Product surface / SynAI',
      caption: 'The AI feature combines profile context with career-guidance entry points inside the product.',
      address: 'syncareer.me',
    }}
  />

  <!-- Work · SessionBook -->
  <ProjectSection
    project={sessionbook}
    anchorId="sessionbook"
    coordinate={`02 / Work · ${sessionbook.name}`}
    showNarrative={false}
  />

  <!-- Work · Koranco (ongoing engagement, no inspector) -->
  <KorancoSection />

  <!-- Reliability Lab · the trace engine, exposed as its own workspace -->
  <section id="reliability-lab" class="reliability-lab" aria-labelledby="reliability-lab-title" data-workspace-section="reliability-lab">
    <SectionFrame coordinate="Lab / Reliability trace" surface="canvas">
      <div class="page-shell reliability-lab__layout">
        <header class="reliability-lab__header">
          <p class="mono-label">Reliability Lab · instrument</p>
          <h2 id="reliability-lab-title">A trace engine you can operate.</h2>
          <p>
            The Reliability Lab is the same engine that runs on the homepage, opened as its own surface.
            Inspect stages, replay, and step through each transition. No fabricated metrics.
          </p>
        </header>
        <ReliabilityTrace instanceId="lab" />
      </div>
    </SectionFrame>
  </section>

  <TechnicalToolkitSection />
  <ExperienceSection />
  <AboutSection />
  <EvidenceSection />
  <ContactSection />
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    isolation: isolate;
  }

  .hero__canvas {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-block: var(--space-6);
    padding-inline: var(--page-gutter);
  }

  .hero__meta {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-rule-on-canvas);
  }

  .hero__coords {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .hero__coords div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-3);
    align-items: center;
  }

  .hero__coords dt {
    color: var(--color-text-on-canvas-faint);
    text-transform: uppercase;
  }

  .hero__coords dd {
    margin: 0;
    color: var(--color-text-on-canvas);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .signal-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 25%, transparent);
    animation: signal-blink 2.4s var(--ease-standard) infinite;
  }

  @keyframes signal-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-dot {
      animation: none;
    }
  }

  .hero__message {
    display: grid;
    gap: var(--space-5);
    align-content: center;
  }

  .hero__eyebrow {
    color: var(--color-accent);
  }

  .hero__eyebrow span {
    color: var(--color-text-on-canvas-faint);
    margin-right: var(--space-1);
  }

  .hero__headline {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-text-on-canvas);
  }

  .hero__line {
    display: block;
  }

  .hero__line:last-child {
    color: var(--color-accent);
  }

  .hero__support {
    max-width: 38rem;
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .hero__actions .text-link {
    color: var(--color-text-on-canvas);
  }

  .hero__actions .text-link:hover {
    color: var(--color-accent);
  }

  /* Reliability Lab section */
  .reliability-lab {
    background: var(--color-canvas);
    color: var(--color-text-on-canvas);
    border-top: 1px solid var(--color-rule-on-canvas);
    border-bottom: 1px solid var(--color-rule-on-canvas);
  }

  .reliability-lab__layout {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-block);
  }

  .reliability-lab__header {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-content);
  }

  .reliability-lab__header h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
  }

  .reliability-lab__header p:last-child {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-on-canvas-muted);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  /* Responsive layout */
  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: var(--space-6);
      row-gap: var(--space-7);
    }

    .hero__message {
      grid-column: 2;
    }

    .reliability-lab__layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-7);
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 14rem minmax(0, 1.4fr) minmax(0, 1fr);
      column-gap: var(--space-7);
      row-gap: var(--space-7);
      align-items: start;
    }

    .hero__message {
      grid-column: 2;
      padding-right: var(--space-4);
    }
  }

  @media (max-width: 30rem) {
    .hero__coords div {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .hero__coords dt {
      color: var(--color-text-on-canvas-faint);
    }
  }
</style>
