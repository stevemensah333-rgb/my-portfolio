---
import { GMAIL_COMPOSE_URL, PUBLIC_LINKS } from '../config/site';
import AboutSection from '../components/AboutSection.astro';
import AmbientField from '../components/AmbientField.astro';
import ContactSection from '../components/ContactSection.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ReliabilityTrace from '../components/ReliabilityTrace.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SyncareerSection from '../components/SyncareerSection.astro';
import TechnicalToolkitSection from '../components/TechnicalToolkitSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Stephen Mensah — AI Engineering & Computer Science';
const description = 'Stephen Mensah is a Computer Science student building LLM-powered software, with a focus on making AI features more reliable in real products.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stephen Mensah',
  url: new URL('/', Astro.site).href,
  image: new URL('/images/stephen-mensah-portrait-880.jpg', Astro.site).href,
  sameAs: [PUBLIC_LINKS.github, PUBLIC_LINKS.linkedin],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Ashesi University',
  },
};
---

<BaseLayout {title} {description} {structuredData} ogType="profile">
  <section class="hero page-shell" aria-labelledby="hero-title">
    <AmbientField density={16} variant="hero" />
    <div class="hero-inner">
      <p class="technical-label eyebrow">AI Engineering · Software</p>

      <div class="hero-composition">
        <div class="hero-message">
          <h1 id="hero-title">I make AI features reliable enough to ship.</h1>

          <div class="hero-details">
            <p class="supporting-copy">
              I build and debug LLM-powered software. I pay attention to what happens when model output
              has to fit an actual product.
            </p>

            <div class="hero-actions" aria-label="Portfolio actions">
              <a class="button" href="#syncareer">See the proof</a>
              <a class="email-link" href={GMAIL_COMPOSE_URL} target="_blank" rel="noopener noreferrer">Email me</a>
            </div>
          </div>
        </div>

        <ReliabilityTrace />
      </div>

      <ul class="hero-meta" aria-label="Current status">
        <li>Computer Science student</li>
        <li>Open to AI engineering internships</li>
      </ul>
    </div>
  </section>

  <SyncareerSection />
  <AboutSection />
  <ExperienceSection />
  <TechnicalToolkitSection />
  <EvidenceSection />
  <ContactSection />
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(34rem, calc(100svh - 4.5rem));
    overflow: clip;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    padding-block: clamp(3.5rem, 7vw, 5rem) var(--space-6);
  }

  .eyebrow {
    margin-bottom: clamp(var(--space-5), 2.5vw, var(--space-6));
  }

  h1 {
    max-width: 12ch;
    margin-bottom: clamp(var(--space-6), 4vw, var(--space-7));
    font-size: var(--type-hero);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: var(--leading-display);
  }

  .hero-composition {
    display: grid;
    gap: var(--space-6);
    margin-bottom: clamp(var(--space-5), 3vw, var(--space-6));
  }

  .hero-message {
    display: grid;
    gap: clamp(var(--space-5), 3vw, var(--space-6));
  }

  .hero-message h1 {
    margin-bottom: 0;
  }

  .hero-details {
    display: grid;
    gap: var(--space-5);
  }

  .supporting-copy {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .email-link {
    display: inline-flex;
    min-height: var(--control-height);
    align-items: center;
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    position: relative;
    transition:
      color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .email-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    border-top: 1px solid currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-standard);
  }

  .email-link:hover {
    transform: translateY(-1px);
  }

  .email-link:hover::after {
    transform: scaleX(1);
  }

  .email-link:active {
    transform: translateY(0);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: auto 0 0;
    padding: var(--space-6) 0 0;
    border-top: var(--border-default);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.5;
    list-style: none;
  }

  @media (max-width: 30rem) {
    h1 {
      max-width: none;
      font-size: clamp(2.25rem, 11.25vw, 3.25rem);
      letter-spacing: -0.045em;
    }

    .hero-meta {
      flex-direction: column;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: min(38rem, calc(100svh - 4.5rem));
    }

    .hero-details {
      grid-template-columns: minmax(0, 7fr) minmax(12rem, 3fr);
      align-items: end;
    }

    .hero-actions {
      justify-content: flex-end;
    }

    .hero-meta {
      justify-content: space-between;
    }
  }

  @media (min-width: 64rem) {
    .hero-composition {
      grid-template-columns: minmax(0, 7fr) minmax(20rem, 5fr);
      gap: clamp(var(--space-7), 5vw, var(--space-9));
      align-items: center;
    }
  }
</style>
